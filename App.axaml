<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CustomMcLauncher.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBrushHover" Color="#60A5FA"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentTranslucentBrush" Color="#223B82F6"/>

        <Color x:Key="AccentGradientStart">#60A5FA</Color>
        <Color x:Key="AccentGradientMid">#3B82F6</Color>
        <Color x:Key="AccentGradientEnd">#1D4ED8</Color>

        <Geometry x:Key="ZenithLogoGeometry">M558.344 400.366C571.623 396.064 583.658 391.147 596.643 386.115L637.625 370.625C666.622 359.837 696.309 350.113 724.897 338.366C711.898 350.999 699.747 364.104 687.038 376.719L556.158 505.636C528.781 532.184 499.524 557.819 471.784 584.055L472.073 585.667C476.856 583.156 484.671 580.042 489.84 577.808L518.249 565.513C554.358 550.211 585.042 537.696 622.348 525.143C627.132 534.236 632.665 542.719 638.059 551.443C646.7 565.735 655.599 579.868 664.753 593.837C684.178 624.592 703.87 655.179 723.825 685.593C671.712 673.401 619.504 661.62 567.205 650.251C523.932 640.119 480.502 630.67 436.931 621.909L303.856 685C318.881 668.775 337.163 651.35 352.875 635.346C390.704 596.217 429.114 557.655 468.092 519.67L513.838 474.463C528.25 459.985 544.85 442.908 560.302 429.712C517.215 444.062 474.236 458.735 431.37 473.73C410.21 481.268 388.993 488.646 367.72 495.861C348.57 502.154 326.751 508.351 307.223 514.086C305.97 514.433 305.093 514.578 303.819 514.805L303.707 514.31L306.212 512.571L391.909 457.609C402.704 450.675 415.614 441.623 426.327 435.161C417.499 427.886 408.138 420.933 399.024 413.993C375.58 396.139 352.079 378.374 328.775 360.334C319.433 353.102 309.717 346.407 300.549 338.932C348.224 351.261 396.066 362.933 444.063 373.946L526.132 392.828C536.8 395.328 547.762 397.627 558.344 400.366Z</Geometry>

        <!-- Surfaces -->
        <SolidColorBrush x:Key="BgBrush" Color="#080A0F"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#06080D"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0A0D15"/>
        <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#080B12"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0D111A"/>
        <SolidColorBrush x:Key="CardAltBrush" Color="#0E121B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151C2C"/>
        <SolidColorBrush x:Key="ChipBrush" Color="#141A28"/>
        <SolidColorBrush x:Key="IconChipBrush" Color="#101623"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#121724"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#1B2338"/>
        <SolidColorBrush x:Key="TabActiveBrush" Color="#131826"/>
        <SolidColorBrush x:Key="TabHoverBrush" Color="#101725"/>
        <SolidColorBrush x:Key="TabPressedBrush" Color="#1B2435"/>
        <SolidColorBrush x:Key="InputFocusBrush" Color="#0F131E"/>
        <SolidColorBrush x:Key="LogSidebarBrush" Color="#0B0E16"/>

        <!-- Borders -->
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#121622"/>
        <SolidColorBrush x:Key="BorderCardSoftBrush" Color="#182030"/>
        <SolidColorBrush x:Key="BorderInputBrush" Color="#1B2236"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#1C2438"/>
        <SolidColorBrush x:Key="BorderHoverBrush" Color="#2A3754"/>
        <SolidColorBrush x:Key="BorderEditorBrush" Color="#1D263B"/>
        <SolidColorBrush x:Key="BorderIconBrush" Color="#1E2638"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#1B2234"/>

        <!-- Danger / Warning -->
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerLightBrush" Color="#F87171"/>
        <SolidColorBrush x:Key="DangerStrongBrush" Color="#E5534B"/>
        <SolidColorBrush x:Key="DangerBgBrush" Color="#221316"/>
        <SolidColorBrush x:Key="DangerBgDeepBrush" Color="#35161B"/>
        <SolidColorBrush x:Key="DangerDimBrush" Color="#1A0F12"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#3B191D"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#2D1215"/>
        <SolidColorBrush x:Key="DangerTranslucentBrush" Color="#22E5484D"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="WarningBrightBrush" Color="#FCD34D"/>
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#3A3320"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#2D2612"/>

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5CBD6"/>
        <SolidColorBrush x:Key="TextSoftBrush" Color="#A6ACCD"/>
        <SolidColorBrush x:Key="TextLabelBrush" Color="#9AA7BD"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#78859E"/>
        <SolidColorBrush x:Key="TextSubtleBrush" Color="#6E7B91"/>
        <SolidColorBrush x:Key="TextFaintBrush" Color="#5E6C84"/>
        <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#5A667E"/>
        <SolidColorBrush x:Key="TextCaptionBrush" Color="#3A4556"/>
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#525E75"/>

        <!-- Overlays -->
        <SolidColorBrush x:Key="OverlayBrush" Color="#C8000000"/>

        <!-- Override Fluent list selection highlights to completely eliminate system blue/cyan -->
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent"/>

        <!-- Slider Theme Brush Overrides -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#1D4ED8"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Remove default focus adorners — no ugly square borders on icons/buttons -->
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Border">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <!-- Utilitarian tactile micro-interactions: crisp press feedback without layout thrashing -->
        <Style Selector="Button">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.982)"/>
        </Style>
        <!-- Global Button Hover Brightening: always illuminate, never darken to black -->
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.dangerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Border[Cursor=Hand]">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border[Cursor=Hand]:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>
        <!-- Smooth dropdown / flyout animations + stylish dark menus -->
        <Style Selector="ComboBox /template/ Popup">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(-6px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox:open /template/ Popup">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
        <Style Selector="ComboBox /template/ Popup Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BoxShadow" Value="0 12 32 0 #80000000"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
        </Style>

        <!-- ListBoxItem: ban system blue/cyan selection highlights, preserve dark theme palette -->
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Selectable ListBox rows (for file/table lists that specifically opt into row highlighting) -->
        <Style Selector="ListBox.selectable ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="ListBox.selectable ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.selectable ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="ListBox.selectable ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
        </Style>
        <!-- MenuFlyout and context menus -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(-6px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="MenuFlyoutPresenter:open">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>

        <!-- Fixed slim scrollbars everywhere: constant size, no hover expansion -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#39445C"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="9"/>
            <Setter Property="MinWidth" Value="9"/>
            <Setter Property="MaxWidth" Value="9"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Classes="scrollPageZone" Focusable="False"/>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Classes="scrollPageZone" Focusable="False"/>
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb Classes="zenThumbV"/>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="9"/>
            <Setter Property="MinHeight" Value="9"/>
            <Setter Property="MaxHeight" Value="9"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Classes="scrollPageZone" Focusable="False"/>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Classes="scrollPageZone" Focusable="False"/>
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb Classes="zenThumbH"/>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Invisible but clickable page zones -->
        <Style Selector="RepeatButton.scrollPageZone">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <!-- Thumbs: always 7px, centered; hover only brightens, never resizes -->
        <Style Selector="Thumb.zenThumbV">
            <Setter Property="Width" Value="7"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="bar" CornerRadius="4" Background="{Binding $parent[ScrollBar].Foreground}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.zenThumbH">
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="bar" CornerRadius="4" Background="{Binding $parent[ScrollBar].Foreground}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.zenThumbV:pointerover /template/ Border, Thumb.zenThumbH:pointerover /template/ Border">
            <Setter Property="Background" Value="#4E5B78"/>
        </Style>
        <Style Selector="Thumb.zenThumbV:pressed /template/ Border, Thumb.zenThumbH:pressed /template/ Border">
            <Setter Property="Background" Value="#5C6C8E"/>
        </Style>

        <!-- Slider: Active/Decreased portion filled with blue accent -->
        <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Slider:horizontal /template/ Thumb#PART_Thumb">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrushHover}"/>
        </Style>
        <Style Selector="Slider:horizontal:pointerover /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
        </Style>
        <Style Selector="Slider:horizontal:pointerover /template/ Thumb#PART_Thumb">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
        </Style>
    </Application.Styles>
</Application>