<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ZenithLauncher"
             x:Class="ZenithLauncher.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Brushes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="/Themes/Controls/Buttons.axaml" />
        <StyleInclude Source="/Themes/Controls/Inputs.axaml" />

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>

        <Style Selector="Border">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>

        <Style Selector="Border[Cursor=Hand]:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>

        

                
        <!-- Instance card subtle elevation on hover -->
        <Style Selector="Border.instanceCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="0.16, 1, 0.3, 1"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="0.16, 1, 0.3, 1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.instanceCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        </Style>
        <Style Selector="Border.targetInstanceCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
        </Style>
        <Style Selector="Border.instanceCard.dragging">
            <Setter Property="Opacity" Value="0.0"/>
        </Style>

        <!-- Toast Notification Animation -->
        <Style Selector="Border.toastNotification">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(24px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="BackEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.toastNotification.visible">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>


        <!-- ListBoxItem: ban system blue/cyan selection highlights, preserve dark theme palette -->
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Selectable ListBox rows (for file/table lists that specifically opt into row highlighting) -->
        <Style Selector="ListBox.selectable ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="ListBox.selectable ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.selectable ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="ListBox.selectable ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
        </Style>

        <!-- FlyoutPresenter: clean dark popup without extra gray frames -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="FlyoutPresenter /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="FlyoutPresenter /template/ ScrollViewer#ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- MenuFlyout and context menus -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>

        </Style>
        <Style Selector="MenuFlyoutPresenter:open">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>


        <!-- Fixed slim scrollbars everywhere: constant size, no hover expansion -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#39445C"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="9"/>
            <Setter Property="MinWidth" Value="9"/>
            <Setter Property="MaxWidth" Value="9"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Classes="scrollPageZone" Focusable="False"/>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Classes="scrollPageZone" Focusable="False"/>
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb Classes="zenThumbV"/>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="9"/>
            <Setter Property="MinHeight" Value="9"/>
            <Setter Property="MaxHeight" Value="9"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Classes="scrollPageZone" Focusable="False"/>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Classes="scrollPageZone" Focusable="False"/>
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb Classes="zenThumbH"/>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Invisible but clickable page zones -->
        <Style Selector="RepeatButton.scrollPageZone">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <!-- Thumbs: always 7px, centered; hover only brightens, never resizes -->
        <Style Selector="Thumb.zenThumbV">
            <Setter Property="Width" Value="7"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="bar" CornerRadius="4" Background="{Binding $parent[ScrollBar].Foreground}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.zenThumbH">
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="bar" CornerRadius="4" Background="{Binding $parent[ScrollBar].Foreground}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.zenThumbV:pointerover /template/ Border, Thumb.zenThumbH:pointerover /template/ Border">
            <Setter Property="Background" Value="#4E5B78"/>
        </Style>
        <Style Selector="Thumb.zenThumbV:pressed /template/ Border, Thumb.zenThumbH:pressed /template/ Border">
            <Setter Property="Background" Value="#5C6C8E"/>
        </Style>

        <!-- Slider colors are driven by theme resources (see ZenithTheme.Apply):
             SliderTrackValueFill / SliderTrackFill / SliderThumbBackground -->


        <Style Selector="PathIcon">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <!-- ============ ZENITH DESIGN SYSTEM v2 (XMCL/Millida: flat, no boxes-in-boxes) ============ -->
        <!-- Typography: page / section / hint — единый ритм вместо разрозненных TextBlock -->
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.sectionHint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.rowHint">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextCaptionBrush}"/>
        </Style>
        <Style Selector="TextBlock.heroName">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Section card: минималистичный уровень карточки с тонкой нейтральной обводкой -->
        <Style Selector="Border.zenSection">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- Isolated mini-card for settings groups: single-level surface, no nesting inside -->
        <Style Selector="Border.zenCard">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="Border.zenDivider">
            <Setter Property="Background" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <!-- Плоская строка настройки: прозрачная, hover-подсветка, без микро-рамки -->
        <Style Selector="Border.zenRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.16, 1, 0.3, 1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.zenRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>


        <!-- Expander Modern Fluent Styling (No black header or black hover border) -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Expander:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
        </Style>
        <Style Selector="Expander:pointerover /template/ Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:expanded">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:expanded:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:expanded:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:expanded:pointerover /template/ Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
        </Style>
        <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader:pressed">
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
        </Style>
        <Style Selector="Expander:pressed /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>


    </Application.Styles>
</Application>
