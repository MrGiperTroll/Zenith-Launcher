<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="using:CustomMcLauncher.Controls"
              x:Class="CustomMcLauncher.Controls.RamCardControl">



    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5,10,4" ClipToBounds="False">
        <StackPanel Spacing="0">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock x:Name="TitleBlock" Text="Memory (RAM)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SubtitleBlock" Text="" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="False" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Minimalist badge with fixed geometry: never shifts or wraps -->
                <Border Grid.Column="1"
                        x:Name="BadgeContainer"
                        Background="{StaticResource FieldBrush}"
                        BorderBrush="{StaticResource BorderEditorBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Height="20"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="IBeam"
                        ToolTip.Tip="Double-click to edit (MB)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="NumberText"
                                   Text="4096"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="EditTextBox"
                                 Classes="badgeInput"
                                 IsVisible="False"
                                 FontSize="11"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                 TextAlignment="Right"
                                 VerticalAlignment="Center"
                                 MinWidth="30"
                                 Height="20"
                                 FocusAdorner="{x:Null}"/>
                        <TextBlock x:Name="UnitText"
                                   Text="MB"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,1,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Slim slider -->
            <Slider x:Name="RamSlider"
                    Minimum="512"
                    Maximum="32768"
                    Value="4096"
                    TickFrequency="512"
                    IsSnapToTickEnabled="True"
                    MinHeight="14"
                    Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</UserControl>

