<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="using:CustomMcLauncher.Controls"
              x:Class="CustomMcLauncher.Controls.RamCardControl">



    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6,10,6" ClipToBounds="False">
        <StackPanel Spacing="0">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleBlock" Text="Memory (RAM)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleBlock" Text="" FontSize="10.5" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="False"/>
                </StackPanel>

                <!-- Minimalist badge with fixed geometry: never shifts or wraps -->
                <Border Grid.Column="1"
                        x:Name="BadgeContainer"
                        Background="{StaticResource FieldBrush}"
                        BorderBrush="{StaticResource BorderEditorBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Height="24"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="IBeam"
                        ToolTip.Tip="Double-click to edit (MB)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="NumberText"
                                   Text="4096"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="EditTextBox"
                                 Classes="badgeInput"
                                 IsVisible="False"
                                 FontSize="11.5"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                 TextAlignment="Right"
                                 VerticalAlignment="Center"
                                 MinWidth="34"
                                 Height="24"
                                 FocusAdorner="{x:Null}"/>
                        <TextBlock x:Name="UnitText"
                                   Text="MB"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,1,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Compact Slider with full breathing room -->
            <Slider x:Name="RamSlider"
                    Minimum="512"
                    Maximum="32768"
                    Value="4096"
                    TickFrequency="512"
                    IsSnapToTickEnabled="True"
                    MinHeight="18"
                    Margin="0,4,0,2"/>
        </StackPanel>
    </Border>
</UserControl>


