<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: self-contained, single-file, win-x64 Release.
  Usage:  dotnet publish -c Release -p:PublishProfile=win-x64-singlefile
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Avalonia runtimeconfig needs to know about bundled assets -->
    <PublishDir>$(MSBuildProjectDirectory)\publish\win-x64-singlefile\</PublishDir>
  </PropertyGroup>
</Project>
