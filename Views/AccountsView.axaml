<UserControl xmlns="https://github.com/avaloniaui"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="using:CustomMcLauncher.ViewModels"

             xmlns:views="using:CustomMcLauncher.Views"

             xmlns:conv="using:Avalonia.Data.Converters"

             xmlns:l10n="using:CustomMcLauncher.Extensions"

             xmlns:pages="using:CustomMcLauncher.ViewModels.Pages"

             x:Class="CustomMcLauncher.Views.AccountsView"

             x:DataType="pages:AccountsViewModel"

             Background="{StaticResource BgBrush}">



    <UserControl.Styles>

        <!-- Sign-in method buttons (Qoder Sleek Style) -->

        <Style Selector="Button.methodBtn">

            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>

            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="8"/>

            <Setter Property="Padding" Value="12,0"/>

            <Setter Property="Height" Value="42"/>

            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="HorizontalAlignment" Value="Stretch"/>

        </Style>

        <Style Selector="Button.methodBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>

        </Style>

        <Style Selector="Button.methodBtn:disabled">

            <Setter Property="Opacity" Value="0.5"/>

        </Style>



        <!-- Account row card -->

        <Style Selector="Border.accRowCard">

            <Setter Property="Background" Value="{StaticResource CardBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="8"/>

        </Style>

        <Style Selector="Border.accRowCard:pointerover">

            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>

        </Style>

        <Style Selector="Border.accRowCard.active">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.accRowCard.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.accRowCard.dragging">
            <Setter Property="Opacity" Value="0.0"/>
        </Style>



        <!-- Account switch button inside row (left side) -->

        <Style Selector="Button.accSwitchBtn">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Padding" Value="10,8"/>

            <Setter Property="HorizontalAlignment" Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Cursor" Value="Hand"/>

        </Style>

        <Style Selector="Button.accSwitchBtn /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

        </Style>

        <Style Selector="Button.accSwitchBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background" Value="Transparent"/>

        </Style>



        <!-- Delete button (separate sibling button, perfectly static and jitter-free) -->

        <Style Selector="Button.delAccBtn">

            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="6"/>

            <Setter Property="Height" Value="28"/>

            <Setter Property="Padding" Value="10,0"/>

            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="HorizontalAlignment" Value="Right"/>

            <Setter Property="RenderTransform" Value="none"/>

        </Style>

        <Style Selector="Button.delAccBtn /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="RenderTransform" Value="none"/>

        </Style>

        <Style Selector="Button.delAccBtn PathIcon">

            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>

        </Style>

        <Style Selector="Button.delAccBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background" Value="{StaticResource DangerDimBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>

            <Setter Property="RenderTransform" Value="none"/>

        </Style>

        <Style Selector="Button.delAccBtn:pointerover TextBlock">

            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>

        </Style>

        <Style Selector="Button.delAccBtn:pointerover PathIcon">

            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>

        </Style>



        <!-- Primary / secondary (offline form buttons) -->

        <Style Selector="Button.primaryBtn">

            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>

            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="CornerRadius" Value="8"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>

            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>

        </Style>

        <Style Selector="Button.subBtn">

            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>

            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="8"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>

            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>

        </Style>

    </UserControl.Styles>



    <Panel>
    <Grid ColumnDefinitions="*,260" Margin="0,0,8,0">



        <!-- LEFT: Account List -->

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,20,0">

                    <StackPanel Spacing="6" Margin="0,0,12,0">

                        <ItemsControl x:Name="AccountsItemsControl" ItemsSource="{Binding AccountRows}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate x:DataType="vm:AccountRow">
                                    <Border Classes="accRowCard" Classes.active="{Binding IsActive}" Classes.dragging="{Binding IsDragging}" Tag="{Binding}" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <!-- Switch account button (covers info area) -->
                                            <Button Grid.Column="0" Classes="accSwitchBtn"
                                                    Command="{Binding $parent[UserControl].((pages:AccountsViewModel)DataContext).SwitchAccountCommand}"
                                                    CommandParameter="{Binding Model}">
                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                    <!-- Skin head avatar -->
                                                    <Border Grid.Column="0" Width="36" Height="36" Background="{StaticResource IconChipBrush}" CornerRadius="6" ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Panel>
                                                            <Image Source="{Binding HeadImage}" Stretch="UniformToFill" IsVisible="{Binding HasHead}" Width="36" Height="36"/>
                                                            <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasHead}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- Name + badges -->
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock Classes="rowTitle" Text="{Binding Username}" FontSize="12.5"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Border Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="5,1.5">
                                                                <TextBlock Text="{Binding TypeDisplay}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!-- Delete Button (no tooltip duplicate) -->
                                            <Button Grid.Column="1" Classes="delAccBtn"
                                                    Command="{Binding $parent[UserControl].((pages:AccountsViewModel)DataContext).DeleteAccountCommand}"
                                                    CommandParameter="{Binding Model}"
                                                    Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="11" Height="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{l10n:Tr Key=acc_remove}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>



                        <TextBlock Text="{l10n:Tr Key=acc_empty}"

                                   FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center"

                                   IsVisible="{Binding HasNoAccounts}" Padding="0,20"/>

                    </StackPanel>

        </ScrollViewer>



            <!-- RIGHT: Clean Minimal Sign-in Actions -->

            <Border Grid.Column="1" Background="Transparent" Padding="16,0,0,0">

                <Panel>

                    <!-- Clean action buttons (Qoder style: no instruction walls) -->

                    <StackPanel IsVisible="{Binding !IsOfflinePanelOpen}" Spacing="8">

                        <Button Classes="methodBtn" Command="{Binding LoginMicrosoftCommand}">

                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">

                                <Border Width="28" Height="28" Background="{StaticResource IconChipBrush}" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">

                                    <PathIcon Data="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Grid.Column="1" Text="Microsoft" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            </Grid>

                        </Button>



                        <Button Classes="methodBtn" Command="{Binding LoginElyByCommand}">

                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">

                                <Border Width="28" Height="28" Background="{StaticResource IconChipBrush}" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">

                                    <TextBlock Text="E" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Grid.Column="1" Text="Ely.by" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            </Grid>

                        </Button>



                        <Button Classes="methodBtn" Command="{Binding ShowOfflinePanelCommand}">

                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">

                                <Border Width="28" Height="28" Background="{StaticResource IconChipBrush}" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">

                                    <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=acc_type_offline}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            </Grid>

                        </Button>



                        <!-- Sign-in error -->

                        <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,0"

                                IsVisible="{Binding AuthErrorText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">

                            <TextBlock Text="{Binding AuthErrorText}" FontSize="11" Foreground="{StaticResource DangerLightBrush}" TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>



                    <!-- Offline nickname form -->

                    <StackPanel IsVisible="{Binding IsOfflinePanelOpen}" Spacing="10">

                        <TextBlock Text="{l10n:Tr Key=acc_nickname}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>

                        <TextBox Classes="darkInput" Text="{Binding NewOfflineUsername}" PlaceholderText="{l10n:Tr Key=placeholder_player}" Height="36" VerticalContentAlignment="Center"/>



                        <Button Classes="primaryBtn" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                Command="{Binding AddOfflineAccountCommand}">

                            <TextBlock Text="{l10n:Tr Key=acc_add_btn}" FontWeight="Bold" HorizontalAlignment="Center"/>

                        </Button>



                        <Button Classes="subBtn" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                Command="{Binding CancelOfflinePanelCommand}">

                            <TextBlock Text="{l10n:Tr Key=btn_back}" HorizontalAlignment="Center"/>

                        </Button>

                    </StackPanel>

                </Panel>

            </Border>

    </Grid>
    <Canvas x:Name="DragOverlayPanel" IsHitTestVisible="False" ClipToBounds="False" ZIndex="9999"/>
</Panel></UserControl>



