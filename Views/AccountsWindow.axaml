<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CustomMcLauncher.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:l10n="using:CustomMcLauncher.Extensions"
        x:Class="CustomMcLauncher.Views.AccountsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{l10n:Tr Key=acc_manage}"
        Width="680" Height="540"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        CanResize="False">

    <Window.Styles>
        <Style Selector="TextBox.darkInput">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Sign-in method buttons - uniform size -->
        <Style Selector="Button.methodBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.methodBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>
        <Style Selector="Button.methodBtn:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Account row -->
        <Style Selector="Button.accRowBtn">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.accRowBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>
        <Style Selector="Button.accRowBtn.active">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
        </Style>
        <Style Selector="Button.accRowBtn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource CardAltBrush}">
        <Grid ColumnDefinitions="*,268" Margin="20,18,20,18">

            <!-- ==================== LEFT: account list ==================== -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,16,0">
                <StackPanel Grid.Row="0" Spacing="2" Margin="2,0,0,14">
                    <TextBlock Text="{l10n:Tr Key=acc_manage}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{l10n:Tr Key=acc_saved_hint}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="0,0,14,0">
                        <ItemsControl ItemsSource="{Binding AccountRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountRow">
                                    <Button Classes="accRowBtn" Classes.active="{Binding IsActive}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,8"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SwitchAccountCommand}"
                                            CommandParameter="{Binding Model}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <!-- Skin head avatar -->
                                            <Border Grid.Column="0" Width="40" Height="40" Background="{StaticResource IconChipBrush}" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0">
                                                <Panel>
                                                    <Image Source="{Binding HeadImage}" Stretch="UniformToFill" IsVisible="{Binding HasHead}" Width="40" Height="40"/>
                                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasHead}"/>
                                                </Panel>
                                            </Border>
                                            <!-- Name + badges -->
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1.5" IsVisible="{Binding IsActive}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Border Width="5" Height="5" CornerRadius="2.5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1.5">
                                                        <TextBlock Text="{Binding TypeDisplay}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Delete Button -->
                                            <Button Grid.Column="2" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteAccountCommand}" CommandParameter="{Binding Model}"
                                                    Background="Transparent" Padding="8" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip.Tip="{l10n:Tr Key=acc_remove}">
                                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="13" Height="13" Foreground="{StaticResource TextMutedBrush}">
                                                    <PathIcon.Styles>
                                                        <Style Selector="Button:pointerover PathIcon">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </Style>
                                                    </PathIcon.Styles>
                                                </PathIcon>
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{l10n:Tr Key=acc_empty}"
                                   FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center"
                                   IsVisible="{Binding HasNoAccounts}" Padding="0,14"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== RIGHT: sign-in methods ==================== -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" Padding="16">
                <Panel>
                    <!-- Method buttons -->
                    <StackPanel IsVisible="{Binding !IsOfflinePanelOpen}" Spacing="10">
                        <TextBlock Text="{l10n:Tr Key=acc_add_header}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" LetterSpacing="1.2"
                                   Margin="2,0,0,2"/>

                        <Button Classes="methodBtn" Command="{Binding LoginMicrosoftCommand}">
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <Border Width="34" Height="34" Background="{StaticResource IconChipBrush}" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <PathIcon Data="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Microsoft" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{l10n:Tr Key=acc_ms_hint}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Classes="methodBtn" Command="{Binding LoginElyByCommand}">
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <Border Width="34" Height="34" Background="{StaticResource IconChipBrush}" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Ely.by" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{l10n:Tr Key=acc_ely_hint}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Classes="methodBtn" Command="{Binding ShowOfflinePanelCommand}">
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <Border Width="34" Height="34" Background="{StaticResource IconChipBrush}" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{l10n:Tr Key=acc_type_offline}" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{l10n:Tr Key=acc_offline_hint}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <TextBlock Text="{l10n:Tr Key=acc_browser_note}"
                                   FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="2,8,0,0"/>

                        <!-- Sign-in error, visible inside this dialog -->
                        <Border Background="#33DC2626" BorderBrush="#66DC2626" BorderThickness="1" CornerRadius="8" Padding="10,8"
                                IsVisible="{Binding AuthErrorText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding AuthErrorText}" FontSize="11" Foreground="#FF7B7B" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Offline nickname form -->
                    <StackPanel IsVisible="{Binding IsOfflinePanelOpen}" Spacing="12">
                        <TextBlock Text="{l10n:Tr Key=acc_offline_badge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" LetterSpacing="1.2" Margin="2,0,0,0"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{l10n:Tr Key=acc_nickname}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Classes="darkInput" Text="{Binding NewOfflineUsername}" PlaceholderText="{l10n:Tr Key=placeholder_player}"/>
                        </StackPanel>

                        <Button Classes="primaryBtn" Height="42" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding AddOfflineAccountCommand}">
                            <TextBlock Text="{l10n:Tr Key=acc_add_btn}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Button>

                        <Button Classes="subBtn" Height="42" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding CancelOfflinePanelCommand}">
                            <TextBlock Text="{l10n:Tr Key=btn_back}" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </Border>
</Window>
