<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:items="using:CustomMcLauncher.ViewModels.Items"
             xmlns:converters="using:CustomMcLauncher.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="CustomMcLauncher.Views.AuthorProfileView"
             x:DataType="vm:AuthorProfileViewModel"
             Background="{DynamicResource BgBrush}">

    <UserControl.Styles>
        <Style Selector="Button.profilePillBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.profilePillBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.profilePillBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.profilePillBtn.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Border.authorProjectCard">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="#1E2026"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.authorProjectCard:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20,14,20,16">

        <!-- Top Header & Bio -->
        <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,16">
            <!-- Back navigation button -->
            <Button Command="{Binding CloseProfileCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="&#x2039;" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Back" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- User Info Header -->
            <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                <!-- Avatar -->
                <Border Grid.Column="0" Width="68" Height="68" CornerRadius="34" ClipToBounds="True" Background="{StaticResource CardBrush}">
                    <Panel>
                        <Image Source="{Binding Profile.AvatarBitmap}" Stretch="UniformToFill" IsVisible="{Binding Profile.HasAvatar}"/>
                        <PathIcon Data="M12 4A4 4 0 0 1 16 8A4 4 0 0 1 12 12A4 4 0 0 1 8 8A4 4 0 0 1 12 4ZM4 20C4 16.69 7.58 14 12 14C16.42 14 20 16.69 20 20V21H4V20Z"
                                  Width="32" Height="32" Foreground="{StaticResource TextPlaceholderBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Profile.HasAvatar}"/>
                    </Panel>
                </Border>

                <!-- Name, Website & Metadata -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Profile.DisplayName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button Command="{Binding OpenWebsiteCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            HorizontalAlignment="Left" IsVisible="{Binding Profile.WebsiteUrl, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}">
                        <TextBlock Text="{Binding Profile.WebsiteUrl}" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="M3 3H10V10H3V3M14 3H21V10H14V3M3 14H10V21H3V14M14 14H21V21H14V14Z" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ProjectsCount, StringFormat='{}{0} projects'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="&#x2022;" FontSize="11" Foreground="{StaticResource TextDisabledBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalDownloadsDisplay}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="&#x2022;" FontSize="11" Foreground="{StaticResource TextDisabledBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Profile.JoinedDisplay}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Filter Pills Row (All, Mods, Plugins) -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Classes="profilePillBtn" Classes.active="{Binding IsCategoryAll}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="all">
                    <TextBlock Text="All"/>
                </Button>
                <Button Classes="profilePillBtn" Classes.active="{Binding IsCategoryMods}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="mod">
                    <TextBlock Text="Mods"/>
                </Button>
                <Button Classes="profilePillBtn" Classes.active="{Binding IsCategoryPlugins}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="plugin">
                    <TextBlock Text="Plugins"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Main Content Area: Full-width Projects List -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="True">
                <StackPanel Spacing="10">
                    <TextBlock Text="Loading projects..." Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,30" IsVisible="{Binding IsLoading}"/>

                    <ItemsControl ItemsSource="{Binding FilteredProjects}" IsVisible="{Binding !IsLoading}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="items:ModrinthProjectItemViewModel">
                                <Border Classes="authorProjectCard" Padding="14,12" Margin="0,0,0,10"
                                        Tapped="OnProjectCardTapped">
                                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                        <!-- Project Icon -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="{StaticResource CardBrush}" ClipToBounds="True">
                                            <Panel>
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}"/>
                                                <PathIcon Data="M20.5 11H19V7C19 5.9 18.1 5 17 5H13V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4C2.9 5 2 5.9 2 7V10.8H3.5C4.99 10.8 6.2 12.01 6.2 13.5S4.99 16.2 3.5 16.2H2V20C2 21.1 2.9 22 4 22H7.8V20.5C7.8 19.01 9.01 17.8 10.5 17.8S13.2 19.01 13.2 20.5V22H17C18.1 22 19 21.1 19 20V16H20.5C21.88 16 23 14.88 23 13.5S21.88 11 20.5 11Z"
                                                          Width="20" Height="20" Foreground="{StaticResource TextPlaceholderBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/>
                                            </Panel>
                                        </Border>

                                        <!-- Title, Description & Tags -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>

                                            <!-- Tags pills -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Loaders}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,3">
                                                                <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right Stats -->
                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                                <TextBlock Text="&#x2193;" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding DownloadsLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            </Grid>
    </Grid>
</UserControl>
