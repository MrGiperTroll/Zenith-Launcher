<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ZenithLauncher.ViewModels"
             xmlns:models="using:ZenithLauncher.Models"
             xmlns:l10n="using:ZenithLauncher.Extensions"
             x:Class="ZenithLauncher.Views.Components.SidebarNavigationControl"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
                    <Border Grid.Column="0" Width="220" Background="{DynamicResource SidebarBgBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="0">
                        <Grid RowDefinitions="*,Auto">
                            <!-- Nav items (Profiles, Modpacks, Servers, Directory, Settings) -->
                            <StackPanel Grid.Row="0" Spacing="4" Margin="10,10,10,10">
                                <Button Classes="discordNavBtn" Classes.active="{Binding IsProfilesView}" Command="{Binding ShowProfilesCommand}" ToolTip.Tip="{l10n:Tr Key=nav_profiles}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M3 3H10V10H3V3M14 3H21V10H14V3M3 14H10V21H3V14M14 14H21V21H14V14Z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_profiles}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>

                                <Button Classes="discordNavBtn" Classes.active="{Binding IsModpacksView}" Command="{Binding ShowModpacksCommand}" ToolTip.Tip="{l10n:Tr Key=nav_catalog}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5 7.51-3.49L17.5 6.5 9.99 9.99 6.5 17.5zm5.5-6.6c.61 0 1.1.49 1.1 1.1s-.49 1.1-1.1 1.1-1.1-.49-1.1-1.1.49-1.1 1.1-1.1z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_catalog}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>

                                <Button Classes="discordNavBtn" Command="{Binding NavigateToCreateServerCommand}" ToolTip.Tip="{l10n:Tr Key=nav_create_server}" IsVisible="{Binding HasExistingServers}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_create_server}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>



                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}" Margin="2,8,2,8"/>

                                <Button Classes="discordNavBtn" Command="{Binding OpenRootDirectoryCommand}" ToolTip.Tip="{l10n:Tr Key=nav_dir}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M10 4H4C2.89 4 2 4.89 2 6V18A2 2 0 0 0 4 20H20A2 2 0 0 0 22 18V8C22 6.89 21.1 6 20 6H12L10 4Z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_dir}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>

                                <Button Classes="discordNavBtn" Command="{Binding OpenSettingsDialogCommand}" ToolTip.Tip="{l10n:Tr Key=nav_settings}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_settings}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Row 1: Pinned Discord User Account Bar (flush at bottom) -->
                            <Border Grid.Row="1" Height="52" Background="{DynamicResource SidebarBgBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0"
                                    CornerRadius="0" Padding="8,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                    <!-- User info (Click opens Monolithic Profile Popover) -->
                                    <Button x:Name="ProfileAccountBtn" Grid.Column="0"
                                            Background="Transparent" BorderThickness="0" Padding="4,4" Cursor="Hand"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <Button.Flyout>
                                            <Flyout Placement="TopEdgeAlignedLeft" VerticalOffset="-16" ShowMode="Standard" Closed="OnProfileFlyoutClosed">
                                                <Flyout.FlyoutPresenterTheme>
                                                    <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="CornerRadius" Value="0"/>
                                                        <Setter Property="MaxWidth" Value="1000"/>
                                                        <Setter Property="MaxHeight" Value="800"/>
                                                        <Setter Property="ClipToBounds" Value="False"/>
                                                        <Setter Property="Template">
                                                            <ControlTemplate>
                                                                <ContentPresenter Name="PART_ContentPresenter"
                                                                                  Background="Transparent"
                                                                                  BorderBrush="Transparent"
                                                                                  BorderThickness="0"
                                                                                  Padding="0"
                                                                                  MaxWidth="1000"
                                                                                  MaxHeight="800"
                                                                                  ClipToBounds="False"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                  HorizontalContentAlignment="Stretch"
                                                                                  VerticalContentAlignment="Stretch"/>
                                                            </ControlTemplate>
                                                        </Setter>
                                                    </ControlTheme>
                                                </Flyout.FlyoutPresenterTheme>
                                                <Grid ColumnDefinitions="250,Auto" ColumnSpacing="8" Background="Transparent" VerticalAlignment="Bottom">
                                                    <!-- Col 0: Main Profile Card (Monolithic Background) -->
                                                    <Border Grid.Column="0" Width="250" MinHeight="195" Background="{DynamicResource CardBrush}"
                                                            BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                                            CornerRadius="14" Padding="14" VerticalAlignment="Bottom">
                                                        <StackPanel Spacing="0">
                                                            <!-- Top: Avatar & User Info on monolithic card -->
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,12" VerticalAlignment="Center"
                                                                  PointerEntered="OnOtherProfileButtonPointerEntered">
                                                                <!-- Head Avatar -->
                                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                                                        Background="{DynamicResource IconChipBrush}" ClipToBounds="True">
                                                                    <Panel>
                                                                        <Image Source="{Binding ActiveAccountRow.HeadImage}" Stretch="UniformToFill"
                                                                               RenderOptions.BitmapInterpolationMode="None"
                                                                               IsVisible="{Binding ActiveAccountRow.HasHead}"/>
                                                                        <PathIcon Data="M12 4A4 4 0 0 1 16 8A4 4 0 0 1 12 12A4 4 0 0 1 8 8A4 4 0 0 1 12 4ZM4 20C4 16.69 7.58 14 12 14C16.42 14 20 16.69 20 20V21H4V20Z"
                                                                                  Width="20" Height="20" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  IsVisible="{Binding !ActiveAccountRow.HasHead}"/>
                                                                    </Panel>
                                                                </Border>

                                                                <!-- Username & Account type -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{Binding ActiveAccountName}" FontWeight="Bold" FontSize="14.5"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding ActiveAccountType}" FontSize="11"
                                                                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>



                                                            <!-- Action items list -->
                                                            <StackPanel Spacing="2">
                                                                <!-- Switch Accounts -->
                                                                <Button Classes="profileMenuItem" Classes.active="{Binding IsSwitchAccountsMenuOpen}"
                                                                        PointerEntered="OnSwitchAccountsPointerEntered"
                                                                        Click="OnSwitchAccountsClick">
                                                                    <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="10" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                                        <PathIcon Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"
                                                                                  Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=acc_switch_accounts}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        <!-- Right arrow on far right -->
                                                                        <PathIcon Grid.Column="2" Data="M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z"
                                                                                  Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                    </Grid>
                                                                </Button>

                                                                <!-- Copy Username -->
                                                                <Button Classes="profileMenuItem"
                                                                        PointerEntered="OnOtherProfileButtonPointerEntered"
                                                                        Click="OnCopyUsernameClick">
                                                                    <Grid ColumnDefinitions="22,*" ColumnSpacing="10" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                                        <PathIcon Grid.Column="0" Data="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm3 4H8C6.9 5 6 5.9 6 7v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                                                  Width="15" Height="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=acc_copy_username}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    </Grid>
                                                                </Button>



                                                                <!-- Delete Profile -->
                                                                <Button Classes="profileMenuItem profileDeleteMenuItem"
                                                                        PointerEntered="OnOtherProfileButtonPointerEntered"
                                                                        Click="OnDeleteProfileClick">
                                                                    <Grid ColumnDefinitions="22,*" ColumnSpacing="10" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                                        <PathIcon Grid.Column="0" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                                                  Width="15" Height="15" Foreground="#EF4444" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=acc_delete_profile}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Foreground="#EF4444"/>
                                                                    </Grid>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Col 1: Switch Accounts Sub-Menu (on completely transparent background) -->
                                                    <Border Grid.Column="1" Width="210" VerticalAlignment="Bottom" Margin="0"
                                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                                            CornerRadius="12" ClipToBounds="True" Padding="6"
                                                            IsVisible="{Binding IsSwitchAccountsMenuOpen}">
                                                        <StackPanel Spacing="2">
                                                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                <ItemsControl ItemsSource="{Binding AccountRows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:AccountRow">
                                                                            <Button Classes="profileMenuItem"
                                                                                    Tag="{Binding}"
                                                                                    Click="OnAccountRowClick">
                                                                                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                                                                            Background="{DynamicResource IconChipBrush}" ClipToBounds="True">
                                                                                        <Panel>
                                                                                            <Image Source="{Binding HeadImage}" Stretch="UniformToFill"
                                                                                                   RenderOptions.BitmapInterpolationMode="None"
                                                                                                   IsVisible="{Binding HasHead}"/>
                                                                                            <PathIcon Data="M12 4A4 4 0 0 1 16 8A4 4 0 0 1 12 12A4 4 0 0 1 8 8A4 4 0 0 1 12 4ZM4 20C4 16.69 7.58 14 12 14C16.42 14 20 16.69 20 20V21H4V20Z"
                                                                                                      Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                      IsVisible="{Binding !HasHead}"/>
                                                                                        </Panel>
                                                                                    </Border>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="12.5" FontWeight="Medium"
                                                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                    <!-- Checkmark circle adapting to theme AccentBrush -->
                                                                                    <Border Grid.Column="2" Width="16" Height="16" CornerRadius="8"
                                                                                            Background="{DynamicResource AccentBrush}"
                                                                                            VerticalAlignment="Center"
                                                                                            HorizontalAlignment="Center"
                                                                                            Margin="0,0,4,0"
                                                                                            IsVisible="{Binding IsActive}">
                                                                                        <PathIcon Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
                                                                                                  Width="8.5" Height="8.5"
                                                                                                  Foreground="{DynamicResource OnAccentBrush}"
                                                                                                  HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>

                                                            <Button Classes="profileMenuItem" Click="OnManageAccountsClick">
                                                                <TextBlock Text="{l10n:Tr Key=acc_manage}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" Background="{DynamicResource IconChipBrush}" CornerRadius="16" ClipToBounds="True">
                                                <Panel>
                                                    <Image Source="{Binding ActiveAccountRow.HeadImage}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapInterpolationMode="None"
                                                           IsVisible="{Binding ActiveAccountRow.HasHead}"/>
                                                    <PathIcon Data="M12 4A4 4 0 0 1 16 8A4 4 0 0 1 12 12A4 4 0 0 1 8 8A4 4 0 0 1 12 4ZM4 20C4 16.69 7.58 14 12 14C16.42 14 20 16.69 20 20V21H4V20Z"
                                                              Width="15" Height="15" Foreground="{DynamicResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsVisible="{Binding !ActiveAccountRow.HasHead}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActiveAccountName}" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                <TextBlock Text="{Binding ActiveAccountType}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- Account Settings Gear Button -->
                                    <Button Grid.Column="1" Classes="gearSettingsBtn" Command="{Binding OpenAccountsDialogCommand}"
                                            ToolTip.Tip="Account Settings">
                                        <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                                  Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

</UserControl>
