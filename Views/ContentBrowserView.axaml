<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CustomMcLauncher.ViewModels"
        xmlns:models="using:CustomMcLauncher.Models"
        xmlns:l10n="using:CustomMcLauncher.Extensions"
        xmlns:views="using:CustomMcLauncher.Views"
        x:Class="CustomMcLauncher.Views.ContentBrowserView"
        x:DataType="vm:ContentBrowserViewModel"
        Background="{StaticResource BgBrush}">

    <UserControl.Styles>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="TextBox.darkInput">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.installedBtn.installed">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
        </Style>
        <Style Selector="Button.installedBtn.installed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerTranslucentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.installedBtn.installed:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.dialogBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dialogBtn:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.dialogDanger">
            <Setter Property="Background" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogDanger:pointerover">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.sourceBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.sourceBtn.active">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <!-- Tag chips: /template/ setters are required because the Fluent theme
             overrides the ContentPresenter background on :pointerover, which would
             otherwise wash out inline backgrounds. Selected chips stay green on hover. -->
        <Style Selector="Button.tagChip">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tagChip:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tagChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>
        <Style Selector="Button.tagChip.selected">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.tagChip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid RowDefinitions="Auto,*" Margin="14">
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10"
                IsVisible="{Binding !IsDetailsOpen}">
            <Grid ColumnDefinitions="180,*,150" ColumnSpacing="10" VerticalAlignment="Center">
                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableContentTypes}" SelectedItem="{Binding SelectedContentType}" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static vm:ContentBrowserConverters.ContentTypeDisplay}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding SearchQuery}" PlaceholderText="{l10n:Tr Key=cb_search}" FontSize="12" VerticalAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortDisplay}" VerticalAlignment="Center" FontSize="11">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static vm:SortDisplayConverter.Instance}}" FontSize="11"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Main catalog (hidden when details page is open) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="12" IsVisible="{Binding !IsDetailsOpen}">
            <!-- Left: results -->
            <Border Background="{StaticResource ContentSurfaceBrush}" BorderBrush="{StaticResource PanelBrush}" BorderThickness="1" CornerRadius="10" Padding="0">
                <Grid RowDefinitions="*,Auto">
                    <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ModrinthProject">
                                <Border Margin="4" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" Padding="0" ClipToBounds="True" Tapped="OnCardTapped" Cursor="Hand">
                                    <Grid ColumnDefinitions="64,*,140" Height="88">
                                        <!-- Icon -->
                                        <Border Width="56" Height="56" CornerRadius="10" Background="{StaticResource IconChipBrush}" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Panel>
                                                <Image Source="{Binding Icon}" Stretch="Uniform" Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasIcon}"/>
                                                <Path Data="M20.5 11H19V7C19 5.9 18.1 5 17 5H13V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4C2.9 5 2 5.9 2 7V10.8H3.5C4.99 10.8 6.2 12.01 6.2 13.5S4.99 16.2 3.5 16.2H2V20C2 21.1 2.9 22 4 22H7.8V20.5C7.8 19.01 9.01 17.8 10.5 17.8S13.2 19.01 13.2 20.5V22H17C18.1 22 19 21.1 19 20V16H20.5C21.88 16 23 14.88 23 13.5S21.88 11 20.5 11Z" Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/>
                                            </Panel>
                                        </Border>
                                        <!-- Middle: title, author, desc, tags -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="12,8,12,8">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Author}" FontSize="10.5" Foreground="{StaticResource TextLabelBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TagsLabel}" FontSize="9.5" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding TagsLabel, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                        </StackPanel>
                                        <!-- Right: stats + fixed button -->
                                        <Grid Grid.Column="2" RowDefinitions="*,Auto" Margin="0,8,12,8">
                                            <StackPanel Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding DownloadsLabel}" FontSize="10" Foreground="{StaticResource TextCaptionBrush}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding FormattedDate}" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <Button Grid.Row="1" Classes="subBtn installedBtn" Classes.installed="{Binding IsInstalled}" Width="110" HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center"
                                                    Content="{Binding InstallButtonText}" IsEnabled="{Binding !IsInstalling}"
                                                    PointerEntered="OnInstalledButtonHover" PointerExited="OnInstalledButtonHoverOut"
                                                    Tapped="OnInstallButtonTapped"
                                                    Command="{Binding $parent[views:ContentBrowserView].((vm:ContentBrowserViewModel)DataContext).DeleteOrInstallCommand}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" Background="{StaticResource BgBrush}" Padding="8,6" IsVisible="{Binding StatusText, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: filters -->
            <StackPanel Grid.Column="1" Spacing="12">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l10n:Tr Key=cb_instance}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCaptionBrush}" LetterSpacing="1"/>
                        <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding InstanceName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding InstanceVersion}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding InstanceLoader}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding InstancePath}" FontSize="9" Foreground="{StaticResource TextPlaceholderBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FilterLabel}" FontSize="10" Foreground="{StaticResource TextCaptionBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDataPackSelected}">
                            <TextBlock Text="{l10n:Tr Key=lbl_world}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailableWorlds}" SelectedItem="{Binding SelectedWorld}" PlaceholderText="{l10n:Tr Key=w_select_world}" FontSize="11" MinWidth="150"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=cb_categories}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCaptionBrush}" LetterSpacing="1"/>
                        <ItemsControl ItemsSource="{Binding AvailableTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BrowserTag">
                                    <Button Classes="tagChip" Classes.selected="{Binding IsSelected}" Content="{Binding Name, Converter={x:Static vm:ContentBrowserConverters.TagDisplay}}" Margin="0,0,6,6"
                                            Command="{Binding $parent[views:ContentBrowserView].((vm:ContentBrowserViewModel)DataContext).ApplyTagCommand}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l10n:Tr Key=cb_tag_hint}" FontSize="9" Foreground="{StaticResource TextPlaceholderBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=cb_quick_info}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCaptionBrush}" LetterSpacing="1"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                            <Run Text="{l10n:Tr Key=cb_type}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding SelectedContentType, Converter={x:Static vm:ContentBrowserConverters.ContentTypeDisplay}}"/>
                            <LineBreak/><Run Text="{l10n:Tr Key=cb_sort}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding SelectedSortDisplay, Converter={x:Static vm:SortDisplayConverter.Instance}}"/>
                        </TextBlock>
                        <Button Classes="subBtn" Content="{l10n:Tr Key=cb_clear}" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- MODAL: Delete Confirmation -->
    <Border IsVisible="{Binding IsDeleteConfirmOpen}" Background="{StaticResource OverlayBrush}" ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="12" MaxWidth="360" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock Text="{l10n:Tr Key=cb_delete_title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding DeleteItemName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextLabelBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{l10n:Tr Key=cb_delete_question}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="{l10n:Tr Key=no}" Command="{Binding CancelDeleteCommand}" Classes="dialogBtn"
                            Width="90" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmDeleteCommand}" Classes="dialogBtn dialogDanger"
                            Width="90" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- Full-page project details (replaces catalog when open) -->
    <Border IsVisible="{Binding IsDetailsOpen}" Background="{StaticResource BgBrush}" Margin="14" CornerRadius="10"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <views:ProjectDetailsView DataContext="{Binding}"/>
    </Border>
    </Panel>
</UserControl>
