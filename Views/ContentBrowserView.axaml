<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CustomMcLauncher.ViewModels"
        xmlns:converters="using:CustomMcLauncher.Converters"
        xmlns:models="using:CustomMcLauncher.Models"
        xmlns:items="using:CustomMcLauncher.ViewModels.Items"
        xmlns:l10n="using:CustomMcLauncher.Extensions"
        xmlns:views="using:CustomMcLauncher.Views"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="CustomMcLauncher.Views.ContentBrowserView"
        x:DataType="vm:ContentBrowserViewModel"
        Background="{StaticResource BgBrush}">

    <UserControl.Styles>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.installedBtn">
            <Setter Property="Width" Value="114"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.installedBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.installedBtn.installed">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.installedBtn.installed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.installedBtn.installing">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.installedBtn.installing:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.dialogBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dialogBtn:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.dialogDanger">
            <Setter Property="Background" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogDanger:pointerover">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.sourceBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.sourceBtn.active">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.sourceTabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sourceTabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.sourceTabBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Tag chips: /template/ setters are required because the Fluent theme
             overrides the ContentPresenter background on :pointerover, which would
             otherwise wash out inline backgrounds. Selected chips stay green on hover. -->
        <Style Selector="Button.tagChip">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tagChip:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tagChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>
        <Style Selector="Button.tagChip.selected">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.tagChip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <!-- Catalog cards: single-level surface, accent border on hover -->
        <Style Selector="Border.catalogCard">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.catalogCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.inlineLinkBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.inlineLinkBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.inlineLinkBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- Unified Toolbar Controls -->
        <Style Selector="ComboBox.toolbarCombo">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="12,0,6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style Selector="ComboBox.toolbarCombo /template/ Border#Background">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.toolbarCombo:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="TextBox.toolbarInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style Selector="TextBox.toolbarInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.toolbarInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.toolbarBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.toolbarBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid RowDefinitions="Auto,*" Margin="14">
        <!-- Top Toolbar & Filters Section -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,16" IsVisible="{Binding !IsDetailsOpen}">
            <!-- 1. Search Box -->
            <TextBox Classes="darkInput" Height="40"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="{l10n:Tr Key=ph_search_content}"
                     FontSize="12.5" VerticalAlignment="Center">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.KeyBindings>
                <TextBox.InnerLeftContent>
                    <PathIcon Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Width="14" Height="14" Foreground="{DynamicResource TextPlaceholderBrush}" Margin="12,0,4,0"/>
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding SearchQuery, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                            Background="Transparent" BorderThickness="0" Padding="8,0" Cursor="Hand" Content="✕"
                            Foreground="{DynamicResource TextPlaceholderBrush}"/>
                </TextBox.InnerRightContent>
            </TextBox>

            <!-- 2. Filters Bar: Source, Categories, Sort, Reset, Status -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
                <!-- 2.1 Source Switcher (Modrinth / CurseForge) in the far-left corner -->
                <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1" CornerRadius="8" Height="32" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="sourceTabBtn" Classes.active="{Binding IsModrinthSource}"
                                Command="{Binding SelectSourceCommand}" CommandParameter="modrinth"
                                ToolTip.Tip="{l10n:Tr Key=source_modrinth}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="M12.252 2c-5.656 0-10.24 4.584-10.24 10.24 0 2.213.702 4.26 1.892 5.932l.024.034 4.092-4.093a3.46 3.46 0 0 1-.222-1.229c0-1.921 1.557-3.478 3.478-3.478.618 0 1.196.162 1.696.446l3.418-3.418A6.87 6.87 0 0 0 12.252 5.6c-3.667 0-6.64 2.973-6.64 6.64 0 .973.21 1.898.587 2.733l-2.073 2.073A10.18 10.18 0 0 1 2.012 12.24C2.012 6.584 6.596 2 12.252 2z"
                                          Width="12" Height="12"
                                          Foreground="{Binding IsModrinthSource, Converter={x:Static converters:ContentBrowserConverters.ModrinthIconBrush}}"/>
                                <TextBlock Text="Modrinth" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="sourceTabBtn" Classes.active="{Binding IsCurseForgeSource}"
                                Command="{Binding SelectSourceCommand}" CommandParameter="curseforge"
                                ToolTip.Tip="{l10n:Tr Key=source_curseforge}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="M18.8 8.4C18.4 5.3 16.2 2.8 13.3 2c-.4-.1-.7.2-.6.6.6 2.2-.4 4.5-2.4 5.6-1.5.8-2.6 2.2-3 3.9-.7 2.7.4 5.5 2.7 7 1.8 1.2 4.1 1.4 6.1.6 2.8-1.2 4.6-3.9 4.6-6.9 0-1.5-.6-3-1.9-4.4zm-4.7 9.8c-1.3.4-2.7.2-3.8-.6-1.3-.9-1.9-2.5-1.5-4 .2-1 .9-1.8 1.8-2.3 1.9-1 3.1-2.8 3.2-4.9 1.6.8 2.8 2.3 3.1 4.1.3 2-.4 4-1.9 5.3-.9.9-2 1.4-3.2 1.5z"
                                          Width="12" Height="12"
                                          Foreground="{Binding IsCurseForgeSource, Converter={x:Static converters:ContentBrowserConverters.CurseForgeIconBrush}}"/>
                                <TextBlock Text="CurseForge" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 2.2 Categories Dropdown (Multi-select) -->
                <views:CategoryFilterDropdown Grid.Column="1" DataContext="{Binding CategoryFilter}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                <!-- 2.3 Sort Dropdown -->
                <views:SortFilterDropdown Grid.Column="2" DataContext="{Binding BrowserSortFilter}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                <!-- 2.4 Refresh Button -->
                <Button Grid.Column="3" Classes="subBtn" Command="{Binding ResetFiltersCommand}" ToolTip.Tip="{l10n:Tr Key=cb_clear}"
                        Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>

                <!-- 2.5 Status Text -->
                <TextBlock Grid.Column="5" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextCaptionBrush}" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Main catalog (hidden when details page is open) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="12" IsVisible="{Binding !IsDetailsOpen}">
            <!-- Left: results -->
            <Border Background="Transparent" Padding="0">
                <Grid RowDefinitions="*,Auto">
                    <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="items:ModrinthProjectItemViewModel">
                                <Border Classes="catalogCard" Margin="4" CornerRadius="10" Padding="0" ClipToBounds="True" Tapped="OnCardTapped" Cursor="Hand">
                                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12" Margin="10,10,14,10">
                                        <!-- Icon -->
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" Background="{StaticResource IconChipBrush}" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Panel>
                                                <Image Source="{Binding Icon}" Stretch="Uniform" Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasIcon}"/>
                                                <Path Data="M20.5 11H19V7C19 5.9 18.1 5 17 5H13V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4C2.9 5 2 5.9 2 7V10.8H3.5C4.99 10.8 6.2 12.01 6.2 13.5S4.99 16.2 3.5 16.2H2V20C2 21.1 2.9 22 4 22H7.8V20.5C7.8 19.01 9.01 17.8 10.5 17.8S13.2 19.01 13.2 20.5V22H17C18.1 22 19 21.1 19 20V16H20.5C21.88 16 23 14.88 23 13.5S21.88 11 20.5 11Z" Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/>
                                            </Panel>
                                        </Border>

                                        <!-- Middle: title, author, desc, tags, stats -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <!-- Title + Author link -->
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="by " FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <Button Classes="authorLinkBtn" Content="{Binding Author}"
                                                        Command="{Binding $parent[UserControl].((vm:ContentBrowserViewModel)DataContext).OpenAuthorProfileCommand}"
                                                        CommandParameter="{Binding Author}"
                                                        FontSize="11.5" VerticalAlignment="Center"/>
                                            </WrapPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" LineHeight="16"/>

                                            <!-- Tag Badges / Chips -->
                                            <ItemsControl ItemsSource="{Binding DisplayTags}" Margin="0,2,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,6,4">
                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Stats row: Downloads, Likes/Follows, Updated -->
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                                                <!-- Downloads -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Width="11" Height="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownloadsLabel}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Likes / Follows -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <PathIcon Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" Width="11" Height="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FollowsLabel}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Updated -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <PathIcon Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.59-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" Width="11" Height="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RelativeUpdated}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: Install button -->
                                        <Button Grid.Column="2" Classes="subBtn installedBtn" Classes.installed="{Binding IsInstalled}" Classes.installing="{Binding IsInstalling}" Width="114" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Content="{Binding InstallButtonText}"
                                                PointerEntered="OnInstalledButtonHover" PointerExited="OnInstalledButtonHoverOut"
                                                Tapped="OnInstallButtonTapped"
                                                Command="{Binding $parent[views:ContentBrowserView].((vm:ContentBrowserViewModel)DataContext).DeleteOrInstallCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" Background="{StaticResource BgBrush}" Padding="8,6" IsVisible="{Binding StatusText, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: filters -->
            <StackPanel Grid.Column="1" Spacing="12">
                <Border Classes="zenSection">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="caption" Text="{l10n:Tr Key=cb_instance}" FontWeight="Bold" LetterSpacing="1"/>
                        <StackPanel Spacing="4">
                                <TextBlock Text="{Binding InstanceName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding InstanceVersion}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding InstanceLoader}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding InstancePath}" FontSize="9" Foreground="{StaticResource TextPlaceholderBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FilterLabel}" FontSize="10" Foreground="{StaticResource TextCaptionBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDataPackSelected}">
                            <TextBlock Text="{l10n:Tr Key=lbl_world}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Classes="zenCombo" ItemsSource="{Binding AvailableWorlds}" SelectedItem="{Binding SelectedWorld}" PlaceholderText="{l10n:Tr Key=w_select_world}" FontSize="11" MinWidth="150"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="zenSection">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Text="{l10n:Tr Key=cb_categories}" FontWeight="Bold" LetterSpacing="1"/>
                        <ItemsControl ItemsSource="{Binding AvailableTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BrowserTag">
                                    <Button Classes="tagChip" Classes.selected="{Binding IsSelected}" Content="{Binding Name, Converter={x:Static converters:ContentBrowserConverters.TagDisplay}}" Margin="0,0,6,6"
                                            Command="{Binding $parent[views:ContentBrowserView].((vm:ContentBrowserViewModel)DataContext).ApplyTagCommand}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l10n:Tr Key=cb_tag_hint}" FontSize="9" Foreground="{StaticResource TextPlaceholderBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Classes="zenSection">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Text="{l10n:Tr Key=cb_quick_info}" FontWeight="Bold" LetterSpacing="1"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                            <Run Text="{l10n:Tr Key=cb_type}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding SelectedContentType, Converter={x:Static converters:ContentBrowserConverters.ContentTypeDisplay}}"/>
                            <LineBreak/><Run Text="{l10n:Tr Key=cb_sort}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding SelectedSortDisplay, Converter={x:Static converters:SortDisplayConverter.Instance}}"/>
                        </TextBlock>
                        <Button Classes="subBtn" Content="{l10n:Tr Key=cb_clear}" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- MODAL: Delete Confirmation -->
    <Border IsVisible="{Binding IsDeleteConfirmOpen}" Background="{StaticResource OverlayBrush}" ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="12" MaxWidth="360" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock Text="{l10n:Tr Key=cb_delete_title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding DeleteItemName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextLabelBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{l10n:Tr Key=cb_delete_question}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="{l10n:Tr Key=no}" Command="{Binding CancelDeleteCommand}" Classes="dialogBtn"
                            Width="90" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmDeleteCommand}" Classes="dialogBtn dialogDanger"
                            Width="90" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- Full-page project details (replaces catalog when open) -->
    <Border IsVisible="{Binding IsDetailsOpen}" Background="Transparent" Margin="0">
        <views:ProjectDetailsView DataContext="{Binding}"/>
    </Border>

    <!-- Full-page author profile (Modrinth author page) -->
    <Border IsVisible="{Binding IsAuthorProfileOpen}" Background="Transparent" Margin="0">
        <views:AuthorProfileView DataContext="{Binding CurrentAuthorProfileVm}"/>
    </Border>
    </Panel>
</UserControl>

