<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
        xmlns:converters="using:CustomMcLauncher.Converters"
        xmlns:controls="using:CustomMcLauncher.Controls"
             xmlns:views="using:CustomMcLauncher.Views"
             xmlns:services="using:CustomMcLauncher.Services"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             x:Class="CustomMcLauncher.Views.CreateProfileView"
             x:DataType="vm:CreateProfileViewModel"
             Background="{StaticResource BgBrush}">

    <UserControl.Styles>
        <!-- Primary button -->
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.primaryBtn:disabled">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
        </Style>
        <!-- Secondary / outline button -->
        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.stepBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.stepBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <!-- Icon card: no hover/focus vignette -->
        <Style Selector="Border.iconCard">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderIconBrush}"/>
        </Style>
        <Style Selector="Border.iconCard:pointerover">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderIconBrush}"/>
        </Style>
        <Style Selector="Button.subBtn:focus">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
        </Style>
        <Style Selector="Button.subBtn:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
        </Style>
        <Style Selector="Button.stepLinkBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.stepLinkBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource CardAltBrush}" CornerRadius="12" ClipToBounds="True">
        <Grid ColumnDefinitions="200,*">
            <!-- Left Vertical Stepper -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="20,24" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <StackPanel Spacing="0">
                    <TextBlock Classes="sectionTitle" Text="{l10n:Tr Key=cp_title}" Margin="0,0,0,4"/>
                    <TextBlock Classes="caption" Text="{Binding StepTitle}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>
                    <!-- Step 1 (Clickable squircle) -->
                    <Button Classes="stepLinkBtn" Command="{Binding GoToStepCommand}" CommandParameter="1"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                            <Border Width="28" Height="28" CornerRadius="7" VerticalAlignment="Top" Background="{Binding IsStep1, Converter={x:Static converters:StepToBrushConverter.Instance}}" BorderBrush="{Binding IsStep1, Converter={x:Static converters:StepToBrushConverter.Instance}}" BorderThickness="1">
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{Binding IsStep1, Converter={x:Static converters:StepToForegroundConverter.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Classes="rowTitle" Text="{l10n:Tr Key=cp_step_info}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsStep1, Converter={x:Static converters:StepToTextBrushConverter.Instance}}"/>
                        </Grid>
                    </Button>
                    <Border Height="18" Width="1" Background="{StaticResource BorderStrongBrush}" Margin="14,0,0,4" HorizontalAlignment="Left"/>
                    <!-- Step 2 (Clickable squircle) -->
                    <Button Classes="stepLinkBtn" Command="{Binding GoToStepCommand}" CommandParameter="2"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="28" Height="28" CornerRadius="7" VerticalAlignment="Top" Background="{Binding IsStep2, Converter={x:Static converters:StepToBrushConverter.Instance}}" BorderBrush="{Binding IsStep2, Converter={x:Static converters:StepToBrushConverter.Instance}}" BorderThickness="1">
                                <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{Binding IsStep2, Converter={x:Static converters:StepToForegroundConverter.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Classes="rowTitle" Text="{l10n:Tr Key=cp_step_version}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsStep2, Converter={x:Static converters:StepToTextBrushConverter.Instance}}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right Content -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <Border Grid.Row="0" Padding="24,20" Background="Transparent">
                    <Grid VerticalAlignment="Stretch">
                        <!-- Step 1: Information & Out-of-the-box Settings -->
                        <Grid IsVisible="{Binding IsStep1}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16" Margin="4,2">
                            <!-- Top: Icon + Name -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="96" Height="96" Classes="iconCard" BorderThickness="1" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Center">
                                    <Panel>
                                        <Image Source="{Binding IconPreview}" Stretch="UniformToFill" Width="94" Height="94" IsVisible="{Binding IconPreview, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                                        <Path Data="{StaticResource ZenithLogoGeometry}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="48" Height="48" Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IconPreview, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                                    </Panel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Width="140" HorizontalAlignment="Center">
                                    <Button Grid.Column="0" Content="Upload" Command="{Binding PickCustomIconCommand}" Classes="subBtn" Padding="8,7" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{l10n:Tr Key=btn_reset}" Command="{Binding ResetIconCommand}" Classes="subBtn" Padding="8,7" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <!-- Profile Name -->
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Classes="rowTitle" Text="{l10n:Tr Key=cp_name_label}"/>
                                <Border BorderThickness="1" CornerRadius="10" Background="Transparent"
                                        BorderBrush="{Binding CanNextStep1, Converter={x:Static converters:BoolToErrorBrushConverter.InstanceInverted}}">
                                    <TextBox Classes="darkInput" Text="{Binding ProfileName}" PlaceholderText="{l10n:Tr Key=ph_profile_name}" FontSize="13" Padding="12,10" BorderThickness="0"/>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="rowHint" Text="{l10n:Tr Key=cp_name_hint2}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{l10n:Tr Key=cp_duplicate}" FontSize="11" Foreground="{StaticResource DangerBrush}" IsVisible="{Binding IsNameDuplicate}"/>
                                        <TextBlock Text="Invalid characters in name" FontSize="11" Foreground="{StaticResource DangerBrush}" IsVisible="{Binding IsNameInvalid}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            </Grid>

                            <!-- Unified RAM Allocation Card -->
                            <controls:RamCardControl Grid.Row="1" Title="{l10n:Tr Key=cs_ram}"
                                                      Subtitle="{l10n:Tr Key=set_memory_hint}"
                                                      Value="{Binding SelectedRamMb}"
                                                      Maximum="{Binding MaxRamMb}"
                                                      Minimum="512"
                                                      TickFrequency="512"/>

                                <!-- Resolution | Java mode -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <Border Grid.Column="0" Classes="zenSection">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Spacing="5">
                                                <TextBlock Classes="rowTitle" Text="{l10n:Tr Key=set_resolution}"/>
                                                <ComboBox Classes="zenCombo" ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}" HorizontalAlignment="Stretch" FontSize="11"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsFullscreen}" VerticalAlignment="Bottom" Margin="0,0,0,4" ToolTip.Tip="{l10n:Tr Key=set_fullscreen}"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Classes="zenSection">
                                        <StackPanel Spacing="5">
                                            <TextBlock Classes="rowTitle" Text="{l10n:Tr Key=set_java}"/>
                                            <TextBlock Text="{l10n:Tr Key=set_java_mode_desc}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <ComboBox Classes="zenCombo" ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJavaOption}" HorizontalAlignment="Stretch" FontSize="11">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:JavaModeOption">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Java path full width -->
                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="darkInput" Text="{Binding EffectiveJavaPath}" PlaceholderText="C:\Path\To\javaw.exe" FontSize="11" Padding="10,6"/>
                                    <Button Grid.Column="1" Content="{l10n:Tr Key=set_java_browse}" Command="{Binding PickCustomJavaCommand}" Classes="subBtn" Padding="14,6" FontSize="11"/>
                                </Grid>
                        </Grid>

                        <!-- Step 2: Game Version (Stretched to bottom) -->
                        <Grid IsVisible="{Binding IsStep2}" RowDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Stretch" MinHeight="420">
                            <TextBlock Grid.Row="0" Classes="sectionTitle" Text="{l10n:Tr Key=cp_panel_version}" Margin="0,0,0,10"/>
                            <!-- Loader / loader-version / search filter panel in a single row -->
                            <Border Grid.Row="1" Background="Transparent" Padding="8">
                                <Grid ColumnDefinitions="140,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                    <ComboBox Classes="zenCombo" ItemsSource="{Binding AvailableLoaders}" SelectedItem="{Binding SelectedLoader}" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="11">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Panel Width="16" Height="16" VerticalAlignment="Center">
                                                        <!-- Official logo; vector fallback underneath -->
                                                        <Path Data="{Binding Converter={x:Static converters:LoaderLogoGeometryConverter.Instance}}" Fill="{Binding Converter={x:Static converters:LoaderLogoBrushConverter.Instance}}" Stretch="Uniform" Width="16" Height="16"
                                                              IsVisible="{Binding Converter={x:Static converters:LoaderOfficialIconMissingConverter.Instance}}"/>
                                                        <Path Data="{Binding Converter={x:Static converters:LoaderLogoGeometryConverter.Instance}, ConverterParameter=2}" Fill="{Binding Converter={x:Static converters:LoaderLogoBrushConverter.Instance}, ConverterParameter=2}" Stretch="Uniform" Width="16" Height="16"
                                                              IsVisible="{Binding Converter={x:Static converters:LoaderOfficialIconMissingConverter.Instance}}"/>
                                                        <Path Data="{Binding Converter={x:Static converters:LoaderLogoGeometryConverter.Instance}, ConverterParameter=3}" Fill="{Binding Converter={x:Static converters:LoaderLogoBrushConverter.Instance}, ConverterParameter=3}" Stretch="Uniform" Width="16" Height="16"
                                                              IsVisible="{Binding Converter={x:Static converters:LoaderOfficialIconMissingConverter.Instance}}"/>
                                                        <Image Source="{Binding Converter={x:Static converters:LoaderOfficialIconConverter.Instance}}" Width="16" Height="16"/>
                                                    </Panel>
                                                    <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- Loader build picker - appears only for non-Vanilla loaders -->
                                    <ComboBox Grid.Column="1" Classes="zenCombo" ItemsSource="{Binding AvailableLoaderBuilds}" SelectedItem="{Binding SelectedLoaderBuild}"
                                              PlaceholderText="{l10n:Tr Key=cp_loader_ph}" IsVisible="{Binding IsLoaderBuildsVisible}"
                                              MinWidth="100" MaxWidth="150" MaxDropDownHeight="220"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBox Grid.Column="2" Classes="darkInput" Text="{Binding VersionSearchQuery}" PlaceholderText="{l10n:Tr Key=cp_search_versions}" FontSize="11" VerticalAlignment="Center"/>
                                    
                                    <!-- Version Filters: Single Row Checkboxes -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <CheckBox Content="{l10n:Tr Key=vf_releases}" IsChecked="{Binding ShowReleases}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <CheckBox Content="{l10n:Tr Key=vf_snapshots}" IsChecked="{Binding ShowSnapshots}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <CheckBox Content="{l10n:Tr Key=vf_betas}" IsChecked="{Binding ShowBetas}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <CheckBox Content="{l10n:Tr Key=vf_alphas}" IsChecked="{Binding ShowAlphas}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="2" Text="{Binding LoaderError}" FontSize="11" Foreground="{StaticResource DangerStrongBrush}" TextWrapping="Wrap" IsVisible="{Binding LoaderErrorVisible}" Margin="0,4,0,0"/>
                            <!-- Version Groups Accordion - stretched to bottom -->
                            <Border Grid.Row="3" Background="Transparent" Padding="8" VerticalAlignment="Stretch" Margin="0,10,0,0">
                                <Panel VerticalAlignment="Stretch">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch" IsVisible="{Binding !UseFlatVersionList}">
                                    <ItemsControl ItemsSource="{Binding VersionGroups}" Margin="0,0,14,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VersionGroup">
                                                <StackPanel Margin="0,4">
                                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            Command="{Binding $parent[UserControl].((vm:CreateProfileViewModel)DataContext).ToggleVersionGroupCommand}" CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Major}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="▼" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}"/>
                                                            <TextBlock Grid.Column="1" Text="▶" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}"/>
                                                        </Grid>
                                                    </Button>
                                                    <ItemsControl IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Versions}" Margin="8,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}" Margin="3" Padding="12,8" FontSize="12" MinHeight="36" CornerRadius="6" Cursor="Hand"
                                                                        Command="{Binding $parent[UserControl].((vm:CreateProfileViewModel)DataContext).SelectVersionCommand}" CommandParameter="{Binding}">
                                                                    <Button.Background>
                                                                        <MultiBinding Converter="{x:Static converters:EqualityToBrushConverter.Instance}">
                                                                            <Binding Path="$parent[UserControl].((vm:CreateProfileViewModel)DataContext).SelectedVersion"/>
                                                                            <Binding Path="."/>
                                                                        </MultiBinding>
                                                                    </Button.Background>
                                                                    <Button.Foreground>
                                                                        <MultiBinding Converter="{x:Static converters:EqualityToForegroundConverter.Instance}">
                                                                            <Binding Path="$parent[UserControl].((vm:CreateProfileViewModel)DataContext).SelectedVersion"/>
                                                                            <Binding Path="."/>
                                                                        </MultiBinding>
                                                                    </Button.Foreground>
                                                                    <Button.BorderBrush>
                                                                        <MultiBinding Converter="{x:Static converters:EqualityToBrushConverter.Instance}">
                                                                            <Binding Path="$parent[UserControl].((vm:CreateProfileViewModel)DataContext).SelectedVersion"/>
                                                                            <Binding Path="."/>
                                                                        </MultiBinding>
                                                                    </Button.BorderBrush>
                                                                    <Button.BorderThickness>1</Button.BorderThickness>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- Flat list mode -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch" IsVisible="{Binding UseFlatVersionList}">
                                    <ItemsControl ItemsSource="{Binding FlatVersions}" Margin="4,2,10,2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FlatVersionItem">
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Padding="14,9" FontSize="12" MinHeight="38" CornerRadius="6" Cursor="Hand"
                                                        Command="{Binding $parent[UserControl].((vm:CreateProfileViewModel)DataContext).SelectVersionCommand}" CommandParameter="{Binding Name}">
                                                    <Button.Background>
                                                        <MultiBinding Converter="{x:Static converters:EqualityToBrushConverter.Instance}">
                                                            <Binding Path="$parent[UserControl].((vm:CreateProfileViewModel)DataContext).SelectedVersion"/>
                                                            <Binding Path="Name"/>
                                                        </MultiBinding>
                                                    </Button.Background>
                                                    <Button.Foreground>
                                                        <MultiBinding Converter="{x:Static converters:EqualityToForegroundConverter.Instance}">
                                                            <Binding Path="$parent[UserControl].((vm:CreateProfileViewModel)DataContext).SelectedVersion"/>
                                                            <Binding Path="Name"/>
                                                        </MultiBinding>
                                                    </Button.Foreground>
                                                    <Button.BorderBrush>
                                                        <MultiBinding Converter="{x:Static converters:EqualityToBrushConverter.Instance}">
                                                            <Binding Path="$parent[UserControl].((vm:CreateProfileViewModel)DataContext).SelectedVersion"/>
                                                            <Binding Path="Name"/>
                                                        </MultiBinding>
                                                    </Button.BorderBrush>
                                                    <Button.BorderThickness>1</Button.BorderThickness>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="{StaticResource FieldBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                </Panel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Bottom Panel -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=btn_reset}" Command="{Binding ResetWizardCommand}" Classes="subBtn" Padding="16,8" FontSize="11" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="{l10n:Tr Key=btn_back}" Command="{Binding PreviousStepCommand}" Classes="subBtn" Padding="16,8" FontSize="11" IsVisible="{Binding IsStep2}"/>
                            <Button Content="{l10n:Tr Key=cp_select_version}" Command="{Binding NextStepCommand}" Classes="primaryBtn" Padding="18,8" FontSize="12" IsVisible="{Binding IsStep1}" IsEnabled="{Binding CanNextStep1}"/>
                            <Button Content="{l10n:Tr Key=cp_create}" Command="{Binding CreateCommand}" Classes="primaryBtn" Padding="18,8" FontSize="12" IsVisible="{Binding IsStep2}" IsEnabled="{Binding CanCreate}"/>
                            <Button Content="{l10n:Tr Key=cancel}" Command="{Binding CancelCommand}" Classes="subBtn" Padding="16,8" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

