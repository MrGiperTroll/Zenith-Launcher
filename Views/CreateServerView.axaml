<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
        xmlns:converters="using:CustomMcLauncher.Converters"
        xmlns:controls="using:CustomMcLauncher.Controls"
             xmlns:views="using:CustomMcLauncher.Views"
             xmlns:services="using:CustomMcLauncher.Services"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             x:Class="CustomMcLauncher.Views.CreateServerView"
             x:DataType="vm:CreateServerViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.darkInput">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Button Brightening Hover Styles -->
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.chipBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.chipBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.dangerBtn">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.dangerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerStrongBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerLightBrush}"/>
        </Style>

        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TabHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn.active">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Master Server List Styles -->
        <Style Selector="ListBox.serverList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.serverList ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.serverList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.serverList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
        </Style>
        <Style Selector="Button.iconChangeBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Button.iconChangeBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <!-- Master-Detail Root Layout (Left: Server List, Right: Dashboard Panel) -->
    <Grid ColumnDefinitions="250,*" ColumnSpacing="18" Margin="0,0,16,16">

        <!-- ========================================================= -->
        <!-- MASTER: LEFT SERVER LIST                                  -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header with "+ New Server" Button -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Servers" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="primaryBtn" Command="{Binding StartCreateNewServerCommand}" Padding="10,6" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="12" Height="12" Foreground="{StaticResource OnAccentBrush}"/>
                            <TextBlock Text="New" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Server List Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="No servers created yet. Click '+ New' to create one."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding ExistingServersList.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"
                                   Margin="4,16"/>

                        <ListBox Classes="serverList" ItemsSource="{Binding ExistingServersList}" SelectedItem="{Binding SelectedServerItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerItemEntry">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" Background="{StaticResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center" ClipToBounds="True">
                                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image IsVisible="{Binding HasIcon}"
                                                       Source="{Binding IconBitmap}"
                                                       Stretch="UniformToFill" Width="28" Height="28"/>
                                                <PathIcon IsVisible="{Binding !HasIcon}"
                                                          Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                                          Width="13" Height="13" Foreground="{StaticResource AccentBrush}"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Local Server" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- DETAIL: RIGHT CONTENT PANEL                               -->
        <!-- ========================================================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <!-- CASE A: CREATING NEW SERVER -->
                <StackPanel Spacing="16" IsVisible="{Binding IsCreatingNewServer}">
                    <!-- Header -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l10n:Tr Key=cs_title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{l10n:Tr Key=cs_creating}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding IsBusy}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Classes="subBtn" Content="{l10n:Tr Key=btn_cancel}" Command="{Binding CancelCreateNewServerCommand}" IsVisible="{Binding HasExistingServers}"/>
                        </Grid>
                    </Border>

                    <!-- Creation Form -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Server Name -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{l10n:Tr Key=cs_name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Classes="darkInput" Text="{Binding ServerName}" IsEnabled="{Binding !IsBusy}"/>
                            </StackPanel>

                            <!-- Version & Software Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{l10n:Tr Key=cs_version}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{l10n:Tr Key=cs_type}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding AvailableSoftware}" SelectedItem="{Binding SelectedSoftware}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="services:ServerSoftwareOption">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Loader Build / Version for Forge / NeoForge / Fabric -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsLoaderBuildVisible}">
                                <TextBlock Text="Loader Version / Build" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableLoaderBuilds}" SelectedItem="{Binding SelectedLoaderBuild}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}"/>
                            </StackPanel>

                            <!-- RAM Allocation & Port Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <!-- RAM Allocation: Unified RamCardControl -->
                                <controls:RamCardControl Grid.Column="0"
                                                      Value="{Binding RamMb}"
                                                      Minimum="512"
                                                      Maximum="32768"
                                                      TickFrequency="512"
                                                      Title="{l10n:Tr Key=cs_ram}"
                                                      IsEnabled="{Binding !IsBusy}"/>

                                <!-- Port -->
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{l10n:Tr Key=cs_port}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Classes="darkInput" Text="{Binding ServerPort}" IsEnabled="{Binding !IsBusy}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Checkboxes (EULA agreement) -->
                            <StackPanel Spacing="10" Margin="0,6,0,0">
                                <CheckBox Content="{l10n:Tr Key=cs_eula}" IsChecked="{Binding AgreeEula}" IsEnabled="{Binding !IsBusy}"/>
                            </StackPanel>

                            <!-- Progress and Status -->
                            <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsBusy}">
                                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Error Status -->
                            <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource DangerLightBrush}" IsVisible="{Binding StatusText, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}" Margin="0,4,0,0"/>

                            <!-- Action Buttons -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                                <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=btn_back}" Command="{Binding CancelCreateNewServerCommand}" IsVisible="{Binding HasExistingServers}"/>
                                <Button Grid.Column="2" Classes="primaryBtn" Content="{l10n:Tr Key=cs_create_btn}" Command="{Binding CreateServerCommand}" IsEnabled="{Binding CanCreate}" Padding="20,9"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CASE B: ACTIVE SERVER DASHBOARD -->
                <StackPanel Spacing="16" IsVisible="{Binding !IsCreatingNewServer}">
                    <!-- Server Header Bar (No duplicate server icon, clean start button without (cmd)) -->
                    <!-- Server Header Bar (Inline rename, address selector) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <!-- Left: Server Name with inline editing + IP badge with selector flyout -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                <!-- Direct In-Place Server Name Input (Profile-style inline rename) -->
                                <TextBox x:Name="ServerNameInput"
                                         Classes="titleInput"
                                         Text="{Binding SelectedServerName, Mode=OneWay}"
                                         FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         HorizontalAlignment="Left"
                                         Padding="0" Margin="0"
                                         MinWidth="50" MaxWidth="360"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                         IsEnabled="{Binding CanEditServer}"
                                         ToolTip.Tip="Double-click to rename"/>

                                <!-- IP Address with Integrated Dropdown Arrow + Clean Copy Button -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- IP Selector with Dropdown Arrow -->
                                    <Button Classes="chipBtn" Padding="8,4" ToolTip.Tip="Available server network addresses">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Spacing="2" MinWidth="260">
                                                    <TextBlock Text="Server Addresses" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,4,8,2"/>
                                                    <ItemsControl ItemsSource="{Binding NetworkEndpoints}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="services:ServerNetworkEndpoint">
                                                                <Button Command="{Binding $parent[views:CreateServerView].((vm:CreateServerViewModel)DataContext).SelectAndCopyAddressCommand}"
                                                                        CommandParameter="{Binding Address}"
                                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                        Padding="8,6" Margin="0,1">
                                                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{Binding Address}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                        </StackPanel>
                                                                        <PathIcon Grid.Column="1" Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                                                  Width="11" Height="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ServerIpDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <PathIcon Data="M7 10l5 5 5-5z" Width="8" Height="8" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Direct 1-Click Copy Button (Icon only) -->
                                    <Button Classes="chipBtn" Command="{Binding CopyIpCommand}" Padding="8,6" ToolTip.Tip="{l10n:Tr Key=cs_copy_ip}" VerticalAlignment="Center">
                                        <Panel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                      Width="11" Height="11" Foreground="{StaticResource TextSecondaryBrush}" IsVisible="{Binding !IsIpCopied}"/>
                                            <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                      Width="11" Height="11" Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding IsIpCopied}"/>
                                        </Panel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Quick Open Folder + Run/Stop -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="subBtn" Content="{l10n:Tr Key=cs_open_folder}" Command="{Binding OpenServerFolderCommand}"/>
                                <Button Classes="primaryBtn" Command="{Binding RunServerCommand}" IsVisible="{Binding !IsServerRunning}" Padding="18,8">
                                    <TextBlock Text="{l10n:Tr Key=cs_run_server}" FontWeight="Bold"/>
                                </Button>
                                <!-- Graceful Stop Button -->
                                <Button Classes="dangerBtn" Command="{Binding StopServerCommand}" IsVisible="{Binding CanShowStopButton}" IsEnabled="{Binding !IsServerStopping}" Padding="18,8">
                                    <TextBlock Text="{Binding StopButtonText}" FontWeight="Bold"/>
                                </Button>
                                <!-- Emergency Force Stop Button (visible after timeout if server hangs) -->
                                <Button Classes="dangerBtn" Command="{Binding ForceStopServerCommand}" IsVisible="{Binding IsServerStopping}" Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12" Foreground="{StaticResource DangerLightBrush}"/>
                                        <TextBlock Text="{l10n:Tr Key=cs_force_stop}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Java Missing Warning Banner -->
                    <Border Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasJavaMissingWarning}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <PathIcon Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" Width="18" Height="18" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding JavaMissingWarningText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="2" Classes="primaryBtn" Command="{Binding DownloadMissingJavaCommand}" Content="{Binding DownloadJavaButtonText}" Padding="12,6" FontSize="11.5"/>
                        </Grid>
                    </Border>

                    <!-- Tabs Navigation Bar (Localized) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="tabBtn" Classes.active="{Binding IsOverviewTab}" Command="{Binding SelectTabCommand}" CommandParameter="0" Content="{l10n:Tr Key=cs_tab_overview}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsConsoleTab}" Command="{Binding SelectTabCommand}" CommandParameter="6" Content="{l10n:Tr Key=cs_tab_console}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsPropertiesTab}" Command="{Binding SelectTabCommand}" CommandParameter="1" Content="{l10n:Tr Key=cs_tab_properties}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsWorldTab}" Command="{Binding SelectTabCommand}" CommandParameter="7" Content="{l10n:Tr Key=cs_tab_world}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsFilesTab}" Command="{Binding SelectTabCommand}" CommandParameter="5" Content="{l10n:Tr Key=cs_tab_files}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsPluginsTab}" Command="{Binding SelectTabCommand}" CommandParameter="2" Content="{Binding PluginsTabTitle}" IsVisible="{Binding IsPluginsTabVisible}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsPlayersTab}" Command="{Binding SelectTabCommand}" CommandParameter="4" Content="{l10n:Tr Key=cs_tab_players}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsSettingsTab}" Command="{Binding SelectTabCommand}" CommandParameter="3" Content="{l10n:Tr Key=cs_tab_settings}"/>
                        </StackPanel>
                    </Border>

                    <!-- TAB 0: OVERVIEW -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsOverviewTab}">
                        <!-- Hero Status Banner -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <Button Classes="iconChangeBtn" Command="{Binding ChangeServerIconCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            ToolTip.Tip="{l10n:Tr Key=icon_change_tip}">
                                        <Border Width="50" Height="50" CornerRadius="12" ClipToBounds="True"
                                                Background="{StaticResource IconChipBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image IsVisible="{Binding HasServerIcon}"
                                                       Source="{Binding ServerIconBitmap}"
                                                       Stretch="UniformToFill" Width="50" Height="50"/>
                                                <PathIcon IsVisible="{Binding !HasServerIcon}"
                                                          Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                                          Width="22" Height="22" Foreground="{StaticResource AccentBrush}"/>
                                            </Panel>
                                        </Border>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedServerName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <!-- Status Badge (Shown when online) -->
                                            <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" IsVisible="{Binding IsServerRunning}">
                                                <TextBlock Text="{l10n:Tr Key=cs_status_online}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ActiveServerDirectory}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="primaryBtn" Command="{Binding RunServerCommand}" IsVisible="{Binding !IsServerRunning}" Padding="16,8">
                                        <TextBlock Text="{l10n:Tr Key=cs_run_server}" FontWeight="Bold"/>
                                    </Button>
                                    <!-- Graceful Stop Button -->
                                    <Button Classes="dangerBtn" Command="{Binding StopServerCommand}" IsVisible="{Binding CanShowStopButton}" IsEnabled="{Binding !IsServerStopping}" Padding="16,8">
                                        <TextBlock Text="{Binding StopButtonText}" FontWeight="Bold"/>
                                    </Button>
                                    <!-- Emergency Force Stop Button -->
                                    <Button Classes="dangerBtn" Command="{Binding ForceStopServerCommand}" IsVisible="{Binding IsServerStopping}" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12" Foreground="{StaticResource DangerLightBrush}"/>
                                            <TextBlock Text="{l10n:Tr Key=cs_force_stop}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Metrics Grid -->
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <!-- 1. Status & Uptime -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_uptime}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding UptimeText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=cs_hint_runtime}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Online Players -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_tab_players}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding OnlinePlayers.Count}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding PropsMaxPlayers, StringFormat='/ {0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{l10n:Tr Key=cs_hint_connections}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. Port & Address -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_port}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding PropsPort}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ServerIpDisplay}" FontSize="10.5" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. Software / Core Version -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_type}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ServerSoftwareDisplay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{l10n:Tr Key=cs_hint_core}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. Memory -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_ram}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ServerAllocatedRamDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=cs_hint_ram}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 6. World Name & Gamemode -->
                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_tab_world}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding PropsLevelName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PropsGamemode, StringFormat='Mode: {0}'}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- TAB 1: SERVER.PROPERTIES (Clean 2-column grid, no overlapping) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" IsVisible="{Binding IsPropertiesTab}">
                        <StackPanel Spacing="14">
                            <!-- Card Header Bar: Title + Save Button -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=cs_tab_properties}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=cs_save_props}" Command="{Binding SavePropertiesCommand}" Padding="16,6" FontSize="11.5" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Feedback Message -->
                            <Border IsVisible="{Binding ConfigStatusMessage, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding ConfigStatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <!-- Balanced 2-Column Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                <!-- Left Column: Core Parameters -->
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock Text="{l10n:Tr Key=cs_prop_general_network}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,0,2"/>

                                    <!-- Row 1: Server Name & Port -->
                                    <Grid ColumnDefinitions="*,110" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Server Name" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsServerName, Mode=TwoWay}" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{l10n:Tr Key=cs_prop_port}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsPort}" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: MOTD / Description -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{l10n:Tr Key=cs_prop_motd}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsMotd}" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Row 3: Gamemode & Difficulty -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l10n:Tr Key=cs_prop_gamemode}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding GamemodeOptions}" SelectedItem="{Binding PropsGamemode}" HorizontalAlignment="Stretch" Height="30" Padding="8,3" FontSize="11.5" IsEnabled="{Binding PropsForceGamemode}" ToolTip.Tip="{l10n:Tr Key=cs_prop_force_gamemode}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{l10n:Tr Key=cs_prop_difficulty}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding PropsDifficulty}" HorizontalAlignment="Stretch" Height="30" Padding="8,3" FontSize="11.5"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 4: Max Players & Spawn Protection -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l10n:Tr Key=cs_prop_max_players}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsMaxPlayers}" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{l10n:Tr Key=cs_prop_spawn_protection}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsSpawnProtection}" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 5: View Distance & Simulation Distance -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l10n:Tr Key=cs_prop_view_distance}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsViewDistance}" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsSimulationDistanceVisible}">
                                            <TextBlock Text="{l10n:Tr Key=cs_prop_sim_distance}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsSimulationDistance}" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 6: Entity Broadcast Range (removed in 1.21.2+) -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsEntityBroadcastRangeVisible}">
                                        <TextBlock Text="{l10n:Tr Key=cs_prop_entity_range}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsEntityBroadcastRangePercentage}" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Row 7: Resource Pack URL -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{l10n:Tr Key=cs_prop_resource_pack}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsResourcePack}" PlaceholderText="https://example.com/pack.zip" Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Row 8: Resource Pack Prompt (1.20.2+) -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsResourcePackPromptVisible}">
                                        <TextBlock Text="{l10n:Tr Key=cs_prop_resource_pack_prompt}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsResourcePackPrompt}" PlaceholderText="Custom prompt message shown to players..." Height="30" Padding="8,4" FontSize="11.5" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Column: Rules & Flags -->
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{l10n:Tr Key=cs_props_rules}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,0,2"/>

                                    <!-- Online Mode / Cracked -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_online_mode}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="On = Mojang authentication; Off = Cracked / Offline mode" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsOnlineMode}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Whitelist -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_whitelist}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Only players on whitelist can join the server" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsWhitelist}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Force Gamemode -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_force_gamemode}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Force players to join in default game mode" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsForceGamemode}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Require Resource Pack (1.17+) -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6" IsVisible="{Binding IsRequireResourcePackVisible}">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_require_resource_pack}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Disconnect players who decline downloading the pack" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsRequireResourcePack}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- PVP -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_pvp}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Enable player versus player combat damage" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsPvp}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Allow Flight -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_allow_flight}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Allow players to fly in survival without being kicked" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsAllowFlight}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Command Blocks -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_command_blocks}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Enable execution of command blocks" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsCommandBlocks}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Allow Nether -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_allow_nether}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Enable portals and Nether dimension travel" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsAllowNether}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Spawn Animals -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_spawn_animals}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Allow passive animals to spawn in the world" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsSpawnAnimals}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Spawn Monsters -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{l10n:Tr Key=cs_prop_spawn_monsters}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Allow hostile mobs and monsters to spawn" FontSize="9.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding PropsSpawnMonsters}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TAB 6: CONSOLE -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsConsoleTab}">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{l10n:Tr Key=cs_tab_console}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=cs_console_sub}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="subBtn" Command="{Binding ClearConsoleCommand}" Padding="12,6" FontSize="11">
                                        <TextBlock Text="{l10n:Tr Key=cs_console_clear}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Console Output Box (Scrollable & Selectable, auto-scrolls to newest lines) -->
                            <Border Background="#0C0C0E" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Height="380">
                                <TextBox x:Name="ConsoleBox"
                                         Classes="darkInput"
                                         Text="{Binding ConsoleLogText}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                         FontSize="12" Foreground="#D1D5DB"
                                         AcceptsReturn="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            </Border>

                            <!-- Command Input Row -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Classes="darkInput" Text="{Binding ConsoleCommandText, Mode=TwoWay}"
                                         PlaceholderText="Type a command... (e.g. say Hello, op player, time set day, stop)"
                                         FontSize="12"
                                         KeyDown="OnConsoleInputKeyDown"
                                         FontFamily="Consolas, Cascadia Code, Courier New, monospace"/>
                                <Button Grid.Column="1" Classes="primaryBtn" Command="{Binding SendConsoleCommand}" Padding="16,8" FontSize="12">
                                    <TextBlock Text="Send" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TAB 7: WORLD MANAGEMENT -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsWorldTab}">
                        <!-- World Summary Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource IconChipBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center" ClipToBounds="True">
                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image IsVisible="{Binding HasWorldIcon}"
                                                   Source="{Binding WorldIconBitmap}"
                                                   Stretch="UniformToFill" Width="48" Height="48"/>
                                            <PathIcon IsVisible="{Binding !HasWorldIcon}"
                                                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                                      Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding WorldNameDisplay, StringFormat='World: {0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding WorldSizeDisplay, StringFormat='Size: {0}'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding WorldDifficulty, StringFormat='Difficulty: {0}'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 4 Action Buttons: Скачать, Загрузить, Настройки, Файлы -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="primaryBtn" Command="{Binding DownloadWorldCommand}" Padding="14,7" FontSize="12">
                                            <TextBlock Text="{l10n:Tr Key=cs_world_download}"/>
                                        </Button>
                                        <Button Classes="subBtn" Command="{Binding UploadWorldCommand}" Padding="14,7" FontSize="12">
                                            <TextBlock Text="{l10n:Tr Key=cs_world_upload}"/>
                                        </Button>
                                        <Button Classes="subBtn" Command="{Binding ToggleWorldSettingsCommand}" Padding="14,7" FontSize="12">
                                            <TextBlock Text="{l10n:Tr Key=cs_world_settings}"/>
                                        </Button>
                                        <Button Classes="subBtn" Command="{Binding OpenWorldFolderCommand}" Padding="14,7" FontSize="12">
                                            <TextBlock Text="{l10n:Tr Key=cs_world_files}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Status message -->
                                <Border IsVisible="{Binding WorldStatusMessage, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"
                                        Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                    <TextBlock Text="{Binding WorldStatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- World Settings In-Place Configuration (Collapsible) -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20"
                                IsVisible="{Binding IsWorldSettingsOpen}">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="World Configuration" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="1" Classes="primaryBtn" Command="{Binding SaveWorldSettingsCommand}" Padding="16,6" FontSize="12">
                                        <TextBlock Text="Save World Settings" FontWeight="Bold"/>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                    <!-- Left Column: Core Generation & Difficulty -->
                                    <StackPanel Grid.Column="0" Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l10n:Tr Key=cs_world_difficulty}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding WorldDifficulty}" HorizontalAlignment="Stretch"/>
                                        </StackPanel>

                                        <!-- Hardcore Toggle Card -->
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{l10n:Tr Key=cs_world_hardcore}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Permanent death and maximum difficulty" FontSize="10.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding WorldHardcore}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <CheckBox Content="{l10n:Tr Key=cs_world_structures}" IsChecked="{Binding WorldGenerateStructures}"/>
                                    </StackPanel>

                                    <!-- Right Column: Datapacks -->
                                    <StackPanel Grid.Column="1" Spacing="10">
                                        <TextBlock Text="Active Datapacks" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="No custom datapacks detected in /datapacks" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   IsVisible="{Binding EnabledDatapacks.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"/>
                                        <ItemsControl ItemsSource="{Binding EnabledDatapacks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource FieldBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderCardSoftBrush}" CornerRadius="4" Padding="6,3" Margin="0,2">
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Disabled Datapacks" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"
                                                   IsVisible="{Binding DisabledDatapacks.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsNonZero}}"/>
                                        <ItemsControl ItemsSource="{Binding DisabledDatapacks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource FieldBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderCardSoftBrush}" CornerRadius="4" Padding="6,3" Margin="0,2" Opacity="0.6">
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2: PLUGINS / MODS (compact rows) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16" IsVisible="{Binding IsPluginsPanelVisible}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PluginsTabTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="primaryBtn" Content="Add JAR..." Command="{Binding AddPluginJarCommand}" Padding="12,5" FontSize="11.5"/>
                                    <Button Classes="subBtn" Content="{l10n:Tr Key=cs_open_folder}" Command="{Binding OpenPluginsFolderCommand}" Padding="12,5" FontSize="11.5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Empty State (single line) -->
                            <TextBlock Text="No plugins or mods installed yet. Click 'Add JAR...' to install one." FontSize="11.5" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding InstalledPlugins.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}" Margin="0,2"/>

                            <!-- Plugins List (compact rows) -->
                            <ItemsControl ItemsSource="{Binding InstalledPlugins}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ServerPluginItem">
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                                <!-- Icon -->
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Background="{StaticResource IconChipBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <PathIcon Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5s-1.12-2.5-2.5-2.5z"
                                                              Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>

                                                <!-- Name, Version, Description, Size -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                                                        <Border Background="{StaticResource AccentDimBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" IsVisible="{Binding Version, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}">
                                                            <TextBlock Text="{Binding Version}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource RowHoverBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Size}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" IsVisible="{Binding Description, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                </StackPanel>

                                                <!-- Action buttons: Toggle & Delete -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Classes="chipBtn" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).TogglePluginCommand}" CommandParameter="{Binding}" Padding="8,4">
                                                        <TextBlock Text="{Binding ToggleButtonText}" FontSize="10.5"/>
                                                    </Button>
                                                    <Button Classes="dangerBtn" Content="{l10n:Tr Key=cs_plugin_delete}" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).DeletePluginCommand}" CommandParameter="{Binding}" Padding="8,4" FontSize="10.5"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- TAB 3: SETTINGS (Technical Configuration & Danger Zone) -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsSettingsTab}">
                        <!-- Technical Configuration Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{l10n:Tr Key=cs_settings_title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{l10n:Tr Key=cs_hint_ram}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primaryBtn" Command="{Binding SaveServerSettingsCommand}" Padding="18,7" FontSize="12">
                                        <TextBlock Text="{l10n:Tr Key=cs_save_settings}" FontWeight="Bold"/>
                                    </Button>
                                </Grid>

                                <!-- Status message -->
                                <Border IsVisible="{Binding ServerSettingsStatusMessage, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                    <TextBlock Text="{Binding ServerSettingsStatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>

                                <!-- Java Executable Path -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l10n:Tr Key=cs_java_path}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="darkInput" Text="{Binding ServerJavaPath}" PlaceholderText="C:\Program Files\Java\jdk-25\bin\java.exe (or auto-resolved)"/>
                                        <Button Grid.Column="1" Classes="subBtn" Command="{Binding BrowseServerJavaCommand}" Content="{l10n:Tr Key=cs_java_browse}" Padding="14,8"/>
                                    </Grid>
                                </StackPanel>

                                <!-- RAM Allocation (compact shared control, synced with launch flags) -->
                                <controls:RamCardControl Value="{Binding ServerRamMb}"
                                                         Minimum="512"
                                                         Maximum="32768"
                                                         TickFrequency="512"
                                                         Title="{l10n:Tr Key=cs_ram}"
                                                         Subtitle="{l10n:Tr Key=cs_hint_ram}"/>

                                <!-- JVM Launch Arguments -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_jvm_args}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Classes="darkInput" Text="{Binding ServerJvmArgs}" PlaceholderText="-XX:+UseG1GC -XX:+ParallelRefProcEnabled ..."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Danger Zone Card (Compact) -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{l10n:Tr Key=cs_danger_zone}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource DangerLightBrush}"/>
                                        <TextBlock Text="{l10n:Tr Key=cs_danger_desc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <!-- Compact Danger Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="dangerBtn" Command="{Binding RequestResetWorldCommand}" IsVisible="{Binding !ShowWorldResetConfirm}" Padding="12,5" FontSize="11">
                                            <TextBlock Text="Reset World" FontWeight="SemiBold"/>
                                        </Button>
                                        <Button Classes="dangerBtn" Command="{Binding RequestDeleteServerCommand}" IsVisible="{Binding !ShowDeleteServerConfirm}" Padding="12,5" FontSize="11">
                                            <TextBlock Text="{l10n:Tr Key=cs_delete_server_sure}" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Reset World 5-Second Countdown Confirmation Box (Compact) -->
                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" IsVisible="{Binding ShowWorldResetConfirm}">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <TextBlock Text="Reset world data? All chunks and builds will be deleted; new world generates on start."
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Button Classes="dangerBtn" Command="{Binding ConfirmResetWorldCommand}" IsEnabled="{Binding CanConfirmResetWorld}" Padding="12,5" FontSize="11">
                                                <TextBlock Text="{Binding ResetButtonText}" FontWeight="Bold"/>
                                            </Button>
                                            <Button Classes="subBtn" Command="{Binding CancelResetWorldCommand}" Content="{l10n:Tr Key=btn_cancel}" Padding="10,5" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Server Delete Confirmation Dialog (Compact) -->
                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" IsVisible="{Binding ShowDeleteServerConfirm}">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <TextBlock Text="{l10n:Tr Key=cs_delete_server_confirm}"
                                                   Foreground="{StaticResource DangerLightBrush}" FontWeight="SemiBold" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Button Classes="dangerBtn" Content="Confirm Delete" Command="{Binding ConfirmDeleteServerCommand}" Padding="12,5" FontSize="11"/>
                                            <Button Classes="subBtn" Content="{l10n:Tr Key=btn_cancel}" Command="{Binding CancelDeleteServerCommand}" Padding="10,5" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding WorldResetStatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" IsVisible="{Binding WorldResetStatusMessage, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 4: PLAYERS -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="14" IsVisible="{Binding IsPlayersTab}">
                        <StackPanel Spacing="10">
                            <!-- Sub-Tabs Switcher -->
                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="tabBtn" Classes.active="{Binding IsOnlinePlayersSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="0" Content="{l10n:Tr Key=tab_online_players}" Padding="10,5" FontSize="11.5"/>
                                    <Button Classes="tabBtn" Classes.active="{Binding IsOpsSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="1" Content="{l10n:Tr Key=cs_players_ops}" Padding="10,5" FontSize="11.5"/>
                                    <Button Classes="tabBtn" Classes.active="{Binding IsWhitelistSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="2" Content="{l10n:Tr Key=cs_players_whitelist}" Padding="10,5" FontSize="11.5"/>
                                    <Button Classes="tabBtn" Classes.active="{Binding IsBansSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="3" Content="{l10n:Tr Key=cs_players_bans}" Padding="10,5" FontSize="11.5"/>
                                </StackPanel>
                            </Border>

                            <!-- Add Player Input Bar (for Ops, Whitelist, Bans) -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !IsOnlinePlayersSubTab}">
                                <TextBox Classes="darkInput" Text="{Binding NewPlayerName}" PlaceholderText="Enter player username..." VerticalContentAlignment="Center" Height="30" FontSize="12"/>
                                <Button Grid.Column="1" Classes="primaryBtn" Content="Add Player" Command="{Binding AddPlayerCommand}" Padding="12,6" FontSize="11.5"/>
                            </Grid>

                            <!-- Live Online Players SubTab -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsOnlinePlayersSubTab}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Classes="subBtn" Command="{Binding RefreshOnlinePlayersCommand}" Padding="10,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="11" Height="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,6" IsVisible="{Binding OnlinePlayers.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}">
                                    <PathIcon Data="M12 4A4 4 0 0 1 16 8A4 4 0 0 1 12 12A4 4 0 0 1 8 8A4 4 0 0 1 12 4ZM4 20C4 16.69 7.58 14 12 14C16.42 14 20 16.69 20 20V21H4V20Z" Width="22" Height="22" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No players currently online (or server is offline)." FontSize="11.5" Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding OnlinePlayers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{StaticResource AccentDimBrush}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Online" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Ops List -->
                            <StackPanel IsVisible="{Binding IsOpsSubTab}">
                                <TextBlock Text="No operators registered in ops.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding OpsList.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}" Margin="0,4"/>
                                <ItemsControl ItemsSource="{Binding OpsList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ServerPlayerEntry">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='OP Level {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0"/>
                                                    <Button Grid.Column="2" Classes="dangerBtn" Content="Remove OP" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}" Padding="10,4" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Whitelist List -->
                            <StackPanel IsVisible="{Binding IsWhitelistSubTab}">
                                <TextBlock Text="No players in whitelist.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding WhitelistList.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}" Margin="0,4"/>
                                <ItemsControl ItemsSource="{Binding WhitelistList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ServerPlayerEntry">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="dangerBtn" Content="Remove" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}" Padding="10,4" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Bans List -->
                            <StackPanel IsVisible="{Binding IsBansSubTab}">
                                <TextBlock Text="No banned players in banned-players.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding BansList.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}" Margin="0,4"/>
                                <ItemsControl ItemsSource="{Binding BansList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ServerPlayerEntry">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="*,*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource DangerLightBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Classes="dangerBtn" Content="Unban" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}" Padding="10,4" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TAB 5: FILE MANAGER & IN-APP EDITOR -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsFilesTab}">
                        <!-- In-App File Editor Overlay Panel -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsFileEditorOpen}">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                                <!-- Top Bar: File Name, Path, Save & Close -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource IconChipBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <PathIcon Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                                                      Width="15" Height="15" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding EditingFileName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding EditingFileFullPath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileEditorStatusMessage}" FontSize="12" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Classes="primaryBtn" Command="{Binding SaveEditedFileCommand}" IsEnabled="{Binding !IsFileEditorSaving}" Padding="16,7" FontSize="12">
                                            <TextBlock Text="{l10n:Tr Key=cs_editor_save}" FontWeight="Bold"/>
                                        </Button>
                                        <Button Classes="subBtn" Command="{Binding CloseFileEditorCommand}" Content="{l10n:Tr Key=cs_editor_close}" Padding="14,7" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Editor Content -->
                                <TextBox Grid.Row="1" Classes="darkInput"
                                         Text="{Binding EditingFileContent}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                         FontSize="12.5"
                                         MinHeight="420"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                                <!-- Bottom Status Bar -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Editing file directly inside Zenith Launcher" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Button Grid.Column="1" Classes="subBtn" Command="{Binding CloseFileEditorCommand}" Content="{l10n:Tr Key=cs_editor_close}" Padding="12,5" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- File Manager Explorer Table -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding !IsFileEditorOpen}">
                            <StackPanel Spacing="14">
                                <!-- Files Header & Toolbar -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <!-- Breadcrumb Path & Up Button -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="chipBtn" Command="{Binding NavigateUpDirectoryCommand}" IsEnabled="{Binding CanNavigateUp}" ToolTip.Tip="{l10n:Tr Key=cs_file_up}">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <PathIcon Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" Width="11" Height="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{l10n:Tr Key=cs_file_up}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Breadcrumb location -->
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="13" Height="13" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding CurrentBrowseRelativePath}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right action buttons: Upload, Refresh, Open in Explorer -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                <Button Classes="chipBtn" Command="{Binding CreateNewFolderCommand}" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="12" Height="12" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="New Folder" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chipBtn" Command="{Binding CreateNewFileCommand}" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <PathIcon Data="M6 2c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6H6zm7 7V3.5L18.5 9H13z" Width="12" Height="12" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="New File" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chipBtn" Command="{Binding UploadServerFilesCommand}" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <PathIcon Data="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z" Width="12" Height="12" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{l10n:Tr Key=cs_file_upload}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chipBtn" Command="{Binding RefreshFilesCommand}" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{l10n:Tr Key=cs_file_refresh}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="subBtn" Command="{Binding OpenCurrentFolderInExplorerCommand}" Content="{l10n:Tr Key=cs_open_folder}" Padding="12,6" FontSize="11.5"/>
                                    </StackPanel>
                                </Grid>

                                                                <!-- Rename Dialog -->
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" IsVisible="{Binding IsRenamingFile}" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBox Classes="darkInput" Text="{Binding RenamingFileNewName}" PlaceholderText="Enter new name..." VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="subBtn" Command="{Binding CancelRenameFileCommand}" Content="{l10n:Tr Key=btn_cancel}"/>
                                        <Button Grid.Column="2" Classes="primaryBtn" Command="{Binding ConfirmRenameFileCommand}" Content="{l10n:Tr Key=cs_settings_save}" Padding="16,8"/>
                                    </Grid>
                                </Border>

                                <!-- Status / Error message if any -->
                                <TextBlock Text="{Binding FileOperationStatus}" FontSize="11.5" Foreground="{StaticResource DangerLightBrush}" IsVisible="{Binding FileOperationStatus, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>

                                <!-- Table Header (click to sort) -->
                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                    <Grid ColumnDefinitions="*,140,80,210">
                                        <Button Classes="tabBtn" Command="{Binding SortFilesByCommand}" CommandParameter="Name" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Name" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <PathIcon Data="{Binding FileSortNameIcon}" Width="9" Height="9" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding FileSortNameIcon, Converter={x:Static converters:EditInstanceWindowConverters.IsNotNull}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="tabBtn" Command="{Binding SortFilesByCommand}" CommandParameter="Date" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Date Modified" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <PathIcon Data="{Binding FileSortDateIcon}" Width="9" Height="9" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding FileSortDateIcon, Converter={x:Static converters:EditInstanceWindowConverters.IsNotNull}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="tabBtn" Command="{Binding SortFilesByCommand}" CommandParameter="Size" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Size" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <PathIcon Data="{Binding FileSortSizeIcon}" Width="9" Height="9" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding FileSortSizeIcon, Converter={x:Static converters:EditInstanceWindowConverters.IsNotNull}}"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Grid.Column="3" Text="Actions" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Empty folder message -->
                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="30" IsVisible="{Binding IsFilesEmpty}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="28" Height="28" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{l10n:Tr Key=cs_file_empty}" FontSize="12.5" Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- File List -->
                                <ItemsControl ItemsSource="{Binding ServerFiles}" IsVisible="{Binding !IsFilesEmpty}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ServerFileItem">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="*,140,80,210" VerticalAlignment="Center">
                                                    <!-- Icon + Name -->
                                                    <Button Classes="tabBtn" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).NavigateIntoFileItemCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="2,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <PathIcon Data="{Binding IconData}" Foreground="{Binding IconColor}" Width="15" Height="15" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Date Modified -->
                                                    <TextBlock Grid.Column="1" Text="{Binding ModifiedDisplay}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                                                    <!-- Size -->
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Classes="chipBtn" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).OpenFileItemCommand}" CommandParameter="{Binding}" ToolTip.Tip="{l10n:Tr Key=cs_file_open}" Padding="8,4">
                                                            <TextBlock Text="{l10n:Tr Key=cs_file_open}" FontSize="11"/>
                                                        </Button>
                                                                                                                <Button Classes="chipBtn" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).StartRenameFileCommand}" CommandParameter="{Binding}" ToolTip.Tip="Rename" Padding="8,4">
                                                            <TextBlock Text="Rename" FontSize="11"/>
                                                        </Button>
                                                        <Button Classes="dangerBtn" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).DeleteFileItemCommand}" CommandParameter="{Binding}" ToolTip.Tip="{l10n:Tr Key=cs_file_delete}" Padding="8,4">
                                                            <TextBlock Text="{l10n:Tr Key=cs_file_delete}" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>







