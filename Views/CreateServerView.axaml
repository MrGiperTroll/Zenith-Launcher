<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:services="using:CustomMcLauncher.Services"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             x:Class="CustomMcLauncher.Views.CreateServerView"
             x:DataType="vm:CreateServerViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.darkInput">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Button Brightening Hover Styles -->
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.dangerBtn">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.dangerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TabHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn.active">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,24,24" MaxWidth="960" HorizontalAlignment="Left">

            <!-- ========================================================= -->
            <!-- 1. DASHBOARD MODE                                         -->
            <!-- ========================================================= -->
            <StackPanel Spacing="16" IsVisible="{Binding IsDashboardMode}">
                <!-- Header Banner (NO duplicate server icon) -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Local Server Dashboard" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Interactive terminal console, live properties editor, and add-ons management" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <!-- Server Selector Dropdown -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Active Server:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding ExistingServers}" SelectedItem="{Binding SelectedServerName}" MinWidth="190"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="subBtn" Content="New Server" Command="{Binding SwitchToWizardCommand}" Padding="12,7" FontSize="12"/>
                            <Button Classes="subBtn" Content="Open Folder" Command="{Binding OpenServerFolderCommand}" Padding="12,7" FontSize="12"/>
                            <Button Classes="primaryBtn" Command="{Binding RunServerCommand}" Padding="16,7" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="M8 5v14l11-7z" Width="13" Height="13" Foreground="{StaticResource OnAccentBrush}"/>
                                    <TextBlock Text="Start (CMD)" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabs Navigation Strip -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="tabBtn" Classes.active="{Binding IsOverviewTab}" Command="{Binding SelectTabCommand}" CommandParameter="0" Content="Overview"/>
                        <Button Classes="tabBtn" Classes.active="{Binding IsPropertiesTab}" Command="{Binding SelectTabCommand}" CommandParameter="1" Content="server.properties"/>
                        <Button Classes="tabBtn" Classes.active="{Binding IsPluginsTab}" Command="{Binding SelectTabCommand}" CommandParameter="2" Content="Plugins &amp; Mods"/>
                        <Button Classes="tabBtn" Classes.active="{Binding IsWorldTab}" Command="{Binding SelectTabCommand}" CommandParameter="3" Content="World Management"/>
                        <Button Classes="tabBtn" Classes.active="{Binding IsPlayersTab}" Command="{Binding SelectTabCommand}" CommandParameter="4" Content="Players (Ops / Whitelist / Bans)"/>
                    </StackPanel>
                </Border>

                <!-- TAB 0: OVERVIEW -->
                <StackPanel Spacing="16" IsVisible="{Binding IsOverviewTab}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!-- Server Information -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Server Information" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>

                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Local Address:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PropsPort, StringFormat='localhost:{0}'}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PropsPort}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gamemode:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PropsGamemode}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Difficulty:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PropsDifficulty}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Players:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PropsMaxPlayers}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="World Name:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PropsLevelName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Terminal & Console Control -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Interactive Console" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Clicking 'Start Server' launches the Minecraft server inside an interactive external Command Prompt window. You can monitor live game logs and type admin commands (like 'op &lt;player&gt;', 'stop', 'whitelist reload') with zero latency."
                                           TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18"/>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                    <Button Classes="primaryBtn" Command="{Binding RunServerCommand}" Padding="18,10" FontSize="13">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <PathIcon Data="M8 5v14l11-7z" Width="14" Height="14" Foreground="{StaticResource OnAccentBrush}"/>
                                            <TextBlock Text="Launch Interactive Console" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subBtn" Content="Open Server Directory" Command="{Binding OpenServerFolderCommand}" Padding="16,10" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- TAB 1: SERVER.PROPERTIES -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsPropertiesTab}">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Text="server.properties Visual Editor" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Grid.Column="1" Classes="primaryBtn" Content="Save Configuration" Command="{Binding SavePropertiesCommand}" Padding="18,8" FontSize="12"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <!-- Left Column: Inputs & Dropdowns -->
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Server Port" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Classes="darkInput" Text="{Binding PropsPort}"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="MOTD (Server Description)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Classes="darkInput" Text="{Binding PropsMotd}"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Gamemode" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding GamemodeOptions}" SelectedItem="{Binding PropsGamemode}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Difficulty" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding PropsDifficulty}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Max Players" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsMaxPlayers}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Spawn Protection" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsSpawnProtection}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="View Distance (chunks)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsViewDistance}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Simulation Distance" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsSimulationDistance}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Right Column: Switches & Rules -->
                            <StackPanel Spacing="16" Margin="0,4,0,0">
                                <TextBlock Text="Security &amp; Gameplay Rules" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>

                                <CheckBox Content="Online Mode (Mojang account authentication)" IsChecked="{Binding PropsOnlineMode}"/>
                                <CheckBox Content="Whitelist Enabled (Only authorized players can join)" IsChecked="{Binding PropsWhitelist}"/>
                                <CheckBox Content="Enable PvP (Player vs Player combat)" IsChecked="{Binding PropsPvp}"/>
                                <CheckBox Content="Hardcore Mode (Permadeath)" IsChecked="{Binding PropsHardcore}"/>
                                <CheckBox Content="Allow Flight in Survival" IsChecked="{Binding PropsAllowFlight}"/>
                                <CheckBox Content="Enable Command Blocks" IsChecked="{Binding PropsCommandBlocks}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Feedback Message -->
                        <TextBlock Text="{Binding ConfigStatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" IsVisible="{Binding ConfigStatusMessage, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TAB 2: PLUGINS & MODS -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsPluginsTab}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding InstalledPlugins.Count, StringFormat='Installed Plugins &amp; Mods ({0})'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Manage .jar extensions located in /plugins or /mods directory" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="primaryBtn" Content="Add JAR..." Command="{Binding AddPluginJarCommand}" Padding="14,7" FontSize="12"/>
                                <Button Classes="subBtn" Content="Open Folder" Command="{Binding OpenPluginsFolderCommand}" Padding="14,7" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Empty State -->
                        <TextBlock Text="No plugins or mods installed yet. Click 'Add JAR...' to install one." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding InstalledPlugins.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,16"/>

                        <!-- Plugins List -->
                        <ItemsControl ItemsSource="{Binding InstalledPlugins}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ServerPluginItem">
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                            <Border Background="{StaticResource AccentDimBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding IsPlugin, Converter={x:Static vm:EditInstanceWindowConverters.ActiveText}}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0"/>

                                            <Button Grid.Column="3" Classes="dangerBtn" Content="Delete" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).DeletePluginCommand}" CommandParameter="{Binding}" Padding="12,5" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- TAB 3: WORLD MANAGEMENT -->
                <StackPanel Spacing="16" IsVisible="{Binding IsWorldTab}">
                    <!-- World Properties -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="World Generation Settings" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="subBtn" Content="Open World Folder" Command="{Binding OpenWorldFolderCommand}" Padding="14,7" FontSize="12"/>
                                    <Button Classes="primaryBtn" Content="Save World Settings" Command="{Binding SavePropertiesCommand}" Padding="16,7" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Level Name (World Folder)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Classes="darkInput" Text="{Binding PropsLevelName}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Level Seed (Leave empty for random)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Classes="darkInput" Text="{Binding PropsLevelSeed}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="World Type" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding LevelTypeOptions}" SelectedItem="{Binding PropsLevelType}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Reset / Regenerate World (Danger Zone) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Danger Zone: Reset &amp; Regenerate World" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="Permanently deletes the current world save folders ('world', 'world_nether', 'world_the_end'). On next server launch, a pristine world with the active seed will be generated."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18"/>

                            <StackPanel Margin="0,6,0,0">
                                <Button Classes="dangerBtn" Content="Reset World Files..." Command="{Binding RequestResetWorldCommand}" IsVisible="{Binding !ShowWorldResetConfirm}" Padding="16,8" FontSize="12"/>

                                <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="{Binding ShowWorldResetConfirm}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Are you absolutely sure? All building, inventories, and player progression will be deleted permanently." Foreground="{StaticResource DangerLightBrush}" FontWeight="Bold" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Classes="dangerBtn" Content="Yes, Delete World Files" Command="{Binding ConfirmResetWorldCommand}" Padding="16,7" FontSize="12"/>
                                            <Button Classes="subBtn" Content="Cancel" Command="{Binding CancelResetWorldCommand}" Padding="14,7" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding WorldResetStatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" IsVisible="{Binding WorldResetStatusMessage, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 4: PLAYERS (OPS / WHITELIST / BANS) -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsPlayersTab}">
                    <StackPanel Spacing="16">
                        <!-- Sub-Tabs Switcher -->
                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="tabBtn" Classes.active="{Binding IsOpsSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="0" Content="{Binding OpsList.Count, StringFormat='Operators ({0})'}"/>
                                <Button Classes="tabBtn" Classes.active="{Binding IsWhitelistSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="1" Content="{Binding WhitelistList.Count, StringFormat='Whitelist ({0})'}"/>
                                <Button Classes="tabBtn" Classes.active="{Binding IsBansSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="2" Content="{Binding BansList.Count, StringFormat='Banned Players ({0})'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Add Player Input Bar -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Classes="darkInput" Text="{Binding NewPlayerName}" PlaceholderText="Enter player username..."/>
                            <Button Grid.Column="1" Classes="primaryBtn" Content="Add Player" Command="{Binding AddPlayerCommand}" Padding="20,8" FontSize="12"/>
                        </Grid>

                        <!-- Ops List -->
                        <StackPanel IsVisible="{Binding IsOpsSubTab}">
                            <TextBlock Text="No operators registered in ops.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding OpsList.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,8"/>
                            <ItemsControl ItemsSource="{Binding OpsList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ServerPlayerEntry">
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='OP Level {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0"/>
                                                <Button Grid.Column="2" Classes="dangerBtn" Content="Remove OP" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Whitelist List -->
                        <StackPanel IsVisible="{Binding IsWhitelistSubTab}">
                            <TextBlock Text="No players in whitelist.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding WhitelistList.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,8"/>
                            <ItemsControl ItemsSource="{Binding WhitelistList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ServerPlayerEntry">
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Classes="dangerBtn" Content="Remove" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Bans List -->
                        <StackPanel IsVisible="{Binding IsBansSubTab}">
                            <TextBlock Text="No banned players in banned-players.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding BansList.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,8"/>
                            <ItemsControl ItemsSource="{Binding BansList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ServerPlayerEntry">
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,*,Auto" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource DangerLightBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2" Classes="dangerBtn" Content="Unban" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- 2. CREATION WIZARD MODE                                   -->
            <!-- ========================================================= -->
            <StackPanel Spacing="16" IsVisible="{Binding !IsDashboardMode}">
                <!-- Header Banner (NO duplicate server icon!) -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{l10n:Tr Key=cs_title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{l10n:Tr Key=cs_creating}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding IsBusy}"/>
                            <TextBlock Text="{l10n:Tr Key=cs_status_ready}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding !IsBusy}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Classes="subBtn" Content="Back to Dashboard" Command="{Binding SwitchToDashboardCommand}" IsVisible="{Binding HasExistingServers}" Padding="14,8" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Configuration Form -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Server Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l10n:Tr Key=cs_name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Classes="darkInput" Text="{Binding ServerName}" IsEnabled="{Binding !IsBusy}"/>
                        </StackPanel>

                        <!-- Version & Software Grid -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <!-- Version -->
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{l10n:Tr Key=cs_version}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}"/>
                            </StackPanel>

                            <!-- Software -->
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{l10n:Tr Key=cs_type}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableSoftware}" SelectedItem="{Binding SelectedSoftware}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:ServerSoftwareOption">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- RAM & Port Grid -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <!-- RAM -->
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{l10n:Tr Key=cs_ram}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding RamOptions}" SelectedItem="{Binding RamGb}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding, StringFormat='{}{0} GB'}" FontSize="12"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Port -->
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{l10n:Tr Key=cs_port}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Classes="darkInput" Text="{Binding ServerPort}" IsEnabled="{Binding !IsBusy}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Checkboxes -->
                        <StackPanel Spacing="10" Margin="0,6,0,0">
                            <CheckBox Content="{l10n:Tr Key=cs_eula}" IsChecked="{Binding AgreeEula}" IsEnabled="{Binding !IsBusy}"/>
                            <CheckBox Content="{l10n:Tr Key=cs_online_mode}" IsChecked="{Binding OnlineMode}" IsEnabled="{Binding !IsBusy}"/>
                        </StackPanel>

                        <!-- Progress and Status -->
                        <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsBusy}">
                            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Success or Error Status -->
                        <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="Bold"
                                   Foreground="{Binding IsCreated, Converter={x:Static vm:EditInstanceWindowConverters.ActiveText}}"
                                   IsVisible="{Binding !IsBusy}" Margin="0,4,0,0"/>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                            <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=btn_back}" Command="{Binding CancelCommand}" Padding="16,9" FontSize="12"/>

                            <!-- Before Creation Actions -->
                            <Button Grid.Column="2" Classes="primaryBtn" Content="{l10n:Tr Key=cs_create_btn}" Command="{Binding CreateServerCommand}"
                                    IsEnabled="{Binding CanCreate}" IsVisible="{Binding !IsCreated}" Padding="20,9" FontSize="13"/>

                            <!-- After Creation Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsCreated}">
                                <Button Classes="subBtn" Content="Go to Dashboard" Command="{Binding SwitchToDashboardCommand}" Padding="16,9" FontSize="12"/>
                                <Button Classes="subBtn" Content="{l10n:Tr Key=cs_open_folder}" Command="{Binding OpenServerFolderCommand}" Padding="16,9" FontSize="12"/>
                                <Button Classes="primaryBtn" Content="Start in CMD" Command="{Binding RunServerCommand}" Padding="20,9" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
