<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:views="using:CustomMcLauncher.Views"
             xmlns:services="using:CustomMcLauncher.Services"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             x:Class="CustomMcLauncher.Views.CreateServerView"
             x:DataType="vm:CreateServerViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.darkInput">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Button Brightening Hover Styles -->
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.chipBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.chipBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.dangerBtn">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.dangerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TabHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn.active">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Master Server List Styles -->
        <Style Selector="ListBox.serverList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.serverList ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.serverList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.serverList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Master-Detail Root Layout (Left: Server List, Right: Dashboard Panel) -->
    <Grid ColumnDefinitions="250,*" ColumnSpacing="18" Margin="0,0,16,16">

        <!-- ========================================================= -->
        <!-- MASTER: LEFT SERVER LIST                                  -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header with "+ New Server" Button -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Servers" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="primaryBtn" Command="{Binding StartCreateNewServerCommand}" Padding="10,6" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="12" Height="12" Foreground="{StaticResource OnAccentBrush}"/>
                            <TextBlock Text="New" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Server List Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="No servers created yet. Click '+ New' to create one."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding ExistingServers.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}"
                                   Margin="4,16"/>

                        <ListBox Classes="serverList" ItemsSource="{Binding ExistingServers}" SelectedItem="{Binding SelectedServerName}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" Background="{StaticResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                            <PathIcon Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                                      Width="13" Height="13" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Local Server" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- DETAIL: RIGHT CONTENT PANEL                               -->
        <!-- ========================================================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <!-- CASE A: CREATING NEW SERVER -->
                <StackPanel Spacing="16" IsVisible="{Binding IsCreatingNewServer}">
                    <!-- Header -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l10n:Tr Key=cs_title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{l10n:Tr Key=cs_creating}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding IsBusy}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Classes="subBtn" Content="{l10n:Tr Key=btn_cancel}" Command="{Binding CancelCreateNewServerCommand}" IsVisible="{Binding HasExistingServers}"/>
                        </Grid>
                    </Border>

                    <!-- Creation Form -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Server Name -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{l10n:Tr Key=cs_name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Classes="darkInput" Text="{Binding ServerName}" IsEnabled="{Binding !IsBusy}"/>
                            </StackPanel>

                            <!-- Version & Software Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{l10n:Tr Key=cs_version}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{l10n:Tr Key=cs_type}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding AvailableSoftware}" SelectedItem="{Binding SelectedSoftware}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="services:ServerSoftwareOption">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- RAM Allocation & Port Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <!-- RAM Allocation: Unified RamCardControl -->
                                <views:RamCardControl Grid.Column="0"
                                                      Value="{Binding RamGb}"
                                                      Minimum="1"
                                                      Maximum="32"
                                                      TickFrequency="1"
                                                      IsGbMode="True"
                                                      Title="{l10n:Tr Key=cs_ram}"
                                                      IsEnabled="{Binding !IsBusy}"/>

                                <!-- Port -->
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{l10n:Tr Key=cs_port}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Classes="darkInput" Text="{Binding ServerPort}" IsEnabled="{Binding !IsBusy}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Checkboxes (EULA agreement) -->
                            <StackPanel Spacing="10" Margin="0,6,0,0">
                                <CheckBox Content="{l10n:Tr Key=cs_eula}" IsChecked="{Binding AgreeEula}" IsEnabled="{Binding !IsBusy}"/>
                            </StackPanel>

                            <!-- Progress and Status -->
                            <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsBusy}">
                                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Error Status -->
                            <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource DangerLightBrush}" IsVisible="{Binding StatusText, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}" Margin="0,4,0,0"/>

                            <!-- Action Buttons -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                                <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=btn_back}" Command="{Binding CancelCreateNewServerCommand}" IsVisible="{Binding HasExistingServers}"/>
                                <Button Grid.Column="2" Classes="primaryBtn" Content="{l10n:Tr Key=cs_create_btn}" Command="{Binding CreateServerCommand}" IsEnabled="{Binding CanCreate}" Padding="20,9"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CASE B: ACTIVE SERVER DASHBOARD -->
                <StackPanel Spacing="16" IsVisible="{Binding !IsCreatingNewServer}">
                    <!-- Server Header Bar (No duplicate server icon, clean start button without (cmd)) -->
                    <!-- Server Header Bar (Inline rename, live IP badge with network flyout, quick action) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <!-- Left: Server Name with inline editing + IP badge with selector flyout -->
                            <StackPanel VerticalAlignment="Center" Spacing="6">
                                <Panel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsEditingServerName}">
                                        <TextBlock x:Name="ServerNameBlock" Text="{Binding SelectedServerName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   Cursor="Hand" ToolTip.Tip="{l10n:Tr Key=cs_rename}" VerticalAlignment="Center"/>
                                        <Button Classes="chipBtn" Command="{Binding StartRenameServerCommand}" IsEnabled="{Binding CanEditServer}"
                                                Padding="4" VerticalAlignment="Center" ToolTip.Tip="{l10n:Tr Key=cs_rename}">
                                            <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="11" Height="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Editing state -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center" IsVisible="{Binding IsEditingServerName}">
                                        <TextBox x:Name="EditServerNameBox" Classes="darkInput" Text="{Binding EditingServerNameText}" FontSize="14" FontWeight="Bold" MinWidth="180" MaxWidth="320"/>
                                        <Button Grid.Column="1" Classes="primaryBtn" Command="{Binding CommitRenameServerCommand}" Padding="8,4" FontSize="11" Content="✓"/>
                                        <Button Grid.Column="2" Classes="subBtn" Command="{Binding CancelRenameServerCommand}" Padding="8,4" FontSize="11" Content="✕"/>
                                    </Grid>
                                </Panel>

                                <!-- IP Badge + Copy with Network Interfaces Selector Flyout -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="7,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="{Binding ServerIpDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Classes="chipBtn" Padding="7,4" ToolTip.Tip="{l10n:Tr Key=cs_copy_ip}">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="260">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Server Addresses" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="6,4"/>
                                                        <ItemsControl ItemsSource="{Binding NetworkEndpoints}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="services:ServerNetworkEndpoint">
                                                                    <Button Classes="tabBtn" Command="{Binding $parent[views:CreateServerView].((vm:CreateServerViewModel)DataContext).CopyAddressCommand}" CommandParameter="{Binding Address}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <StackPanel Spacing="1">
                                                                                <TextBlock Text="{Binding Address}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                            </StackPanel>
                                                                            <PathIcon Grid.Column="1" Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                      Width="11" Height="11" Foreground="{StaticResource TextSecondaryBrush}" IsVisible="{Binding !IsIpCopied}"/>
                                            <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                      Width="11" Height="11" Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding IsIpCopied}"/>
                                            <TextBlock Text="{l10n:Tr Key=cs_ip_copied}" IsVisible="{Binding IsIpCopied}" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock Text="{l10n:Tr Key=cs_copy_ip}" IsVisible="{Binding !IsIpCopied}" FontSize="11"/>
                                            <PathIcon Data="M7 10l5 5 5-5z" Width="9" Height="9" Foreground="{StaticResource TextMutedBrush}" Margin="2,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Quick Open Folder + Run/Stop -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="subBtn" Content="{l10n:Tr Key=cs_open_folder}" Command="{Binding OpenServerFolderCommand}"/>
                                <Button Classes="primaryBtn" Command="{Binding RunServerCommand}" IsVisible="{Binding !IsServerRunning}" Padding="18,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="M8 5v14l11-7z" Width="13" Height="13" Foreground="{StaticResource OnAccentBrush}"/>
                                        <TextBlock Text="{l10n:Tr Key=cs_run_server}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="dangerBtn" Command="{Binding StopServerCommand}" IsVisible="{Binding IsServerRunning}" Padding="18,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="M6 6h12v12H6z" Width="13" Height="13" Foreground="{StaticResource DangerLightBrush}"/>
                                        <TextBlock Text="{l10n:Tr Key=btn_kill_short}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabs Navigation Bar (Localized) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="tabBtn" Classes.active="{Binding IsOverviewTab}" Command="{Binding SelectTabCommand}" CommandParameter="0" Content="{l10n:Tr Key=cs_tab_overview}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsPropertiesTab}" Command="{Binding SelectTabCommand}" CommandParameter="1" Content="{l10n:Tr Key=cs_tab_properties}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsPluginsTab}" Command="{Binding SelectTabCommand}" CommandParameter="2" Content="{l10n:Tr Key=cs_tab_plugins}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsWorldTab}" Command="{Binding SelectTabCommand}" CommandParameter="3" Content="{l10n:Tr Key=cs_tab_world}"/>
                            <Button Classes="tabBtn" Classes.active="{Binding IsPlayersTab}" Command="{Binding SelectTabCommand}" CommandParameter="4" Content="{l10n:Tr Key=cs_tab_players}"/>
                        </StackPanel>
                    </Border>

                    <!-- TAB 0: OVERVIEW (Rich live data & quick actions) -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsOverviewTab}">
                        <!-- Hero Status Banner -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource IconChipBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <PathIcon Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                                  Width="22" Height="22" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedServerName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <!-- Status Badge -->
                                            <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsServerRunning}">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"/>
                                                    <TextBlock Text="{l10n:Tr Key=cs_status_online}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" IsVisible="{Binding !IsServerRunning}">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{l10n:Tr Key=cs_status_offline}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ActiveServerDirectory}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="primaryBtn" Command="{Binding RunServerCommand}" IsVisible="{Binding !IsServerRunning}" Padding="16,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="M8 5v14l11-7z" Width="13" Height="13" Foreground="{StaticResource OnAccentBrush}"/>
                                            <TextBlock Text="{l10n:Tr Key=cs_run_server}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="dangerBtn" Command="{Binding StopServerCommand}" IsVisible="{Binding IsServerRunning}" Padding="16,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="M6 6h12v12H6z" Width="13" Height="13" Foreground="{StaticResource DangerLightBrush}"/>
                                            <TextBlock Text="{l10n:Tr Key=btn_kill_short}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Metrics Grid -->
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <!-- 1. Status & Uptime -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_uptime}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding UptimeText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Server process runtime" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Online Players -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_tab_players}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding OnlinePlayers.Count}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding PropsMaxPlayers, StringFormat='/ {0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Active connections" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. Port & Address -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_port}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding PropsPort}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ServerIpDisplay}" FontSize="10.5" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. Software / Core Version -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_type}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ServerSoftwareDisplay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Core build" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. Allocated RAM -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_ram}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ServerAllocatedRamDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Configured in run.bat" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 6. World Name & Gamemode -->
                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l10n:Tr Key=cs_tab_world}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding PropsLevelName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PropsGamemode, StringFormat='Mode: {0}'}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Actions Bar -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="Quick Actions" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="subBtn" Command="{Binding OpenServerFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="13" Height="13" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="{l10n:Tr Key=cs_open_folder}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subBtn" Command="{Binding OpenLogsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Width="13" Height="13" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="Logs / Console"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subBtn" Command="{Binding RequestResetWorldCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" Width="13" Height="13" Foreground="{StaticResource WarningBrush}"/>
                                            <TextBlock Text="Reset World"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- TAB 1: SERVER.PROPERTIES (Clean 2-column grid, no overlapping, locked if running) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsPropertiesTab}">
                        <StackPanel Spacing="16">
                            <!-- Top bar: Title & Save Button with indicator -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{l10n:Tr Key=cs_props_title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Full visual editor for all 22 server configuration settings" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=cs_save_props}" Command="{Binding SavePropertiesCommand}" IsEnabled="{Binding CanEditServer}" Padding="18,7" FontSize="12"/>
                            </Grid>

                            <!-- Running lock notification -->
                            <Border IsVisible="{Binding !CanEditServer}" Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" Width="14" Height="14" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=cs_running_locked}" FontSize="12" Foreground="{StaticResource WarningBrightBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Feedback Message -->
                            <Border IsVisible="{Binding ConfigStatusMessage, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding ConfigStatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <!-- Balanced 2-Column Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsEnabled="{Binding CanEditServer}">
                                <!-- Left Column: Core Parameters -->
                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="General &amp; Network" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Server Port" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsPort}"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="MOTD (Server Description)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsMotd}"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Gamemode" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding GamemodeOptions}" SelectedItem="{Binding PropsGamemode}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Difficulty" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding PropsDifficulty}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Max Players" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Classes="darkInput" Text="{Binding PropsMaxPlayers}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Spawn Protection" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Classes="darkInput" Text="{Binding PropsSpawnProtection}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="View Distance" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Classes="darkInput" Text="{Binding PropsViewDistance}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Simulation Distance" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Classes="darkInput" Text="{Binding PropsSimulationDistance}"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Entity Broadcast Range (%)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsEntityBroadcastRangePercentage}"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Level Name" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Classes="darkInput" Text="{Binding PropsLevelName}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Level Type" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding LevelTypeOptions}" SelectedItem="{Binding PropsLevelType}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Level Seed" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Classes="darkInput" Text="{Binding PropsLevelSeed}" PlaceholderText="Leave empty for random seed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Right Column: Rules & Flags -->
                                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{l10n:Tr Key=cs_props_rules}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>

                                        <CheckBox Content="Online Mode (Mojang account verification)" IsChecked="{Binding PropsOnlineMode}"/>
                                        <CheckBox Content="Whitelist Enabled (Only allowed players)" IsChecked="{Binding PropsWhitelist}"/>
                                        <CheckBox Content="Enable PvP (Player vs player combat)" IsChecked="{Binding PropsPvp}"/>
                                        <CheckBox Content="Hardcore Mode (Permadeath spectator)" IsChecked="{Binding PropsHardcore}"/>
                                        <CheckBox Content="Allow Flight (Allow flight in survival)" IsChecked="{Binding PropsAllowFlight}"/>
                                        <CheckBox Content="Enable Command Blocks" IsChecked="{Binding PropsCommandBlocks}"/>
                                        <CheckBox Content="Allow Nether (Enable Nether dimension)" IsChecked="{Binding PropsAllowNether}"/>
                                        <CheckBox Content="Generate Structures (Villages, fortresses)" IsChecked="{Binding PropsGenerateStructures}"/>
                                        <CheckBox Content="Spawn Animals (Passive mobs)" IsChecked="{Binding PropsSpawnAnimals}"/>
                                        <CheckBox Content="Spawn Monsters (Hostile mobs)" IsChecked="{Binding PropsSpawnMonsters}"/>
                                        <CheckBox Content="Spawn NPCs (Villagers &amp; traders)" IsChecked="{Binding PropsSpawnNpcs}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TAB 2: PLUGINS & MODS -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsPluginsTab}">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding InstalledPlugins.Count, StringFormat='Installed Plugins &amp; Mods ({0})'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Files located in /plugins or /mods folder" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primaryBtn" Content="Add JAR..." Command="{Binding AddPluginJarCommand}" Padding="14,7" FontSize="12"/>
                                    <Button Classes="subBtn" Content="{l10n:Tr Key=cs_open_folder}" Command="{Binding OpenPluginsFolderCommand}" Padding="14,7" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Empty State -->
                            <TextBlock Text="No plugins or mods installed yet. Click 'Add JAR...' to install one." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding InstalledPlugins.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,16"/>

                            <!-- Plugins List -->
                            <ItemsControl ItemsSource="{Binding InstalledPlugins}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ServerPluginItem">
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                                <Border Background="{StaticResource AccentDimBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding IsPlugin, Converter={x:Static vm:EditInstanceWindowConverters.ActiveText}}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0"/>

                                                <Button Grid.Column="3" Classes="dangerBtn" Content="Delete" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).DeletePluginCommand}" CommandParameter="{Binding}" Padding="12,5" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- TAB 3: WORLD & SERVER MANAGEMENT (Strict utilitarian, no AI-slop Danger Zone) -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsWorldTab}">
                        <!-- World Settings Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="World Generation Settings" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="subBtn" Content="Open World Folder" Command="{Binding OpenWorldFolderCommand}" Padding="12,7" FontSize="12"/>
                                        <Button Classes="primaryBtn" Content="Save World Settings" Command="{Binding SavePropertiesCommand}" Padding="16,7" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Level Name" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsLevelName}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Level Seed" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Classes="darkInput" Text="{Binding PropsLevelSeed}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="World Type" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding LevelTypeOptions}" SelectedItem="{Binding PropsLevelType}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Utilitarian World & Server Operations (Clean, matching launcher palette) -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Server Data &amp; Maintenance" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Reset world save data to force a fresh regeneration, or delete this local server installation."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Classes="subBtn" Content="Reset World" Command="{Binding RequestResetWorldCommand}" IsVisible="{Binding !ShowWorldResetConfirm}"/>
                                    <Button Classes="dangerBtn" Content="Delete Server" Command="{Binding RequestDeleteServerCommand}" IsVisible="{Binding !ShowDeleteServerConfirm}"/>
                                </StackPanel>

                                <!-- World Reset Confirmation Dialog -->
                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="{Binding ShowWorldResetConfirm}" Margin="0,4,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Reset world data? All chunks and player builds will be deleted; a new world will generate on next start."
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="dangerBtn" Content="Confirm Reset" Command="{Binding ConfirmResetWorldCommand}"/>
                                            <Button Classes="subBtn" Content="Cancel" Command="{Binding CancelResetWorldCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Server Delete Confirmation Dialog -->
                                <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="{Binding ShowDeleteServerConfirm}" Margin="0,4,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Are you sure you want to permanently delete this entire server folder and all its files?"
                                                   Foreground="{StaticResource DangerLightBrush}" FontWeight="Bold" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="dangerBtn" Content="Delete Server" Command="{Binding ConfirmDeleteServerCommand}"/>
                                            <Button Classes="subBtn" Content="Cancel" Command="{Binding CancelDeleteServerCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding WorldResetStatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" IsVisible="{Binding WorldResetStatusMessage, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 4: PLAYERS (ONLINE PLAYERS / OPS / WHITELIST / BANS) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsPlayersTab}">
                        <StackPanel Spacing="16">
                            <!-- Sub-Tabs Switcher -->
                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="tabBtn" Classes.active="{Binding IsOnlinePlayersSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{l10n:Tr Key=tab_online_players}" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource AccentDimBrush}" CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="{Binding OnlinePlayers.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="tabBtn" Classes.active="{Binding IsOpsSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="1" Content="{Binding OpsList.Count, StringFormat='Operators ({0})'}"/>
                                    <Button Classes="tabBtn" Classes.active="{Binding IsWhitelistSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="2" Content="{Binding WhitelistList.Count, StringFormat='Whitelist ({0})'}"/>
                                    <Button Classes="tabBtn" Classes.active="{Binding IsBansSubTab}" Command="{Binding SelectPlayersSubTabCommand}" CommandParameter="3" Content="{Binding BansList.Count, StringFormat='Banned Players ({0})'}"/>
                                </StackPanel>
                            </Border>

                            <!-- Add Player Input Bar (for Ops, Whitelist, Bans) -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding !IsOnlinePlayersSubTab}">
                                <TextBox Classes="darkInput" Text="{Binding NewPlayerName}" PlaceholderText="Enter player username..."/>
                                <Button Grid.Column="1" Classes="primaryBtn" Content="Add Player" Command="{Binding AddPlayerCommand}" Padding="20,8" FontSize="12"/>
                            </Grid>

                            <!-- Live Online Players SubTab -->
                            <StackPanel Spacing="10" IsVisible="{Binding IsOnlinePlayersSubTab}">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OnlinePlayersCountText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button Grid.Column="1" Classes="subBtn" Command="{Binding RefreshOnlinePlayersCommand}" Padding="12,5" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="11" Height="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="No players currently online (or server is offline)." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding OnlinePlayers.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,8"/>

                                <ItemsControl ItemsSource="{Binding OnlinePlayers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="{StaticResource AccentDimBrush}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Online" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Ops List -->
                            <StackPanel IsVisible="{Binding IsOpsSubTab}">
                                <TextBlock Text="No operators registered in ops.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding OpsList.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,8"/>
                                <ItemsControl ItemsSource="{Binding OpsList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ServerPlayerEntry">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='OP Level {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0"/>
                                                    <Button Grid.Column="2" Classes="dangerBtn" Content="Remove OP" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Whitelist List -->
                            <StackPanel IsVisible="{Binding IsWhitelistSubTab}">
                                <TextBlock Text="No players in whitelist.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding WhitelistList.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,8"/>
                                <ItemsControl ItemsSource="{Binding WhitelistList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ServerPlayerEntry">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="dangerBtn" Content="Remove" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Bans List -->
                            <StackPanel IsVisible="{Binding IsBansSubTab}">
                                <TextBlock Text="No banned players in banned-players.json." FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding BansList.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}" Margin="0,8"/>
                                <ItemsControl ItemsSource="{Binding BansList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ServerPlayerEntry">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource DangerLightBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Classes="dangerBtn" Content="Unban" Command="{Binding $parent[UserControl].((vm:CreateServerViewModel)DataContext).RemovePlayerCommand}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
