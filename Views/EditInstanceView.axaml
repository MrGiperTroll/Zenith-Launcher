<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CustomMcLauncher.ViewModels"
        xmlns:converters="using:CustomMcLauncher.Converters"
        xmlns:controls="using:CustomMcLauncher.Controls"
        xmlns:models="using:CustomMcLauncher.Models"
        xmlns:views="using:CustomMcLauncher.Views"
        xmlns:l10n="using:CustomMcLauncher.Extensions"
        x:Class="CustomMcLauncher.Views.EditInstanceView"
        x:DataType="vm:EditInstanceViewModel"
        Background="{StaticResource BgBrush}">

    <UserControl.Resources>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="Button.chipBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.chipBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.chipBtn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.chipBtn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.worldPlayBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.worldPlayBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.rowDelBtn">
            <Setter Property="Background" Value="{DynamicResource IconChipBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.rowDelBtn PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.rowDelBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
        </Style>
        <Style Selector="Button.rowDelBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>

        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>

        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.dangerBtn">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dangerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style Selector="Button.resetBtn">
            <Setter Property="Background" Value="{StaticResource TabHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.resetBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TabPressedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WarningBrightBrush}"/>
        </Style>

        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sideTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.sideTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- Main: Sidebar + Content -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" Width="210" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="10" IsVisible="{Binding !IsLogExpanded}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">

                        <Button Classes="sideTab" Classes.active="{Binding IsOverviewTab}" Command="{Binding SelectTabCommand}" CommandParameter="Overview">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <PathIcon Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" Width="15" Height="15" Foreground="{Binding IsOverviewTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_overview}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsOverviewTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <Button Classes="sideTab" Classes.active="{Binding IsLogsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Logs">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <PathIcon Data="M20 19V7H4V19H20M20 3C21.1 3 22 3.9 22 5V19C22 20.1 21.1 21 20 21H4C2.9 21 2 20.1 2 19V5C2 3.9 2.9 3 4 3H20M13 13H17V15H13M13 9H17V11H13M13 17H17V19H13M7 13H11V15H7V17M7 9H11V11H7V13Z" Width="15" Height="15" Foreground="{Binding IsLogsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_logs}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsLogsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <StackPanel>
                            <Button Classes="sideTab" Classes.active="{Binding IsModsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Mods" IsVisible="{Binding HasModsSupport}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M20.8 22H3.2C2.54 22 2 21.46 2 20.8V3.2C2 2.54 2.54 2 3.2 2H20.8C21.46 2 22 2.54 22 3.2V20.8C22 21.46 21.46 22 20.8 22ZM7 4H4V17H7V4ZM10 4V20H14V4H10ZM17 4V12H20V4H17Z" Width="15" Height="15" Foreground="{Binding IsModsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_mods}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsModsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsResourcePacksTab}" Command="{Binding SelectTabCommand}" CommandParameter="Resource Packs">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M12 2C6.49 2 2 6.49 2 12c0 4.41 3.59 8 8 8 1.1 0 2-.9 2-2 0-.46-.17-.89-.45-1.22-.28-.33-.45-.76-.45-1.22 0-1.1.9-2 2-2h2.35c3.67 0 6.65-2.98 6.65-6.65C22 5.37 17.51 2 12 2zM6.5 12c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" Width="15" Height="15" Foreground="{Binding IsResourcePacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_resourcepacks}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsResourcePacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsShaderPacksTab}" Command="{Binding SelectTabCommand}" CommandParameter="Shader Packs" IsVisible="{Binding HasShaderSupport}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" Width="15" Height="15" Foreground="{Binding IsShaderPacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_shaders}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsShaderPacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsDataPacksTab}" Command="{Binding SelectTabCommand}" CommandParameter="Data Packs">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M20 3H4C2.89 3 2 3.89 2 5V15C2 16.11 2.89 17 4 17H8V21L12 18H20C21.11 18 22 17.11 22 16V5C22 3.89 21.11 3 20 3M20 14H12L8 18V14H4V5H20V14M14 6H6V8H14V6M18 9H6V11H18V9M18 12H6V14H14V12Z" Width="15" Height="15" Foreground="{Binding IsDataPacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_datapacks}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsDataPacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsWorldsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Worlds">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" Width="15" Height="15" Foreground="{Binding IsWorldsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_worlds}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsWorldsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsServersTab}" Command="{Binding SelectTabCommand}" CommandParameter="Servers">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Width="15" Height="15" Foreground="{Binding IsServersTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_servers}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsServersTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsScreenshotsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Screenshots">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" Width="15" Height="15" Foreground="{Binding IsScreenshotsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_screenshots}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsScreenshotsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsSettingsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Settings">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M19.14 12.94C19.18 12.64 19.2 12.33 19.2 12C19.2 11.68 19.18 11.36 19.13 11.06L21.16 9.5C21.34 9.36 21.39 9.11 21.28 8.9L19.36 5.55C19.24 5.33 18.99 5.25 18.77 5.33L16.38 6.29C15.88 5.9 15.34 5.58 14.76 5.35L14.4 2.81C14.36 2.57 14.16 2.4 13.91 2.4H10.09C9.84 2.4 9.64 2.57 9.6 2.81L9.24 5.35C8.66 5.58 8.12 5.9 7.62 6.29L5.23 5.33C5.01 5.25 4.76 5.33 4.64 5.55L2.72 8.9C2.61 9.11 2.66 9.37 2.84 9.5L4.87 11.06C4.82 11.36 4.8 11.68 4.8 12C4.8 12.32 4.82 12.64 4.87 12.94L2.84 14.5C2.66 14.64 2.61 14.88 2.72 15.1L4.64 18.45C4.76 18.67 5.01 18.75 5.23 18.67L7.62 17.71C8.12 18.1 8.66 18.42 9.24 18.65L9.6 21.19C9.64 21.43 9.84 21.6 10.09 21.6H13.91C14.16 21.6 14.36 21.43 14.4 21.19L14.76 18.65C15.34 18.42 15.88 18.1 16.38 17.71L18.77 18.67C18.99 18.75 19.24 18.67 19.36 18.45L21.28 15.1C21.39 14.89 21.34 14.64 21.16 14.5L19.13 12.94ZM12 15.5C10.1 15.5 8.5 13.9 8.5 12C8.5 10.1 10.1 8.5 12 8.5C13.9 8.5 15.5 10.1 15.5 12C15.5 13.9 13.9 15.5 12 15.5Z" Width="15" Height="15" Foreground="{Binding IsSettingsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content -->
            <Border Grid.Column="1" Background="{StaticResource LogSidebarBrush}">
                <Grid x:Name="TabContentGrid">
                <!-- Overview / Dashboard -->
                <ScrollViewer IsVisible="{Binding IsOverviewTab}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="24,20,24,24">
                                                <!-- Instance Hero Card -->
                        <Border Classes="zenSection">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <!-- Instance Icon (Clickable, no border) -->
                                <Button Command="{Binding ChangeIconCommand}" Cursor="Hand" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTip.Tip="{l10n:Tr Key=mi_change_icon}">
                                    <Border Width="72" Height="72" CornerRadius="16" ClipToBounds="True" Background="{StaticResource ChipBrush}" BorderThickness="0">
                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path IsVisible="{Binding !Instance.HasCustomIcon}"
                                                  Data="{StaticResource ZenithLogoGeometry}"
                                                  Fill="{DynamicResource AccentBrush}"
                                                  Stretch="Uniform"
                                                  Width="42" Height="42"
                                                  Margin="0,3.5,0,0"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image IsVisible="{Binding Instance.HasCustomIcon}"
                                                   Source="{Binding Instance.IconPath, Converter={x:Static converters:IconPathToBitmapConverter.Instance}}"
                                                   Stretch="UniformToFill"
                                                   Width="72" Height="72"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Panel>
                                    </Border>
                                </Button>

                                <!-- Instance Details -->
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center" Spacing="6">
                                    <TextBox Classes="titleInput heroName"
                                             Text="{Binding Instance.Name, Mode=TwoWay}"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                             HorizontalAlignment="Left"
                                             Padding="0" Margin="0"
                                             MinWidth="80" MaxWidth="380"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                             DoubleTapped="OnTitleDoubleTapped"
                          LostFocus="OnInstanceNameLostFocus"
                                             ToolTip.Tip="Double-click to rename"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{StaticResource ChipBrush}" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="{Binding Instance.DisplayVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" IsVisible="{Binding Instance.LoaderType, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}">
                                            <TextBlock Text="{Binding Instance.LoaderType}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Single Clean Open Folder Button next to instance details -->
                                <Button Grid.Column="2" Classes="primaryBtn" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" Content="{l10n:Tr Key=btn_launch}" Padding="18,9" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Classes="subBtn" Command="{Binding OpenInstanceFolderCommand}" Padding="16,9" VerticalAlignment="Center" ToolTip.Tip="{l10n:Tr Key=btn_open_folder}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{l10n:Tr Key=btn_open_folder}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Statistics Section: directly underneath hero card without redundant header -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <!-- Playtime -->
                            <Border Grid.Column="0" Background="Transparent" Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="{l10n:Tr Key=stat_playtime}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Instance.PlaytimeDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Last Played -->
                            <Border Grid.Column="1" Background="Transparent" Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="{l10n:Tr Key=stat_last_played}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="rowTitle" Text="{Binding Instance.LastPlayedDisplay}"/>
                                </StackPanel>
                            </Border>

                            <!-- Created At -->
                            <Border Grid.Column="2" Background="Transparent" Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="{l10n:Tr Key=stat_created}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="rowTitle" Text="{Binding Instance.CreatedAtDisplay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logs (Redesigned matching Modrinth style) -->
                <Grid IsVisible="{Binding IsLogsTab}" RowDefinitions="Auto,Auto,*" Margin="16,14,16,14">
                    <!-- Row 0: Search input & Live Log dropdown -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,10">
                        <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1" CornerRadius="8" Width="280" Height="34" Padding="10,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Classes="titleInput" Text="{Binding LogSearchQuery, Mode=TwoWay}"
                                         PlaceholderText="Search logs" FontSize="12" Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" Padding="0"/>
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="2" Classes="zenCombo" ItemsSource="{Binding LogSources}"
                                  SelectedItem="{Binding SelectedLogSource}" Width="130" Height="34" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 1: Filter chips (All / Error / Warn / Info) + Expand & Copy actions -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" Width="14" Height="14"
                                      Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Classes="chipBtn" Classes.active="{Binding IsFilterAll}" Content="All"
                                    Command="{Binding SelectLogFilterCommand}" CommandParameter="All"/>
                            <Button Classes="chipBtn" Classes.active="{Binding IsFilterError}" Content="Error"
                                    Command="{Binding SelectLogFilterCommand}" CommandParameter="Error"/>
                            <Button Classes="chipBtn" Classes.active="{Binding IsFilterWarn}" Content="Warn"
                                    Command="{Binding SelectLogFilterCommand}" CommandParameter="Warn"/>
                            <Button Classes="chipBtn" Classes.active="{Binding IsFilterInfo}" Content="Info"
                                    Command="{Binding SelectLogFilterCommand}" CommandParameter="Info"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="subBtn" Command="{Binding CopyLogsCommand}" Padding="10,5" FontSize="11" ToolTip.Tip="{l10n:Tr Key=btn_copy_logs}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm3 4H8C6.9 5 6 5.9 6 7v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="12" Height="12"/>
                                    <TextBlock Text="{l10n:Tr Key=btn_copy_logs}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="subBtn" Command="{Binding ToggleLogExpandCommand}" Padding="10,5" FontSize="11">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding LogExpandText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Terminal Area (Clean Monospace Container) -->
                    <Border Grid.Row="2" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="10" ClipToBounds="True" Padding="14,10">
                        <Panel>
                            <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          ScrollChanged="OnLogScrollChanged" IsVisible="{Binding LogHasContent}">
                                <TextBox Text="{Binding FilteredLogText, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="{Binding LogTextWrapping}"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         Foreground="{DynamicResource TextSoftBrush}"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                         MinWidth="600"/>
                            </ScrollViewer>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding !LogHasContent}">
                                <TextBlock Text=" _________________________________________&#10;/ Start your instance in the top right to \&#10;| receive live logs!                      |&#10;\_________________________________________/"
                                           FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Text="    -   -&#10;   (o)--(o)&#10;  /.______.\&#10;  \________/&#10; ./        \&#10;( .        , )&#10; \ \_\\ //_/ /&#10;  ~~  ~~  ~~"
                                           FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Panel>
                    </Border>
                </Grid>

                <!-- Mods -->
                <Grid IsVisible="{Binding IsModsTab}" RowDefinitions="Auto,*" Margin="14,10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="{Binding ModAuditMessage}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="subBtn" Content="{l10n:Tr Key=mods_audit_check}" Command="{Binding AuditModsCommand}" Padding="14,7" FontSize="12"/>
                            <Button Classes="primaryBtn" Content="{l10n:Tr Key=btn_browse_mods}" Command="{Binding OpenContentBrowserCommand}" CommandParameter="Mods" Padding="14,7" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <views:FileListView Grid.Row="1" x:Name="ModView" DataContext="{Binding ModList}"/>
                </Grid>

                <!-- Resource Packs -->
                <Grid IsVisible="{Binding IsResourcePacksTab}" RowDefinitions="Auto,*" Margin="14,10">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Classes="primaryBtn" Content="{l10n:Tr Key=btn_browse_packs}" Command="{Binding OpenContentBrowserCommand}" CommandParameter="Resource Packs" Padding="14,7" FontSize="12"/>
                    </StackPanel>
                    <views:FileListView Grid.Row="1" x:Name="ResourceView" DataContext="{Binding ResourcePackList}"/>
                </Grid>

                <!-- Shader Packs -->
                <Grid IsVisible="{Binding IsShaderPacksTab}" RowDefinitions="Auto,*" Margin="14,10">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Classes="primaryBtn" Content="{l10n:Tr Key=btn_browse_shaders}" Command="{Binding OpenContentBrowserCommand}" CommandParameter="Shader Packs" Padding="14,7" FontSize="12"/>
                    </StackPanel>
                    <views:FileListView Grid.Row="1" x:Name="ShaderView" DataContext="{Binding ShaderList}"/>
                </Grid>

                <!-- Data Packs -->
                <Grid IsVisible="{Binding IsDataPacksTab}" RowDefinitions="Auto,*,Auto" Margin="14,10">
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=btn_browse_datapacks}" Command="{Binding OpenContentBrowserCommand}" CommandParameter="Data Packs" Padding="14,7" FontSize="12" VerticalAlignment="Center" IsEnabled="{Binding AvailableWorlds.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsNonZero}}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{l10n:Tr Key=lbl_world}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" Classes="zenCombo" ItemsSource="{Binding AvailableWorlds}" SelectedItem="{Binding SelectedWorld}" PlaceholderText="{l10n:Tr Key=w_select_world}" FontSize="11" Padding="10,6" MinWidth="200" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Classes="subBtn" Content="{l10n:Tr Key=btn_open_folder}" Command="{Binding OpenDataPackFolderCommand}" Padding="12,6" FontSize="11" VerticalAlignment="Center" IsEnabled="{Binding SelectedWorld, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                        </Grid>
                        <TextBlock Text="{l10n:Tr Key=w_no_worlds}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding AvailableWorlds.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="Transparent" Padding="4">
                        <Grid>
                            <ListBox ItemsSource="{Binding DataPacks}" Background="Transparent" BorderThickness="0" Padding="6">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:InstanceFileEntry">
                                        <Grid ColumnDefinitions="48,*,Auto" MinHeight="52" Margin="4,6,4,6">
                                            <Border Width="40" Height="40" Background="{StaticResource IconChipBrush}" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Panel>
                                                    <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}" Stretch="UniformToFill" Width="40" Height="40" IsVisible="{Binding HasPreview}"/>
                                                    <Path Data="M14 2H6A2 2 0 0 0 4 4V20A2 2 0 0 0 6 22H18A2 2 0 0 0 20 20V6L14 2Z" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPreview}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10" Foreground="{StaticResource TextCaptionBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Command="{Binding $parent[Window].((vm:EditInstanceViewModel)DataContext).OpenDataPackCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="{StaticResource TextPlaceholderBrush}" Padding="4,1" Cursor="Hand" ToolTip.Tip="Open" VerticalAlignment="Center">
                                                    <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="14" Height="14" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                                </Button>
                                                <Button Command="{Binding $parent[Window].((vm:EditInstanceViewModel)DataContext).DeleteDataPackCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="{StaticResource TextPlaceholderBrush}" Padding="4,1" Cursor="Hand" ToolTip.Tip="Delete" VerticalAlignment="Center">
                                                    <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="13" Height="13" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{l10n:Tr Key=w_none}" Foreground="{StaticResource TextPlaceholderBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding DataPacks.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"/>
                            <TextBlock Text="{l10n:Tr Key=w_pick_hint}" Foreground="{StaticResource TextPlaceholderBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding SelectedWorld, Converter={x:Static converters:EditInstanceWindowConverters.IsEmpty}}"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{l10n:Tr Key=w_tip}" FontSize="10" Foreground="{StaticResource TextCaptionBrush}" Margin="2,8,0,0"/>
                </Grid>
                <!-- Worlds (Matches Modrinth/Zenith Clean Card Layout) -->
                <Grid IsVisible="{Binding IsWorldsTab}" RowDefinitions="Auto,*" Margin="14,10">
                    <!-- Top bar: search/count + import button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Panel/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="subBtn" Command="{Binding WorldList.ImportFilesCommand}" FontSize="11" Padding="12,5">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=fl_import}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="subBtn" Command="{Binding WorldList.OpenFolderCommand}" FontSize="11" Padding="12,5">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=btn_open_folder}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Worlds List -->
                    <Border Grid.Row="1" Background="Transparent">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding WorldList.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:InstanceFileEntry">
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Thumbnail -->
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True"
                                                            Background="{DynamicResource IconChipBrush}" VerticalAlignment="Center">
                                                        <Panel>
                                                            <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}"
                                                                   Stretch="UniformToFill" Width="44" Height="44" IsVisible="{Binding HasPreview}"/>
                                                            <PathIcon Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                                                                      Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsVisible="{Binding !HasPreview}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- World Title & Last Played -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="12,0,16,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding RelativeTimeDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>

                                                    <!-- Actions: Green Play Button + 3-dots Menu Button -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <!-- Green Play Button -->
                                                        <Button Classes="worldPlayBtn"
                                                                Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).LaunchWorldCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <PathIcon Data="M8 5v14l11-7z" Width="11" Height="11" Foreground="{DynamicResource OnAccentBrush}"/>
                                                                <TextBlock Text="{l10n:Tr Key=btn_play}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource OnAccentBrush}"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- 3-Dots Button with Flyout -->
                                                        <Button Width="32" Height="32" CornerRadius="16"
                                                                Background="{DynamicResource IconChipBrush}" Padding="0" Cursor="Hand"
                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                            <PathIcon Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                                                                      Width="14" Height="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                    <MenuItem Header="Edit" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).OpenEditWorldDialogCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="13" Height="13"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Open folder" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).OpenWorldFolderCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="13" Height="13"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Create shortcut" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).CreateWorldShortcutCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" Width="13" Height="13"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Delete" Foreground="{DynamicResource DangerBrush}" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).RequestDeleteWorldCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="13" Height="13" Foreground="{DynamicResource DangerBrush}"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{l10n:Tr Key=fl_empty_worlds}" TextWrapping="Wrap" Foreground="{DynamicResource TextPlaceholderBrush}" FontSize="12"
                                       Margin="12,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding WorldList.Entries.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Servers (Unified list with Play, Delete, Add Server) -->
                <Grid IsVisible="{Binding IsServersTab}" RowDefinitions="Auto,*" Margin="14,10">
                    <!-- Top bar: count + Add Server button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Panel/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=sv_add_server}"
                                Command="{Binding OpenAddServerDialogCommand}" FontSize="11" Padding="12,5"/>
                    </Grid>

                    <!-- Servers List -->
                    <Border Grid.Row="1" Background="Transparent">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Servers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:InstanceFileEntry">
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <!-- Server Icon -->
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True"
                                                            Background="{DynamicResource IconChipBrush}" VerticalAlignment="Center">
                                                        <Panel>
                                                            <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}"
                                                                   Stretch="Uniform" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasPreview}"/>
                                                            <Path Data="M4 1H20C21.1 1 22 1.9 22 3V6C22 7.1 21.1 8 20 8H4C2.9 8 2 7.1 2 6V3C2 1.9 2.9 1 4 1ZM4 10H20C21.1 10 22 10.9 22 12V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V12C2 10.9 2.9 10 4 10ZM6 3V6H8V3H6ZM6 12V15H8V12H6Z"
                                                                  Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextPlaceholderBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPreview}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- Server Title, IP, MOTD -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="12,0,16,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding Subtitle, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                                                   IsVisible="{Binding Description, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                    </StackPanel>

                                                    <!-- Player count / Ping -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource TextCaptionBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                                                               IsVisible="{Binding Meta, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>

                                                    <!-- Actions: Play Button + Delete Button -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <!-- Play Button -->
                                                        <Button Classes="worldPlayBtn"
                                                                Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).LaunchServerCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <PathIcon Data="M8 5v14l11-7z" Width="11" Height="11" Foreground="{DynamicResource OnAccentBrush}"/>
                                                                <TextBlock Text="{l10n:Tr Key=btn_play}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource OnAccentBrush}"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Delete Button -->
                                                        <Button Classes="rowDelBtn"
                                                                Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).RequestDeleteServerCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{l10n:Tr Key=btn_delete}">
                                                            <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                                      Width="13" Height="13"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{l10n:Tr Key=sv_nodat}" TextWrapping="Wrap" Foreground="{DynamicResource TextPlaceholderBrush}" FontSize="12"
                                       Margin="12,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Servers.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Screenshots -->
                <Grid IsVisible="{Binding IsScreenshotsTab}" Margin="14,10">
                    <views:FileListView x:Name="ScreenshotView" DataContext="{Binding ScreenshotList}"/>
                </Grid>

                <!-- Settings (Clean utilitarian controls) -->
                <ScrollViewer IsVisible="{Binding IsSettingsTab}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="24,16,24,24">
                                                <controls:RamCardControl Title="{l10n:Tr Key=set_memory}"
                                              Subtitle="{l10n:Tr Key=set_memory_hint}"
                                              Value="{Binding RamMb}"
                                              Minimum="512"
                                              Maximum="{Binding MaxRamMb}"
                                              TickFrequency="512"/>

                        <!-- Resolution & Display Card -->
                        <Border Classes="zenSection">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sectionTitle" Text="{l10n:Tr Key=set_resolution}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="resetBtn" Content="{l10n:Tr Key=btn_reset}" Command="{Binding ResetWindowCommand}" IsVisible="{Binding CanResetWindow}" FontSize="11" Padding="10,4" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{l10n:Tr Key=ei_inherited_generic}" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding IsWindowInherited}"/>
                                <Grid ColumnDefinitions="Auto,70,14,70,14,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="W" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding GameWidth}" FontSize="12" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="26"/>
                                    <TextBlock Grid.Column="2" Text="×" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Classes="darkInput" Text="{Binding GameHeight}" FontSize="12" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="26"/>
                                    <TextBlock Grid.Column="4" Text="H" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Classes="rowTitle" Text="{l10n:Tr Key=set_fullscreen}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsFullscreen}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java Runtime Card -->
                        <Border Classes="zenSection">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sectionTitle" Text="{l10n:Tr Key=set_java}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="resetBtn" Content="{l10n:Tr Key=btn_reset}" Command="{Binding ResetJavaCommand}" IsVisible="{Binding CanResetJava}" FontSize="11" Padding="10,4" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox Classes="darkInput" Text="{Binding JavaDisplayPath, Mode=OneWay}" IsReadOnly="True" FontSize="11" Padding="8,5" ToolTip.Tip="{l10n:Tr Key=custom_java_hint}"/>
                                <TextBlock Text="{l10n:Tr Key=ei_inherited_generic}" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding IsJavaInherited}"/>
                                <ComboBox Classes="zenCombo" ItemsSource="{Binding JavaModes}" SelectedItem="{Binding SelectedJavaMode}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static converters:JavaModeDisplayConverter.Instance}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Classes="darkInput" Text="{Binding CustomJavaPath}" PlaceholderText="{l10n:Tr Key=custom_java_hint}" FontSize="11" Padding="8,5"/>
                                    <Button Grid.Column="1" Classes="subBtn" Content="{l10n:Tr Key=browse}" Command="{Binding PickCustomJavaCommand}" Margin="6,0,0,0" Padding="10,5" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- JVM Arguments Card -->
                        <Border Classes="zenSection">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sectionTitle" Text="{l10n:Tr Key=set_jvmargs}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="resetBtn" Content="{l10n:Tr Key=btn_reset}" Command="{Binding ResetJvmArgsCommand}" IsVisible="{Binding CanResetJvmArgs}" FontSize="11" Padding="10,4" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{l10n:Tr Key=ei_jvm_hint}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                <TextBlock Text="{l10n:Tr Key=ei_inherited_generic}" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}" IsVisible="{Binding IsJvmArgsInherited}"/>
                                <TextBox Classes="darkInput" Text="{Binding JvmArgs}" PlaceholderText="-XX:+UseG1GC ..." Padding="8,6" FontSize="12" AcceptsReturn="True" Height="48" TextWrapping="Wrap"/>
                                <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0" IsVisible="{Binding HasJvmArgsWarning}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{l10n:Tr Key=jvm_warn_title}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                            <TextBlock Text="{Binding JvmArgsWarningMessage}" FontSize="11" Foreground="{StaticResource DangerLightBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="dangerBtn" Content="{l10n:Tr Key=btn_clean_jvm_flags}" Command="{Binding CleanIncompatibleJvmArgsCommand}" FontSize="11" Padding="12,6" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{l10n:Tr Key=ei_autosave_note}" FontSize="11" Foreground="{StaticResource TextCaptionBrush}"/>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom control bar -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDownloading}">
                    <ProgressBar Value="{Binding LaunchProgress}" Height="4" Foreground="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Width="160"/>
                    <TextBlock Text="{Binding DownloadStatus}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                    <TextBlock Text="{Binding Instance.Path}" FontSize="11" Foreground="{StaticResource TextCaptionBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" IsVisible="{Binding IsRunning}" Background="{DynamicResource ChipBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{l10n:Tr Key=status_running}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Classes="primaryBtn" Content="{l10n:Tr Key=btn_launch}" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" Width="110" Height="38" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3" Classes="dangerBtn" Content="{l10n:Tr Key=btn_kill_short}" Command="{Binding KillCommand}" IsEnabled="{Binding IsRunning}" Width="90" Height="38" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="4" Classes="subBtn" Content="{l10n:Tr Key=close}" Command="{Binding CloseCommand}" Width="90" Height="38" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
        <!-- Delete World Confirmation Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000" IsVisible="{Binding IsDeleteWorldConfirmOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="480">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=w_delete_title}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding DeleteWorldPrompt}"
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelDeleteWorldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="dangerBtn" Content="{l10n:Tr Key=btn_delete}"
                                Command="{Binding ConfirmDeleteWorldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Edit World Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000" IsVisible="{Binding IsEditWorldOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="480">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l10n:Tr Key=w_edit_title}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=w_edit_name}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Classes="darkInput" Text="{Binding EditingWorldName, Mode=TwoWay}" FontSize="13" Padding="8,6"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelEditWorldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="primaryBtn" Content="{l10n:Tr Key=btn_save}"
                                Command="{Binding SaveEditWorldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        <!-- Delete Server Confirmation Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000" IsVisible="{Binding IsDeleteServerConfirmOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="480">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=sv_delete_title}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding DeleteServerPrompt}"
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelDeleteServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="dangerBtn" Content="{l10n:Tr Key=btn_delete}"
                                Command="{Binding ConfirmDeleteServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add Server Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000" IsVisible="{Binding IsAddServerOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="480">
                <StackPanel Spacing="16">
                    <TextBlock Text="Add Server" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server Name:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Classes="darkInput" Text="{Binding NewServerName, Mode=TwoWay}" PlaceholderText="Minecraft Server" FontSize="13" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server Address / IP:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Classes="darkInput" Text="{Binding NewServerIp, Mode=TwoWay}" PlaceholderText="mc.example.com" FontSize="13" Padding="8,6"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelAddServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="primaryBtn" Content="Add"
                                Command="{Binding SaveAddServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        <!-- Mod Conflicts Resolution Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000" IsVisible="{Binding IsConflictDialogOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="480" MaxWidth="640" MaxHeight="520">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Mod Conflicts Detected" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Multiple versions or conflicting copies of the same mod were found. Delete obsolete versions to prevent crashes."
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding DuplicateConflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DuplicateConflictGroup">
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ModId}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description, StringFormat='({0})'}" FontSize="11" Foreground="{DynamicResource WarningBrush}"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DuplicateModFileItem">
                                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding ModifiedDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Classes="dangerBtn" Content="Delete" FontSize="11" Padding="10,4"
                                                                        Command="{Binding DeleteCommand}" Cursor="Hand"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Classes="subBtn" Content="{l10n:Tr Key=close}"
                            Command="{Binding CloseConflictDialogCommand}" HorizontalAlignment="Right" Padding="16,6"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

