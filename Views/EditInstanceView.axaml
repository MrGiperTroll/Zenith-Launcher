<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZenithLauncher.ViewModels"
        xmlns:converters="using:ZenithLauncher.Converters"
        xmlns:controls="using:ZenithLauncher.Controls"
        xmlns:models="using:ZenithLauncher.Models"
        xmlns:views="using:ZenithLauncher.Views"
        xmlns:l10n="using:ZenithLauncher.Extensions"
        xmlns:anim="using:ZenithLauncher.UI.Animations"
        x:Class="ZenithLauncher.Views.EditInstanceView"
        x:DataType="vm:EditInstanceViewModel"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True">

    <UserControl.Resources>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.chipBtn">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.chipBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.chipBtn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.chipBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Button.chipBtn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.worldPlayBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.worldPlayBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.rowDelBtn">
            <Setter Property="Background" Value="{DynamicResource IconChipBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.rowDelBtn PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.rowDelBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
        </Style>
        <Style Selector="Button.rowDelBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style Selector="Border.eiRowCard">
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.eiRowCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
        </Style>

        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sideTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.sideTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>

        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- Main: Sidebar + Content -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" Width="210" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="10" IsVisible="{Binding !IsLogExpanded}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">

                        <Button Classes="sideTab" Classes.active="{Binding IsOverviewTab}" Command="{Binding SelectTabCommand}" CommandParameter="Overview">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <PathIcon Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Width="15" Height="15" Foreground="{Binding IsOverviewTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_overview}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsOverviewTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <Button Classes="sideTab" Classes.active="{Binding IsLogsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Logs">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <PathIcon Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v10zm-12-7l3 3-3 3-1.4-1.4L8.2 13l-1.6-1.6L8 11zm5 5h5v2h-5v-2z" Width="15" Height="15" Foreground="{Binding IsLogsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_logs}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsLogsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <StackPanel>
                            <Button Classes="sideTab" Classes.active="{Binding IsModsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Mods" IsVisible="{Binding HasModsSupport}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M19.0,10.2 H17.5 V7.2 C17.5,6.1 16.6,5.2 15.5,5.2 H12.5 V4.5 A2.5,2.5 0 0,0 7.5,4.5 V5.2 H4.5 C3.4,5.2 2.5,6.1 2.5,7.2 V10.5 H3.2 A2.5,2.5 0 0,1 3.2,15.5 H2.5 V18.8 C2.5,19.9 3.4,20.8 4.5,20.8 H7.5 V20.1 A2.5,2.5 0 0,1 12.5,20.1 V20.8 H15.5 C16.6,20.8 17.5,19.9 17.5,18.8 V15.2 H19.0 A2.5,2.5 0 0,0 19.0,10.2 Z" Width="16" Height="16" Foreground="{Binding IsModsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_mods}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsModsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsResourcePacksTab}" Command="{Binding SelectTabCommand}" CommandParameter="Resource Packs">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5.04-6.71l-2.75 3.54-1.96-2.36L6.5 17h11l-3.54-4.71zM9 9a2 2 0 1 1-4 0 2 2 0 0 1 4 0z" Width="15" Height="15" Foreground="{Binding IsResourcePacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_resourcepacks}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsResourcePacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsShaderPacksTab}" Command="{Binding SelectTabCommand}" CommandParameter="Shader Packs" IsVisible="{Binding HasShaderSupport}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M10.5 2L12.2 7.7 18 9.5 12.2 11.3 10.5 17 8.8 11.3 3 9.5 8.8 7.7 10.5 2zm7.5 10l1 3.2 3.2 1-3.2 1-1 3.2-1-3.2-3.2-1 3.2-1 1-3.2z" Width="15" Height="15" Foreground="{Binding IsShaderPacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_shaders}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsShaderPacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsDataPacksTab}" Command="{Binding SelectTabCommand}" CommandParameter="Data Packs">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-2 10H6v-2h12v2zm0-4H6v-2h12v2z" Width="15" Height="15" Foreground="{Binding IsDataPacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_datapacks}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsDataPacksTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsWorldsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Worlds">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2zm6.93 6h-3.3a14.7 14.7 0 0 0-1.63-4.32A8.04 8.04 0 0 1 18.93 8zM12 4.07c.88 1.07 1.6 2.58 2.04 3.93H9.96c.44-1.35 1.16-2.86 2.04-3.93zM4.26 14A8.03 8.03 0 0 1 4 12c0-.69.09-1.36.26-2h3.9c-.11.65-.16 1.32-.16 2 0 .68.05 1.35.16 2zm.81 2h3.3c.4 1.63 1 3.12 1.63 4.32A8.04 8.04 0 0 1 5.07 16zm3.3-8H5.07a8.04 8.04 0 0 1 4.93-4.32A14.7 14.7 0 0 0 8.37 8zm3.63 11.93c-.88-1.07-1.6-2.58-2.04-3.93h4.08c-.44 1.35-1.16 2.86-2.04 3.93zM10.04 14c-.13-.65-.2-1.31-.2-2 0-.69.07-1.35.2-2h3.92c.13.65.2 1.31.2 2 0 .69-.07 1.35-.2 2zm4.33 6.32c.63-1.2 1.23-2.69 1.63-4.32h3.3a8.04 8.04 0 0 1-4.93 4.32zM15.84 14c.11-.65.16-1.32.16-2 0-.68-.05-1.35-.16-2h3.9c.17.64.26 1.31.26 2 0 .69-.09 1.36-.26 2z" Width="15" Height="15" Foreground="{Binding IsWorldsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_worlds}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsWorldsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsServersTab}" Command="{Binding SelectTabCommand}" CommandParameter="Servers">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M4 4h16a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm2 3a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm4 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm-6 6h16a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2zm2 3a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm4 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" Width="15" Height="15" Foreground="{Binding IsServersTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_servers}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsServersTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsScreenshotsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Screenshots">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" Width="15" Height="15" Foreground="{Binding IsScreenshotsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_screenshots}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsScreenshotsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                            <Button Classes="sideTab" Classes.active="{Binding IsSettingsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Settings">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                        <PathIcon Data="M19.14 12.94C19.18 12.64 19.2 12.33 19.2 12C19.2 11.68 19.18 11.36 19.13 11.06L21.16 9.5C21.34 9.36 21.39 9.11 21.28 8.9L19.36 5.55C19.24 5.33 18.99 5.25 18.77 5.33L16.38 6.29C15.88 5.9 15.34 5.58 14.76 5.35L14.4 2.81C14.36 2.57 14.16 2.4 13.91 2.4H10.09C9.84 2.4 9.64 2.57 9.6 2.81L9.24 5.35C8.66 5.58 8.12 5.9 7.62 6.29L5.23 5.33C5.01 5.25 4.76 5.33 4.64 5.55L2.72 8.9C2.61 9.11 2.66 9.37 2.84 9.5L4.87 11.06C4.82 11.36 4.8 11.68 4.8 12C4.8 12.32 4.82 12.64 4.87 12.94L2.84 14.5C2.66 14.64 2.61 14.88 2.72 15.1L4.64 18.45C4.76 18.67 5.01 18.75 5.23 18.67L7.62 17.71C8.12 18.1 8.66 18.42 9.24 18.65L9.6 21.19C9.64 21.43 9.84 21.6 10.09 21.6H13.91C14.16 21.6 14.36 21.43 14.4 21.19L14.76 18.65C15.34 18.42 15.88 18.1 16.38 17.71L18.77 18.67C18.99 18.75 19.24 18.67 19.36 18.45L21.28 15.1C21.39 14.89 21.34 14.64 21.16 14.5L19.13 12.94ZM12 15.5C10.1 15.5 8.5 13.9 8.5 12C8.5 10.1 10.1 8.5 12 8.5C13.9 8.5 15.5 10.1 15.5 12C15.5 13.9 13.9 15.5 12 15.5Z" Width="15" Height="15" Foreground="{Binding IsSettingsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{l10n:Tr Key=tab_settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTab, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content -->
            <Border Grid.Column="1" Background="{DynamicResource LogSidebarBrush}" ClipToBounds="True">
                <Grid x:Name="TabContentGrid" ClipToBounds="True">
                <!-- Overview / Dashboard -->
                <ScrollViewer x:Name="OverviewScroll" IsVisible="{Binding IsOverviewTab}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="14,10,14,24">
                                                <!-- Instance Hero Card -->
                        <Border Classes="zenSection">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <!-- Instance Icon (Clickable, no border) -->
                                <Button Command="{Binding ChangeIconCommand}" Cursor="Hand" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTip.Tip="{l10n:Tr Key=mi_change_icon}">
                                    <Border Width="72" Height="72" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource ChipBrush}" BorderThickness="0">
                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path IsVisible="{Binding !Instance.HasCustomIcon}"
                                                  Data="{StaticResource ZenithLogoGeometry}"
                                                  Fill="{DynamicResource AccentBrush}"
                                                  Stretch="Uniform"
                                                  Width="42" Height="42"
                                                  Margin="0,3.5,0,0"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image IsVisible="{Binding Instance.HasCustomIcon}"
                                                   Source="{Binding Instance.IconPath, Converter={x:Static converters:IconPathToBitmapConverter.Instance}}"
                                                   Stretch="UniformToFill"
                                                   Width="72" Height="72"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Panel>
                                    </Border>
                                </Button>

                                <!-- Instance Details -->
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center" Spacing="6">
                                    <TextBox Classes="titleInput heroName"
                                             Text="{Binding Instance.Name, Mode=TwoWay}"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                             HorizontalAlignment="Left"
                                             Padding="0" Margin="0"
                                             MinWidth="80" MaxWidth="380"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                             DoubleTapped="OnTitleDoubleTapped"
                          LostFocus="OnInstanceNameLostFocus"
                                             ToolTip.Tip="Double-click to rename"/>
                                    <TextBlock Text="{Binding Instance.DisplayVersion}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Single Clean Open Folder Button next to instance details -->
                                <Button Grid.Column="2" Classes="primaryBtn" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" Content="{l10n:Tr Key=btn_launch}" Height="34" Padding="16,0" FontSize="12.5" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Classes="subBtn" Command="{Binding OpenInstanceFolderCommand}" Content="{l10n:Tr Key=btn_open_folder}" Height="34" Padding="14,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="{l10n:Tr Key=btn_open_folder}"/>
                            </Grid>
                        </Border>

                        <!-- Statistics Section: directly underneath hero card without redundant header -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <!-- Playtime -->
                            <Border Grid.Column="0" Background="Transparent" Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="{l10n:Tr Key=stat_playtime}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Instance.PlaytimeDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Last Played -->
                            <Border Grid.Column="1" Background="Transparent" Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="{l10n:Tr Key=stat_last_played}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="rowTitle" Text="{Binding Instance.LastPlayedDisplay}"/>
                                </StackPanel>
                            </Border>

                            <!-- Created At -->
                            <Border Grid.Column="2" Background="Transparent" Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="{l10n:Tr Key=stat_created}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="rowTitle" Text="{Binding Instance.CreatedAtDisplay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logs (Unified Catalog Toolbar & Terminal Area) -->
                <Grid IsVisible="{Binding IsLogsTab}" RowDefinitions="Auto,Auto,*" Margin="16">
                    <!-- Row 0: Search input & Log source Flyout dropdown -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBox Grid.Column="0" Classes="darkInput" Text="{Binding LogSearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Search logs..." FontSize="12" Height="36"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Width="13" Height="13" Foreground="{DynamicResource TextPlaceholderBrush}" Margin="10,0,2,0"/>
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <Button Command="{Binding ClearLogSearchCommand}"
                                        IsVisible="{Binding LogSearchQuery, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"
                                        Background="Transparent" BorderThickness="0" Padding="8,0" Cursor="Hand" Content="✕"
                                        Foreground="{DynamicResource TextPlaceholderBrush}"/>
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <Button Grid.Column="1" x:Name="LogSourceDropdownBtn" Classes="filterDropdownBtn" MinWidth="136" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedLogSource}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <PathIcon Grid.Column="1" Data="M7 10l5 5 5-5z" Width="10" Height="10"
                                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
                                    <Flyout.FlyoutPresenterTheme>
                                        <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                            <Setter Property="ClipToBounds" Value="True"/>
                                        </ControlTheme>
                                    </Flyout.FlyoutPresenterTheme>
                                    <Border Width="155" Background="{DynamicResource CardBrush}" Padding="2">
                                        <ItemsControl ItemsSource="{Binding LogSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Classes="flyoutOptionBtn" Click="OnLogSourceOptionClicked"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                        <Classes.selected>
                                                            <MultiBinding Converter="{x:Static converters:EditInstanceWindowConverters.AreStringsEqual}">
                                                                <Binding/>
                                                                <Binding Path="$parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).SelectedLogSource"/>
                                                            </MultiBinding>
                                                        </Classes.selected>
                                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- Row 1: Filter chips (All / Error / Warn / Info) + Expand & Copy actions -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" Width="14" Height="14"
                                      Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Classes="chipBtn" Classes.active="{Binding IsFilterAll}" Content="All"
                                    Command="{Binding SelectLogFilterCommand}" CommandParameter="All"/>
                            <Button Classes="chipBtn" Classes.active="{Binding IsFilterError}" Content="Error"
                                    Command="{Binding SelectLogFilterCommand}" CommandParameter="Error"/>
                            <Button Classes="chipBtn" Classes.active="{Binding IsFilterWarn}" Content="Warn"
                                    Command="{Binding SelectLogFilterCommand}" CommandParameter="Warn"/>
                            <Button Classes="chipBtn" Classes.active="{Binding IsFilterInfo}" Content="Info"
                                    Command="{Binding SelectLogFilterCommand}" CommandParameter="Info"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="subBtn" Command="{Binding OpenLogFileCommand}" Content="{l10n:Tr Key=fl_open}" Height="32" Padding="12,0" FontSize="12" FontWeight="SemiBold"/>
                            <Button Classes="subBtn" Command="{Binding CopyLogsCommand}" Content="{l10n:Tr Key=btn_copy_logs}" Height="32" Padding="12,0" FontSize="12" FontWeight="SemiBold" ToolTip.Tip="{l10n:Tr Key=btn_copy_logs}"/>
                            <Button Classes="subBtn" Command="{Binding ToggleLogExpandCommand}" Content="{Binding LogExpandText}" Height="32" Padding="12,0" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Terminal Area (Clean Monospace Container) -->
                    <Border Grid.Row="2" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="10" ClipToBounds="True" Padding="14,10">
                        <Panel>
                            <TextBox x:Name="LogTextBox" Text="{Binding FilteredLogText, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     TextWrapping="{Binding LogTextWrapping}"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource TextSoftBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                     IsVisible="{Binding LogHasContent}"/>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !LogHasContent}">
                                <TextBlock Text="{l10n:Tr Key=logs_empty_hint}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Panel>
                    </Border>
                </Grid>

                <!-- Mods -->
                <Grid IsVisible="{Binding IsModsTab}" Margin="16">
                    <views:FileListView x:Name="ModView" DataContext="{Binding ModList}"/>
                </Grid>

                <!-- Resource Packs -->
                <Grid IsVisible="{Binding IsResourcePacksTab}" Margin="16">
                    <views:FileListView x:Name="ResourceView" DataContext="{Binding ResourcePackList}"/>
                </Grid>

                <!-- Shader Packs -->
                <Grid IsVisible="{Binding IsShaderPacksTab}" Margin="16">
                    <views:FileListView x:Name="ShaderView" DataContext="{Binding ShaderList}"/>
                </Grid>

                <!-- Data Packs -->
                <Grid IsVisible="{Binding IsDataPacksTab}" RowDefinitions="Auto,*,Auto" Margin="16">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Button Grid.Column="0" x:Name="DataPackWorldDropdownBtn" Classes="filterDropdownBtn" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="{DynamicResource IconChipBrush}" ClipToBounds="True" VerticalAlignment="Center">
                                    <Panel>
                                        <Image Source="{Binding SelectedWorldEntry.PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}"
                                               Stretch="UniformToFill" Width="22" Height="22"
                                               IsVisible="{Binding SelectedWorldEntry.HasPreview, FallbackValue=False}"/>
                                        <PathIcon Data="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                                  Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                  IsVisible="{Binding !SelectedWorldEntry.HasPreview, FallbackValue=True}"/>
                                    </Panel>
                                </Border>
                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedWorldEntry.Title, FallbackValue=''}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding SelectedWorldEntry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <TextBlock Text="{l10n:Tr Key=w_select_world}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding SelectedWorldEntry, Converter={x:Static ObjectConverters.IsNull}}"/>
                                </Panel>
                                <PathIcon Grid.Column="2" Data="M7 10l5 5 5-5z" Width="10" Height="10"
                                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
                                    <Flyout.FlyoutPresenterTheme>
                                        <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                            <Setter Property="ClipToBounds" Value="True"/>
                                        </ControlTheme>
                                    </Flyout.FlyoutPresenterTheme>
                                    <Border Width="340" MaxHeight="320" Background="{DynamicResource CardBrush}" Padding="4">
                                        <Panel>
                                            <TextBlock Text="{l10n:Tr Key=w_no_worlds}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="14,16"
                                                       IsVisible="{Binding HasNoWorlds}"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !HasNoWorlds}">
                                                <ItemsControl ItemsSource="{Binding AvailableWorldEntries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:InstanceFileEntry">
                                                            <Button Classes="flyoutOptionBtn" Click="OnDataPackWorldOptionClicked"
                                                                    Padding="8,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                <Classes.selected>
                                                                    <MultiBinding Converter="{x:Static converters:EditInstanceWindowConverters.AreStringsEqual}">
                                                                        <Binding Path="Name"/>
                                                                        <Binding Path="$parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).SelectedWorld"/>
                                                                    </MultiBinding>
                                                                </Classes.selected>
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource IconChipBrush}">
                                                                        <Panel>
                                                                            <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}"
                                                                                   Stretch="UniformToFill" Width="36" Height="36" IsVisible="{Binding HasPreview}"/>
                                                                            <PathIcon Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                                                                                      Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      IsVisible="{Binding !HasPreview}"/>
                                                                        </Panel>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="{Binding RelativeTimeDisplay}" FontSize="10.5" Opacity="0.75"/>
                                                                            <TextBlock Text="{Binding Meta}" FontSize="10.5" Opacity="0.75"
                                                                                       IsVisible="{Binding Meta, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Panel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Classes="subBtn" Content="{l10n:Tr Key=btn_open_folder}" Command="{Binding OpenDataPackFolderCommand}" Height="32" Padding="12,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" IsEnabled="{Binding SelectedWorld, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                            <Button Classes="primaryBtn" Content="{l10n:Tr Key=btn_browse_datapacks}" Command="{Binding OpenContentBrowserCommand}" CommandParameter="Data Packs" Height="32" Padding="14,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" IsEnabled="{Binding AvailableWorldEntries.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsNonZero}}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="Transparent" Padding="0">
                        <Grid>
                            <ListBox x:Name="DataPacksList" ItemsSource="{Binding DataPacks}" Background="Transparent" BorderThickness="0" Padding="0,0,4,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     IsVisible="{Binding HasDataPacks}">
                                <ListBox.ItemContainerTheme>
                                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </ControlTheme>
                                </ListBox.ItemContainerTheme>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:InstanceFileEntry">
                                        <Border Classes="eiRowCard">
                                            <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="8">
                                                <Border Width="44" Height="44" Background="{DynamicResource IconChipBrush}" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Panel>
                                                        <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}" Stretch="UniformToFill" Width="44" Height="44" IsVisible="{Binding HasPreview}"/>
                                                        <Path Data="M14 2H6A2 2 0 0 0 4 4V20A2 2 0 0 0 6 22H18A2 2 0 0 0 20 20V6L14 2Z" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextPlaceholderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPreview}"/>
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10.5" Foreground="{DynamicResource TextCaptionBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Classes="rowActionBtn" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).OpenDataPackCommand}" CommandParameter="{Binding}" ToolTip.Tip="{l10n:Tr Key=fl_reveal_tip}" VerticalAlignment="Center">
                                                        <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Classes="rowDelBtn" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).DeleteDataPackCommand}" CommandParameter="{Binding}" ToolTip.Tip="{l10n:Tr Key=fl_delete}" VerticalAlignment="Center">
                                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="13" Height="13"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{l10n:Tr Key=w_no_worlds}" Foreground="{DynamicResource TextPlaceholderBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoWorlds}"/>
                            <TextBlock Text="{l10n:Tr Key=w_pick_hint}" Foreground="{DynamicResource TextPlaceholderBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoSelectedWorld}"/>
                            <TextBlock Text="{l10n:Tr Key=w_none}" Foreground="{DynamicResource TextPlaceholderBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasEmptyDataPacks}"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{l10n:Tr Key=w_tip}" FontSize="11" Foreground="{DynamicResource TextCaptionBrush}" Margin="2,8,0,0"/>
                </Grid>
                <!-- Worlds (Matches Catalog & FileListView Clean Card Layout) -->
                <Grid IsVisible="{Binding IsWorldsTab}" RowDefinitions="Auto,*" Margin="16">
                    <!-- Top bar: search/count + import button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                        <TextBox Grid.Column="0" Classes="darkInput" Text="{Binding WorldList.SearchQuery}"
                                 PlaceholderText="{l10n:Tr Key=ph_search}" FontSize="12" Height="36"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Width="13" Height="13" Foreground="{DynamicResource TextPlaceholderBrush}" Margin="10,0,2,0"/>
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <Button Command="{Binding WorldList.ClearSearchCommand}"
                                        IsVisible="{Binding WorldList.SearchQuery, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"
                                        Background="Transparent" BorderThickness="0" Padding="8,0" Cursor="Hand" Content="✕"
                                        Foreground="{DynamicResource TextPlaceholderBrush}"/>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="subBtn" Command="{Binding WorldList.OpenFolderCommand}"
                                    Content="{l10n:Tr Key=btn_open_folder}" FontSize="12" FontWeight="SemiBold" Height="32" Padding="12,0" VerticalAlignment="Center"/>
                            <Button Classes="primaryBtn" Command="{Binding WorldList.ImportFilesCommand}"
                                    Content="{l10n:Tr Key=fl_import}" FontSize="12" FontWeight="Bold" Height="32" Padding="14,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Worlds List -->
                    <Border Grid.Row="1" Background="Transparent">
                        <Grid>
                            <ListBox x:Name="WorldsList" Classes="plainVirtualList" ItemsSource="{Binding WorldList.Entries}" Padding="0,0,4,0" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:InstanceFileEntry">
                                            <Border Classes="eiRowCard">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Thumbnail -->
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True"
                                                            Background="{DynamicResource IconChipBrush}" VerticalAlignment="Center">
                                                        <Panel>
                                                            <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}"
                                                                   Stretch="UniformToFill" Width="44" Height="44" IsVisible="{Binding HasPreview}"/>
                                                            <PathIcon Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                                                                      Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsVisible="{Binding !HasPreview}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- World Title & Last Played -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="12,0,16,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding RelativeTimeDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>

                                                    <!-- Actions: Play Button + 3-dots Menu Button -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <!-- Play Button -->
                                                        <Button Classes="worldPlayBtn"
                                                                Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).LaunchWorldCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{l10n:Tr Key=btn_play}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OnAccentBrush}"/>
                                                        </Button>

                                                        <!-- 3-Dots Button with Flyout -->
                                                        <Button Classes="rowActionBtn">
                                                            <PathIcon Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                                                                      Width="14" Height="14"/>
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                    <MenuItem Header="Edit" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).OpenEditWorldDialogCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="13" Height="13"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Open folder" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).OpenWorldFolderCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="13" Height="13"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Create shortcut" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).CreateWorldShortcutCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" Width="13" Height="13"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Delete" Foreground="{DynamicResource DangerBrush}" Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).RequestDeleteWorldCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="13" Height="13" Foreground="{DynamicResource DangerBrush}"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{l10n:Tr Key=fl_empty_worlds}" TextWrapping="Wrap" Foreground="{DynamicResource TextPlaceholderBrush}" FontSize="12"
                                       Margin="12,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding WorldList.Entries.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Servers (Unified list with Play, Delete, Add Server) -->
                <Grid IsVisible="{Binding IsServersTab}" RowDefinitions="Auto,*" Margin="16">
                    <!-- Top bar: count + Add Server button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Panel/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=sv_add_server}"
                                Command="{Binding OpenAddServerDialogCommand}" FontSize="12" FontWeight="Bold" Height="32" Padding="14,0"/>
                    </Grid>

                    <!-- Servers List -->
                    <Border Grid.Row="1" Background="Transparent">
                        <Grid>
                            <ListBox x:Name="ServersList" Classes="plainVirtualList" ItemsSource="{Binding Servers}" Padding="0,0,4,0" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:InstanceFileEntry">
                                            <Border Classes="eiRowCard">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <!-- Server Icon -->
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True"
                                                            Background="{DynamicResource IconChipBrush}" VerticalAlignment="Center">
                                                        <Panel>
                                                            <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}"
                                                                   Stretch="Uniform" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasPreview}"/>
                                                            <Path Data="M4 1H20C21.1 1 22 1.9 22 3V6C22 7.1 21.1 8 20 8H4C2.9 8 2 7.1 2 6V3C2 1.9 2.9 1 4 1ZM4 10H20C21.1 10 22 10.9 22 12V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V12C2 10.9 2.9 10 4 10ZM6 3V6H8V3H6ZM6 12V15H8V12H6Z"
                                                                  Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextPlaceholderBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPreview}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- Server Title, IP, MOTD -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="12,0,16,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding Subtitle, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                                                   IsVisible="{Binding Description, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                    </StackPanel>

                                                    <!-- Player count / Ping -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource TextCaptionBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                                                               IsVisible="{Binding Meta, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>

                                                    <!-- Actions: Play Button + Delete Button -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <!-- Play Button -->
                                                        <Button Classes="worldPlayBtn"
                                                                Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).LaunchServerCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{l10n:Tr Key=btn_play}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OnAccentBrush}"/>
                                                        </Button>

                                                        <!-- Delete Button -->
                                                        <Button Classes="rowDelBtn"
                                                                Command="{Binding $parent[views:EditInstanceView].((vm:EditInstanceViewModel)DataContext).RequestDeleteServerCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{l10n:Tr Key=btn_delete}">
                                                            <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                                      Width="13" Height="13"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{l10n:Tr Key=sv_nodat}" TextWrapping="Wrap" Foreground="{DynamicResource TextPlaceholderBrush}" FontSize="12"
                                       Margin="12,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Servers.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Screenshots -->
                <Grid IsVisible="{Binding IsScreenshotsTab}" Margin="16">
                    <views:FileListView x:Name="ScreenshotView" DataContext="{Binding ScreenshotList}"/>
                </Grid>

                <!-- Settings (Clean utilitarian controls) -->
                <ScrollViewer x:Name="SettingsScroll" IsVisible="{Binding IsSettingsTab}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="24,16,24,24">
                                                <controls:RamCardControl Title="{l10n:Tr Key=set_memory}"
                                              Subtitle="{l10n:Tr Key=set_memory_hint}"
                                              Value="{Binding RamMb}"
                                              Minimum="512"
                                              Maximum="{Binding MaxRamMb}"
                                              TickFrequency="512"/>

                        <!-- Resolution & Display Card -->
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{l10n:Tr Key=set_resolution}"/>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Text="{l10n:Tr Key=set_window_resolution_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{l10n:Tr Key=set_resolution}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{l10n:Tr Key=set_resolution_hint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,72,14,72,14,Auto" VerticalAlignment="Center">
                                        <TextBlock Text="W" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding GameWidth}" FontSize="12" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="32"/>
                                        <TextBlock Grid.Column="2" Text="×" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox Grid.Column="3" Classes="darkInput" Text="{Binding GameHeight}" FontSize="12" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="32"/>
                                        <TextBlock Grid.Column="4" Text="H" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{l10n:Tr Key=set_fullscreen}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{l10n:Tr Key=set_fullscreen_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsFullscreen}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java Runtime Card -->
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding JavaCardTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                    <TextBox Grid.Column="0" Classes="darkInput" Text="{Binding CustomJavaPath, Mode=TwoWay}" PlaceholderText="{Binding JavaPlaceholderPath}" FontSize="12" Height="34"/>
                                    <Button Grid.Column="1" Classes="subBtn" Content="{l10n:Tr Key=btn_browse}" Command="{Binding PickCustomJavaCommand}" Padding="14,0" Height="34" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- JVM Arguments Card -->
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{l10n:Tr Key=set_jvmargs}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{l10n:Tr Key=set_jvmargs_hint}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="subBtn" Content="{l10n:Tr Key=btn_reset}" Command="{Binding ResetJvmArgsCommand}" IsVisible="{Binding CanResetJvmArgs}" FontSize="12" FontWeight="SemiBold" Height="32" Padding="12,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox Classes="darkInput" Text="{Binding JvmArgs}" PlaceholderText="-XX:+UseG1GC ..." Padding="10,6" FontSize="12" Height="34"/>
                                <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" IsVisible="{Binding HasJvmArgsWarning}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{l10n:Tr Key=jvm_warn_title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                            <TextBlock Text="{Binding JvmArgsWarningMessage}" FontSize="11" Foreground="{DynamicResource DangerLightBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="dangerBtn" Content="{l10n:Tr Key=btn_clean_jvm_flags}" Command="{Binding CleanIncompatibleJvmArgsCommand}" FontSize="12" FontWeight="SemiBold" Height="32" Padding="12,0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom control bar -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDownloading}">
                    <ProgressBar Value="{Binding LaunchProgress}" Height="4" Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Width="160"/>
                    <TextBlock Text="{Binding DownloadStatus}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                    <TextBlock Text="{Binding Instance.Path}" FontSize="11" Foreground="{DynamicResource TextCaptionBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" IsVisible="{Binding IsRunning}" Background="{DynamicResource ChipBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="{l10n:Tr Key=status_running}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Classes="primaryBtn" Content="{l10n:Tr Key=btn_launch}" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" MinWidth="104" Height="34" Padding="16,0" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3" Classes="dangerBtn" Content="{l10n:Tr Key=btn_kill_short}" Command="{Binding KillCommand}" IsEnabled="{Binding IsRunning}" MinWidth="88" Height="34" Padding="14,0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="4" Classes="subBtn" Content="{l10n:Tr Key=close}" Command="{Binding CloseCommand}" MinWidth="88" Height="34" Padding="14,0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
        <!-- Delete World Confirmation Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" IsVisible="False" anim:ZenithMotion.ModalOpen="{Binding IsDeleteWorldConfirmOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="480">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=w_delete_title}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding DeleteWorldPrompt}"
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelDeleteWorldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="dangerBtn" Content="{l10n:Tr Key=btn_delete}"
                                Command="{Binding ConfirmDeleteWorldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Edit World Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" IsVisible="False" anim:ZenithMotion.ModalOpen="{Binding IsEditWorldOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="480">
                <StackPanel Spacing="16">
                    <TextBlock Text="{l10n:Tr Key=w_edit_title}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=w_edit_name}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Classes="darkInput" Text="{Binding EditingWorldName, Mode=TwoWay}" FontSize="13" Padding="8,6"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelEditWorldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="primaryBtn" Content="{l10n:Tr Key=btn_save}"
                                Command="{Binding SaveEditWorldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        <!-- Delete Server Confirmation Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" IsVisible="False" anim:ZenithMotion.ModalOpen="{Binding IsDeleteServerConfirmOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="480">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=sv_delete_title}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding DeleteServerPrompt}"
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelDeleteServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="dangerBtn" Content="{l10n:Tr Key=btn_delete}"
                                Command="{Binding ConfirmDeleteServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add Server Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" IsVisible="False" anim:ZenithMotion.ModalOpen="{Binding IsAddServerOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="480">
                <StackPanel Spacing="16">
                    <TextBlock Text="Add Server" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server Name:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Classes="darkInput" Text="{Binding NewServerName, Mode=TwoWay}" PlaceholderText="Minecraft Server" FontSize="13" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server Address / IP:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Classes="darkInput" Text="{Binding NewServerIp, Mode=TwoWay}" PlaceholderText="mc.example.com" FontSize="13" Padding="8,6"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelAddServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="primaryBtn" Content="Add"
                                Command="{Binding SaveAddServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        <!-- Mod Conflicts Resolution Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" IsVisible="False" anim:ZenithMotion.ModalOpen="{Binding IsConflictDialogOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="110">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="480" MaxWidth="640" MaxHeight="520">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Mod Conflicts Detected" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Multiple versions or conflicting copies of the same mod were found. Delete obsolete versions to prevent crashes."
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <ScrollViewer x:Name="ConflictListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding DuplicateConflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DuplicateConflictGroup">
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ModId}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description, StringFormat='({0})'}" FontSize="11" Foreground="{DynamicResource WarningBrush}"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DuplicateModFileItem">
                                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding ModifiedDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Classes="dangerBtn" Content="Delete" FontSize="11" Padding="10,4"
                                                                        Command="{Binding DeleteCommand}" Cursor="Hand"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Classes="subBtn" Content="{l10n:Tr Key=close}"
                            Command="{Binding CloseConflictDialogCommand}" HorizontalAlignment="Right" Padding="16,6"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

