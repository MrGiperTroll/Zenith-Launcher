<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:items="using:CustomMcLauncher.ViewModels.Items"
             xmlns:views="using:CustomMcLauncher.Views"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             x:Class="CustomMcLauncher.Views.Experimental.ExperimentalDiscoverView"
             x:DataType="vm:ModpacksBrowserViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Filter row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" IsVisible="{Binding !IsDetailsOpen}">
            <TextBox Classes="darkInput" Width="220" Text="{Binding SearchQuery}" FontSize="12" VerticalAlignment="Center" PlaceholderText="{l10n:Tr Key=mp_search_hint}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>
            <ComboBox MinWidth="110" ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}" FontSize="11" VerticalAlignment="Center"/>
            <ComboBox MinWidth="120" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" FontSize="11" VerticalAlignment="Center"/>
            <ComboBox MinWidth="110" ItemsSource="{Binding AvailableLoaders}" SelectedItem="{Binding SelectedLoader}" FontSize="11" VerticalAlignment="Center"/>
            <ComboBox MinWidth="130" ItemsSource="{Binding AvailableSortOptions}" SelectedItem="{Binding SelectedSort}" FontSize="11" VerticalAlignment="Center"/>
            <Button Classes="primaryBtn" Content="{l10n:Tr Key=btn_search}" Command="{Binding SearchCommand}" Padding="14,7" FontSize="12" VerticalAlignment="Center"/>
            <Button Classes="subBtn" Command="{Binding ResetFiltersCommand}" ToolTip.Tip="{l10n:Tr Key=cb_clear}" Padding="10,7" VerticalAlignment="Center">
                <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Button>
        </StackPanel>

        <!-- Results -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsDetailsOpen}">
            <StackPanel Spacing="0">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="items:ModrinthProjectItemViewModel">
                            <Border Margin="0,0,0,8" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" Padding="10">
                                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" Background="{StaticResource IconChipBrush}" CornerRadius="8" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" Width="44" Height="44" IsVisible="{Binding HasIcon}"/>
                                            <Path Data="M20 3H4C2.89 3 2 3.89 2 5V15C2 16.11 2.89 17 4 17H8V21L12 18H20C21.11 18 22 17.11 22 16V5C22 3.89 21.11 3 20 3M20 14H12L8 18V14H4V5H20V14Z" Fill="{StaticResource TextPlaceholderBrush}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/>
                                        </Panel>
                                    </Border>
                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            Command="{Binding $parent[Window].((vm:ExperimentalShellViewModel)DataContext).OpenDiscoverDetailsCommand}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{Binding DownloadsLabel}" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="primaryBtn" Width="104" Height="30" Content="{Binding InstallButtonText}"
                                            Command="{Binding $parent[UserControl].((vm:ModpacksBrowserViewModel)DataContext).DeleteOrInstallCommand}"
                                            CommandParameter="{Binding}" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l10n:Tr Key=mp_loading}" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" Margin="0,12" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{l10n:Tr Key=mp_empty}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Margin="0,12" Foreground="{StaticResource TextPlaceholderBrush}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Details -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsDetailsOpen}">
            <Button Grid.Row="0" Classes="subBtn" Content="{l10n:Tr Key=exp_back}" Padding="12,6" FontSize="11.5" HorizontalAlignment="Left" Margin="0,0,0,10"
                    Command="{Binding $parent[Window].((vm:ExperimentalShellViewModel)DataContext).CloseDiscoverDetailsCommand}"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <views:ProjectDetailsView DataContext="{Binding}"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
