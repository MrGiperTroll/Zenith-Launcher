<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZenithLauncher.ViewModels"
        xmlns:converters="using:ZenithLauncher.Converters"
             xmlns:models="using:ZenithLauncher.Models"
        xmlns:l10n="using:ZenithLauncher.Extensions"
             x:Class="ZenithLauncher.Views.FileListView"
             x:DataType="vm:FileListViewModel"
             DragDrop.AllowDrop="True"
             KeyDown="OnKeyDown"
             Focusable="True">

    <UserControl.Styles>
        <Style Selector="Button.dialogBtn">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dialogBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <!-- Search box stretched across the left side -->
                <TextBox Grid.Column="0" x:Name="SearchBox" Classes="darkInput" Text="{Binding SearchQuery}"
                         PlaceholderText="{l10n:Tr Key=ph_search}" FontSize="11" Padding="10,6"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                <!-- Right toolbar: Sort, Batch Actions, Refresh, Open Folder, Primary Action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox Classes="zenCombo" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                              FontSize="11" Padding="8,4" Width="118" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:FileSortDisplayConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="subBtn" Command="{Binding EnableAllCommand}"
                            Content="{l10n:Tr Key=fl_enable_all}" FontSize="11" Padding="10,5" VerticalAlignment="Center"
                            IsVisible="{Binding SupportsDisable}"/>
                    <Button Classes="subBtn" Command="{Binding DisableAllCommand}"
                            Content="{l10n:Tr Key=fl_disable_all}" FontSize="11" Padding="10,5" VerticalAlignment="Center"
                            IsVisible="{Binding SupportsDisable}"/>
                    <Button Classes="subBtn" Command="{Binding RefreshListCommand}"
                            Content="{l10n:Tr Key=fl_refresh}" FontSize="11" Padding="10,5" VerticalAlignment="Center"/>
                    <Button Classes="subBtn" Command="{Binding OpenFolderCommand}"
                            Content="{l10n:Tr Key=btn_open_folder}" FontSize="11" Padding="10,5" VerticalAlignment="Center"
                            ToolTip.Tip="{l10n:Tr Key=btn_open_folder}"/>
                    <Button Classes="primaryBtn" Command="{Binding PrimaryActionCommand}" CommandParameter="{Binding PrimaryActionCommandParameter}"
                            Content="{Binding PrimaryActionText}" FontSize="11.5" FontWeight="SemiBold" Padding="14,5" VerticalAlignment="Center"
                            IsVisible="{Binding HasPrimaryAction}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="Transparent" Padding="4">
            <Grid>
                <!-- Standard card list (mods / packs / worlds / generic) -->
                <ListBox ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0" Padding="6"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         IsVisible="{Binding !IsGalleryMode}" x:Name="EntryList" DragDrop.AllowDrop="True">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:InstanceFileEntry">
                            <Grid ColumnDefinitions="56,*,Auto,Auto" MinHeight="58" Margin="2,4,2,4" Cursor="Hand">
                                <Border Width="48" Height="48" Background="{DynamicResource IconChipBrush}" CornerRadius="8"
                                        ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Panel>
                                        <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}}" Stretch="UniformToFill" Width="48" Height="48"
                                               IsVisible="{Binding HasPreview}"/>
                                        <Path Data="M14 2H6A2 2 0 0 0 4 4V20A2 2 0 0 0 6 22H18A2 2 0 0 0 20 20V6L14 2Z"
                                              Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextPlaceholderBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPreview}"/>
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                                   IsVisible="{Binding Subtitle, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                        <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource TextCaptionBrush}"
                                                   IsVisible="{Binding Meta, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                               IsVisible="{Binding Description, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                    <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10"
                                               Foreground="{DynamicResource TextCaptionBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}"
                                          Command="{Binding $parent[UserControl].DataContext.ToggleFileCommand}"
                                          CommandParameter="{Binding}"
                                          OnContent="" OffContent=""
                                          Margin="4,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                    <Button Classes="subBtn" Content="{l10n:Tr Key=fl_backup}" FontSize="11" Padding="12,4" ToolTip.Tip="{l10n:Tr Key=fl_backup_tip}"
                                            IsVisible="{Binding $parent[UserControl].DataContext.SupportsBackup}"
                                            Command="{Binding $parent[UserControl].DataContext.BackupFileCommand}" CommandParameter="{Binding}"/>
                                    <Button Command="{Binding $parent[UserControl].DataContext.OpenFileCommand}" CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Padding="4,1" Cursor="Hand"
                                            ToolTip.Tip="{l10n:Tr Key=fl_reveal_tip}" VerticalAlignment="Center">
                                        <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                                  Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover PathIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    <Button Command="{Binding $parent[UserControl].DataContext.DeleteFileCommand}" CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Padding="4,1" Cursor="Hand"
                                            ToolTip.Tip="{l10n:Tr Key=fl_delete}" VerticalAlignment="Center">
                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                  Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover PathIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Screenshot gallery (grid of preview tiles) -->
                <ListBox ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0" Padding="8"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         IsVisible="{Binding IsGalleryMode}" x:Name="GalleryList" DragDrop.AllowDrop="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Margin" Value="4"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Opacity" Value="0.92"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:InstanceFileEntry">
                            <Border Width="190" CornerRadius="10" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderCardSoftBrush}" BorderThickness="1" ClipToBounds="True"
                                    DoubleTapped="OnGalleryItemDoubleTapped">
                                <StackPanel>
                                    <Border Height="112" Background="{DynamicResource CardAltBrush}" ClipToBounds="True">
                                        <Button Command="{Binding $parent[UserControl].((vm:FileListViewModel)DataContext).OpenLightboxCommand}" CommandParameter="{Binding}"
                                                Padding="0" BorderThickness="0" Background="Transparent"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand"
                                                ToolTip.Tip="{l10n:Tr Key=fl_open}">
                                            <Panel>
                                                <Image Source="{Binding PreviewBytes, Converter={x:Static converters:BytesToBitmapConverter.Instance}, ConverterParameter=400}"
                                                       Stretch="Uniform" Width="188" Height="112"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasPreview}"/>
                                                <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01 3.5-4.51 4.5 6H5l3.5-4.5z"
                                                      Width="42" Height="42" Stretch="Uniform" Fill="{DynamicResource TextPlaceholderBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasPreview}"/>
                                            </Panel>
                                        </Button>
                                    </Border>
                                    <StackPanel Spacing="2" Margin="10,8,10,10">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10"
                                                   Foreground="{DynamicResource TextCaptionBrush}"/>
                                        <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource TextPlaceholderBrush}"
                                                   IsVisible="{Binding Meta, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                            <Button Classes="subBtn" Content="{l10n:Tr Key=fl_open}" Padding="12,4" FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:FileListViewModel)DataContext).OpenLightboxCommand}" CommandParameter="{Binding}"/>
                                            <Button Classes="subBtn" Content="{l10n:Tr Key=fl_locate}" Padding="12,4" FontSize="11" ToolTip.Tip="{l10n:Tr Key=fl_explorer_tip}"
                                                    Command="{Binding $parent[UserControl].((vm:FileListViewModel)DataContext).LocateFileCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Full-list drop highlight (covers the file field, not the header) -->
                <Border IsVisible="{Binding IsDragOver}" IsHitTestVisible="False" Background="{DynamicResource AccentTranslucentBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2" CornerRadius="6" Margin="6" ZIndex="50"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⬇" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l10n:Tr Key=fl_drop}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Invalid-format drop warning -->
                <Border IsVisible="{Binding IsDragInvalid}" IsHitTestVisible="False" Background="{DynamicResource DangerTranslucentBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="2" CornerRadius="6" Margin="6" ZIndex="51"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="✕" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l10n:Tr Key=fl_invalid}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding EmptyHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextPlaceholderBrush}" FontSize="12"
                           Margin="12,14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding Entries.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsZero}}"/>
            </Grid>
        </Border>



        <!-- Delete File Confirmation Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource OverlayBrush}" IsVisible="{Binding IsDeleteConfirmOpen}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="100">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="360" MaxWidth="460">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=fl_delete}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding PendingDeleteName, StringFormat='Are you sure you want to delete \'{0}\'? This cannot be undone.'}"
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*" HorizontalAlignment="Right" Width="200">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=cancel}"
                                Command="{Binding CancelDeleteFileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="dangerBtn" Content="{l10n:Tr Key=btn_delete}"
                                Command="{Binding ConfirmDeleteFileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Lightbox Modal for Screenshots -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource OverlayBrush}"
                IsVisible="{Binding IsLightboxOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="200">
            <Grid RowDefinitions="Auto,*,Auto" Margin="24">
                <!-- Top Header: Title + Actions + Close -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentLightboxEntry.Title}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentLightboxEntry.Meta}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="subBtn" Content="{l10n:Tr Key=fl_locate}"
                                Command="{Binding LocateFileCommand}" CommandParameter="{Binding CurrentLightboxEntry}"
                                Padding="12,6" FontSize="12"/>
                        <Button Classes="subBtn" Content="{l10n:Tr Key=fl_open}"
                                Command="{Binding OpenFileCommand}" CommandParameter="{Binding CurrentLightboxEntry}"
                                Padding="12,6" FontSize="12" ToolTip.Tip="Open externally"/>
                        <Button Classes="subBtn" Command="{Binding CloseLightboxCommand}"
                                Width="34" Height="34" Padding="0" Cursor="Hand" ToolTip.Tip="Close (Esc)">
                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Width="12" Height="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Center Area: Full Image + Prev/Next Navigation -->
                <Grid Grid.Row="1">
                    <Border CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                        <Image Source="{Binding CurrentLightboxEntry.FullPath, Converter={x:Static converters:FullImageConverter.Instance}}"
                               Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Border>

                    <!-- Previous Image Button -->
                    <Button Command="{Binding PrevLightboxCommand}"
                            Classes="subBtn"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="44" Height="44" Padding="0" CornerRadius="22" Margin="16,0,0,0"
                            ToolTip.Tip="Previous (Left Arrow)">
                        <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>

                    <!-- Next Image Button -->
                    <Button Command="{Binding NextLightboxCommand}"
                            Classes="subBtn"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="44" Height="44" Padding="0" CornerRadius="22" Margin="0,0,16,0"
                            ToolTip.Tip="Next (Right Arrow)">
                        <PathIcon Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </Grid>

                <!-- Bottom Footer: Date -->
                <TextBlock Grid.Row="2"
                           Text="{Binding CurrentLightboxEntry.ModifiedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                           FontSize="12" Foreground="{DynamicResource TextCaptionBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
