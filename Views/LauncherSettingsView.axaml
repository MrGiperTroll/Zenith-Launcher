<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:pages="using:CustomMcLauncher.ViewModels.Pages"
             xmlns:converters="using:CustomMcLauncher.Converters"
             xmlns:views="using:CustomMcLauncher.Views"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             xmlns:services="using:CustomMcLauncher.Services"
             x:Name="RootSettingsControl"
             x:Class="CustomMcLauncher.Views.LauncherSettingsView"
             x:DataType="pages:LauncherSettingsViewModel"
             Background="{StaticResource BgBrush}">

    <UserControl.Styles>
        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="{StaticResource RowHoverBrushTransparent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sideTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.sideTab:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.sideTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>
        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
        </Style>

        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBlock.itemTitle">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.itemDesc">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="200,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" Padding="14,16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBox Classes="darkInput" Text="{Binding SettingsSearchQuery}" PlaceholderText="{l10n:Tr Key=ph_search}" Padding="8,6" FontSize="11" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabGame}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Game"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <PathIcon Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" Width="15" Height="15" Foreground="{Binding IsSettingsTabGame, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Minecraft" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGame, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabAppearance}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Appearance"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <PathIcon Data="M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34a2 2 0 0 0-2.83 0L9 10.83l4.17 4.17 7.54-7.54a2 2 0 0 0 0-2.83z" Width="15" Height="15" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Launcher" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" IsVisible="False"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" Padding="28,24,32,24" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsSettingsTabTheme}">
                <StackPanel Spacing="24">

                    <!-- ========================================== -->
                    <!-- GAME SETTINGS (Minecraft Tab)              -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="24" IsVisible="{Binding IsSettingsTabGame}">

                        <!-- Group: Memory Allocation -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSearchMemoryVisible}">
                            <TextBlock Classes="groupTitle" Text="{l10n:Tr set_memory}"/>

                            <!-- Min RAM Row -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="{l10n:Tr set_min_memory}"/>
                                    <TextBlock Classes="itemDesc" Text="Initial amount of RAM allocated when starting Minecraft."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Command="{Binding StepMinRamDownCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Decrease RAM">
                                        <PathIcon Data="M5 11h14v2H5z" Width="10" Height="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="6" Height="30" Padding="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MinRam, StringFormat='{}{0} MB'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Command="{Binding StepMinRamUpCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Increase RAM">
                                        <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="10" Height="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>

                            <!-- Max RAM Row -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="{l10n:Tr set_max_memory}"/>
                                    <TextBlock Classes="itemDesc" Text="Maximum memory limit Minecraft is permitted to consume."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Command="{Binding StepMaxRamDownCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Decrease RAM">
                                        <PathIcon Data="M5 11h14v2H5z" Width="10" Height="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="6" Height="30" Padding="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MaxRam, StringFormat='{}{0} MB'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Command="{Binding StepMaxRamUpCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Increase RAM">
                                        <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="10" Height="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Group: Java Runtime -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSearchJavaVisible}">
                            <TextBlock Classes="groupTitle" Text="{l10n:Tr set_java}"/>

                            <!-- Java Mode Selector -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="{l10n:Tr set_java_mode}"/>
                                    <TextBlock Classes="itemDesc" Text="Select whether to use the launcher recommended Java, system runtime, or a custom binary."/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding JavaModes}" SelectedItem="{Binding SelectedJavaMode}" Classes="darkCombo" Width="180" Height="32" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>

                            <!-- Auto-manage Java toggle -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="Auto-manage Java Runtimes"/>
                                    <TextBlock Classes="itemDesc" Text="Automatically acquire and match compatible Adoptium Java versions for each Minecraft version."/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoManageJava}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>

                            <!-- Custom Java Path (Conditional) -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsCustomJavaMode}">
                                <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_java_path}"/>
                                        <TextBlock Classes="itemDesc" Text="Full file path to the custom javaw.exe or java binary."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="subBtn" Command="{Binding BrowseJavaPathCommand}" Content="Browse" Padding="14,6" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <TextBox Classes="darkInput" Text="{Binding EffectiveJavaPath}" PlaceholderText="C:\Program Files\Java\jdk-21\bin\javaw.exe" Height="34" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>

                            <!-- Java Runtime Status / Installer -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="Detected Runtime"/>
                                    <TextBlock Classes="itemDesc" Text="{Binding CurrentJavaDisplay}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="subBtn" Command="{Binding OpenJavaInstallerCommand}" Content="Java Manager" Padding="14,6" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Group: Window Resolution -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSearchResolutionVisible}">
                            <TextBlock Classes="groupTitle" Text="{l10n:Tr set_resolution}"/>

                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="Initial Window Dimensions"/>
                                    <TextBlock Classes="itemDesc" Text="Launch resolution for Minecraft game window."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBox Classes="darkInput" Text="{Binding GameWidth}" Width="68" Height="32" FontSize="12" TextAlignment="Center"/>
                                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}" VerticalAlignment="Center"/>
                                    <TextBox Classes="darkInput" Text="{Binding GameHeight}" Width="68" Height="32" FontSize="12" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Group: Instance Directory Strategy -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSearchDirectoryVisible}">
                            <TextBlock Classes="groupTitle" Text="{l10n:Tr set_directory}"/>

                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="Game Data Directory"/>
                                    <TextBlock Classes="itemDesc" Text="Choose whether instances store mods and saves in separate folders or a shared directory."/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DirectoryModes}" SelectedItem="{Binding SelectedDirectoryMode}" Classes="darkCombo" Width="260" Height="32" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Group: Advanced JVM Arguments -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSearchJvmVisible}">
                            <TextBlock Classes="groupTitle" Text="{l10n:Tr set_jvm_args}"/>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="itemTitle" Text="Custom JVM Arguments"/>
                                <TextBlock Classes="itemDesc" Text="Flags passed directly to the Java Virtual Machine on launch (e.g. -XX:+UseG1GC)."/>
                                <TextBox Classes="darkInput" Text="{Binding JvmArgs}" PlaceholderText="-XX:+UseG1GC -Dsun.rmi.dgc.server.gcInterval=2147483646" Height="36" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>


                    <!-- ========================================== -->
                    <!-- APPEARANCE & LAUNCHER (Launcher Tab)       -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="24" IsVisible="{Binding IsSettingsTabAppearance}">

                        <!-- Group: General -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="groupTitle" Text="General"/>

                            <!-- Language -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchLanguageVisible}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="{l10n:Tr Key=settings_lang}"/>
                                    <TextBlock Classes="itemDesc" Text="Select application interface language."/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Classes="darkCombo" Width="180" Height="32" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>

                            <!-- Discord Rich Presence -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchDiscordVisible}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="{l10n:Tr set_discord}"/>
                                    <TextBlock Classes="itemDesc" Text="{l10n:Tr set_discord_hint}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordRpcEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>

                            <!-- Flat Version List Toggle -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="Flat Version Selector"/>
                                    <TextBlock Classes="itemDesc" Text="Display Minecraft versions in instance creator as a flat list instead of nested groups."/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseFlatVersionList}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Group: Appearance -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsSearchAppearanceVisible}">
                            <TextBlock Classes="groupTitle" Text="Appearance"/>

                            <!-- Theme Customization -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="itemTitle" Text="{l10n:Tr Key=theme_edit}"/>
                                    <TextBlock Classes="itemDesc" Text="{l10n:Tr Key=theme_edit_desc}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=theme_customize}" Command="{Binding OpenThemeEditorCommand}" Padding="16,8" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>

                            <!-- Launcher Scale -->
                            <StackPanel Spacing="8">
                                <TextBlock Classes="itemTitle" Text="{l10n:Tr Key=settings_scale}"/>
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <Slider Minimum="0.5" Maximum="2.0" Value="{Binding PendingLauncherScale}" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            PointerCaptureLost="OnScaleSliderPointerCaptureLost"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PendingLauncherScale, StringFormat='{}{0:P0}'}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12.5" Width="44" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Group: Integrations -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="groupTitle" Text="Integrations"/>

                            <!-- CurseForge API Key -->
                            <StackPanel Spacing="4">
                                <TextBlock Classes="itemTitle" Text="CurseForge API Key"/>
                                <TextBlock Classes="itemDesc" Text="Required to browse and install Worlds and Maps from CurseForge (console.curseforge.com)."/>
                                <TextBox Classes="darkInput" Text="{Binding CurseForgeApiKey}" PasswordChar="•" PlaceholderText="Enter your CurseForge API key" Height="36" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Theme Settings Overlay Tab -->
            <views:ThemeSettingsView Grid.Column="1" DataContext="{Binding ThemeSettingsVm}" IsVisible="{Binding $parent[UserControl].((pages:LauncherSettingsViewModel)DataContext).IsSettingsTabTheme}" Padding="28,24,32,24"/>
        </Grid>

        <!-- MODAL: Restart Confirmation (Theme Application) -->
        <Border IsVisible="{Binding IsRestartConfirmOpen}" Background="{StaticResource OverlayBrush}" ZIndex="999">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="390" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr Key=dialog_restart_title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l10n:Tr Key=dialog_restart_theme_msg}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="17"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=no}" Command="{Binding CancelRestartConfirmCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="34"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmRestartAndApplyThemeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL: Discard Changes Confirmation (Tab Switching) -->
        <Border IsVisible="{Binding IsThemeDiscardConfirmOpen}" Background="{StaticResource OverlayBrush}" ZIndex="999">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="390" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr Key=dialog_discard_title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l10n:Tr Key=dialog_discard_theme_msg}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="17"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=no}" Command="{Binding CancelDiscardThemeChangesCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="34"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmDiscardThemeChangesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
