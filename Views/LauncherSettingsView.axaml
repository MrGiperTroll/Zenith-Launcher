<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZenithLauncher.ViewModels"
             xmlns:pages="using:ZenithLauncher.ViewModels.Pages"
             xmlns:converters="using:ZenithLauncher.Converters"
             xmlns:controls="using:ZenithLauncher.Controls"
             xmlns:views="using:ZenithLauncher.Views"
             xmlns:l10n="using:ZenithLauncher.Extensions"
             xmlns:services="using:ZenithLauncher.Services"
             x:Name="RootSettingsControl"
             x:Class="ZenithLauncher.Views.LauncherSettingsView"
             x:DataType="pages:LauncherSettingsViewModel"
             Background="{DynamicResource BgBrush}"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Flyout x:Key="CustomThemeColorFlyout" Placement="BottomEdgeAlignedLeft" Closing="OnCustomColorFlyoutClosing">
            <Flyout.FlyoutPresenterTheme>
                <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="12"/>
                    <Setter Property="ClipToBounds" Value="True"/>
                </ControlTheme>
            </Flyout.FlyoutPresenterTheme>
            <Border x:DataType="pages:LauncherSettingsViewModel"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="14"
                    Width="292">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="5"
                                Background="{Binding CustomColorPreviewBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=theme_custom_picker_title}"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Classes="rowActionBtn" Width="24" Height="24"
                                IsVisible="{Binding HasCustomColorSaved}"
                                Command="{Binding ResetCustomThemeColorCommand}"
                                ToolTip.Tip="{l10n:Tr Key=theme_custom_reset}">
                            <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                      Width="12" Height="12"/>
                        </Button>
                    </Grid>

                    <controls:ColorPadControl HorizontalAlignment="Stretch"
                                              Height="156"
                                              CornerRadius="10"
                                              HsvColor="{Binding CustomHsvColor, Mode=TwoWay}"/>

                    <ColorSlider Orientation="Horizontal"
                                 ColorModel="Hsva"
                                 ColorComponent="Component1"
                                 IsPerceptive="False"
                                 HorizontalAlignment="Stretch"
                                 HsvColor="{Binding CustomHsvColor, Mode=TwoWay}"/>

                    <ItemsControl ItemsSource="{Binding CustomColorSwatches}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:ThemeSwatchModel">
                                <Button Classes="swatchDotBtn"
                                        Command="{Binding $parent[UserControl].((pages:LauncherSettingsViewModel)DataContext).PickCustomSwatchCommand}"
                                        CommandParameter="{Binding Hex}"
                                        ToolTip.Tip="{Binding Hex}">
                                    <Border Width="18" Height="18" CornerRadius="9"
                                            Background="{Binding ColorBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Classes="darkInput" Height="32" FontSize="12"
                                 MaxLength="7" Text="{Binding CustomColorHexInput, Mode=TwoWay}"
                                 PlaceholderText="#RRGGBB"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Height="32" Padding="14,0" FontSize="12"
                                Content="{l10n:Tr Key=theme_custom_apply}"
                                Click="OnCustomColorApplyClicked"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Flyout>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.swatchDotBtn">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.swatchDotBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sideTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.sideTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>

        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
        </Style>

        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style Selector="Button.pillSelectBtn">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions" Value="{DynamicResource MotionCtrlBgBorderTransitions}"/>
        </Style>
        <Style Selector="Button.pillSelectBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.pillSelectBtn.active">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.pillSelectBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.sectionHeaderTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.sectionHeaderDesc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style Selector="TextBlock.itemTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="TextBlock.itemDesc">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="210,*">
            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" Padding="14,18"
                    BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBox Classes="darkInput" Text="{Binding SettingsSearchQuery}" PlaceholderText="{l10n:Tr set_search_placeholder}" Padding="9,7" FontSize="11.5" Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <!-- Category: Minecraft -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabGame}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Game">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M5,1 L11,1 L11,2 L13,2 L13,3 L14,3 L14,5 L15,5 L15,11 L14,11 L14,12 L12,12 L12,10 L13,10 L13,7 L12,7 L12,6 L11,6 L11,7 L10,7 L10,8 L9,8 L9,9 L8,9 L8,10 L7,10 L7,11 L6,11 L6,12 L5,12 L5,13 L4,13 L4,14 L3,14 L3,15 L1,15 L1,13 L2,13 L2,12 L3,12 L3,11 L4,11 L4,10 L5,10 L5,9 L6,9 L6,8 L7,8 L7,7 L8,7 L8,6 L9,6 L9,5 L10,5 L10,4 L9,4 L9,3 L6,3 L6,4 L4,4 L4,2 L5,2 Z" Width="15" Height="15" Foreground="{Binding IsSettingsTabGame, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr set_game}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGame, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Java Runtimes -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabJava}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Java">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M9.8,8.5 C8.4,7.0 10.9,5.6 9.6,3.8 C9.0,3.0 9.1,2.2 9.8,1.5 C10.6,2.3 10.6,3.2 11.1,4.0 C12.3,5.8 9.9,7.1 11.1,8.5 Z M13.6,8.2 C12.5,7.0 14.4,5.9 13.4,4.4 C12.9,3.7 13.0,3.0 13.6,2.4 C14.3,3.1 14.3,3.9 14.7,4.5 C15.7,6.0 13.7,7.0 14.7,8.2 Z M4.5,10 H17.5 V13.5 C17.5,16.5 14.8,18.5 11.0,18.5 C7.2,18.5 4.5,16.5 4.5,13.5 Z M17.5,10.5 H19.3 C20.6,10.5 21.5,11.4 21.5,12.8 C21.5,14.2 20.6,15.2 19.3,15.2 H17.5 V13.7 H19.0 C19.6,13.7 20.0,13.3 20.0,12.8 C20.0,12.3 19.6,12.0 19.0,12.0 H17.5 Z M3,20.2 C6.2,21.6 15.8,21.6 19,20.2 C19.5,20.0 19.9,20.4 19.6,20.9 C16.0,22.4 6.0,22.4 2.4,20.9 C2.1,20.4 2.5,20.0 3,20.2 Z" Width="15" Height="15" Foreground="{Binding IsSettingsTabJava, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr set_java}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabJava, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Launcher & System -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabGeneral}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="General">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Width="14" Height="14" Foreground="{Binding IsSettingsTabGeneral, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr set_launcher_settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGeneral, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Appearance -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabAppearance}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Appearance">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18V4c4.41 0 8 3.59 8 8s-3.59 8-8 8z" Width="14" Height="14" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr set_appearance}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" IsVisible="False"/>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" Padding="32,24,36,28" VerticalScrollBarVisibility="Visible" UseLayoutRounding="True" Focusable="False">
                <Panel ClipToBounds="True">

                    <!-- ========================================================= -->
                    <!-- TAB 1: MINECRAFT & GAME                                   -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="TabGamePanel" Spacing="18" IsVisible="{Binding IsSettingsTabGame}">

                        <!-- Section: Memory (RAM) Allocation -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchMemoryVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_memory}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_memory_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Min RAM -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_min_memory}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_min_memory_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Command="{Binding StepMinRamDownCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="{l10n:Tr ram_decrease}">
                                            <PathIcon Data="M5 11h14v2H5z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="30" Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MinRamMb, StringFormat='{}{0} MB'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Command="{Binding StepMinRamUpCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="{l10n:Tr ram_increase}">
                                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Max RAM -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_max_memory}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_max_memory_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Command="{Binding StepRamDownCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="{l10n:Tr ram_decrease}">
                                            <PathIcon Data="M5 11h14v2H5z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="30" Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RamMb, StringFormat='{}{0} MB'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Command="{Binding StepRamUpCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="{l10n:Tr ram_increase}">
                                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Resolution & Display -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchResolutionVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_window_resolution}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_window_resolution_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_resolution}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_resolution_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox Classes="darkInput" Text="{Binding GameWidth}" Width="80" Height="32" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox Classes="darkInput" Text="{Binding GameHeight}" Width="80" Height="32" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_lock_aspect_ratio}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_lock_aspect_ratio_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsLockAspectRatio}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchFullscreenVisible}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_fullscreen}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_fullscreen_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsFullscreen}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Storage Strategy -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchDirectoryVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_dirstrategy}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_dirstrategy_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_dirstrategy}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_dirstrategy_hint}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DirectoryModes}" SelectedItem="{Binding SelectedDirectoryMode}" Classes="darkCombo" Width="260" Height="32" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Version Filters -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchVersionFiltersVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_versionfilters}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_versionfilters_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                                    <CheckBox Content="{l10n:Tr Key=vf_releases}" IsChecked="{Binding ShowReleases}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="{l10n:Tr Key=vf_snapshots}" IsChecked="{Binding ShowSnapshots}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="{l10n:Tr Key=vf_betas}" IsChecked="{Binding ShowBetas}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="{l10n:Tr Key=vf_alphas}" IsChecked="{Binding ShowAlphas}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_flat_version_list}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_flat_version_list_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseFlatVersionList}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Custom JVM Arguments -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJvmArgsVisible}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_jvmargs}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_jvmargs_hint}"/>
                                </StackPanel>
                                <TextBox Classes="darkInput" Text="{Binding JvmArgs}" PlaceholderText="-XX:+UseG1GC -Dsun.rmi.dgc.server.gcInterval=2147483646" Height="36" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 2: JAVA RUNTIMES                                      -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="TabJavaPanel" Spacing="18" IsVisible="{Binding IsSettingsTabJava}">

                        <!-- Section: Java Management Strategy -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_java}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_java_mode_desc}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_autojava}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_autojava_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoManageJava}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java 25 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="itemTitle" Text="Java 25"/>
                                <TextBox Classes="darkInput" Text="{Binding Java25Location, Mode=TwoWay}"  Height="34" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="25" Content="{Binding Java25DownloadButtonText}" IsEnabled="{Binding !IsJava25Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="25" Content="{l10n:Tr Key=btn_detect}" IsEnabled="{Binding !IsJava25Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="25" Content="{l10n:Tr Key=btn_browse}" IsEnabled="{Binding !IsJava25Downloading}" Padding="14,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsJava25Downloading}">
                                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java 21 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="itemTitle" Text="Java 21"/>
                                <TextBox Classes="darkInput" Text="{Binding Java21Location, Mode=TwoWay}"  Height="34" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="21" Content="{Binding Java21DownloadButtonText}" IsEnabled="{Binding !IsJava21Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="21" Content="{l10n:Tr Key=btn_detect}" IsEnabled="{Binding !IsJava21Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="21" Content="{l10n:Tr Key=btn_browse}" IsEnabled="{Binding !IsJava21Downloading}" Padding="14,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsJava21Downloading}">
                                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java 17 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="itemTitle" Text="Java 17"/>
                                <TextBox Classes="darkInput" Text="{Binding Java17Location, Mode=TwoWay}"  Height="34" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="17" Content="{Binding Java17DownloadButtonText}" IsEnabled="{Binding !IsJava17Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="17" Content="{l10n:Tr Key=btn_detect}" IsEnabled="{Binding !IsJava17Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="17" Content="{l10n:Tr Key=btn_browse}" IsEnabled="{Binding !IsJava17Downloading}" Padding="14,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsJava17Downloading}">
                                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java 8 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="itemTitle" Text="Java 8"/>
                                <TextBox Classes="darkInput" Text="{Binding Java8Location, Mode=TwoWay}"  Height="34" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="8" Content="{Binding Java8DownloadButtonText}" IsEnabled="{Binding !IsJava8Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="8" Content="{l10n:Tr Key=btn_detect}" IsEnabled="{Binding !IsJava8Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="8" Content="{l10n:Tr Key=btn_browse}" IsEnabled="{Binding !IsJava8Downloading}" Padding="14,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsJava8Downloading}">
                                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 3: LAUNCHER & SYSTEM (General)                        -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="TabGeneralPanel" Spacing="18" IsVisible="{Binding IsSettingsTabGeneral}">

                        <!-- General & Launch Behavior -->
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_general}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_general_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Launch Behavior (What happens on Minecraft launch) -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_launch_behavior}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_launch_behavior_hint}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LaunchBehaviors}"
                                              SelectedItem="{Binding SelectedLaunchBehavior}"
                                              Classes="darkCombo" Width="300" Height="32" FontSize="12"
                                              HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static converters:LaunchBehaviorDisplayConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Minimize to Tray on Close -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_minimize_to_tray}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_minimize_to_tray_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose}"
                                                  OnContent="{x:Null}" OffContent="{x:Null}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- GUI Hardware Acceleration -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_hardware_accel}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_hardware_accel_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding HardwareAcceleration, Mode=TwoWay}"
                                                  OnContent="{x:Null}" OffContent="{x:Null}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Discord RPC -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchDiscordVisible}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_discord}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_discord_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordRpcEnabled}"
                                                  OnContent="{x:Null}" OffContent="{x:Null}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Cache & Storage Management -->
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_cache}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_cache_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr btn_clear_cache}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_cache_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CacheStatusText}" FontSize="11.5"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding CacheStatusText, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                        <Button Classes="subBtn" Command="{Binding ClearCacheCommand}"
                                                Content="{l10n:Tr btn_clear_cache}"
                                                IsEnabled="{Binding !IsClearingCache}"
                                                Height="32" Padding="14,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 4: APPEARANCE (Themes, Particles, Typography, Motion) -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="TabAppearancePanel" Spacing="18" IsVisible="{Binding IsSettingsTabAppearance}">
                        <!-- Card 1: Theme Settings -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchAppearanceVisible}">
                            <StackPanel Spacing="16">
                                <!-- Theme Header -->
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr theme_mode}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr theme_mode_desc}"/>
                                </StackPanel>

                                <!-- Theme Preview Cards Grid -->
                                <ItemsControl ItemsSource="{Binding ThemeCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="pages:ThemeCardModel">
                                            <Button Command="{Binding $parent[UserControl].((pages:LauncherSettingsViewModel)DataContext).SelectThemeCardCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Click="OnThemeCardClicked"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,12,12"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Style>
                                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Style>
                                                </Button.Styles>
                                                <StackPanel Spacing="7" Width="144">
                                                    <!-- Outer Card Container -->
                                                    <Border Background="{DynamicResource CardBrush}"
                                                            CornerRadius="8"
                                                            Height="84"
                                                            Padding="12,10"
                                                            BorderThickness="{Binding CardBorderThickness}"
                                                            BorderBrush="{Binding CardBorderBrush}">
                                                        <Grid RowDefinitions="Auto,Auto,*">
                                                            <!-- Row 0: Top Accent Pill -->
                                                            <Border Grid.Row="0" Width="48" Height="6" CornerRadius="3" Background="{Binding AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                                            <!-- Row 1: Sub line below pill -->
                                                            <Border Grid.Row="1" Width="36" Height="4" CornerRadius="2" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Left" Margin="0,5,0,6"/>

                                                            <!-- Row 2: Window surface with 2 mock bars -->
                                                            <Border Grid.Row="2" CornerRadius="5" Background="{DynamicResource BgBrush}" Padding="8,6" VerticalAlignment="Stretch">
                                                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                                                    <Border Width="42" Height="5" CornerRadius="2.5" Background="{Binding SoftBrush}" HorizontalAlignment="Left"/>
                                                                    <Border Width="26" Height="5" CornerRadius="2.5" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Theme Name Label -->
                                                    <Panel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   IsVisible="{Binding !IsCustom}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding NameForegroundBrush}"/>
                                                        <TextBlock Text="{l10n:Tr Key=theme_custom_card}" FontSize="12"
                                                                   IsVisible="{Binding IsCustom}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding NameForegroundBrush}"/>
                                                    </Panel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Background Particles (strictly below theme selection block) -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchAppearanceVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr particles_title}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr particles_hint}"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Particle Type Selector -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr particles_mode}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr particles_mode_hint}"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="pillSelectBtn" Classes.active="{Binding IsParticleOff}"
                                                Command="{Binding SelectParticleTypeCommand}" CommandParameter="Off"
                                                Content="{l10n:Tr particles_off}" Margin="0,0,6,4"/>
                                        <Button Classes="pillSelectBtn" Classes.active="{Binding IsParticleSnow}"
                                                Command="{Binding SelectParticleTypeCommand}" CommandParameter="Snow"
                                                Content="{l10n:Tr particles_snow}" Margin="0,0,6,4"/>
                                        <Button Classes="pillSelectBtn" Classes.active="{Binding IsParticleLeaves}"
                                                Command="{Binding SelectParticleTypeCommand}" CommandParameter="Leaves"
                                                Content="{l10n:Tr particles_leaves}" Margin="0,0,6,4"/>
                                        <Button Classes="pillSelectBtn" Classes.active="{Binding IsParticleSakura}"
                                                Command="{Binding SelectParticleTypeCommand}" CommandParameter="Sakura"
                                                Content="{l10n:Tr particles_sakura}" Margin="0,0,6,4"/>
                                        <Button Classes="pillSelectBtn" Classes.active="{Binding IsParticleCustom}"
                                                Command="{Binding SelectParticleTypeCommand}" CommandParameter="Custom"
                                                Content="{l10n:Tr particles_custom}" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                </Grid>

                                <!-- Leaves Palette Sub-Section -->
                                <StackPanel Spacing="14" IsVisible="{Binding IsParticleLeaves}">
                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr particles_palette}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr particles_palette_hint}"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="pillSelectBtn" Classes.active="{Binding IsLeafPaletteSpring}"
                                                    Command="{Binding SelectLeafPaletteCommand}" CommandParameter="Spring"
                                                    Content="{l10n:Tr particles_palette_spring}" Margin="0,0,6,4"/>
                                            <Button Classes="pillSelectBtn" Classes.active="{Binding IsLeafPaletteGolden}"
                                                    Command="{Binding SelectLeafPaletteCommand}" CommandParameter="Golden"
                                                    Content="{l10n:Tr particles_palette_golden}" Margin="0,0,6,4"/>
                                            <Button Classes="pillSelectBtn" Classes.active="{Binding IsLeafPaletteAutumn}"
                                                    Command="{Binding SelectLeafPaletteCommand}" CommandParameter="Autumn"
                                                    Content="{l10n:Tr particles_palette_autumn}" Margin="0,0,6,4"/>
                                            <Button Classes="pillSelectBtn" Classes.active="{Binding IsLeafPaletteForest}"
                                                    Command="{Binding SelectLeafPaletteCommand}" CommandParameter="Forest"
                                                    Content="{l10n:Tr particles_palette_forest}" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Custom Particle Image Sub-Section -->
                                <StackPanel Spacing="14" IsVisible="{Binding IsParticleCustom}">
                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr particles_custom_image}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr particles_custom_image_hint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="32" Padding="10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ParticleCustomImageDisplayName}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Classes="subBtn" Command="{Binding PickParticleImageCommand}" Height="32" Padding="12,0" Content="{l10n:Tr btn_browse}" VerticalAlignment="Center"/>
                                            <Button Classes="subBtn" Command="{Binding ClearParticleImageCommand}" IsVisible="{Binding HasParticleCustomImage}" Width="32" Height="32" Padding="0" Content="✕" ToolTip.Tip="{l10n:Tr grp_clear}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Particle Physics & Style Sliders -->
                                <StackPanel Spacing="14" IsVisible="{Binding AreParticlesEnabled}">
                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- Density / Count -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr particles_density}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr particles_density_hint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Slider Width="160" Minimum="10" Maximum="160" SmallChange="1" LargeChange="10"
                                                    Value="{Binding ParticleCount, Mode=TwoWay}"
                                                    PointerCaptureLost="OnParticleSliderPointerCaptureLost"
                                                    PointerReleased="OnParticleSliderPointerReleased"
                                                    KeyUp="OnParticleSliderKeyUp"
                                                    VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="28" Width="58" Padding="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ParticleCountText}" FontSize="11.5" FontWeight="Bold" FontFeatures="+tnum" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- Fall Speed -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr particles_speed}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr particles_speed_hint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Slider Width="160" Minimum="0.2" Maximum="2.5" SmallChange="0.05" LargeChange="0.2"
                                                    Value="{Binding ParticleSpeed, Mode=TwoWay}"
                                                    PointerCaptureLost="OnParticleSliderPointerCaptureLost"
                                                    PointerReleased="OnParticleSliderPointerReleased"
                                                    KeyUp="OnParticleSliderKeyUp"
                                                    VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="28" Width="58" Padding="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ParticleSpeedText}" FontSize="11.5" FontWeight="Bold" FontFeatures="+tnum" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- Wind & Sway -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr particles_wind}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr particles_wind_hint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Slider Width="160" Minimum="-1.5" Maximum="1.5" SmallChange="0.05" LargeChange="0.2"
                                                    Value="{Binding ParticleWind, Mode=TwoWay}"
                                                    PointerCaptureLost="OnParticleSliderPointerCaptureLost"
                                                    PointerReleased="OnParticleSliderPointerReleased"
                                                    KeyUp="OnParticleSliderKeyUp"
                                                    VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="28" Width="58" Padding="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ParticleWindText}" FontSize="11.5" FontWeight="Bold" FontFeatures="+tnum" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- Size -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr particles_size}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr particles_size_hint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Slider Width="160" Minimum="0.4" Maximum="2.2" SmallChange="0.05" LargeChange="0.2"
                                                    Value="{Binding ParticleSize, Mode=TwoWay}"
                                                    PointerCaptureLost="OnParticleSliderPointerCaptureLost"
                                                    PointerReleased="OnParticleSliderPointerReleased"
                                                    KeyUp="OnParticleSliderKeyUp"
                                                    VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="28" Width="58" Padding="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ParticleSizeText}" FontSize="11.5" FontWeight="Bold" FontFeatures="+tnum" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- Opacity -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr particles_opacity}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr particles_opacity_hint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Slider Width="160" Minimum="0.15" Maximum="1.0" SmallChange="0.02" LargeChange="0.1"
                                                    Value="{Binding ParticleOpacity, Mode=TwoWay}"
                                                    PointerCaptureLost="OnParticleSliderPointerCaptureLost"
                                                    PointerReleased="OnParticleSliderPointerReleased"
                                                    KeyUp="OnParticleSliderKeyUp"
                                                    VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="28" Width="58" Padding="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ParticleOpacityText}" FontSize="11.5" FontWeight="Bold" FontFeatures="+tnum" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Interface Language, Typography & Scale -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchAppearanceVisible}">
                            <StackPanel Spacing="14">
                                <!-- Language Selector -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_language}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_language_hint}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" Classes="darkCombo" Width="180" Height="32" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Font Style Selector -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_font_style}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_font_style_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomFontDisplayName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsCustomFontOption}" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseCustomFontCommand}" ToolTip.Tip="{l10n:Tr set_font_browse_tip}" Height="32" Padding="10,0" VerticalAlignment="Center" IsVisible="{Binding IsCustomFontOption}">
                                            <TextBlock Text="{l10n:Tr btn_browse}" FontSize="11.5"/>
                                        </Button>
                                        <ComboBox ItemsSource="{Binding FontStyleOptions}" SelectedItem="{Binding SelectedFontStyle}" Classes="darkCombo" Width="160" Height="32" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- UI Scale (Interface Scaling) -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_scale}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_scale_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Classes="scaleSlider" Width="140" Minimum="0.8" Maximum="1.5" SmallChange="0.01" LargeChange="0.05"
                                                Value="{Binding PendingLauncherScale, Mode=TwoWay}"
                                                PointerCaptureLost="OnScaleSliderPointerCaptureLost"
                                                PointerReleased="OnScaleSliderPointerReleased"
                                                KeyUp="OnScaleSliderKeyUp"
                                                VerticalAlignment="Center"/>
                                        <!-- Fixed-width badge container: never jumps between 2 and 3 digits -->
                                        <Border Background="{DynamicResource FieldBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Height="28"
                                                Width="68"
                                                Padding="6,0"
                                                VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <TextBox Grid.Column="0"
                                                         Classes="badgeInput"
                                                         Text="{Binding ScalePercentText, Mode=TwoWay}"
                                                         FontSize="11.5"
                                                         FontWeight="Bold"
                                                         MinWidth="0"
                                                         TextAlignment="Right"
                                                         VerticalAlignment="Center"
                                                         KeyDown="OnScaleInputKeyDown"
                                                         LostFocus="OnScaleInputLostFocus"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="%"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="2,0,0,0"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Expandable Interface Animations & Motion Details -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchAppearanceVisible}">
                            <StackPanel Spacing="14">
                                <!-- Master Row (Clickable Header + Minimalist Vector Chevron + Toggle) -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                            Tapped="OnAnimationHeaderTapped"
                                            ToolTip.Tip="{l10n:Tr set_ui_anim_details}"
                                            VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_animations}"/>
                                                <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_animations_hint}"/>
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Path Data="M 1 1 L 5 5 L 9 1" Width="10" Height="6" Stretch="Uniform"
                                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      IsVisible="{Binding !IsAnimationDetailsExpanded}"/>
                                                <Path Data="M 1 5 L 5 1 L 9 5" Width="10" Height="6" Stretch="Uniform"
                                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      IsVisible="{Binding IsAnimationDetailsExpanded}"/>
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UiAnimationsEnabled, Mode=TwoWay}"
                                                  OnContent="{x:Null}" OffContent="{x:Null}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Expandable Fine-Grained Motion Toggles -->
                                <StackPanel Spacing="12" IsVisible="{Binding IsAnimationDetailsExpanded}">
                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- 1. Pages & Catalog Swipes -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_anim_pages}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_anim_pages_hint}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding UiAnimPageTransitionsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding UiAnimationsEnabled}"
                                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- 2. Internal Tabs -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_anim_tabs}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_anim_tabs_hint}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding UiAnimTabsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding UiAnimationsEnabled}"
                                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- 3. Modals & Dialogs -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_anim_modals}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_anim_modals_hint}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding UiAnimModalsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding UiAnimationsEnabled}"
                                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- 4. Sidebars & Console -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_anim_sidebars}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_anim_sidebars_hint}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding UiAnimSidebarsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding UiAnimationsEnabled}"
                                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- 5. Flyouts & Toasts -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_anim_popups}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_anim_popups_hint}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding UiAnimPopupsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding UiAnimationsEnabled}"
                                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                    <!-- 6. Smooth Scrolling (Independent of Master Toggle) -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_anim_scroll}"/>
                                            <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_anim_scroll_hint}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding SmoothScrollEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Panel>
            </ScrollViewer>

        </Grid>
    </Panel>
</UserControl>
