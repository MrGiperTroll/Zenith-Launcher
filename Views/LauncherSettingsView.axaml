<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:pages="using:CustomMcLauncher.ViewModels.Pages"
             xmlns:converters="using:CustomMcLauncher.Converters"
             xmlns:views="using:CustomMcLauncher.Views"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             xmlns:services="using:CustomMcLauncher.Services"
             x:Name="RootSettingsControl"
             x:Class="CustomMcLauncher.Views.LauncherSettingsView"
             x:DataType="pages:LauncherSettingsViewModel"
             Background="{DynamicResource BgBrush}">

    <UserControl.Styles>
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sideTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.sideTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>

        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
        </Style>

        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style Selector="TextBlock.sectionHeaderTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.sectionHeaderDesc">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style Selector="TextBlock.itemTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.itemDesc">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="210,*">
            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" Padding="14,18"
                    BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBox Classes="darkInput" Text="{Binding SettingsSearchQuery}" PlaceholderText="Search settings..." Padding="9,7" FontSize="11.5" Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <!-- Category: Minecraft -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabGame}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Game">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Width="14" Height="14" Foreground="{Binding IsSettingsTabGame, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Minecraft" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGame, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Java Runtimes -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabJava}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Java">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M2,19H20V21H2V19M4,13H16V15H4V13M3,7H17V9H3V7M18,3V5H20V3H18M18,7V9H20V7H18M18,11V13H20V11H18M5,3H15V5H5V3Z" Width="14" Height="14" Foreground="{Binding IsSettingsTabJava, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Java Runtimes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabJava, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Launcher & System -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabGeneral}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="General">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Width="14" Height="14" Foreground="{Binding IsSettingsTabGeneral, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Launcher" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGeneral, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Appearance -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabAppearance}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Appearance">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34a2 2 0 0 0-2.83 0L9 10.83l4.17 4.17 7.54-7.54a2 2 0 0 0 0-2.83z" Width="14" Height="14" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Appearance" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" IsVisible="False"/>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" Padding="32,24,36,28" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsSettingsTabTheme}">
                <StackPanel Spacing="20">

                    <!-- ========================================================= -->
                    <!-- TAB 1: MINECRAFT & GAME                                   -->
                    <!-- ========================================================= -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsSettingsTabGame}">

                        <!-- Section: Memory (RAM) Allocation -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchMemoryVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="Memory Allocation"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Configure initial heap (-Xms) and maximum memory limit (-Xmx) for the game process."/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Min RAM -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Minimum Memory (-Xms)"/>
                                        <TextBlock Classes="itemDesc" Text="Initial amount of RAM allocated when Minecraft boots up."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Command="{Binding StepMinRamDownCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Decrease RAM">
                                            <PathIcon Data="M5 11h14v2H5z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="30" Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MinRamMb, StringFormat='{}{0} MB'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Command="{Binding StepMinRamUpCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Increase RAM">
                                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Max RAM -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Maximum Memory (-Xmx)"/>
                                        <TextBlock Classes="itemDesc" Text="Upper memory limit Minecraft is permitted to consume under load."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Command="{Binding StepRamDownCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Decrease RAM">
                                            <PathIcon Data="M5 11h14v2H5z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="30" Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RamMb, StringFormat='{}{0} MB'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Command="{Binding StepRamUpCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Increase RAM">
                                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Resolution & Display -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchResolutionVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="Window &amp; Resolution"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Default window size and fullscreen behavior applied on game launch."/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Launch Dimensions"/>
                                        <TextBlock Classes="itemDesc" Text="Window width and height in pixels when launched in windowed mode."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox Classes="darkInput" Text="{Binding GameWidth}" Width="80" Height="32" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox Classes="darkInput" Text="{Binding GameHeight}" Width="80" Height="32" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Lock 16:9 Aspect Ratio"/>
                                        <TextBlock Classes="itemDesc" Text="Automatically recalculate height to preserve widescreen proportion."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsLockAspectRatio}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchFullscreenVisible}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Launch Fullscreen"/>
                                        <TextBlock Classes="itemDesc" Text="Start Minecraft directly in exclusive fullscreen display."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsFullscreen}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Storage Strategy -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchDirectoryVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="Instance Directory Strategy"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Select how instance files, mods, and worlds are isolated on disk."/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Directory Isolation Mode"/>
                                        <TextBlock Classes="itemDesc" Text="Separate folder per instance prevents mod and world cross-contamination."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DirectoryModes}" SelectedItem="{Binding SelectedDirectoryMode}" Classes="darkCombo" Width="260" Height="32" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Version Filters -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchVersionFiltersVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="Version Filters"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Choose which Minecraft build channels are offered in profile creation."/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                                    <CheckBox Content="Releases" IsChecked="{Binding ShowReleases}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="Snapshots" IsChecked="{Binding ShowSnapshots}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="Betas" IsChecked="{Binding ShowBetas}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="Alphas" IsChecked="{Binding ShowAlphas}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Flat Version List"/>
                                        <TextBlock Classes="itemDesc" Text="Display all versions in a single flat list instead of nested version groups."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseFlatVersionList}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Custom JVM Arguments -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJvmArgsVisible}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="Custom JVM Arguments"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Global flags passed directly to the Java virtual machine on game launch."/>
                                </StackPanel>
                                <TextBox Classes="darkInput" Text="{Binding JvmArgs}" PlaceholderText="-XX:+UseG1GC -Dsun.rmi.dgc.server.gcInterval=2147483646" Height="36" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 2: JAVA RUNTIMES                                      -->
                    <!-- ========================================================= -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsSettingsTabJava}">

                        <!-- Section: Java Management Strategy -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="Java Management &amp; Mode"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Control how Java runtimes are selected and managed across profiles."/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Automatic Java Management"/>
                                        <TextBlock Classes="itemDesc" Text="Zenith automatically downloads and configures the exact required JDK per version."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoManageJava}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Java Selection Mode"/>
                                        <TextBlock Classes="itemDesc" Text="Recommended (auto-select per version), System (PATH), or Custom executable."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding JavaModes}" SelectedItem="{Binding SelectedJavaMode}" Classes="darkCombo" Width="200" Height="32" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Custom Java Path Input (Visible when Custom is selected) -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsCustomJavaMode}">
                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>
                                    <TextBlock Classes="itemTitle" Text="Custom Java Executable"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="darkInput" Text="{Binding CustomJavaPath}" PlaceholderText="C:\Program Files\Eclipse Adoptium\jdk-21\bin\javaw.exe" Height="34" FontSize="12"/>
                                        <Button Grid.Column="1" Classes="subBtn" Command="{Binding BrowseJavaPathCommand}" Content="Browse..." Height="34" Padding="14,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Java 25 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Java 25 (Latest Minecraft 1.21.5+)"/>
                                        <TextBlock Classes="itemDesc" Text="Modern JDK required for cutting-edge snapshots and future releases."/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="12" Padding="8,4" Background="{DynamicResource FieldBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" IsVisible="{Binding IsJava25Valid}"/>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" IsVisible="{Binding !IsJava25Valid}"/>
                                            <TextBlock Text="Installed &amp; Active" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" IsVisible="{Binding IsJava25Valid}"/>
                                            <TextBlock Text="Not Configured" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsJava25Valid}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBox Classes="darkInput" Text="{Binding Java25Location, Mode=TwoWay}" PlaceholderText="Auto-populated upon download or detect (/path/to/javaw.exe)" Height="34" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="25" Content="Auto Download" Padding="14,6"/>
                                    <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="25" Content="Detect" Padding="14,6"/>
                                    <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="25" Content="Browse..." Padding="14,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Java 21 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Java 21 (Minecraft 1.20.5 – 1.21.4)"/>
                                        <TextBlock Classes="itemDesc" Text="Standard LTS runtime for modern Minecraft releases."/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="12" Padding="8,4" Background="{DynamicResource FieldBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" IsVisible="{Binding IsJava21Valid}"/>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" IsVisible="{Binding !IsJava21Valid}"/>
                                            <TextBlock Text="Installed &amp; Active" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" IsVisible="{Binding IsJava21Valid}"/>
                                            <TextBlock Text="Not Configured" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsJava21Valid}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBox Classes="darkInput" Text="{Binding Java21Location, Mode=TwoWay}" PlaceholderText="Auto-populated upon download or detect (/path/to/javaw.exe)" Height="34" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="21" Content="Auto Download" Padding="14,6"/>
                                    <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="21" Content="Detect" Padding="14,6"/>
                                    <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="21" Content="Browse..." Padding="14,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Java 17 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Java 17 (Minecraft 1.18 – 1.20.4)"/>
                                        <TextBlock Classes="itemDesc" Text="LTS runtime used for Caves &amp; Cliffs and Trails &amp; Tales."/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="12" Padding="8,4" Background="{DynamicResource FieldBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" IsVisible="{Binding IsJava17Valid}"/>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" IsVisible="{Binding !IsJava17Valid}"/>
                                            <TextBlock Text="Installed &amp; Active" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" IsVisible="{Binding IsJava17Valid}"/>
                                            <TextBlock Text="Not Configured" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsJava17Valid}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBox Classes="darkInput" Text="{Binding Java17Location, Mode=TwoWay}" PlaceholderText="Auto-populated upon download or detect (/path/to/javaw.exe)" Height="34" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="17" Content="Auto Download" Padding="14,6"/>
                                    <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="17" Content="Detect" Padding="14,6"/>
                                    <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="17" Content="Browse..." Padding="14,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Java 8 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Java 8 (Legacy Minecraft 1.12 – 1.16.5)"/>
                                        <TextBlock Classes="itemDesc" Text="Legacy runtime essential for classic Forge modpacks and older versions."/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="12" Padding="8,4" Background="{DynamicResource FieldBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" IsVisible="{Binding IsJava8Valid}"/>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" IsVisible="{Binding !IsJava8Valid}"/>
                                            <TextBlock Text="Installed &amp; Active" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" IsVisible="{Binding IsJava8Valid}"/>
                                            <TextBlock Text="Not Configured" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsJava8Valid}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBox Classes="darkInput" Text="{Binding Java8Location, Mode=TwoWay}" PlaceholderText="Auto-populated upon download or detect (/path/to/javaw.exe)" Height="34" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="8" Content="Auto Download" Padding="14,6"/>
                                    <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="8" Content="Detect" Padding="14,6"/>
                                    <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="8" Content="Browse..." Padding="14,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 3: LAUNCHER & SYSTEM (General)                        -->
                    <!-- ========================================================= -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsSettingsTabGeneral}">

                        <!-- General Preferences -->
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="Interface &amp; System"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Language, integrations, and display scaling preferences."/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Language -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchLanguageVisible}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Interface Language"/>
                                        <TextBlock Classes="itemDesc" Text="Select your preferred language for all launcher views and menus."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" Classes="darkCombo" Width="180" Height="32" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Discord RPC -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchDiscordVisible}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Discord Rich Presence"/>
                                        <TextBlock Classes="itemDesc" Text="Display launcher activity and active Minecraft instance on your Discord profile."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordRpcEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- UI Scale -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Interface Scaling"/>
                                        <TextBlock Classes="itemDesc" Text="Adjust UI scale factor for high-resolution 2K/4K displays."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Slider Width="140" Minimum="0.8" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" Value="{Binding LauncherScale}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LauncherScale, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Integrations & API Keys -->
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="External Integrations"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Optional developer credentials for CurseForge and external catalogs."/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="itemTitle" Text="CurseForge API Key"/>
                                    <TextBlock Classes="itemDesc" Text="Enables searching and downloading maps and mods directly from CurseForge."/>
                                    <TextBox Classes="darkInput" Text="{Binding CurseForgeApiKey}" PlaceholderText="Enter your CurseForge API key" Height="36" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 4: APPEARANCE & THEME                                 -->
                    <!-- ========================================================= -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsSettingsTabAppearance}">
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchAppearanceVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="Visual Theme"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="Customize launcher colors, accent highlights, and visual elements."/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="itemTitle" Text="Theme Customizer"/>
                                        <TextBlock Classes="itemDesc" Text="Launch interactive theme editor to pick accents, card colors, and typography."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primaryBtn" Command="{Binding OpenThemeEditorCommand}" Content="Customize your theme" Padding="18,7" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Embedded Theme Editor View -->
            <views:ThemeSettingsView Grid.Column="1" DataContext="{Binding ThemeSettingsVm}" IsVisible="{Binding $parent[UserControl].((pages:LauncherSettingsViewModel)DataContext).IsSettingsTabTheme}"/>

        </Grid>

        <!-- MODAL: Restart Confirmation (Theme Application) -->
        <Border IsVisible="{Binding IsRestartConfirmOpen}" Background="{StaticResource OverlayBrush}" ZIndex="999">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Width="390" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr Key=dialog_restart_title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l10n:Tr Key=dialog_restart_theme_msg}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="17"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=no}" Command="{Binding CancelRestartConfirmCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="34"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmRestartAndApplyThemeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL: Discard Changes Confirmation (Tab Switching) -->
        <Border IsVisible="{Binding IsThemeDiscardConfirmOpen}" Background="{StaticResource OverlayBrush}" ZIndex="999">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Width="390" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr Key=dialog_discard_title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l10n:Tr Key=dialog_discard_theme_msg}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="17"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=no}" Command="{Binding CancelDiscardThemeChangesCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="34"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmDiscardThemeChangesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
