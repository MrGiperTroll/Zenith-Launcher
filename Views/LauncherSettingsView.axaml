<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:pages="using:CustomMcLauncher.ViewModels.Pages"
             xmlns:converters="using:CustomMcLauncher.Converters"
             xmlns:views="using:CustomMcLauncher.Views"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             xmlns:services="using:CustomMcLauncher.Services"
             x:Name="RootSettingsControl"
             x:Class="CustomMcLauncher.Views.LauncherSettingsView"
             x:DataType="pages:LauncherSettingsViewModel"
             Background="{DynamicResource BgBrush}">

    <UserControl.Styles>
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sideTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.sideTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
        </Style>

        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
        </Style>

        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style Selector="TextBlock.sectionHeaderTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.sectionHeaderDesc">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style Selector="TextBlock.itemTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="TextBlock.itemDesc">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="210,*">
            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" Padding="14,18"
                    BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBox Classes="darkInput" Text="{Binding SettingsSearchQuery}" PlaceholderText="{l10n:Tr set_search_placeholder}" Padding="9,7" FontSize="11.5" Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <!-- Category: Minecraft -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabGame}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Game">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Width="14" Height="14" Foreground="{Binding IsSettingsTabGame, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr set_game}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGame, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Java Runtimes -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabJava}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Java">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M2,21H20V19H2M20,8H18V5H20M20,3H4V13A4,4 0 0,0 8,17H14A4,4 0 0,0 18,13V10H20A2,2 0 0,0 22,8V5C22,3.89 21.1,3 20,3Z" Width="14" Height="14" Foreground="{Binding IsSettingsTabJava, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr set_java}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabJava, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Launcher & System -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabGeneral}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="General">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Width="14" Height="14" Foreground="{Binding IsSettingsTabGeneral, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr set_launcher_settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGeneral, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>

                        <!-- Category: Appearance -->
                        <Button Classes="sideTab" Classes.active="{Binding IsSettingsTabAppearance}" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Appearance">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34a2 2 0 0 0-2.83 0L9 10.83l4.17 4.17 7.54-7.54a2 2 0 0 0 0-2.83z" Width="14" Height="14" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static converters:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr set_appearance}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static converters:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" IsVisible="False"/>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" Padding="32,24,36,28" VerticalScrollBarVisibility="Visible">
                <StackPanel Spacing="20">

                    <!-- ========================================================= -->
                    <!-- TAB 1: MINECRAFT & GAME                                   -->
                    <!-- ========================================================= -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsSettingsTabGame}">

                        <!-- Section: Memory (RAM) Allocation -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchMemoryVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_memory}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_memory_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Min RAM -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_min_memory}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_min_memory_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Command="{Binding StepMinRamDownCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Decrease RAM">
                                            <PathIcon Data="M5 11h14v2H5z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="30" Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MinRamMb, StringFormat='{}{0} MB'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Command="{Binding StepMinRamUpCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Increase RAM">
                                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Max RAM -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_max_memory}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_max_memory_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Command="{Binding StepRamDownCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Decrease RAM">
                                            <PathIcon Data="M5 11h14v2H5z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="30" Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RamMb, StringFormat='{}{0} MB'}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Command="{Binding StepRamUpCommand}" Classes="subBtn" Width="30" Height="30" Padding="0" ToolTip.Tip="Increase RAM">
                                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Resolution & Display -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchResolutionVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_window_resolution}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_window_resolution_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_resolution}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_resolution_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox Classes="darkInput" Text="{Binding GameWidth}" Width="80" Height="32" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox Classes="darkInput" Text="{Binding GameHeight}" Width="80" Height="32" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_lock_aspect_ratio}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_lock_aspect_ratio_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsLockAspectRatio}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchFullscreenVisible}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_fullscreen}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_fullscreen_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsFullscreen}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Storage Strategy -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchDirectoryVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_dirstrategy}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_dirstrategy_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_dirstrategy}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_dirstrategy_hint}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DirectoryModes}" SelectedItem="{Binding SelectedDirectoryMode}" Classes="darkCombo" Width="260" Height="32" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Version Filters -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchVersionFiltersVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_versionfilters}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_versionfilters_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                                    <CheckBox Content="{l10n:Tr Key=vf_releases}" IsChecked="{Binding ShowReleases}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="{l10n:Tr Key=vf_snapshots}" IsChecked="{Binding ShowSnapshots}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="{l10n:Tr Key=vf_betas}" IsChecked="{Binding ShowBetas}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                    <CheckBox Content="{l10n:Tr Key=vf_alphas}" IsChecked="{Binding ShowAlphas}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_flat_version_list}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_flat_version_list_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseFlatVersionList}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Custom JVM Arguments -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJvmArgsVisible}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_jvmargs}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_jvmargs_hint}"/>
                                </StackPanel>
                                <TextBox Classes="darkInput" Text="{Binding JvmArgs}" PlaceholderText="-XX:+UseG1GC -Dsun.rmi.dgc.server.gcInterval=2147483646" Height="36" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 2: JAVA RUNTIMES                                      -->
                    <!-- ========================================================= -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsSettingsTabJava}">

                        <!-- Section: Java Management Strategy -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_java}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_java_mode_desc}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_autojava}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_autojava_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoManageJava}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java 25 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="itemTitle" Text="Java 25"/>
                                <TextBox Classes="darkInput" Text="{Binding Java25Location, Mode=TwoWay}" PlaceholderText="Auto-populated upon download or detect (/path/to/javaw.exe)" Height="34" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="25" Content="{Binding Java25DownloadButtonText}" IsEnabled="{Binding !IsJava25Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="25" Content="{l10n:Tr Key=btn_detect}" IsEnabled="{Binding !IsJava25Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="25" Content="{l10n:Tr Key=btn_browse}" IsEnabled="{Binding !IsJava25Downloading}" Padding="14,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsJava25Downloading}">
                                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java 21 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="itemTitle" Text="Java 21"/>
                                <TextBox Classes="darkInput" Text="{Binding Java21Location, Mode=TwoWay}" PlaceholderText="Auto-populated upon download or detect (/path/to/javaw.exe)" Height="34" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="21" Content="{Binding Java21DownloadButtonText}" IsEnabled="{Binding !IsJava21Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="21" Content="{l10n:Tr Key=btn_detect}" IsEnabled="{Binding !IsJava21Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="21" Content="{l10n:Tr Key=btn_browse}" IsEnabled="{Binding !IsJava21Downloading}" Padding="14,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsJava21Downloading}">
                                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java 17 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="itemTitle" Text="Java 17"/>
                                <TextBox Classes="darkInput" Text="{Binding Java17Location, Mode=TwoWay}" PlaceholderText="Auto-populated upon download or detect (/path/to/javaw.exe)" Height="34" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="17" Content="{Binding Java17DownloadButtonText}" IsEnabled="{Binding !IsJava17Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="17" Content="{l10n:Tr Key=btn_detect}" IsEnabled="{Binding !IsJava17Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="17" Content="{l10n:Tr Key=btn_browse}" IsEnabled="{Binding !IsJava17Downloading}" Padding="14,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsJava17Downloading}">
                                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Java 8 Card -->
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="itemTitle" Text="Java 8"/>
                                <TextBox Classes="darkInput" Text="{Binding Java8Location, Mode=TwoWay}" PlaceholderText="Auto-populated upon download or detect (/path/to/javaw.exe)" Height="34" FontSize="12"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primaryBtn" Command="{Binding InstallJavaCommand}" CommandParameter="8" Content="{Binding Java8DownloadButtonText}" IsEnabled="{Binding !IsJava8Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding DetectJavaCommand}" CommandParameter="8" Content="{l10n:Tr Key=btn_detect}" IsEnabled="{Binding !IsJava8Downloading}" Padding="14,6"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseJavaCommand}" CommandParameter="8" Content="{l10n:Tr Key=btn_browse}" IsEnabled="{Binding !IsJava8Downloading}" Padding="14,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsJava8Downloading}">
                                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 3: LAUNCHER & SYSTEM (General)                        -->
                    <!-- ========================================================= -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsSettingsTabGeneral}">

                        <!-- General Preferences -->
                        <Border Classes="settingsCard">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr set_general}"/>
                                    <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr set_general_hint}"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Discord RPC -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSearchDiscordVisible}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_discord}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_discord_hint}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordRpcEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- UI Scale -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_ui_scale}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_ui_scale_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Width="140" Minimum="0.8" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                                                Value="{Binding PendingLauncherScale, Mode=TwoWay}"
                                                PointerCaptureLost="OnScaleSliderPointerCaptureLost"
                                                PointerReleased="OnScaleSliderPointerReleased"
                                                KeyUp="OnScaleSliderKeyUp"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PendingLauncherScale, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- TAB 4: APPEARANCE                                         -->
                    <!-- ========================================================= -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsSettingsTabAppearance}">
                        <Border Classes="settingsCard" IsVisible="{Binding IsSearchAppearanceVisible}">
                            <StackPanel Spacing="16">
                                <!-- Theme Mode Header + Dropdown -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="sectionHeaderTitle" Text="{l10n:Tr theme_mode}"/>
                                        <TextBlock Classes="sectionHeaderDesc" Text="{l10n:Tr theme_mode_desc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedThemeModeItem}" Classes="darkCombo" MinWidth="130" Height="32" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="pages:ThemeModeItem">
                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="2,0">
                                                    <PathIcon Grid.Column="0" Data="{Binding IconData}" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <!-- Theme Preview Cards Grid -->
                                <ItemsControl ItemsSource="{Binding ThemeCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="pages:ThemeCardModel">
                                            <Button Command="{Binding $parent[UserControl].((pages:LauncherSettingsViewModel)DataContext).SelectThemeCardCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,12,12"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Style>
                                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Style>
                                                </Button.Styles>
                                                <StackPanel Spacing="7" Width="144">
                                                    <!-- Outer Card Container -->
                                                    <Border Background="{DynamicResource CardBrush}"
                                                            CornerRadius="8"
                                                            Height="84"
                                                            Padding="12,10"
                                                            BorderThickness="{Binding CardBorderThickness}"
                                                            BorderBrush="{Binding CardBorderBrush}">
                                                        <Grid RowDefinitions="Auto,Auto,*">
                                                            <!-- Row 0: Top Accent Pill + Radio Checkmark -->
                                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                <Border Grid.Column="0" Width="48" Height="6" CornerRadius="3" Background="{Binding AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1" Width="16" Height="16" CornerRadius="8"
                                                                        BorderBrush="{Binding RadioBorderBrush}"
                                                                        BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="{Binding AccentBrush}" IsVisible="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Row 1: Sub line below pill -->
                                                            <Border Grid.Row="1" Width="36" Height="4" CornerRadius="2" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Left" Margin="0,5,0,6"/>

                                                            <!-- Row 2: Window surface with 2 mock bars -->
                                                            <Border Grid.Row="2" CornerRadius="5" Background="{DynamicResource BgBrush}" Padding="8,6" VerticalAlignment="Stretch">
                                                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                                                    <Border Width="42" Height="5" CornerRadius="2.5" Background="{Binding SoftBrush}" HorizontalAlignment="Left"/>
                                                                    <Border Width="26" Height="5" CornerRadius="2.5" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    
                                                    <!-- Theme Name Label -->
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{Binding NameForegroundBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Custom Theme Configuration Panel (Studio Design) -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18,16" IsVisible="{Binding IsCustomThemeActive}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <!-- Studio Header -->
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{l10n:Tr set_custom_theme}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{l10n:Tr set_custom_theme_hint}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="subBtn" Command="{Binding AutoHarmonizeCustomPaletteCommand}" Height="28" Padding="12,0" VerticalAlignment="Center" ToolTip.Tip="Automatically harmonize background and surface contrast">
                                                <TextBlock Text="Auto Harmonize" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                        <!-- Accent Color Section -->
                                        <Grid ColumnDefinitions="140,*,Auto" VerticalAlignment="Center">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Accent Color" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Primary brand color" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Button Classes="subBtn" Command="{Binding PickQuickCustomColorCommand}" CommandParameter="#8B5CF6" Width="24" Height="24" CornerRadius="12" Background="#8B5CF6" Padding="0" BorderThickness="0" ToolTip.Tip="Zenith Purple"/>
                                                <Button Classes="subBtn" Command="{Binding PickQuickCustomColorCommand}" CommandParameter="#3B82F6" Width="24" Height="24" CornerRadius="12" Background="#3B82F6" Padding="0" BorderThickness="0" ToolTip.Tip="Cobalt Blue"/>
                                                <Button Classes="subBtn" Command="{Binding PickQuickCustomColorCommand}" CommandParameter="#10B981" Width="24" Height="24" CornerRadius="12" Background="#10B981" Padding="0" BorderThickness="0" ToolTip.Tip="Emerald Green"/>
                                                <Button Classes="subBtn" Command="{Binding PickQuickCustomColorCommand}" CommandParameter="#06B6D4" Width="24" Height="24" CornerRadius="12" Background="#06B6D4" Padding="0" BorderThickness="0" ToolTip.Tip="Mint Cyan"/>
                                                <Button Classes="subBtn" Command="{Binding PickQuickCustomColorCommand}" CommandParameter="#EAB308" Width="24" Height="24" CornerRadius="12" Background="#EAB308" Padding="0" BorderThickness="0" ToolTip.Tip="Amber Gold"/>
                                                <Button Classes="subBtn" Command="{Binding PickQuickCustomColorCommand}" CommandParameter="#FB923C" Width="24" Height="24" CornerRadius="12" Background="#FB923C" Padding="0" BorderThickness="0" ToolTip.Tip="Parchment Peach"/>
                                                <Button Classes="subBtn" Command="{Binding PickQuickCustomColorCommand}" CommandParameter="#EC4899" Width="24" Height="24" CornerRadius="12" Background="#EC4899" Padding="0" BorderThickness="0" ToolTip.Tip="Rose Pink"/>
                                                <Button Classes="subBtn" Command="{Binding PickQuickCustomColorCommand}" CommandParameter="#EF4444" Width="24" Height="24" CornerRadius="12" Background="#EF4444" Padding="0" BorderThickness="0" ToolTip.Tip="Crimson Red"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Width="26" Height="26" CornerRadius="6" Background="{Binding CustomAccentBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1.5" Padding="0" Cursor="Hand" ToolTip.Tip="Pick Accent Color">
                                                    <Button.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedRight">
                                                            <ColorView Color="{Binding CustomAccentHex, Mode=TwoWay, Converter={x:Static converters:HexToColorConverter.Instance}}" ColorModel="Rgba" IsAlphaVisible="False"/>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <TextBox Classes="darkInput" Text="{Binding CustomAccentHex}" Width="85" Height="28" FontSize="11.5" VerticalAlignment="Center" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Atmosphere Tone Presets -->
                                        <Grid ColumnDefinitions="140,*" VerticalAlignment="Center">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Base Atmosphere" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Window tone preset" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="subBtn" Command="{Binding SetCustomBaseToneCommand}" CommandParameter="Dark" Height="28" Padding="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Charcoal Dark" FontSize="11"/>
                                                </Button>
                                                <Button Classes="subBtn" Command="{Binding SetCustomBaseToneCommand}" CommandParameter="Oled" Height="28" Padding="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="OLED Pitch Black" FontSize="11"/>
                                                </Button>
                                                <Button Classes="subBtn" Command="{Binding SetCustomBaseToneCommand}" CommandParameter="Light" Height="28" Padding="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Clean Light" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Background & Surface Color Pickers -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" VerticalAlignment="Center">
                                            <!-- Window Background -->
                                            <Border Background="{DynamicResource FieldBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="Window Background" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="Base window canvas" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Width="24" Height="24" CornerRadius="5" Background="{Binding CustomBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1.5" Padding="0" Cursor="Hand" ToolTip.Tip="Pick Background Color">
                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                                    <ColorView Color="{Binding CustomBgHex, Mode=TwoWay, Converter={x:Static converters:HexToColorConverter.Instance}}" ColorModel="Rgba" IsAlphaVisible="False"/>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <TextBox Classes="darkInput" Text="{Binding CustomBgHex}" Width="80" Height="26" FontSize="11" VerticalAlignment="Center" TextAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Cards & Surfaces -->
                                            <Border Background="{DynamicResource FieldBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="Cards &amp; Panels" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="Surface container color" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Width="24" Height="24" CornerRadius="5" Background="{Binding CustomCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1.5" Padding="0" Cursor="Hand" ToolTip.Tip="Pick Card Surface Color">
                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                                    <ColorView Color="{Binding CustomCardHex, Mode=TwoWay, Converter={x:Static converters:HexToColorConverter.Instance}}" ColorModel="Rgba" IsAlphaVisible="False"/>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <TextBox Classes="darkInput" Text="{Binding CustomCardHex}" Width="80" Height="26" FontSize="11" VerticalAlignment="Center" TextAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Miniature Real-Life Launcher Preview -->
                                        <Border CornerRadius="8" Background="{Binding CustomBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" ClipToBounds="True">
                                            <Grid RowDefinitions="26,80">
                                                <!-- Mock Title Bar -->
                                                <Border Grid.Row="0" Background="{Binding CustomCardBrush}" Padding="10,0">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <Border Width="7" Height="7" CornerRadius="3.5" Background="#FF5F56"/>
                                                            <Border Width="7" Height="7" CornerRadius="3.5" Background="#FFBD2E"/>
                                                            <Border Width="7" Height="7" CornerRadius="3.5" Background="#27C93F"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="Zenith Launcher" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Width="12"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Mock Body -->
                                                <Grid Grid.Row="1" ColumnDefinitions="60,*">
                                                    <!-- Mock Sidebar -->
                                                    <Border Grid.Column="0" Background="{Binding CustomCardBrush}" Padding="6,8">
                                                        <StackPanel Spacing="5">
                                                            <Border Height="14" CornerRadius="4" Background="{Binding CustomAccentBrush}" Padding="4,0">
                                                                <Border Width="24" Height="3" CornerRadius="1.5" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border Width="36" Height="4" CornerRadius="2" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Left"/>
                                                            <Border Width="28" Height="4" CornerRadius="2" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Mock Main Content -->
                                                    <Border Grid.Column="1" Padding="12,8">
                                                        <Border Background="{Binding CustomCardBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" Padding="10,8">
                                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                                    <Border Width="80" Height="5" CornerRadius="2.5" Background="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                                                                    <Border Width="110" Height="4" CornerRadius="2" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="{Binding CustomAccentBrush}" CornerRadius="5" Padding="12,5" VerticalAlignment="Center">
                                                                    <TextBlock Text="Launch" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Studio Bottom Action Bar -->
                                        <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="Restart required to re-evaluate static theme styles" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="subBtn" Command="{Binding ResetCustomThemeCommand}" Height="34" Padding="16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Reset to Defaults" FontSize="11.5"/>
                                            </Button>
                                            <Button Grid.Column="2" Classes="primaryBtn" Command="{Binding ApplyCustomThemeCommand}" Height="34" Padding="20,0" VerticalAlignment="Center">
                                                <TextBlock Text="{l10n:Tr set_apply}" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Language Selector -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_language}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_language_hint}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" Classes="darkCombo" Width="180" Height="32" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}"/>

                                <!-- Font Style Selector -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Classes="itemTitle" Text="{l10n:Tr set_font_style}"/>
                                        <TextBlock Classes="itemDesc" Text="{l10n:Tr set_font_style_hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomFontDisplayName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsCustomFontOption}" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                        <Button Classes="subBtn" Command="{Binding BrowseCustomFontCommand}" ToolTip.Tip="Select custom font file (*.ttf, *.otf)" Height="32" Padding="10,0" VerticalAlignment="Center" IsVisible="{Binding IsCustomFontOption}">
                                            <TextBlock Text="{l10n:Tr btn_browse}" FontSize="11.5"/>
                                        </Button>
                                        <ComboBox ItemsSource="{Binding FontStyleOptions}" SelectedItem="{Binding SelectedFontStyle}" Classes="darkCombo" Width="160" Height="32" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- MODAL: Theme Restart Confirmation -->
        <Border IsVisible="{Binding IsThemeRestartDialogOpen}"
                Background="#99000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="1000">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="400"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr dialog_restart_title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{l10n:Tr dialog_restart_theme_msg}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" LineHeight="18"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=no}" Command="{Binding CancelThemeRestartCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="36"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmThemeRestartCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
