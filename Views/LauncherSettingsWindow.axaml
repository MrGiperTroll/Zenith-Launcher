<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CustomMcLauncher.ViewModels"
        xmlns:views="using:CustomMcLauncher.Views"
        xmlns:l10n="using:CustomMcLauncher.Extensions"
        xmlns:services="using:CustomMcLauncher.Services"
        x:Name="RootSettingsWindow"
        x:Class="CustomMcLauncher.Views.LauncherSettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{l10n:Tr set_window_title}"
        Width="700" Height="540"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        CanResize="True">

    <Window.Styles>
        <Style Selector="TextBox.darkInput">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="CheckBox:checked">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.sideTab:pointerover">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        </Style>
        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource CardAltBrush}">
        <Panel>
            <Grid ColumnDefinitions="180,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBox Classes="darkInput" Text="{Binding SettingsSearchQuery}" PlaceholderText="{l10n:Tr Key=ph_search}" Padding="8,6" FontSize="11" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <Button Classes="sideTab" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Game"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Button.Styles>
                                <Style Selector="Button.sideTab.active">
                                    <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                </Style>
                            </Button.Styles>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Width="15" Height="15" Foreground="{Binding IsSettingsTabGame, Converter={x:Static vm:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=set_game}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGame, Converter={x:Static vm:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>
                        <Button Classes="sideTab" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="General"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Button.Styles>
                                <Style Selector="Button.sideTab.active">
                                    <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                </Style>
                            </Button.Styles>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Width="15" Height="15" Foreground="{Binding IsSettingsTabGeneral, Converter={x:Static vm:EditInstanceWindowConverters.ActiveIcon}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=set_general}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabGeneral, Converter={x:Static vm:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>
                        <Button Classes="sideTab" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Appearance"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Button.Styles>
                                <Style Selector="Button.sideTab.active">
                                    <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                </Style>
                            </Button.Styles>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" Background="{StaticResource IconChipBrush}" CornerRadius="7" VerticalAlignment="Center">
                                    <Path Data="{StaticResource ZenithLogoGeometry}" Fill="{Binding IsSettingsTabAppearance, Converter={x:Static vm:EditInstanceWindowConverters.ActiveIcon}}" Stretch="Uniform" Width="15" Height="15" Margin="0,1.5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{Binding IsSettingsTabAppearance, Converter={x:Static vm:EditInstanceWindowConverters.ActiveText}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding WindowTitle}" FontSize="10" Foreground="{StaticResource TextCaptionBrush}" HorizontalAlignment="Left" Margin="10,0,0,6"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Column="1" Padding="20,16,26,16" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">
                    <!-- Game Settings -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsSettingsTabGame}">
                        <TextBlock Text="{l10n:Tr set_game}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>

                        <!-- Compact Memory Configuration (Min / Max RAM) -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" IsVisible="{Binding IsSearchMemoryVisible}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{l10n:Tr set_memory}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>

                                <!-- Min RAM Row -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="{l10n:Tr set_min_memory}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Compact Counter Row -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Command="{Binding StepMinRamDownCommand}" Classes="subBtn" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Decrease RAM">
                                            <PathIcon Data="M5 11h14v2H5z" Width="9" Height="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="5" Height="26" Padding="8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox Classes="badgeInput" Text="{Binding MinRamMb, Mode=TwoWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextAlignment="Right" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" MinWidth="34"/>
                                                <TextBlock Text="MB" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Command="{Binding StepMinRamUpCommand}" Classes="subBtn" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Increase RAM">
                                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="9" Height="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Max RAM Row -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="{l10n:Tr set_max_memory}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Compact Counter Row -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Command="{Binding StepRamDownCommand}" Classes="subBtn" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Decrease RAM">
                                            <PathIcon Data="M5 11h14v2H5z" Width="9" Height="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="5" Height="26" Padding="8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox Classes="badgeInput" Text="{Binding RamMb, Mode=TwoWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextAlignment="Right" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" MinWidth="34"/>
                                                <TextBlock Text="MB" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Command="{Binding StepRamUpCommand}" Classes="subBtn" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Increase RAM">
                                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="9" Height="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Resolution -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsSearchResolutionVisible}">
                            <TextBlock Text="{l10n:Tr set_resolution}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnDefinitions="Auto,60,14,60,14,Auto,Auto" VerticalAlignment="Center">
                                <TextBlock Text="W" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding GameWidth}" FontSize="12" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="26"/>
                                <TextBlock Grid.Column="2" Text="×" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox Grid.Column="3" Classes="darkInput" Text="{Binding GameHeight}" FontSize="12" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="26"/>
                                <TextBlock Grid.Column="4" Text="H" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <CheckBox Grid.Column="5" IsChecked="{Binding IsLockAspectRatio}" Content="{l10n:Tr Key=lock_ratio}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Fullscreen -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsSearchFullscreenVisible}" Margin="0,4,0,0">
                            <CheckBox Content="{l10n:Tr set_fullscreen}" IsChecked="{Binding IsFullscreen}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Java Runtime -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsSearchJavaVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{l10n:Tr set_java}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{l10n:Tr set_java_hint}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            <CheckBox Content="{l10n:Tr set_autojava}" IsChecked="{Binding AutoManageJava}" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <Grid ColumnDefinitions="190,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <ComboBox Grid.Column="0" MinHeight="30" ItemsSource="{Binding JavaModes}" SelectedItem="{Binding SelectedJavaMode}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static vm:JavaModeDisplayConverter.Instance}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Classes="subBtn" Width="30" Height="30" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="{l10n:Tr Key=java_plus_tip}"
                                        Command="{Binding OpenJavaInstallerCommand}">
                                    <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="11" Height="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentJavaDisplay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <!-- Always-Visible Editable Java Path Row + Browse Button -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Classes="darkInput" Text="{Binding EffectiveJavaPath}" PlaceholderText="{l10n:Tr Key=custom_java_hint}" FontSize="11" Padding="8,5"/>
                                <Button Grid.Column="1" Classes="subBtn" Content="{l10n:Tr Key=btn_browse}" Command="{Binding BrowseJavaPathCommand}" Padding="12,0" Height="30" FontSize="11" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- General Settings -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsSettingsTabGeneral}">
                        <TextBlock Text="{l10n:Tr set_general}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>

                        <StackPanel Spacing="6" IsVisible="{Binding IsSearchDirectoryVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{l10n:Tr set_dirstrategy}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{l10n:Tr set_dirstrategy_hint}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            <ComboBox ItemsSource="{Binding DirectoryModes}" SelectedItem="{Binding SelectedDirectoryMode}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static vm:DirectoryModeDisplayConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsSearchVersionFiltersVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{l10n:Tr set_versionfilters}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                <CheckBox Content="{l10n:Tr vf_releases}" IsChecked="{Binding ShowReleases}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <CheckBox Content="{l10n:Tr vf_snapshots}" IsChecked="{Binding ShowSnapshots}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <CheckBox Content="{l10n:Tr vf_betas}" IsChecked="{Binding ShowBetas}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <CheckBox Content="{l10n:Tr vf_alphas}" IsChecked="{Binding ShowAlphas}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <CheckBox Content="{l10n:Tr vf_flatlist}" IsChecked="{Binding UseFlatVersionList}" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsSearchJvmArgsVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{l10n:Tr set_jvmargs}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{l10n:Tr set_jvmargs_hint}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            <TextBox Classes="darkInput" Text="{Binding JvmArgs}" PlaceholderText="-XX:+UseG1GC ..." Padding="8,6" FontSize="11" AcceptsReturn="True" Height="54" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsSearchLanguageVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{l10n:Tr set_language}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{l10n:Tr set_language_hint}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsSearchDiscordVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="{l10n:Tr set_discord}" IsChecked="{Binding DiscordRpcEnabled}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{l10n:Tr set_discord_hint}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Settings (Appearance & Themes) -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsSettingsTabAppearance}">
                        <TextBlock Text="{l10n:Tr Key=nav_settings}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>

                        <!-- Theme Presets Card (Lunar Client Style) -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" IsVisible="{Binding IsSearchAppearanceVisible}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{l10n:Tr Key=set_theme}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=set_theme_hint}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                </StackPanel>

                                <!-- Grid of Presets -->
                                <ItemsControl ItemsSource="{Binding AvailableThemes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:ThemePreset">
                                            <Button Command="{Binding #RootSettingsWindow.((vm:MainWindowViewModel)DataContext).ChooseThemeCommand}"
                                                    CommandParameter="{Binding HexColor}"
                                                    Classes="subBtn"
                                                    Margin="0,0,8,8"
                                                    Padding="12,7"
                                                    CornerRadius="8"
                                                    VerticalContentAlignment="Center"
                                                    HorizontalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="{Binding ColorBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Live Component Accent Preview Box -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Accent Preview" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPlaceholderBrush}" LetterSpacing="0.5"/>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                            <!-- Sample Primary Button -->
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="14,7" VerticalAlignment="Center">
                                                <TextBlock Text="Primary Button" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                                            </Border>
                                            <!-- Sample Badge -->
                                            <Border Grid.Column="1" Background="{DynamicResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                                <TextBlock Text="Accent Pill" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <!-- Sample Text -->
                                            <TextBlock Grid.Column="2" Text="{Binding CustomThemeHex}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Custom Theme Hex Input & Apply Action -->
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{l10n:Tr Key=set_custom_theme}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" VerticalAlignment="Center" ToolTip.Tip="Selected Accent"/>
                                            <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding CustomThemeHex, Mode=TwoWay}" PlaceholderText="#3B82F6" Height="36" VerticalContentAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12" FontWeight="SemiBold"/>
                                            <Button Grid.Column="2" Classes="primaryBtn" Command="{Binding RequestApplyThemeCommand}" Height="36" Padding="18,0" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Content="{l10n:Tr Key=set_apply}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- MODAL: Restart Confirmation (Theme Application) -->
        <Border IsVisible="{Binding IsRestartConfirmOpen}" Background="{StaticResource OverlayBrush}" ZIndex="999">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="390" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                            <PathIcon Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 004 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{l10n:Tr Key=dialog_restart_title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{l10n:Tr Key=dialog_restart_theme_msg}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="17"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=no}" Command="{Binding CancelRestartConfirmCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="34"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmRestartAndApplyThemeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        </Panel>
    </Border>
</Window>
