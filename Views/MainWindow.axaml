<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CustomMcLauncher.Controls"
        xmlns:vm="using:CustomMcLauncher.ViewModels"
        xmlns:converters="using:CustomMcLauncher.Converters"
        xmlns:models="using:CustomMcLauncher.Models"
        xmlns:items="using:CustomMcLauncher.ViewModels.Items"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:views="using:CustomMcLauncher.Views"
        xmlns:dialogs="using:CustomMcLauncher.ViewModels.Dialogs"
        xmlns:l10n="using:CustomMcLauncher.Extensions"
        x:Class="CustomMcLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Zenith Launcher"
        Width="1280" Height="780"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{DynamicResource BgBrush}"
        BorderThickness="0"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        WindowDecorations="None"
        FontFamily="{DynamicResource AppFontFamily}"
        Opacity="1">

<Window.Resources>
        <Geometry x:Key="ZenithLogoGeometry">M558.344 400.366C571.623 396.064 583.658 391.147 596.643 386.115L637.625 370.625C666.622 359.837 696.309 350.113 724.897 338.366C711.898 350.999 699.747 364.104 687.038 376.719L556.158 505.636C528.781 532.184 499.524 557.819 471.784 584.055L472.073 585.667C476.856 583.156 484.671 580.042 489.84 577.808L518.249 565.513C554.358 550.211 585.042 537.696 622.348 525.143C627.132 534.236 632.665 542.719 638.059 551.443C646.7 565.735 655.599 579.868 664.753 593.837C684.178 624.592 703.87 655.179 723.825 685.593C671.712 673.401 619.504 661.62 567.205 650.251C523.932 640.119 480.502 630.67 436.931 621.909L303.856 685C318.881 668.775 337.163 651.35 352.875 635.346C390.704 596.217 429.114 557.655 468.092 519.67L513.838 474.463C528.25 459.985 544.85 442.908 560.302 429.712C517.215 444.062 474.236 458.735 431.37 473.73C410.21 481.268 388.993 488.646 367.72 495.861C348.57 502.154 326.751 508.351 307.223 514.086C305.97 514.433 305.093 514.578 303.819 514.805L303.707 514.31L306.212 512.571L391.909 457.609C402.704 450.675 415.614 441.623 426.327 435.161C417.499 427.886 408.138 420.933 399.024 413.993C375.58 396.139 352.079 378.374 328.775 360.334C319.433 353.102 309.717 346.407 300.549 338.932C348.224 351.261 396.066 362.933 444.063 373.946L526.132 392.828C536.8 395.328 547.762 397.627 558.344 400.366Z</Geometry>

        <converters:BoolToBorderBrushConverter x:Key="BoolToBorderBrushConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Тонкий скроллбар -->
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Поле заголовка без синих рамок и фона при фокусе -->
        <Style Selector="TextBox.titleInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBox.titleInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.titleInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.railBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="ToolTip.Placement" Value="Right"/>
            <Setter Property="ToolTip.HorizontalOffset" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
                                    </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.railBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.railBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.railBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.railBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.railBtn.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.railBtn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.railBtn.active:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Border.expanded Button.railBtn">
            <Setter Property="Width" Value="164"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.expanded Button.railBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.expanded Button.railBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.expanded Button.railBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.expanded Button.railBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.expanded Button.railBtn.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.expanded Button.railBtn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.expanded Button.railBtn.active:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Cards -->
        <Style Selector="Button.cardBtn">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cardBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Instance card border (no Button wrapper — Border handles click + drag) -->
        <Style Selector="Border.instanceCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.instanceCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        </Style>

        <!-- Primary Buttons -->
        <Style Selector="Button.primaryBtn">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>

        <!-- Secondary Buttons -->
        <Style Selector="Button.subBtn">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- Danger Buttons -->
        <Style Selector="Button.dangerBtn">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.dangerBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- Catalog top tab pill styles -->
        <Style Selector="Button.catalogTabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.catalogTabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.catalogTabBtn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.catalogTabBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>

        <!-- Catalog item install button style matching reference -->
        <Style Selector="Button.catalogInstallBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.catalogInstallBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.catalogInstallBtn.installed">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
        </Style>
        <Style Selector="Button.catalogInstallBtn.installed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>

        <Style Selector="Button.installedBtn">
            <Setter Property="Width" Value="114"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.installedBtn.installed">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.installedBtn.installed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.installedBtn.installing">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.installedBtn.installing:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.sourceTabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sourceTabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.sourceTabBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.modpackInstalledBtn">
            <Setter Property="Width" Value="114"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.1" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modpackInstalledBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modpackInstalledBtn.installed">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.modpackInstalledBtn.installed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.modpackInstalledBtn.installing">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.modpackInstalledBtn.installing:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Icon Change Button without square hover artifact -->
        <Style Selector="Button.iconChangeBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="Button.iconChangeBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.dialogBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dialogBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>
        <Style Selector="Button.dialogDanger">
            <Setter Property="Background" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogDanger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.sourceBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.sourceBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>


        <!-- Sidebar Tabs -->
        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="{StaticResource PanelBrushTransparent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.sideTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        </Style>

        <!-- Navigation Buttons (<, >) -->
        <Style Selector="Button.navBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.navBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.navBtn:disabled">
            <Setter Property="Opacity" Value="0.3"/>
        </Style>

        <!-- Update Button: circle arrow flanked by side lines; pill auto-fits label, arrow stays pinned -->
        <Style Selector="Button.updateBtn">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="MaxWidth" Value="29"/>
            <Setter Property="CornerRadius" Value="14.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.updateBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Button.updateBtn:pointerover">
            <Setter Property="MaxWidth" Value="132"/>
        </Style>

        <!-- Breadcrumb Item Buttons -->
        <Style Selector="Button.breadcrumbBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Button.breadcrumbBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.breadcrumbBtn.active">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Header Account Button -->
        <Style Selector="Button.headerAccountBtn">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.headerAccountBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        </Style>
        <!-- Top Menu Bar Buttons -->
        <Style Selector="Button.menuBarBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Button.menuBarBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Menu Flyout Item Button -->
        <Style Selector="Button.menuItemBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.menuItemBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Window Caption Controls -->
        <Style Selector="Button.captionBtn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.captionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.captionCloseBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.captionCloseBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- Discord-Style Navigation Buttons -->
        <Style Selector="Button.discordNavBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.discordNavBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.discordNavBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.discordNavBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.discordNavBtn.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.gearSettingsBtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.gearSettingsBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.gearSettingsBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="12"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderDarkBrush}"
            BorderThickness="1"
            ClipToBounds="True">
    <Panel Background="{DynamicResource BgBrush}">
        
        <LayoutTransformControl>
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding LauncherScale}" ScaleY="{Binding LauncherScale}"/>
            </LayoutTransformControl.LayoutTransform>
            <Grid RowDefinitions="38,*">
                <!-- Unified Top Header (Row 0) -->
                <Grid Grid.Row="0" Height="38" Background="{DynamicResource SidebarBgBrush}"
                      ColumnDefinitions="220,*,Auto"
                      PointerPressed="OnTopBarPointerPressed"
                      DoubleTapped="OnTopBarDoubleTapped">

                    <!-- Left (Col 0, Width 220): Zenith Brand Menu -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Button Classes="menuBarBtn" Padding="8,5">
                            <TextBlock Text="Zenith Launcher" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
                                    <Flyout.FlyoutPresenterTheme>
                                        <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                            <Setter Property="Padding" Value="4"/>
                                            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </ControlTheme>
                                    </Flyout.FlyoutPresenterTheme>
                                    <StackPanel Spacing="2" MinWidth="170">
                                        <TextBlock Text="{Binding VersionLabel, StringFormat='Version {0}'}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Padding="10,6"
                                                   IsHitTestVisible="False"/>
                                        <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="4,2"/>
                                        <Button Classes="menuItemBtn" Command="{Binding CheckForUpdatesNowCommand}">
                                            <TextBlock Text="Check for Updates" FontSize="12" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Middle (Col 1): Navigation (< >) + Breadcrumbs + Drag Area -->
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="navBtn" Command="{Binding GoBackCommand}" ToolTip.Tip="{l10n:Tr Key=nav_back}">
                                <PathIcon Data="M15.41 16.59L10.83 12L15.41 7.41L14 6L8 12L14 18L15.41 16.59Z" Width="13" Height="13"/>
                            </Button>
                            <Button Classes="navBtn" Command="{Binding GoForwardCommand}" ToolTip.Tip="{l10n:Tr Key=nav_forward}">
                                <PathIcon Data="M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z" Width="13" Height="13"/>
                            </Button>

                            <!-- Breadcrumbs -->
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="4,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BreadcrumbItem">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="/" Foreground="{StaticResource TextDisabledBrush}" FontSize="12" VerticalAlignment="Center"
                                                       IsVisible="{Binding ShowSeparator}"/>
                                            <Button Classes="breadcrumbBtn" Classes.active="{Binding IsActive}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding Title}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Draggable Area -->
                        <Panel Grid.Column="1" Background="Transparent"/>
                    </Grid>

                    <!-- Right (Col 2): Window Caption Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">
                        <Button Classes="captionBtn" Click="OnMinimizeButtonClick" ToolTip.Tip="Minimize">
                            <PathIcon Data="M19 13H5v-2h14v2z" Width="10" Height="10"/>
                        </Button>
                        <Button Classes="captionBtn" Click="OnMaximizeButtonClick" ToolTip.Tip="Maximize">
                            <PathIcon x:Name="MaximizeButtonIcon" Data="M4 4h16v16H4V4zm2 2v12h12V6H6z" Width="10" Height="10"/>
                        </Button>
                        <Button Classes="captionBtn captionCloseBtn" Click="OnCloseButtonClick" ToolTip.Tip="Close">
                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Main Application Body -->
                <Grid Grid.Row="1" ColumnDefinitions="220,*">

                    <!-- Discord-Style Left Sidebar (Width 220) -->
                    <Border Grid.Column="0" Width="220" Background="{DynamicResource SidebarBgBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="0">
                        <Grid RowDefinitions="*,Auto">
                            <!-- Nav items (Profiles, Modpacks, Servers, Directory, Settings) -->
                            <StackPanel Grid.Row="0" Spacing="4" Margin="10,10,10,10">
                                <Button Classes="discordNavBtn" Classes.active="{Binding IsProfilesView}" Command="{Binding ShowProfilesCommand}" ToolTip.Tip="{l10n:Tr Key=nav_profiles}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M3 3H10V10H3V3M14 3H21V10H14V3M3 14H10V21H3V14M14 14H21V21H14V14Z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_profiles}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>

                                <Button Classes="discordNavBtn" Classes.active="{Binding IsModpacksView}" Command="{Binding ShowModpacksCommand}" ToolTip.Tip="{l10n:Tr Key=nav_catalog}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5 7.51-3.49L17.5 6.5 9.99 9.99 6.5 17.5zm5.5-6.6c.61 0 1.1.49 1.1 1.1s-.49 1.1-1.1 1.1-1.1-.49-1.1-1.1.49-1.1 1.1-1.1z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_catalog}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>

                                <Button Classes="discordNavBtn" Command="{Binding NavigateToCreateServerCommand}" ToolTip.Tip="{l10n:Tr Key=nav_create_server}" IsVisible="{Binding HasExistingServers}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_create_server}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>



                                <Border Height="1" Background="{DynamicResource BorderDarkBrush}" Margin="2,8,2,8"/>

                                <Button Classes="discordNavBtn" Command="{Binding OpenRootDirectoryCommand}" ToolTip.Tip="{l10n:Tr Key=nav_dir}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M10 4H4C2.89 4 2 4.89 2 6V18A2 2 0 0 0 4 20H20A2 2 0 0 0 22 18V8C22 6.89 21.1 6 20 6H12L10 4Z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_dir}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>

                                <Button Classes="discordNavBtn" Command="{Binding OpenSettingsDialogCommand}" ToolTip.Tip="{l10n:Tr Key=nav_settings}">
                                    <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                                        <PathIcon Grid.Column="0" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{l10n:Tr Key=nav_settings}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Row 1: Pinned Discord User Account Bar (flush at bottom) -->
                            <Border Grid.Row="1" Height="52" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0"
                                    CornerRadius="0" Padding="8,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                    <!-- User info (Click opens accounts) -->
                                    <Button Grid.Column="0" Command="{Binding OpenAccountsDialogCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="4,4" Cursor="Hand"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" Background="{DynamicResource IconChipBrush}" CornerRadius="16" ClipToBounds="True">
                                                <Panel>
                                                    <Image Source="{Binding ActiveAccountRow.HeadImage}" Stretch="UniformToFill" IsVisible="{Binding ActiveAccountRow.HasHead}"/>
                                                    <PathIcon Data="M12 4A4 4 0 0 1 16 8A4 4 0 0 1 12 12A4 4 0 0 1 8 8A4 4 0 0 1 12 4ZM4 20C4 16.69 7.58 14 12 14C16.42 14 20 16.69 20 20V21H4V20Z"
                                                              Width="15" Height="15" Foreground="{DynamicResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsVisible="{Binding !ActiveAccountRow.HasHead}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActiveAccountName}" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                <TextBlock Text="{Binding ActiveAccountType}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- Account Settings Gear Button -->
                                    <Button Grid.Column="1" Classes="gearSettingsBtn" Command="{Binding OpenAccountsDialogCommand}"
                                            ToolTip.Tip="Account Settings">
                                        <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                                  Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Workspace Column (RowDefinitions="*,Auto") -->
                    <Grid Grid.Column="1" RowDefinitions="*,Auto">
                        <!-- Center Workspace Content (Row 0) -->
                        <Grid Grid.Row="0" Margin="24,14,0,0">
                    <!-- Profiles View -->
                    <Grid IsVisible="{Binding IsProfilesView}" ColumnDefinitions="*,Auto" x:Name="ProfilesPane" Classes="viewPane">
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Padding="0,0,16,16">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2,0,6">
                                    <Panel Grid.Column="0"/>
                                    <Button Grid.Column="1" Classes="subBtn" Command="{Binding ImportInstancesCommand}" Padding="14,7">
                                        <TextBlock Text="{l10n:Tr Key=profile_import}" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="primaryBtn" Command="{Binding OpenNewInstanceDialogCommand}" Padding="14,7">
                                        <TextBlock Text="{l10n:Tr Key=mw_create_btn}" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </Grid>

                            <Border IsVisible="{Binding !HasInstances}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="36" Margin="0,10,0,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
<TextBlock Text="{l10n:Tr Key=mw_no_profiles}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{l10n:Tr Key=mw_no_profiles_hint}" Foreground="{StaticResource TextPlaceholderBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="InstancesItemsControl" ItemsSource="{Binding Instances}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:AnimatedWrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
<DataTemplate x:DataType="models:InstanceModel">
                                        <Border Width="150" Height="150" Margin="2,2,10,10" CornerRadius="12"
                                                Classes="instanceCard" Classes.dragging="{Binding IsDragging}"
                                                BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBorderBrushConverter}}"
                                                BorderThickness="1"
                                                Tag="{Binding}" Cursor="Hand"
                                                PointerPressed="OnInstanceCardPointerPressed"
                                                Tapped="OnInstanceCardTapped"
                                                DoubleTapped="OnInstanceCardDoubleTapped">
                                            <Border.ContextMenu>
                                                <ContextMenu Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}">
                                                    <MenuItem Header="{l10n:Tr Key=mi_launch}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchSpecificInstanceCommand}" CommandParameter="{Binding}" FontWeight="Bold"/>
                                                    <MenuItem Header="{l10n:Tr Key=btn_edit_instance}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditInstanceCommand}" CommandParameter="{Binding}"/>
                                                    <Separator Background="{StaticResource BorderStrongBrush}"/>
                                                    <MenuItem Header="{l10n:Tr Key=btn_browse_mods}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileBrowseModsCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasModsSupport}"/>
                                                    <MenuItem Header="{l10n:Tr Key=tab_servers}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileServerManagerCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{l10n:Tr Key=btn_open_folder}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileFolderCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{l10n:Tr Key=mi_sections}">
                                                        <MenuItem Header="{l10n:Tr Key=tab_mods}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileSectionModsCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasModsSupport}"/>
                                                        <MenuItem Header="{l10n:Tr Key=tab_resourcepacks}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileSectionResourcePacksCommand}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{l10n:Tr Key=tab_shaders}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileSectionShaderPacksCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasShaderSupport}"/>
                                                        <MenuItem Header="{l10n:Tr Key=tab_worlds}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileSectionWorldsCommand}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{l10n:Tr Key=tab_screenshots}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileSectionScreenshotsCommand}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{l10n:Tr Key=tab_logs}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileSectionLogsCommand}" CommandParameter="{Binding}"/>
                                                    </MenuItem>
                                                    <Separator Background="{StaticResource BorderStrongBrush}"/>
                                                    <MenuItem Header="{l10n:Tr Key=mi_change_icon}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangeInstanceIconCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{l10n:Tr Key=btn_clone_profile}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenCopyDialogCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{l10n:Tr Key=btn_shortcut}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CreateDesktopShortcutCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{l10n:Tr Key=mi_export}">
                                                        <MenuItem Header="{l10n:Tr Key=exp_curseforge}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportCurseForgeCommand}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Modrinth (.mrpack)" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportModrinthCommand}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{l10n:Tr Key=exp_prism}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportPrismCommand}" CommandParameter="{Binding}"/>
                                                    </MenuItem>
                                                    <Separator Background="{StaticResource BorderStrongBrush}"/>
                                                    <MenuItem Header="{l10n:Tr Key=btn_kill}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).KillInstanceCommand}" CommandParameter="{Binding}" IsEnabled="{Binding IsRunning}"/>
                                                    <MenuItem Header="{l10n:Tr Key=btn_delete_profile}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RequestDeleteProfileCommand}" CommandParameter="{Binding}" Foreground="{StaticResource DangerBrush}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="56" Height="56" Background="{StaticResource ChipBrush}" CornerRadius="12" HorizontalAlignment="Center" ClipToBounds="True">
                                                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path IsVisible="{Binding !HasCustomIcon}" Data="{StaticResource ZenithLogoGeometry}" Fill="{StaticResource SubtleEmeraldBrush}" Stretch="Uniform" Width="32" Height="32" Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image IsVisible="{Binding HasCustomIcon}" Source="{Binding IconPath, Converter={x:Static converters:IconPathToBitmapConverter.Instance}}" Stretch="UniformToFill" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                <TextBlock Text="{Binding DisplayVersion}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right Sidebar: Instance Details -->
                    <Border Grid.Column="1" IsVisible="False" Width="300" Opacity="0" Background="{DynamicResource SidebarBgBrush}" Padding="16,8,16,16"
                            x:Name="InstanceDetailsSidebar">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{l10n:Tr Key=mw_instance_details}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseRightSidebarCommand}" Background="Transparent" Foreground="{StaticResource TextPlaceholderBrush}" Padding="6,2" Cursor="Hand"/>
                                </Grid>

                                <!-- Profile Preview Box (Без обводки фокуса, имя опущено ближе к версии) -->
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                    <StackPanel HorizontalAlignment="Center" Spacing="0">
                                        <!-- Иконка профиля -->
                                        <Button Classes="iconChangeBtn" Command="{Binding ChangeInstanceIconCommand}" CommandParameter="{Binding SelectedInstance}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,16" Cursor="Hand"
                                                ToolTip.Tip="{l10n:Tr Key=icon_change_tip}"
                                                HorizontalAlignment="Center">
                                            <Border Width="72" Height="72" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderIconBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Center">
                                                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path IsVisible="{Binding !SelectedInstance.HasCustomIcon}" 
                                                          Data="{StaticResource ZenithLogoGeometry}" 
                                                          Fill="{StaticResource SubtleEmeraldBrush}" 
                                                          Stretch="Uniform" 
                                                          Width="42" Height="42" 
                                                          Margin="0,3.5,0,0" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image IsVisible="{Binding SelectedInstance.HasCustomIcon}" 
                                                           Source="{Binding SelectedInstance.IconPath, Converter={x:Static converters:IconPathToBitmapConverter.Instance}}" 
                                                           Stretch="UniformToFill" 
                                                           Width="72" Height="72" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Panel>
                                            </Border>
                                        </Button>

<!-- Имя профиля: компактный однострочный бейдж -->
                                        <Border Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="8,0" Margin="0,4,0,4" HorizontalAlignment="Center" Height="22">
                                            <TextBox Classes="titleInput" Text="{Binding SelectedInstance.Name, Mode=TwoWay}"
                                                     FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                     HorizontalAlignment="Center" TextAlignment="Center" MinWidth="24" MaxWidth="180"
                                                     DoubleTapped="OnInstanceNameDoubleTapped"
                                                     LostFocus="OnInstanceNameLostFocus"/>
                                        </Border>

                                        <!-- Версия профиля -->
                                        <Border Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedInstanceDetails}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Кнопки действий -->
                                <StackPanel Spacing="8">
                                    <Button Classes="primaryBtn" Command="{Binding LaunchOrCancelCommand}" IsEnabled="{Binding CanLaunchOrCancel}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="42">
                                        <TextBlock Text="{Binding LaunchButtonText}" FontSize="14" FontWeight="Bold"/>
                                    </Button>

                                    <Button Classes="dangerBtn" Command="{Binding KillInstanceCommand}" CommandParameter="{Binding SelectedInstance}"
                                            IsEnabled="{Binding SelectedInstance.IsRunning}" Height="38"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <TextBlock Text="{l10n:Tr Key=btn_kill}" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <Button Classes="subBtn" Command="{Binding EditInstanceCommand}" CommandParameter="{Binding SelectedInstance}" Height="38">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <PathIcon Data="M3 17.25V21H6.75L17.81 9.94L14.06 6.19L3 17.25ZM20.71 7.04C21.1 6.65 21.1 6.02 20.71 5.63L18.37 3.29C17.98 2.9 17.35 2.9 16.96 3.29L15.13 5.12L18.88 8.87L20.71 7.04Z" Width="12" Height="12"/>
                                            <TextBlock Text="{l10n:Tr Key=btn_edit_instance}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="subBtn" Command="{Binding OpenProfileFolderCommand}" CommandParameter="{Binding SelectedInstance}" Height="38">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="13" Height="13"/>
                                            <TextBlock Text="{l10n:Tr Key=btn_open_folder}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="subBtn" Command="{Binding OpenCopyDialogCommand}" CommandParameter="{Binding SelectedInstance}" Height="38">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="12" Height="12"/>
                                            <TextBlock Text="{l10n:Tr Key=btn_clone_profile}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

<Button Classes="subBtn" Command="{Binding CreateDesktopShortcutCommand}" CommandParameter="{Binding SelectedInstance}" Height="38">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <PathIcon Data="M3 4H15V6H5V18H17V11H19V19C19 19.55 18.55 20 18 20H4C3.45 20 3 19.55 3 19V5C3 4.45 3.45 4 3 4ZM14 6V4H21V11H19V7.41L10.17 16.24L8.76 14.83L17.59 6H14Z" Width="13" Height="13" Margin="0,-1,0,0"/>
                                            <TextBlock Text="{l10n:Tr Key=btn_shortcut}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="dangerBtn" Command="{Binding RequestDeleteProfileCommand}" CommandParameter="{Binding SelectedInstance}"
                                            Background="{StaticResource DangerDimBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" HorizontalContentAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="{l10n:Tr Key=btn_delete_profile}" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    </Grid>
                                <!-- Server Under Development Dialog -->
            <Border IsVisible="{Binding IsServerUnderDevDialogOpen}" Background="{StaticResource OverlayBrush}" ZIndex="150">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="30" Height="30" Background="{DynamicResource IconChipBrush}" CornerRadius="6" VerticalAlignment="Center">
                                    <PathIcon Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Серверы" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseDialogsCommand}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" Foreground="{DynamicResource TextMutedBrush}">
                                <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Сейчас создание сервера было перенесено в разработку. Вы можете открыть папку всех ранее созданных серверов."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <Button Grid.Column="0" Classes="primaryBtn" Command="{Binding OpenServersDirectoryCommand}" Padding="16,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="M10 4H4C2.89 4 2 4.89 2 6V18A2 2 0 0 0 4 20H20A2 2 0 0 0 22 18V8C22 6.89 21.1 6 20 6H12L10 4Z" Width="13" Height="13" Foreground="{StaticResource OnAccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Открыть папку серверов" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="subBtn" Command="{Binding CloseDialogsCommand}" Content="Закрыть" Padding="14,8" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>



                    <!-- Catalog / Modpacks View -->
                    <Grid IsVisible="{Binding IsModpacksView}" Classes="viewPane" Margin="0,0,16,0" x:Name="ModpacksPane">
                        <Grid RowDefinitions="Auto,*" IsVisible="{Binding !ModpacksBrowser.IsDetailsOpen}">
                            <!-- Header: Type Tabs, Search Bar, and Filter Controls -->
                            <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
                                <!-- Top Segmented Content Type Tabs -->
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1" CornerRadius="18" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Classes="catalogTabBtn" Classes.active="{Binding ModpacksBrowser.IsModpacksTab}"
                                                Command="{Binding ModpacksBrowser.SelectProjectTypeCommand}" CommandParameter="modpack"
                                                Content="{l10n:Tr nav_modpacks}"/>
                                        <Button Classes="catalogTabBtn" Classes.active="{Binding ModpacksBrowser.IsModsTab}"
                                                Command="{Binding ModpacksBrowser.SelectProjectTypeCommand}" CommandParameter="mod"
                                                Content="{l10n:Tr tab_mods}"/>
                                        <Button Classes="catalogTabBtn" Classes.active="{Binding ModpacksBrowser.IsResourcePacksTab}"
                                                Command="{Binding ModpacksBrowser.SelectProjectTypeCommand}" CommandParameter="resourcepack"
                                                Content="{l10n:Tr tab_resourcepacks}"/>
                                        <Button Classes="catalogTabBtn" Classes.active="{Binding ModpacksBrowser.IsDataPacksTab}"
                                                Command="{Binding ModpacksBrowser.SelectProjectTypeCommand}" CommandParameter="datapack"
                                                Content="{l10n:Tr tab_datapacks}"/>
                                        <Button Classes="catalogTabBtn" Classes.active="{Binding ModpacksBrowser.IsShadersTab}"
                                                Command="{Binding ModpacksBrowser.SelectProjectTypeCommand}" CommandParameter="shader"
                                                Content="{l10n:Tr tab_shaders}"/>
                                        <Button Classes="catalogTabBtn" Classes.active="{Binding ModpacksBrowser.IsWorldsTab}"
                                                Command="{Binding ModpacksBrowser.SelectProjectTypeCommand}" CommandParameter="world"
                                                Content="{l10n:Tr tab_worlds}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Full Width Search Bar -->
                                <TextBox Classes="darkInput" Height="40"
                                         Text="{Binding ModpacksBrowser.SearchQuery}"
                                         PlaceholderText="{Binding ModpacksBrowser.SearchPlaceholder}"
                                         FontSize="12.5" VerticalAlignment="Center">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding ModpacksBrowser.SearchCommand}"/>
                                    </TextBox.KeyBindings>
                                    <TextBox.InnerLeftContent>
                                        <PathIcon Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                                  Width="14" Height="14" Foreground="{DynamicResource TextPlaceholderBrush}" Margin="12,0,4,0"/>
                                    </TextBox.InnerLeftContent>
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding ModpacksBrowser.ClearSearchCommand}"
                                                IsVisible="{Binding ModpacksBrowser.SearchQuery, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                Background="Transparent" BorderThickness="0" Padding="8,0" Cursor="Hand" Content="✕"
                                                Foreground="{DynamicResource TextPlaceholderBrush}"/>
                                    </TextBox.InnerRightContent>
                                </TextBox>

                                <!-- Filters bar: Source, Sort, Versions, Loaders, Reset, Status -->
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
                                    <!-- 0. Source Switcher (Modrinth / CurseForge) -->
                                    <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1" CornerRadius="8" Height="32" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Classes="sourceTabBtn" Classes.active="{Binding ModpacksBrowser.IsModrinthSource}"
                                                    Command="{Binding ModpacksBrowser.SelectSourceCommand}" CommandParameter="modrinth"
                                                    ToolTip.Tip="{l10n:Tr Key=source_modrinth}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <PathIcon Data="M12.252 2c-5.656 0-10.24 4.584-10.24 10.24 0 2.213.702 4.26 1.892 5.932l.024.034 4.092-4.093a3.46 3.46 0 0 1-.222-1.229c0-1.921 1.557-3.478 3.478-3.478.618 0 1.196.162 1.696.446l3.418-3.418A6.87 6.87 0 0 0 12.252 5.6c-3.667 0-6.64 2.973-6.64 6.64 0 .973.21 1.898.587 2.733l-2.073 2.073A10.18 10.18 0 0 1 2.012 12.24C2.012 6.584 6.596 2 12.252 2z"
                                                              Width="12" Height="12"
                                                              Foreground="{Binding ModpacksBrowser.IsModrinthSource, Converter={x:Static converters:ContentBrowserConverters.ModrinthIconBrush}}"/>
                                                    <TextBlock Text="Modrinth" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="sourceTabBtn" Classes.active="{Binding ModpacksBrowser.IsCurseForgeSource}"
                                                    Command="{Binding ModpacksBrowser.SelectSourceCommand}" CommandParameter="curseforge"
                                                    ToolTip.Tip="{l10n:Tr Key=source_curseforge}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <PathIcon Data="M18.8 8.4C18.4 5.3 16.2 2.8 13.3 2c-.4-.1-.7.2-.6.6.6 2.2-.4 4.5-2.4 5.6-1.5.8-2.6 2.2-3 3.9-.7 2.7.4 5.5 2.7 7 1.8 1.2 4.1 1.4 6.1.6 2.8-1.2 4.6-3.9 4.6-6.9 0-1.5-.6-3-1.9-4.4zm-4.7 9.8c-1.3.4-2.7.2-3.8-.6-1.3-.9-1.9-2.5-1.5-4 .2-1 .9-1.8 1.8-2.3 1.9-1 3.1-2.8 3.2-4.9 1.6.8 2.8 2.3 3.1 4.1.3 2-.4 4-1.9 5.3-.9.9-2 1.4-3.2 1.5z"
                                                              Width="12" Height="12"
                                                              Foreground="{Binding ModpacksBrowser.IsCurseForgeSource, Converter={x:Static converters:ContentBrowserConverters.CurseForgeIconBrush}}"/>
                                                    <TextBlock Text="CurseForge" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <views:SortFilterDropdown Grid.Column="1" DataContext="{Binding ModpacksBrowser.BrowserSortFilter}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                    <views:GameVersionFilterDropdown Grid.Column="2" DataContext="{Binding ModpacksBrowser.BrowserVersionFilter}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                    <views:LoaderFilterDropdown Grid.Column="3" DataContext="{Binding ModpacksBrowser.BrowserLoaderFilter}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                    <Button Grid.Column="4" Classes="subBtn" Command="{Binding ModpacksBrowser.ResetFiltersCommand}" ToolTip.Tip="{l10n:Tr Key=cb_clear}"
                                            Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>

                                    <TextBlock Grid.Column="6" Text="{Binding ModpacksBrowser.StatusText}" FontSize="11" Foreground="{DynamicResource TextCaptionBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Results list matching media_1793574109804_ca3d7d5e.png -->
                            <Grid Grid.Row="1" RowDefinitions="*,Auto">
                                <ListBox x:Name="ModpacksList" ItemsSource="{Binding ModpacksBrowser.Results}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AttachedToVisualTree="OnModpacksListAttached">
                                    <ListBox.ItemContainerTheme>
                                        <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </ControlTheme>
                                    </ListBox.ItemContainerTheme>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="items:ModrinthProjectItemViewModel">
                                            <Border Margin="0,0,0,8" CornerRadius="12" Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderCardSoftBrush}" BorderThickness="1" Padding="14,12" Tapped="OnModpackCardTapped" Cursor="Hand">
                                                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14">
                                                    <!-- Icon -->
                                                    <Border Grid.Column="0" Width="56" Height="56" Background="{DynamicResource ChipBrush}" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top">
                                                        <Panel>
                                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" Width="56" Height="56" IsVisible="{Binding HasIcon}"/>
                                                            <Path Data="M20 3H4C2.89 3 2 3.89 2 5V15C2 16.11 2.89 17 4 17H8V21L12 18H20C21.11 18 22 17.11 22 16V5C22 3.89 21.11 3 20 3M20 14H12L8 18V14H4V5H20V14Z" Fill="{DynamicResource TextPlaceholderBrush}" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- Content -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                        <!-- Title + Author link -->
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="by " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            <Button Classes="authorLinkBtn" Content="{Binding Author}"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ModpacksBrowser.OpenAuthorProfileCommand}"
                                                                    CommandParameter="{Binding Author}"
                                                                    FontSize="12" VerticalAlignment="Center"/>
                                                        </WrapPanel>

                                                        <!-- Description -->
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" LineHeight="17"/>

                                                        <!-- Tag Badges / Chips -->
                                                        <ItemsControl ItemsSource="{Binding DisplayTags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource ChipBrush}" CornerRadius="6" Padding="7,2" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Stats row (Downloads, Followers/Likes, Updated) -->
                                                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                                                            <!-- Downloads -->
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Width="11" Height="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DownloadsLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <!-- Likes / Follows -->
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <PathIcon Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" Width="11" Height="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding FollowsLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <!-- Updated -->
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <PathIcon Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.59-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" Width="11" Height="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding RelativeUpdated}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Install Button -->
                                                    <Button Grid.Column="2" Classes="subBtn installedBtn" Classes.installed="{Binding IsInstalled}" Classes.installing="{Binding IsInstalling}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ModpacksBrowser.DeleteOrInstallCommand}" CommandParameter="{Binding}"
                                                            PointerEntered="OnModpackButtonHover" PointerExited="OnModpackButtonHoverOut" Tapped="OnModpackButtonTapped"
                                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                                            Content="{Binding InstallButtonText}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="{l10n:Tr Key=mp_loading}" IsVisible="{Binding ModpacksBrowser.IsBusy}" HorizontalAlignment="Center" Margin="0,12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{l10n:Tr Key=mp_empty}" IsVisible="{Binding ModpacksBrowser.IsEmpty}" HorizontalAlignment="Center" Margin="0,12" Foreground="{DynamicResource TextPlaceholderBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding ModpacksBrowser.StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,8,0,0" TextWrapping="Wrap" IsVisible="{Binding ModpacksBrowser.StatusText, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                            </Grid>
                        </Grid>

                        <!-- Full-page modpack details (replaces catalog when open, seamless stretch) -->
                        <Panel IsVisible="{Binding ModpacksBrowser.IsDetailsOpen}">
                            <views:ProjectDetailsView DataContext="{Binding ModpacksBrowser}"/>
                        </Panel>

                        <!-- Full-page author profile for modpacks -->
                        <Panel IsVisible="{Binding ModpacksBrowser.IsAuthorProfileOpen}">
                            <views:AuthorProfileView DataContext="{Binding ModpacksBrowser.CurrentAuthorProfileVm}"/>
                        </Panel>
                    </Grid>

                    <!-- In-Window Edit Instance View -->
                    <Panel x:Name="EditInstancePane" Classes="viewPane" IsVisible="{Binding IsEditInstanceView}" Margin="-24,-14,0,0">
                        <views:EditInstanceView DataContext="{Binding CurrentEditInstanceVm}"/>
                    </Panel>

                    <!-- In-Window Content Browser View -->
                    <Panel x:Name="ContentBrowserPane" Classes="viewPane" IsVisible="{Binding IsContentBrowserView}" Margin="0,0,16,0">
                        <views:ContentBrowserView DataContext="{Binding CurrentContentBrowserVm}"/>
                    </Panel>

                    <!-- In-Window Launcher Settings View -->
                    <Panel x:Name="SettingsPane" Classes="viewPane" IsVisible="{Binding IsSettingsView}" Margin="-24,-14,0,0">
                        <views:LauncherSettingsView DataContext="{Binding LauncherSettingsVm}"/>
                    </Panel>

                    <!-- In-Window Server Manager View -->
                    <Panel x:Name="ServerManagerPane" Classes="viewPane" IsVisible="{Binding IsServerManagerView}" Margin="0,0,16,0">
                        <views:ServerManagerView DataContext="{Binding CurrentServerManagerVm}"/>
                    </Panel>

                    <!-- In-Window Accounts View -->
                    <Panel x:Name="AccountsPane" Classes="viewPane" IsVisible="{Binding IsAccountsView}" Margin="0,0,16,0">
                        <views:AccountsView DataContext="{Binding AccountsVm}"/>
                    </Panel>

                    <!-- In-Window Create Profile View -->
                    <Panel x:Name="CreateProfilePane" Classes="viewPane" IsVisible="{Binding IsCreateProfileView}" Margin="0,0,16,0">
                        <views:CreateProfileView DataContext="{Binding CreateProfileVm}"/>
                    </Panel>

                    <!-- In-Window Create Server View -->
                    <Panel x:Name="CreateServerPane" Classes="viewPane" IsVisible="{Binding IsCreateServerView}" Margin="0,0,16,0">
                        <views:CreateServerView DataContext="{Binding CreateServerVm}"/>
                    </Panel>
                </Grid>

                <!-- Full-Width Bottom Launch Bar -->
                <Border Grid.Row="1" Height="76" IsVisible="{Binding IsLaunchBarVisible}" Background="{DynamicResource SidebarBgBrush}">
                    <Grid ColumnDefinitions="*,280" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="24,0,16,0">
                            <TextBlock Text="{Binding SelectedInstanceName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedInstanceDetails}" FontSize="12" Foreground="{StaticResource TextSubtleBrush}" Margin="0,2,0,0"/>
                            <ProgressBar IsVisible="{Binding IsLaunching}" Value="{Binding LaunchProgress}" Height="4" Foreground="{StaticResource AccentBrush}" Margin="0,6,24,0"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" Margin="0,4,24,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

<Border Grid.Column="1" Padding="16,0,16,0" VerticalAlignment="Center">
                            <Button Classes="primaryBtn" Command="{Binding LaunchOrCancelCommand}" IsEnabled="{Binding CanLaunchOrCancel}" Height="42" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LaunchButtonText}" FontSize="14" FontWeight="Bold"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- MODAL: Create Profile -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsCreateDialogOpen}" Background="{StaticResource OverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="440" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{l10n:Tr Key=cp_title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>

<StackPanel Spacing="4">
                        <TextBlock Text="{l10n:Tr Key=cp_name_label}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Classes="darkInput" Text="{Binding NewInstanceName}" PlaceholderText="{l10n:Tr Key=ph_profile_name}">
                            <TextBox.Styles>
                                <Style Selector="TextBox.darkInput" x:DataType="vm:MainWindowViewModel">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                </Style>
                            </TextBox.Styles>
                        </TextBox>
                    </StackPanel>

<StackPanel Spacing="4">
                        <TextBlock Text="{l10n:Tr Key=cp_step_version}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Classes="zenCombo" ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}" HorizontalAlignment="Stretch"
                                      PlaceholderText="{l10n:Tr Key=none_select_version}"/>
                            <Button Grid.Column="1" Content="✕" Command="{Binding ClearVersionCommand}" Background="Transparent" Foreground="{StaticResource TextPlaceholderBrush}" Padding="6,0" Cursor="Hand" FontSize="12" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{l10n:Tr Key=set_loader}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" Classes="zenCombo" ItemsSource="{Binding AvailableLoaders}" SelectedItem="{Binding SelectedLoader}"
                                      HorizontalAlignment="Stretch" IsVisible="{Binding IsLoaderTypesVisible}"/>
                            <ComboBox Grid.Column="0" Classes="zenCombo" ItemsSource="{Binding AvailableLoaderBuilds}" SelectedItem="{Binding SelectedLoaderBuild}"
                                      HorizontalAlignment="Stretch" IsVisible="{Binding IsLoaderBuildsVisible}"/>
                            <Button Grid.Column="1" Content="⇄" Command="{Binding ToggleLoaderBuildsCommand}"
                                    Width="32" Height="32" Padding="0" Margin="6,0,0,0"
                                    Background="{StaticResource FieldBrush}" Foreground="{DynamicResource TextMutedBrush}"
                                    BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1"
                                    CornerRadius="8" Cursor="Hand" FontSize="14"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    IsEnabled="{Binding CanSwapLoader}"
                                    ToolTip.Tip="{l10n:Tr Key=tip_switch_loader}">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding LoaderError}" FontSize="11" Foreground="{StaticResource DangerStrongBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding LoaderErrorVisible}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=cancel}" Command="{Binding CloseDialogsCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=create}" Command="{Binding ConfirmCreateInstanceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0"
                                IsEnabled="{Binding CanCreateInstance}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL: Console & Logs -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsConsoleDialogOpen}" Background="{StaticResource OverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="700" Height="480" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                        <TextBlock Text="{l10n:Tr Key=mw_console_title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=btn_copy_logs}" Command="{Binding CopyConsoleLogsCommand}" Margin="0,0,8,0" Padding="12,5" FontSize="11"/>
                        <Button Grid.Column="2" Content="✕" Command="{Binding CloseConsoleDialogCommand}" Background="Transparent" Foreground="{StaticResource TextPlaceholderBrush}" Padding="4" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SidebarBgBrush}" CornerRadius="6" Padding="10">
                        <TextBox Text="{Binding ConsoleLogs}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource TextSoftBrush}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" BorderThickness="0"/>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <ProgressBar Value="{Binding LaunchProgress}" Height="4" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding LaunchProgress, StringFormat='{}{0}%'}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

<!-- MODAL: Delete Confirmation -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsDeleteConfirmOpen}" Background="{StaticResource OverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="380" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr Key=dialog_delete_title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="{Binding PendingDeleteInstance.Name, Converter={x:Static converters:L10nFormatConverter.Instance}, ConverterParameter=dialog_delete_confirm}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="17"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=cancel}" Command="{Binding CancelDeleteProfileCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Classes="dangerBtn" Content="{l10n:Tr Key=delete}" Command="{Binding ConfirmDeleteProfileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Background="{StaticResource DangerBorderBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL: Restart Confirmation (Theme Application) -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsRestartConfirmOpen}" Background="{StaticResource OverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="400" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr Key=dialog_restart_title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l10n:Tr Key=dialog_restart_theme_msg}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" LineHeight="18"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=no}" Command="{Binding CancelRestartConfirmCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="36"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmRestartAndApplyThemeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL: Discard Changes Confirmation (Theme Tab Switch) -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsThemeDiscardConfirmOpen}" Background="{StaticResource OverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="400" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr Key=dialog_discard_title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l10n:Tr Key=dialog_discard_theme_msg}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" LineHeight="18"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=no}" Command="{Binding CancelDiscardThemeChangesCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="36"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=yes}" Command="{Binding ConfirmDiscardThemeChangesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL: Modpack Delete Confirmation -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ModpacksBrowser.IsDeleteConfirmOpen}" Background="{StaticResource OverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="12" MaxWidth="360" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{l10n:Tr Key=cb_delete_title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ModpacksBrowser.DeleteItemName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextLabelBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{l10n:Tr Key=cb_delete_question}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{l10n:Tr Key=no}" Command="{Binding ModpacksBrowser.CancelDeleteCommand}" Classes="dialogBtn"
                                Width="90" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="{l10n:Tr Key=yes}" Command="{Binding ModpacksBrowser.ConfirmDeleteCommand}" Classes="dialogBtn dialogDanger"
                                Width="90" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL: Ely.by Error -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsElyByErrorOpen}" Background="{StaticResource OverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="420" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l10n:Tr Key=dialog_connection}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="{Binding ElyByErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="17"/>
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Content="{l10n:Tr Key=close}" Command="{Binding CloseDialogsCommand}" Classes="subBtn" HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=btn_switch_offline}" Command="{Binding SwitchToOfflineAccountCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    <!-- Java Runtime Installer In-App Modal -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource OverlayBrush}" IsVisible="{Binding IsJavaInstallerOpen}" ZIndex="1000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
            <Border x:Name="JavaInstallerCard" Background="{StaticResource SurfaceBrush}" CornerRadius="14" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 18 46 0 #55000000" Padding="24,20,24,18">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{l10n:Tr Key=java_installer_title}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{l10n:Tr Key=java_installer_hint}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseJavaInstallerCommand}" Classes="subBtn"
                                Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                VerticalAlignment="Top" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Version tiles -->
                    <UniformGrid Grid.Row="1" Columns="2" Rows="3" Margin="0,0,0,10">
                        <Button Classes="verBtn" Margin="0,0,4,6"
                                Command="{Binding DownloadJavaCommand}" CommandParameter="8"
                                IsEnabled="{Binding CanDownloadJava}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Java 8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{l10n:Tr Key=java_tag_old}" FontSize="9" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="verBtn" Margin="4,0,0,6"
                                Command="{Binding DownloadJavaCommand}" CommandParameter="11"
                                IsEnabled="{Binding CanDownloadJava}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Java 11" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="LTS" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="verBtn" Margin="0,0,4,6"
                                Command="{Binding DownloadJavaCommand}" CommandParameter="16"
                                IsEnabled="{Binding CanDownloadJava}">
                            <TextBlock Text="Java 16" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Classes="verBtn" Margin="4,0,0,6"
                                Command="{Binding DownloadJavaCommand}" CommandParameter="17"
                                IsEnabled="{Binding CanDownloadJava}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Java 17" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="LTS" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="verBtn" Margin="0,0,4,0"
                                Command="{Binding DownloadJavaCommand}" CommandParameter="21"
                                IsEnabled="{Binding CanDownloadJava}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Java 21" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="LTS" FontSize="9" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="verBtn" Margin="4,0,0,0"
                                Command="{Binding DownloadJavaCommand}" CommandParameter="25"
                                IsEnabled="{Binding CanDownloadJava}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Java 25" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{l10n:Tr Key=java_tag_new}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Status -->
                    <TextBlock Grid.Row="2" Text="{Binding JavaDownloadStatus}" FontSize="11"
                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="2,4,2,8"
                               IsVisible="{Binding JavaDownloadStatus, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>

                    <!-- Footer -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,96" Margin="0,6,0,0">
                        <Button Grid.Column="0" Classes="subBtn" Content="{l10n:Tr Key=java_pick_manual}"
                                Command="{Binding PickCustomJavaCommand}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="1" Classes="subBtn" Content="{l10n:Tr Key=close}"
                                Command="{Binding CloseJavaInstallerCommand}" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    <!-- Import Picker In-App Modal -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource OverlayBrush}" IsVisible="{Binding IsImportPickerOpen}" ZIndex="1000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
            <Border Background="{StaticResource BgBrush}" CornerRadius="14" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 18 46 0 #55000000" Padding="24,20,24,18">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{l10n:Tr Key=imp_title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseImportPickerCommand}" Classes="subBtn"
                                Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                VerticalAlignment="Top" Margin="8,0,0,0"/>
                    </Grid>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <!-- Official Prism Launcher mark, rasterized from github.com/PrismLauncher/PrismLauncher (CC BY-SA 4.0) -->
                            <Border Width="40" Height="40" Background="{DynamicResource IconChipBrush}" CornerRadius="10" VerticalAlignment="Center">
                                <Image Source="{Binding PrismImportIcon}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="rowTitle" Text="{l10n:Tr Key=imp_prism_t}"/>
                                <TextBlock Classes="rowHint" Text="{l10n:Tr Key=imp_prism_d}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subBtn" Content="{l10n:Tr Key=imp_choose}" Command="{Binding PickImportFolderCommand}" CommandParameter="Prism" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <!-- Official MultiMC mark (github.com/MultiMC/MultiMC) -->
                            <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Center" ClipToBounds="True">
                                <Image Source="{Binding MultiMCImportIcon}" Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="rowTitle" Text="{l10n:Tr Key=imp_mmc_t}"/>
                                <TextBlock Classes="rowHint" Text="{l10n:Tr Key=imp_mmc_d}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subBtn" Content="{l10n:Tr Key=imp_choose}" Command="{Binding PickImportFolderCommand}" CommandParameter="MultiMC" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Width="40" Height="40" Background="{DynamicResource IconChipBrush}" CornerRadius="10" VerticalAlignment="Center">
                                <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="rowTitle" Text="{l10n:Tr Key=imp_single_t}"/>
                                <TextBlock Classes="rowHint" Text="Any archive (.zip, .mrpack) or custom instance/version folder"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subBtn" Content="{l10n:Tr Key=imp_choose}" Command="{Binding PickImportSingleCommand}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    <!-- Update In-App Modal (soft fade-in via code-behind) -->
        <Border Grid.Row="0" Grid.RowSpan="2" x:Name="UpdateOverlay" Background="{StaticResource OverlayBrush}" IsVisible="{Binding IsUpdateOpen}" ZIndex="2000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 18 46 0 #55000000" Padding="24,20">
                <views:UpdateNotificationView DataContext="{Binding UpdateVm}"/>
            </Border>
        </Border>
        <!-- Info Dialog Modal (Updates / Alerts) -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsInfoDialogOpen}" Background="{StaticResource OverlayBrush}" ZIndex="2100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderCardSoftBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 18 46 0 #55000000">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="{DynamicResource IconChipBrush}" CornerRadius="8" VerticalAlignment="Center">
                            <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                      Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding InfoDialogTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding InfoDialogMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"/>

                    <Button Grid.Row="2" Classes="primaryBtn" Content="OK" Command="{Binding CloseInfoDialogCommand}"
                            HorizontalAlignment="Right" Width="96" Height="34" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </Border>
        <!-- DragOverlayPanel: topmost layer for drag ghost rendering -->
        <Canvas Grid.Row="0" Grid.RowSpan="2" x:Name="DragOverlayPanel" IsHitTestVisible="False" ClipToBounds="False" ZIndex="9999"/>
    </Grid>
    </LayoutTransformControl>
    <controls:ParticleSystemControl ParticleType="{Binding SelectedParticle}" ParticleCount="{Binding ParticleCount}" ParticleScale="{Binding ParticleScale}" ParticleSpeed="{Binding ParticleSpeed}" ParticleColorHex="{Binding ParticleColorHex}" ParticleAngleDeg="{Binding ParticleAngleDeg}" ParticleTexturePath="{Binding ParticleTexturePath}" IsHitTestVisible="False"/>
        <!-- MODAL: Add to Instance / World Selector -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource OverlayBrush}"
                IsVisible="{Binding ModpacksBrowser.IsAddToInstanceOpen}" ZIndex="1100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource BgBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                    Width="640" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 18 46 0 #55000000" Padding="26,22,26,20">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModpacksBrowser.AddToInstanceModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1" Content="✕" Command="{Binding ModpacksBrowser.CloseAddToInstanceCommand}" Classes="subBtn"
                                Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- STEP 1: Search & Instance List (Visible when !IsSelectWorldStep) -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding !ModpacksBrowser.IsSelectWorldStep}">
                        <TextBox Classes="darkInput" Text="{Binding ModpacksBrowser.InstanceSearchQuery}" PlaceholderText="Search instance..." Height="36" FontSize="12.5" Margin="0,0,0,12"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !ModpacksBrowser.IsSelectWorldStep}">
                        <ItemsControl ItemsSource="{Binding ModpacksBrowser.TargetInstances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:InstanceTargetItem">
                                    <Button Command="{Binding InstallCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </Button.Styles>
                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                                <Border Width="42" Height="42" Background="{DynamicResource ChipBrush}" CornerRadius="8" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path IsVisible="{Binding !HasIcon}" Data="{StaticResource ZenithLogoGeometry}" Fill="{StaticResource SubtleEmeraldBrush}" Stretch="Uniform" Width="26" Height="26" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image IsVisible="{Binding HasIcon}" Source="{Binding IconPath, Converter={x:Static converters:IconPathToBitmapConverter.Instance}}" Stretch="UniformToFill" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding VersionDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <!-- If NOT datapack: show standard Install button -->
                                                <Button Grid.Column="2" Classes="primaryBtn" Classes.installed="{Binding IsInstalled}"
                                                        Command="{Binding InstallCommand}" IsEnabled="{Binding CanClickButton}"
                                                        IsVisible="{Binding !IsDatapackSelection}"
                                                        Padding="16,7" FontSize="12">
                                                    <TextBlock Text="{Binding ButtonText}"/>
                                                </Button>
                                                <!-- If datapack: show chevron icon to indicate opening world list -->
                                                <Border Grid.Column="2" IsVisible="{Binding IsDatapackSelection}" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ChipBrush}" VerticalAlignment="Center">
                                                    <PathIcon Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- STEP 2: World List for Datapack (Visible when IsSelectWorldStep) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12" Spacing="8" IsVisible="{Binding ModpacksBrowser.IsSelectWorldStep}">
                        <Button Command="{Binding ModpacksBrowser.BackToInstancesCommand}" Classes="subBtn" Padding="10,5" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="‹" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Back to profiles" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ModpacksBrowser.SelectWorldSubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ModpacksBrowser.IsSelectWorldStep}">
                        <StackPanel Spacing="6">
                            <Border IsVisible="{Binding ModpacksBrowser.HasNoWorldsFound}" Padding="20" Background="{DynamicResource CardBrush}" CornerRadius="10" HorizontalAlignment="Stretch" Margin="0,8">
                                <TextBlock Text="No worlds found in this profile. Launch Minecraft and create a world first." Foreground="{DynamicResource TextPlaceholderBrush}" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12.5"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ModpacksBrowser.TargetWorlds}" IsVisible="{Binding !ModpacksBrowser.HasNoWorldsFound}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dialogs:WorldTargetItem">
                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                                <Border Width="42" Height="42" Background="{DynamicResource ChipBrush}" CornerRadius="8" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <PathIcon IsVisible="{Binding !HasIcon}" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
                                                        <Image IsVisible="{Binding HasIcon}" Source="{Binding IconBitmap}" Stretch="UniformToFill" Width="42" Height="42"/>
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WorldName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding FolderName, StringFormat='saves/{0}'}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="primaryBtn" Classes.installed="{Binding IsInstalled}"
                                                        Command="{Binding InstallCommand}" IsEnabled="{Binding !IsInstalled}"
                                                        Padding="16,7" FontSize="12">
                                                    <TextBlock Text="{Binding ButtonText}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="0,16,0,0" VerticalAlignment="Center">
                        <Button Classes="subBtn" Content="Cancel" Command="{Binding ModpacksBrowser.CloseAddToInstanceCommand}" HorizontalAlignment="Right" Padding="18,6"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Panel>
    </Border>
</Window>





































