<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:models="using:CustomMcLauncher.Models"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             x:Class="CustomMcLauncher.Views.ProjectDetailsView"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="ToggleButton.tabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="ToggleButton.tabBtn:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.tabBtn:checked">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>
        <!-- Green action button: brighten on hover, NOT gray -->
        <Style Selector="Button.actionBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.actionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>
        <!-- Selectable version row: Background/Border set via MultiBinding converters -->
        <!-- Clickable version chip: Background/Text set via MultiBinding converters -->
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ========== HEADER (compact) ========== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="12"
                        Background="{StaticResource IconChipBrush}" ClipToBounds="True" VerticalAlignment="Center">
                    <Panel>
                        <Image Source="{Binding Icon}" Stretch="Uniform" Width="52" Height="52"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasIcon}"/>
                        <Path Data="M20.5 11H19V7C19 5.9 18.1 5 17 5H13V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4C2.9 5 2 5.9 2 7V10.8H3.5C4.99 10.8 6.2 12.01 6.2 13.5S4.99 16.2 3.5 16.2H2V20C2 21.1 2.9 22 4 22H7.8V20.5C7.8 19.01 9.01 17.8 10.5 17.8S13.2 19.01 13.2 20.5V22H17C18.1 22 19 21.1 19 20V16H20.5C21.88 16 23 14.88 23 13.5S21.88 11 20.5 11Z" Width="26" Height="26" Stretch="Uniform" Fill="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/>
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,3,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="↓" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DownloadsLabel}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding $parent[Window].DataContext.FullProject.Follows, Converter={x:Static vm:EditInstanceWindowConverters.IsNotZero}}">
                            <TextBlock Text="♡" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding $parent[Window].DataContext.FullProject.Follows}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="8,3">
                            <TextBlock Text="{Binding ProjectTypeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <!-- Back + Install/Reinstall buttons side by side -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{l10n:Tr Key=btn_back}" CornerRadius="8" Padding="14,8"
                            Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"
                            Command="{Binding $parent[Window].DataContext.CloseDetailsCommand}"/>
                    <Button Classes="actionBtn" Padding="18,8"
                            Content="{Binding $parent[Window].DataContext.ReinstallText}"
                            Command="{Binding $parent[Window].DataContext.MainActionCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== TABS ========== -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="0,0,0,1" Padding="24,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton Classes="tabBtn" IsChecked="{Binding $parent[Window].DataContext.IsDescriptionTab}"
                              Content="{l10n:Tr Key=cb_description}"
                              Command="{Binding $parent[Window].DataContext.SelectTabCommand}" CommandParameter="description"/>
                <ToggleButton Classes="tabBtn" IsChecked="{Binding $parent[Window].DataContext.IsChangelogTab}"
                              Content="{l10n:Tr Key=cb_changelog}"
                              Command="{Binding $parent[Window].DataContext.SelectTabCommand}" CommandParameter="changelog"/>
                <ToggleButton Classes="tabBtn" IsChecked="{Binding $parent[Window].DataContext.IsVersionsTab}"
                              Content="{l10n:Tr Key=cb_versions}"
                              Command="{Binding $parent[Window].DataContext.SelectTabCommand}" CommandParameter="versions"/>
            </StackPanel>
        </Border>

        <!-- ========== TWO-COLUMN BODY ========== -->
        <Grid Grid.Row="2" ColumnDefinitions="*,260" ColumnSpacing="16" Margin="24,12,24,12">

            <!-- Left: tabbed content -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Description tab -->
                        <StackPanel IsVisible="{Binding $parent[Window].DataContext.IsDescriptionTab}" Spacing="10">
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"/>
                            <TextBlock Text="{Binding $parent[Window].DataContext.CleanBody}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"
                                       IsVisible="{Binding $parent[Window].DataContext.CleanBody, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}"/>
                        </StackPanel>

                        <!-- Changelog tab -->
                        <StackPanel IsVisible="{Binding $parent[Window].DataContext.IsChangelogTab}" Spacing="10">
                            <TextBlock Text="{l10n:Tr Key=cb_changelog}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding $parent[Window].DataContext.CleanBody}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"
                                       IsVisible="{Binding $parent[Window].DataContext.CleanBody, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}"/>
                            <TextBlock Text="{l10n:Tr Key=cb_no_changelog}" FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}"
                                       IsVisible="{Binding $parent[Window].DataContext.CleanBody, Converter={x:Static vm:EditInstanceWindowConverters.IsEmpty}}"/>
                        </StackPanel>

                        <!-- Versions tab -->
                        <StackPanel IsVisible="{Binding $parent[Window].DataContext.IsVersionsTab}" Spacing="6">
                            <!-- Top row: title + show all toggle -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{l10n:Tr Key=cb_versions}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Content="{l10n:Tr Key=cb_show_all_versions}" IsChecked="{Binding $parent[Window].DataContext.ShowAllVersions}"
                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </Grid>
                            <!-- Version list: selectable rows, no per-row Install button -->
                            <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.VersionList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModrinthProjectVersion">
                                        <Border Margin="0,0,0,4"
                                                CornerRadius="10" Padding="14,12" Cursor="Hand"
                                                Tapped="OnVersionRowTapped" Tag="{Binding}">
                                            <Border.Background>
                                                <MultiBinding Converter="{x:Static vm:ContentBrowserConverters.VersionHighlightBg}">
                                                    <Binding Path="Id"/>
                                                    <Binding Path="$parent[Window].((vm:ContentBrowserViewModel)DataContext).SelectedVersionId"/>
                                                </MultiBinding>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <MultiBinding Converter="{x:Static vm:ContentBrowserConverters.VersionHighlightBorder}">
                                                    <Binding Path="Id"/>
                                                    <Binding Path="$parent[Window].((vm:ContentBrowserViewModel)DataContext).SelectedVersionId"/>
                                                </MultiBinding>
                                            </Border.BorderBrush>
                                            <Border.BorderThickness>1</Border.BorderThickness>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <Border CornerRadius="8" Padding="6,2"
                                                                Background="{Binding VersionType, Converter={x:Static vm:ContentBrowserConverters.VersionTypeBg}}">
                                                            <TextBlock Text="{Binding VersionTypeDisplay}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding VersionType, Converter={x:Static vm:ContentBrowserConverters.VersionTypeFg}}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{Binding GameVersionsLabel}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding LoadersLabel}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                                                   IsVisible="{Binding LoadersLabel, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                        <TextBlock Text="{Binding FileSizeLabel}" FontSize="10.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                                        <TextBlock Text="{Binding DateLabel}" FontSize="10.5" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l10n:Tr Key=cb_no_versions}" FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,4"
                                       IsVisible="{Binding $parent[Window].DataContext.VersionList, Converter={x:Static vm:EditInstanceWindowConverters.IsCollectionEmpty}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: sidebar cards -->
            <StackPanel Grid.Column="1" Spacing="10">

                <!-- Compatibility (clickable versions + max height + scroll) -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="6">
                        <!-- Header row: title + clear filter button -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{l10n:Tr Key=cb_compatibility}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕" FontSize="10" Padding="6,2" CornerRadius="6"
                                    Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextMutedBrush}"
                                    BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                    IsVisible="{Binding $parent[Window].DataContext.IsCompatibilityFilterActive}"
                                    Command="{Binding $parent[Window].DataContext.ClearCompatibilityFilterCommand}"/>
                        </Grid>
                        <TextBlock Text="Minecraft: Java Edition" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.CompatibilityVersions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="8,5" Margin="0,0,0,4" Cursor="Hand"
                                                    Tapped="OnCompatibilityVersionTapped" Tag="{Binding}">
                                                <Border.Background>
                                                    <MultiBinding Converter="{x:Static vm:ContentBrowserConverters.VersionChipHighlight}">
                                                        <Binding/>
                                                        <Binding Path="$parent[Window].((vm:ContentBrowserViewModel)DataContext).SelectedCompatibilityVersion"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{x:Static vm:ContentBrowserConverters.VersionChipFg}">
                                                            <Binding/>
                                                            <Binding Path="$parent[Window].((vm:ContentBrowserViewModel)DataContext).SelectedCompatibilityVersion"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Text="{l10n:Tr Key=cb_platforms}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextCaptionBrush}" Margin="0,4,0,0"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ItemsControl ItemsSource="{Binding Loaders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Links -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="12"
                        IsVisible="{Binding $parent[Window].DataContext.FullProject, Converter={x:Static vm:EditInstanceWindowConverters.IsNotNull}}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{l10n:Tr Key=cb_links}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <Button Classes="sourceBtn" IsVisible="{Binding $parent[Window].DataContext.FullProject.SourceUrl, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}"
                                Command="{Binding $parent[Window].DataContext.OpenLinkCommand}" CommandParameter="source" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&lt;&gt;" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{l10n:Tr Key=cb_source}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="sourceBtn" IsVisible="{Binding $parent[Window].DataContext.FullProject.IssuesUrl, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}"
                                Command="{Binding $parent[Window].DataContext.OpenLinkCommand}" CommandParameter="issues" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="△" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{l10n:Tr Key=cb_issues}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="sourceBtn" IsVisible="{Binding $parent[Window].DataContext.FullProject.WikiUrl, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}"
                                Command="{Binding $parent[Window].DataContext.OpenLinkCommand}" CommandParameter="wiki" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="◈" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{l10n:Tr Key=cb_wiki}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="sourceBtn" IsVisible="{Binding $parent[Window].DataContext.FullProject.DiscordUrl, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}"
                                Command="{Binding $parent[Window].DataContext.OpenLinkCommand}" CommandParameter="discord" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="💬" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{l10n:Tr Key=cb_discord}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Creators -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="12"
                        IsVisible="{Binding $parent[Window].DataContext.FullProject.TeamMembers.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsNotZero}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=cb_creators}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.FullProject.TeamMembers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ModrinthTeamMember">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource IconChipBrush}" ClipToBounds="True">
                                            <Panel>
                                                <Image Source="{Binding AvatarUrl}" Width="28" Height="28" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Username[0]}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Details -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="12"
                        IsVisible="{Binding $parent[Window].DataContext.FullProject, Converter={x:Static vm:EditInstanceWindowConverters.IsNotNull}}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{l10n:Tr Key=cb_details}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding $parent[Window].DataContext.FullProject.LicenseName, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}">
                            <TextBlock Text="☰" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{l10n:Tr Key=cb_licensed}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding $parent[Window].DataContext.FullProject.LicenseName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding $parent[Window].DataContext.FullProject.DateCreated, Converter={x:Static vm:EditInstanceWindowConverters.IsNotDefault}}">
                            <TextBlock Text="📅" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{l10n:Tr Key=cb_published}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding $parent[Window].DataContext.FullProject.DateCreated, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⟳" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{l10n:Tr Key=cb_updated}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tags -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="12"
                        IsVisible="{Binding TagsLabel, Converter={x:Static vm:EditInstanceWindowConverters.IsNotEmpty}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l10n:Tr Key=cb_tags}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource FieldBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
