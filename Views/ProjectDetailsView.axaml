<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:converters="using:CustomMcLauncher.Converters"
             xmlns:models="using:CustomMcLauncher.Models"
             xmlns:utils="using:CustomMcLauncher.Common.Utils"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             x:Class="CustomMcLauncher.Views.ProjectDetailsView"
             x:CompileBindings="False">

    <UserControl.Styles>
        <!-- Tab navigation buttons: clean rounded pills matching Modrinth -->
        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tabBtn:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Button.tabBtn.active">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>

        <!-- Rounded Filter Dropdowns -->
        <Style Selector="Expander:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
        </Style>
        <Style Selector="Expander:expanded:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="Expander:expanded:pointerover /template/ Border#Root">
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
        </Style>
        <Style Selector="ComboBox.roundedFilterCombo">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ComboBox.roundedFilterCombo:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>

        <!-- Primary Action Button -->
        <Style Selector="Button.actionBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.actionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="Button.actionBtn.installing">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrushHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.actionBtn.installing:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>

        <!-- Link Buttons for Sidebar -->
        <Style Selector="Button.sidebarLinkBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.sidebarLinkBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sidebarLinkBtn:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.inlineLinkBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.inlineLinkBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.inlineLinkBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.socialMediaBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.socialMediaBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>

        <!-- Table and List Row Hover Styles (No transition to prevent white flash) -->
        <Style Selector="Border.versionRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Border.versionRow:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>

        <!-- Gallery Card Hover Styles -->
        <Style Selector="Border.galleryCard">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.galleryCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Modal Dialog Buttons -->
        <Style Selector="Button.dialogBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.dialogBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
        </Style>
        <Style Selector="Button.dialogDanger">
            <Setter Property="Background" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogDanger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.pageNumberBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pageNumberBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.pageNavBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pageNavBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.iconCopyBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.iconCopyBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Button.iconCopyBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.iconCopyBtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    
        <!-- Version Title Link Button for Changelog -->
        <Style Selector="Button.versionTitleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <TextBlock Text="{TemplateBinding Content}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               Foreground="{TemplateBinding Foreground}"
                               VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.versionTitleBtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
        <Style Selector="Button.versionTitleBtn:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
</UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- ========== TOP HEADER ========== -->
            <Border Grid.Row="0" Background="Transparent" Padding="0,8,0,14">
                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="12"
                            Background="{StaticResource IconChipBrush}" ClipToBounds="True" VerticalAlignment="Center">
                        <Panel>
                            <Image Source="{Binding DetailsProject.Icon}" Stretch="Uniform" Width="52" Height="52"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding DetailsProject.HasIcon}"/>
                            <Path Data="M20.5 11H19V7C19 5.9 18.1 5 17 5H13V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4C2.9 5 2 5.9 2 7V10.8H3.5C4.99 10.8 6.2 12.01 6.2 13.5S4.99 16.2 3.5 16.2H2V20C2 21.1 2.9 22 4 22H7.8V20.5C7.8 19.01 9.01 17.8 10.5 17.8S13.2 19.01 13.2 20.5V22H17C18.1 22 19 21.1 19 20V16H20.5C21.88 16 23 14.88 23 13.5S21.88 11 20.5 11Z"
                                  Width="26" Height="26" Stretch="Uniform" Fill="{StaticResource TextPlaceholderBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !DetailsProject.HasIcon}"/>
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DetailsProject.Title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,2">
                            <TextBlock Text="by" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Classes="inlineLinkBtn" Content="{Binding DetailsProject.Author}"
                                    Tag="{Binding DetailsProject.Author}" Click="OnAuthorTapped"
                                    FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                    Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="sectionHint" Text="{Binding DetailsProject.Description}" TextWrapping="Wrap" MaxLines="2"/>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="&#x2193;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetailsProject.DownloadsLabel}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4"
                                        IsVisible="{Binding FullProject.Follows, Converter={x:Static converters:EditInstanceWindowConverters.IsNotZero}}">
                                <TextBlock Text="&#x2661;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FullProject.Follows}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{l10n:Tr Key=btn_back}" CornerRadius="8" Padding="14,8"
                                Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"
                                Command="{Binding CloseDetailsCommand}"/>
                        <Button Classes="actionBtn" Classes.installing="{Binding SelectedProject.IsInstalling}" Padding="18,8"
                                Content="{Binding ReinstallText}"
                                Command="{Binding MainActionCommand}"
                                PointerEntered="OnActionButtonHover"
                                PointerExited="OnActionButtonHoverOut"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== TABS ========== -->
            <Border Grid.Row="1" Background="{StaticResource FieldBrush}" CornerRadius="20" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="tabBtn" Classes.active="{Binding IsDescriptionTab}"
                            Content="{l10n:Tr Key=cb_description}"
                            Command="{Binding SelectTabCommand}" CommandParameter="description"/>
                    <Button Classes="tabBtn" Classes.active="{Binding IsGalleryTab}"
                            Content="{l10n:Tr Key=cb_gallery}"
                            Command="{Binding SelectTabCommand}" CommandParameter="gallery"/>
                    <Button Classes="tabBtn" Classes.active="{Binding IsChangelogTab}"
                            Content="{l10n:Tr Key=cb_changelog}"
                            Command="{Binding SelectTabCommand}" CommandParameter="changelog"/>
                    <Button Classes="tabBtn" Classes.active="{Binding IsVersionsTab}"
                            Content="{l10n:Tr Key=cb_versions}"
                            Command="{Binding SelectTabCommand}" CommandParameter="versions"/>
                </StackPanel>
            </Border>

            <!-- ========== TWO-COLUMN BODY ========== -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="True" Padding="0,0,10,0">
                        <StackPanel>

                            <!-- ============================================== -->
                            <!-- VERSION DETAIL VIEW (Active when a version is selected) -->
                            <!-- ============================================== -->
                            <StackPanel IsVisible="{Binding IsVersionDetailActive}" Spacing="16">
                                <!-- Back navigation link -->
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        Command="{Binding CloseVersionDetailCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="&#x2039;" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="All versions" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Version Title Row -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedDetailVersion.VersionNumber}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border CornerRadius="12" Padding="8,3" VerticalAlignment="Center"
                                                    Background="{Binding SelectedDetailVersion.VersionType, Converter={x:Static converters:ContentBrowserConverters.VersionTypeBg}}">
                                                <TextBlock Text="{Binding SelectedDetailVersion.VersionTypeDisplay}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding SelectedDetailVersion.VersionType, Converter={x:Static converters:ContentBrowserConverters.VersionTypeFg}}"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- Subtitle metadata -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding SelectedDetailVersion.Name}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="&#x2022;" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailVersion.PrimaryLoader}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="&#x2022;" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailVersion.RelativeTime}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="&#x2022;" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"
                                                       IsVisible="{Binding SelectedDetailVersion.Downloads, Converter={x:Static converters:EditInstanceWindowConverters.IsNotZero}}"/>
                                            <TextBlock Text="{Binding SelectedDetailVersion.DownloadsLabel}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                                       IsVisible="{Binding SelectedDetailVersion.Downloads, Converter={x:Static converters:EditInstanceWindowConverters.IsNotZero}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Download Button -->
                                    <Button Grid.Column="1" Classes="actionBtn" Padding="18,8" VerticalAlignment="Center"
                                            Command="{Binding DownloadVersionCommand}" CommandParameter="{Binding SelectedDetailVersion}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="&#x2193;" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="Download" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Compatibility 3-Card Section -->
                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <TextBlock Text="Compatibility" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                        <!-- Minecraft Java Edition -->
                                        <Border Grid.Column="0" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="16,14" MinHeight="72">
                                            <StackPanel Spacing="8" HorizontalAlignment="Left">
                                                <TextBlock Text="Minecraft: Java Edition" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1"
                                                        CornerRadius="14" Padding="10,5" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding SelectedDetailVersion.PrimaryGameVersion}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Platform -->
                                        <Border Grid.Column="1" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="16,14" MinHeight="72">
                                            <StackPanel Spacing="8" HorizontalAlignment="Left">
                                                <TextBlock Text="Platform" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1"
                                                        CornerRadius="14" Padding="10,5" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <PathIcon Data="M12 15.5A3.5 3.5 0 0 1 8.5 12A3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5a3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97c0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1c0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66Z"
                                                                  Width="12" Height="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedDetailVersion.PrimaryLoader}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Supported Environments -->
                                        <Border Grid.Column="2" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="16,14" MinHeight="72">
                                            <StackPanel Spacing="8" HorizontalAlignment="Left">
                                                <TextBlock Text="Supported environments" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1"
                                                        CornerRadius="14" Padding="10,5" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <PathIcon Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"
                                                                  Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FullProject.ClientSideDisplay}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <!-- Changes Section -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Changes" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="18,16" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="What's Changed" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailVersion.CleanChangelog}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Developer Information Section matching Modrinth -->
                                <Expander Header="Developer information" IsExpanded="True" HorizontalAlignment="Stretch" Background="{StaticResource FieldBrush}"
                                          BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                                          Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13">
                                    <StackPanel Spacing="14" Margin="0,10,0,6">
                                        <!-- Explanatory intro text -->
                                        <TextBlock Text="Projects on Modrinth are automatically available through a Maven repository for use with JVM build tools such as Gradle. To learn more about the Modrinth Maven API, click here."
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>

                                        <!-- Explanatory note text -->
                                        <TextBlock Text="Note: When available, you should use the creator's maven repo instead as it will have transitive dependency information that the Modrinth Maven API does not. You may also end up with duplicate dependencies if you use a mix of Modrinth and non-Modrinth Maven repositories for your dependencies, because the group identifier will be different when served through the Modrinth Maven API."
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="17"/>

                                        <!-- Maven coordinates -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Maven coordinates:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedDetailVersion.MavenCoordinates}" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Classes="iconCopyBtn" Click="OnCopyMavenClicked" ToolTip.Tip="Copy Maven coordinates">
                                                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="13" Height="13" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Version ID -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Version ID:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedDetailVersion.Id}" FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Classes="iconCopyBtn" Click="OnCopyVersionIdClicked" ToolTip.Tip="Copy Version ID">
                                                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="13" Height="13" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- build.gradle -->
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="build.gradle:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Classes="iconCopyBtn" Click="OnCopyGradleClicked" ToolTip.Tip="Copy build.gradle snippet">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Copy" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                                <TextBlock Text="{Binding SelectedDetailVersion.GradleSnippet}" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- REGULAR TABS (Visible when no version detail active) -->
                            <!-- ============================================== -->
                            <StackPanel IsVisible="{Binding !IsVersionDetailActive}">

                                <!-- DESCRIPTION TAB (Rich Markdown Layout matching Modrinth) -->
                                <!-- TAB 0: DESCRIPTION (Two-column: Body + Sidebar) -->
                            <Grid IsVisible="{Binding IsDescriptionTab}" ColumnDefinitions="*,270" ColumnSpacing="16">
                                <!-- LEFT: Description Content -->
                                <StackPanel Grid.Column="0" Spacing="10">

                                    <ItemsControl ItemsSource="{Binding FullProject.DescriptionBlocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="utils:MarkdownBlock">
                                                <Panel Margin="0,0,0,4">
                                                    <!-- Banner image -->
                                                    <Border CornerRadius="8" ClipToBounds="True" MaxWidth="640" HorizontalAlignment="Center" Margin="0,4,0,16"
                                                            IsVisible="{Binding IsBannerImage}">
                                                        <Image Source="{Binding ImageBitmap}" Stretch="Uniform" MaxWidth="640"/>
                                                    </Border>

                                                    <!-- Social media button row -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,16"
                                                                IsVisible="{Binding IsSocialButtons}">
                                                        <ItemsControl ItemsSource="{Binding SocialButtons}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="utils:MarkdownSocialButton">
                                                                    <Button Classes="socialMediaBtn" ToolTip.Tip="{Binding Alt}" Tag="{Binding LinkUrl}" Click="OnExternalLinkTagClicked"
                                                                            Padding="0" Width="36" Height="36" Background="{StaticResource FieldBrush}" CornerRadius="8">
                                                                        <Image Source="{Binding IconBitmap}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- Headline image (e.g. About.png, Features.png) -->
                                                    <Border HorizontalAlignment="Left" Margin="0,18,0,8" IsVisible="{Binding IsHeadlineImage}">
                                                        <Image Source="{Binding ImageBitmap}" Height="34" Stretch="Uniform"/>
                                                    </Border>

                                                    <!-- Divider graphic image -->
                                                    <Border HorizontalAlignment="Center" Margin="0,16,0,16" IsVisible="{Binding IsDividerImage}">
                                                        <Image Source="{Binding ImageBitmap}" Height="16" Stretch="Uniform"/>
                                                    </Border>

                                                    <!-- Divider Line -->
                                                    <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,12,0,12" IsVisible="{Binding IsDividerLine}"/>

                                                    <!-- Header 1 -->
                                                    <TextBlock Text="{Binding Text}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="0,14,0,6" IsVisible="{Binding IsHeader1}"/>

                                                    <!-- Header 2 -->
                                                    <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="0,12,0,4" IsVisible="{Binding IsHeader2}"/>

                                                    <!-- Header 3 -->
                                                    <TextBlock Text="{Binding Text}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="0,8,0,3" IsVisible="{Binding IsHeader3}"/>

                                                    <!-- Bullet point with rich spans -->
                                                    <Grid ColumnDefinitions="14,*" Margin="4,2,0,2" IsVisible="{Binding IsBullet}">
                                                        <TextBlock Text="&#x2022;" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                                                        <utils:MarkdownParagraphControl Grid.Column="1" Spans="{Binding Spans}" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"/>
                                                    </Grid>

                                                    <!-- Paragraph with bold spans and formatted runs -->
                                                    <utils:MarkdownParagraphControl Spans="{Binding Spans}" Text="{Binding Text}" FontSize="12.5"
                                                                                     TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,6"
                                                                                     IsVisible="{Binding IsParagraph}"/>

                                                    <!-- Table -->
                                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                                                            BorderThickness="1" CornerRadius="8" Margin="0,6,0,10" ClipToBounds="True" IsVisible="{Binding IsTable}">
                                                        <StackPanel>
                                                            <!-- Headers -->
                                                            <Border Background="{StaticResource CardAltBrush}" Padding="10,8" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="0,0,0,1">
                                                                <ItemsControl ItemsSource="{Binding Table.Headers}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Rows="1"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                            <!-- Rows -->
                                                            <ItemsControl ItemsSource="{Binding Table.Rows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="utils:MarkdownTableRow">
                                                                        <Border Padding="10,7" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                                                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <UniformGrid Rows="1"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Fallback if blocks are empty -->
                                    <TextBlock Text="{Binding CleanBody}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"
                                               IsVisible="{Binding FullProject.DescriptionBlocks, Converter={x:Static converters:EditInstanceWindowConverters.IsCollectionEmpty}}"/>
                                
                                </StackPanel>

                                <!-- RIGHT: Sidebar -->
<!-- RIGHT SIDEBAR (Matching Modrinth Spec) -->
                <StackPanel Grid.Column="1" Spacing="12">

                    <!-- 1. Compatibility -->
                    <Border Classes="zenSection" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{l10n:Tr Key=cb_compatibility}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>

                            <!-- Game Versions -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Minecraft: Java Edition" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <ItemsControl ItemsSource="{Binding FullProject.GroupedGameVersions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Platforms -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l10n:Tr Key=cb_platforms}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <ItemsControl ItemsSource="{Binding FullProject.Loaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Supported Environments -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Supported environments" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding FullProject.ClientSideDisplay}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Links -->
                    <Border Classes="zenSection" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12"
                            IsVisible="{Binding FullProject, Converter={x:Static converters:EditInstanceWindowConverters.IsNotNull}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l10n:Tr Key=cb_links}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>

                            <Button Classes="sidebarLinkBtn" IsVisible="{Binding FullProject.IssuesUrl, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"
                                    Command="{Binding OpenLinkCommand}" CommandParameter="issues">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" Width="13" Height="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Report issues" FontSize="11.5"/>
                                    <TextBlock Text="&#x2197;" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebarLinkBtn" IsVisible="{Binding FullProject.SourceUrl, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"
                                    Command="{Binding OpenLinkCommand}" CommandParameter="source">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z" Width="13" Height="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="View source" FontSize="11.5"/>
                                    <TextBlock Text="&#x2197;" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebarLinkBtn" IsVisible="{Binding FullProject.DiscordUrl, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"
                                    Command="{Binding OpenLinkCommand}" CommandParameter="discord">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.08-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.01.06.02.09.01 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z"
                                              Width="13" Height="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Join Discord server" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#x2197;" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebarLinkBtn" IsVisible="{Binding FullProject.WikiUrl, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"
                                    Command="{Binding OpenLinkCommand}" CommandParameter="wiki">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z" Width="13" Height="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Wiki" FontSize="11.5"/>
                                    <TextBlock Text="&#x2197;" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 3. Tags -->
                    <Border Classes="zenSection" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12"
                            IsVisible="{Binding DetailsProject.Categories.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsNotZero}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l10n:Tr Key=cb_tags}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding DetailsProject.Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 4. Creators -->
                    <Border Classes="zenSection" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12"
                            IsVisible="{Binding FullProject.TeamMembers.Count, Converter={x:Static converters:EditInstanceWindowConverters.IsNotZero}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{l10n:Tr Key=cb_creators}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding FullProject.TeamMembers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModrinthTeamMember">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource IconChipBrush}" ClipToBounds="True">
                                                <Panel>
                                                    <Image Source="{Binding Avatar}" Width="28" Height="28" Stretch="UniformToFill"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasAvatar}"/>
                                                    <TextBlock Text="{Binding Username[0]}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasAvatar}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Classes="inlineLinkBtn" Content="{Binding Username}" Tag="{Binding Username}" Click="OnAuthorTapped" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#x1F451;" FontSize="10" IsVisible="{Binding IsOwner}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
                            </Grid>

                                <!-- GALLERY TAB -->
                                <StackPanel IsVisible="{Binding IsGalleryTab}" Spacing="14">
                                    <ItemsControl ItemsSource="{Binding GalleryItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ModrinthGalleryItem">
                                                <Border Classes="galleryCard" Width="260" Margin="0,0,14,14"
                                                        Tapped="OnGalleryItemTapped">
                                                    <StackPanel>
                                                        <Border Height="145" Background="{StaticResource FieldBrush}" ClipToBounds="True">
                                                            <Image Source="{Binding Image}" Stretch="UniformToFill" IsVisible="{Binding HasImage}"/>
                                                        </Border>
                                                        <StackPanel Margin="12,10,12,10" Spacing="4">
                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding HasDisplayTitle}"/>
                                                            <TextBlock Text="{Binding CreatedDisplay}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       IsVisible="{Binding CreatedDisplay, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{l10n:Tr Key=cb_no_screenshots}" FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}"
                                               IsVisible="{Binding !GalleryItems.Count}"/>
                                </StackPanel>

                                <!-- CHANGELOG TAB (Timeline matching Modrinth) -->
                                <StackPanel IsVisible="{Binding IsChangelogTab}" Spacing="6">
                                    <!-- Filters bar above timeline with multi-select platforms and theme-aware pagination -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <PathIcon Grid.Column="0" Data="M3 4h18v2l-7 8v6l-4-2v-4L3 6V4z" Width="13" Height="13"
                                                  Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <ComboBox Grid.Column="1" Classes="roundedFilterCombo" ItemsSource="{Binding FilterGameVersions}" SelectedItem="{Binding SelectedFilterGameVersion}"
                                                  Width="150" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="2" Classes="roundedFilterCombo" ItemsSource="{Binding FilterPlatforms}" SelectedItem="{Binding SelectedFilterPlatform}"
                                                  Width="140" VerticalAlignment="Center"/>

                                        <!-- Theme-aware Pagination -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                    IsVisible="{Binding HasMultipleVersionPages}">
                                            <Button Classes="pageNavBtn" Click="OnPrevPageClicked" IsEnabled="{Binding CanGoPrevVersionPage}"
                                                    IsVisible="{Binding CanGoPrevVersionPage}">
                                                <TextBlock Text="&#x2039;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding VersionPageItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PaginationPageItem">
                                                        <Panel VerticalAlignment="Center">
                                                            <!-- Active Page: Theme-aware Circle -->
                                                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                                                    IsVisible="{Binding IsActive}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="12.5" FontWeight="Bold"
                                                                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <!-- Ellipsis -->
                                                            <TextBlock Text="..." FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding IsEllipsis}"/>
                                                            <!-- Inactive Page Button -->
                                                            <Button Classes="pageNumberBtn" Content="{Binding DisplayText}" Click="OnPageNumberClicked"
                                                                    IsVisible="{Binding IsClickable}"/>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="pageNavBtn" Click="OnNextPageClicked" IsEnabled="{Binding CanGoNextVersionPage}"
                                                    IsVisible="{Binding CanGoNextVersionPage}">
                                                <TextBlock Text="&#x203A;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Timeline items container matching Modrinth background -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="#1E2026" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                        <ItemsControl ItemsSource="{Binding VersionList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ModrinthProjectVersion">
                                                    <Border Classes="changelogRow" Padding="16,12" Margin="0,0,0,4" Background="Transparent">
                                                        <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12" VerticalAlignment="Top">
                                                            <!-- Compact Timeline: Accent Dot + Dashed Line -->
                                                            <Grid Grid.Column="0" VerticalAlignment="Stretch">
                                                                <Line StartPoint="0,14" EndPoint="0,85" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                                                      StrokeDashArray="3,3" HorizontalAlignment="Center"/>
                                                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}"
                                                                         VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                            </Grid>

                                                            <!-- Title & Details (Cursor pointer ONLY on title) -->
                                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Classes="versionTitleBtn" Content="{Binding Name}" Click="OnVersionRowTapped" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="by " FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                    <Button Classes="authorLinkBtn" Content="{Binding AuthorName}" Tag="{Binding AuthorName}" Click="OnAuthorTapped"
                                                                            FontSize="11.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="&#x2022;" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <Border Background="{Binding VersionType, Converter={x:Static converters:ContentBrowserConverters.VersionTypeBg}}"
                                                                            CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding VersionTypeDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                                                   Foreground="{Binding VersionType, Converter={x:Static converters:ContentBrowserConverters.VersionTypeFg}}"/>
                                                                    </Border>
                                                                    <TextBlock Text="&#x2022;" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding RelativeTime}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                                                </WrapPanel>

                                                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding GameVersionsLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="{Binding LoadersLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                                </WrapPanel>

                                                                <TextBlock Text="{Binding Changelog}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                                           IsVisible="{Binding Changelog, Converter={x:Static converters:EditInstanceWindowConverters.IsNotEmpty}}"/>
                                                            </StackPanel>

                                                            <!-- Install / Download Action -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0">
                                                                <Button Classes="actionBtn" Click="OnDownloadVersionClicked" Padding="12,6"
                                                                        CornerRadius="6" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"
                                                                        Cursor="Hand" ToolTip.Tip="Install Version">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                        <PathIcon Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                                                                                  Width="12" Height="12" Foreground="{DynamicResource OnAccentBrush}"/>
                                                                        <TextBlock Text="Install" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <TextBlock Text="{l10n:Tr Key=cb_no_changelog}" FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}"
                                               IsVisible="{Binding VersionList, Converter={x:Static converters:EditInstanceWindowConverters.IsCollectionEmpty}}"/>
                                </StackPanel>

                                <!-- VERSIONS TAB (Table matching Modrinth) -->
                                <StackPanel IsVisible="{Binding IsVersionsTab}" Spacing="6">
                                    <!-- Filters bar above timeline with multi-select platforms and theme-aware pagination -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <PathIcon Grid.Column="0" Data="M3 4h18v2l-7 8v6l-4-2v-4L3 6V4z" Width="13" Height="13"
                                                  Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <ComboBox Grid.Column="1" Classes="roundedFilterCombo" ItemsSource="{Binding FilterGameVersions}" SelectedItem="{Binding SelectedFilterGameVersion}"
                                                  Width="150" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="2" Classes="roundedFilterCombo" ItemsSource="{Binding FilterPlatforms}" SelectedItem="{Binding SelectedFilterPlatform}"
                                                  Width="140" VerticalAlignment="Center"/>

                                        <!-- Theme-aware Pagination -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                    IsVisible="{Binding HasMultipleVersionPages}">
                                            <Button Classes="pageNavBtn" Click="OnPrevPageClicked" IsEnabled="{Binding CanGoPrevVersionPage}"
                                                    IsVisible="{Binding CanGoPrevVersionPage}">
                                                <TextBlock Text="&#x2039;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding VersionPageItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PaginationPageItem">
                                                        <Panel VerticalAlignment="Center">
                                                            <!-- Active Page: Theme-aware Circle -->
                                                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                                                    IsVisible="{Binding IsActive}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="12.5" FontWeight="Bold"
                                                                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <!-- Ellipsis -->
                                                            <TextBlock Text="..." FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding IsEllipsis}"/>
                                                            <!-- Inactive Page Button -->
                                                            <Button Classes="pageNumberBtn" Content="{Binding DisplayText}" Click="OnPageNumberClicked"
                                                                    IsVisible="{Binding IsClickable}"/>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="pageNavBtn" Click="OnNextPageClicked" IsEnabled="{Binding CanGoNextVersionPage}"
                                                    IsVisible="{Binding CanGoNextVersionPage}">
                                                <TextBlock Text="&#x203A;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Versions Table Container matching Modrinth coordinates -->
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="#1E2026" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <StackPanel>
                                            <!-- Table Header -->
                                            <Border Background="Transparent" Padding="16,10"
                                                    BorderBrush="#1E2026" BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="150,110,120,90,90,*">
                                                    <TextBlock Grid.Column="0" Text="Version" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="Game version" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Platform" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="Published" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="4" Text="Downloads" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Table Rows -->
                                            <ItemsControl ItemsSource="{Binding VersionList}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ModrinthProjectVersion">
                                                        <Border Classes="versionRow" Padding="16,10" BorderBrush="#1E2026"
                                                                BorderThickness="0,0,0,1" Tapped="OnVersionRowTapped">
                                                            <Grid ColumnDefinitions="150,110,120,90,90,*">
                                                                <!-- Version with Initial Badge -->
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center"
                                                                            Background="{Binding VersionType, Converter={x:Static converters:ContentBrowserConverters.VersionTypeBg}}">
                                                                        <TextBlock Text="{Binding VersionTypeInitial}" FontSize="11" FontWeight="Bold"
                                                                                   Foreground="{Binding VersionType, Converter={x:Static converters:ContentBrowserConverters.VersionTypeFg}}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding VersionNumber}" FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <!-- Game Version Pill -->
                                                                <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,3"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PrimaryGameVersion}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                </Border>

                                                                <!-- Platform Pill -->
                                                                <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,3"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PrimaryLoader}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                                </Border>

                                                                <!-- Published -->
                                                                <TextBlock Grid.Column="3" Text="{Binding RelativeTime}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                                                                <!-- Downloads -->
                                                                <TextBlock Grid.Column="4" Text="{Binding DownloadsLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                                <!-- Download Action Button matching Changelog -->
                                                                <Button Grid.Column="5" Classes="actionBtn" Width="104" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                        Click="OnDownloadVersionClicked" ToolTip.Tip="Download and install">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="&#x2193;" FontWeight="Bold" FontSize="13"/>
                                                                        <TextBlock Text="Download" FontWeight="Bold" FontSize="11.5"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{l10n:Tr Key=cb_no_versions}" FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,4"
                                               IsVisible="{Binding VersionList, Converter={x:Static converters:EditInstanceWindowConverters.IsCollectionEmpty}}"/>
                                </StackPanel>

                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- LIGHTBOX MODAL: FULLSCREEN GALLERY VIEWER -->
        <!-- ============================================== -->
        <Border IsVisible="{Binding IsGalleryModalOpen}" Background="#E6000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="2000">
            <Grid RowDefinitions="Auto,*" Margin="20">
                <!-- Modal Toolbar -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ActiveGalleryModalItem.Title}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="-" Command="{Binding GalleryZoomOutCommand}" Classes="dialogBtn" Width="32" Height="32" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="{Binding GalleryZoom, StringFormat='{}{0:P0}'}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="45" TextAlignment="Center"/>
                        <Button Content="+" Command="{Binding GalleryZoomInCommand}" Classes="dialogBtn" Width="32" Height="32" HorizontalContentAlignment="Center"/>
                        <Button Content="100%" Command="{Binding GalleryZoomResetCommand}" Classes="dialogBtn" Padding="8,4" Height="32"/>
                        <Button Content="&#x2715;" Command="{Binding CloseGalleryModalCommand}" Classes="dialogBtn" Width="32" Height="32" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Zoomable Image View with Mouse Wheel -->
                <Border Grid.Row="1" ClipToBounds="True" PointerWheelChanged="OnGalleryViewerPointerWheel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image Source="{Binding ActiveGalleryModalItem.Image}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="{Binding GalleryZoom}" ScaleY="{Binding GalleryZoom}"/>
                        </Image.RenderTransform>
                    </Image>
                </Border>
            </Grid>
        </Border>

        <!-- MODAL: Reinstall Confirmation Overlay -->
        <Border IsVisible="{Binding IsReinstallConfirmOpen, FallbackValue=False, TargetNullValue=False}" Background="{StaticResource OverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1200">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="12" MaxWidth="380" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding ReinstallConfirmTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerLightBrush}"/>
                    <TextBlock Text="{Binding ReinstallConfirmMessage}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{l10n:Tr Key=no}" Command="{Binding CancelReinstallCommand}" Classes="dialogBtn"
                                Width="90" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="{Binding ReinstallConfirmButtonText}" Command="{Binding ConfirmReinstallCommand}"
                                IsEnabled="{Binding CanConfirmReinstall}" Classes="dialogBtn dialogDanger"
                                MinWidth="110" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
