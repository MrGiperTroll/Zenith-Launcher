<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="using:CustomMcLauncher.Views"
              x:Class="CustomMcLauncher.Views.RamCardControl">



    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleBlock" Text="Allocated RAM" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleBlock" Text="" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                </StackPanel>

                <!-- Minimalist badge with fixed geometry: never shifts or wraps -->
                <Border Grid.Column="1"
                        x:Name="BadgeContainer"
                        Background="{StaticResource FieldBrush}"
                        BorderBrush="{StaticResource BorderEditorBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Height="28"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="IBeam"
                        ToolTip.Tip="Double-click to edit (MB)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="NumberText"
                                   Text="4096"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="EditTextBox"
                                 Classes="badgeInput"
                                 IsVisible="False"
                                 FontSize="12"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                 TextAlignment="Right"
                                 VerticalAlignment="Center"
                                 MinWidth="38"
                                 FocusAdorner="{x:Null}"/>
                        <TextBlock x:Name="UnitText"
                                   Text="MB"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="7,0,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Compact Slider -->
            <Slider x:Name="RamSlider"
                    Minimum="512"
                    Maximum="16384"
                    Value="4096"
                    TickFrequency="512"
                    IsSnapToTickEnabled="True"
                    Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
