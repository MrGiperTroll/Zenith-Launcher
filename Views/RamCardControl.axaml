<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="using:CustomMcLauncher.Views"
              x:Class="CustomMcLauncher.Views.RamCardControl">



    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7">
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleBlock" Text="Allocated RAM" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="SubtitleBlock" Text="" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Minimalist badge with fixed geometry: never shifts or wraps -->
                <Border Grid.Column="1"
                        x:Name="BadgeContainer"
                        Background="{StaticResource FieldBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Height="24"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="IBeam"
                        ToolTip.Tip="Double-click to edit (MB)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="NumberText"
                                   Text="4096"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="EditTextBox"
                                 Classes="badgeInput"
                                 IsVisible="False"
                                 FontSize="11.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 SelectionForegroundBrush="{DynamicResource OnAccentBrush}"
                                 TextAlignment="Right"
                                 VerticalAlignment="Center"
                                 MinWidth="34"
                                 FocusAdorner="{x:Null}"/>
                        <TextBlock x:Name="UnitText"
                                   Text="MB"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Compact Slider -->
            <Slider x:Name="RamSlider"
                    Minimum="1024"
                    Maximum="16384"
                    Value="4096"
                    TickFrequency="512"
                    IsSnapToTickEnabled="True"
                    Margin="0,-4,0,-2"/>
        </StackPanel>
    </Border>
</UserControl>
