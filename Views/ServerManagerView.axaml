<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CustomMcLauncher.Views.ServerManagerView"
             xmlns:views="using:CustomMcLauncher.Views"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:services="using:CustomMcLauncher.Services"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             x:DataType="vm:ServerManagerViewModel"
             Background="{StaticResource BgBrush}">

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource CardAltBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderCardSoftBrush}" BorderThickness="1" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Spacing="2">
                    <TextBlock Text="{l10n:Tr Key=sm_title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="primaryBtn" Content="{l10n:Tr Key=sm_add}" Command="{Binding AddServerCommand}" VerticalAlignment="Center" Padding="16,8"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource ContentSurfaceBrush}" BorderBrush="{StaticResource PanelBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Servers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ServerEntry">
                                    <Border Margin="0,2,0,2" Padding="10,8" CornerRadius="8" Background="{StaticResource CardBrush}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Ip}" FontSize="11" Foreground="{StaticResource TextLabelBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding $parent[views:ServerManagerView].((vm:ServerManagerViewModel)DataContext).EditServerCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="{StaticResource TextLabelBrush}" Padding="8,6" Cursor="Hand" Margin="4,0">
                                                <PathIcon Data="M3 17.25V21H6.75L17.81 9.94L14.06 6.19L3 17.25ZM20.71 7.04C21.1 6.65 21.1 6.02 20.71 5.63L18.37 3.29C17.98 2.9 17.35 2.9 16.96 3.29L15.13 5.12L18.88 8.87L20.71 7.04Z" Width="13" Height="13"/>
                                            </Button>
                                            <Button Grid.Column="2" Command="{Binding $parent[views:ServerManagerView].((vm:ServerManagerViewModel)DataContext).DeleteServerCommand}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="{StaticResource DangerBrush}" Padding="8,6" Cursor="Hand" Margin="4,0">
                                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="13" Height="13"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l10n:Tr Key=sm_empty}" Foreground="{StaticResource TextPlaceholderBrush}" FontSize="12" HorizontalAlignment="Center" Padding="0,24"
                                   IsVisible="{Binding Servers.Count, Converter={x:Static vm:EditInstanceWindowConverters.IsZero}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" IsVisible="{Binding IsEditorOpen}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l10n:Tr Key=sm_name}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox Text="{Binding EditorName}" PlaceholderText="{l10n:Tr Key=sm_server_ph}"/>
                    <TextBlock Text="{l10n:Tr Key=sm_ip}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox Text="{Binding EditorIp}" PlaceholderText="play.example.com:25565"/>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <CheckBox Content="{l10n:Tr Key=sm_accept_packs}" IsChecked="{Binding EditorAcceptTextures}"/>
                        <CheckBox Content="{l10n:Tr Key=sm_hide_address}" IsChecked="{Binding EditorHideAddress}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                        <Button Grid.Column="1" Classes="subBtn" Content="{l10n:Tr Key=sm_icon}" Command="{Binding PickIconCommand}" Padding="16,8"/>
                        <Button Grid.Column="2" Classes="subBtn" Content="{l10n:Tr Key=cancel}" Command="{Binding CancelEditCommand}" Padding="16,8"/>
                        <Button Grid.Column="3" Classes="primaryBtn" Content="{l10n:Tr Key=btn_save}" Command="{Binding SaveEditorCommand}" Padding="20,8"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
