<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             xmlns:services="using:CustomMcLauncher.Services"
             x:Class="CustomMcLauncher.Views.ThemeSettingsView"
             x:DataType="vm:MainWindowViewModel">
    
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Classes="iconBtn" Command="{Binding CloseThemeEditorCommand}" Margin="0,0,12,0" ToolTip.Tip="{l10n:Tr Key=back}">
                    <PathIcon Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" Width="16" Height="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
                <TextBlock Grid.Column="1" Text="Edit Theme" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0">
            <StackPanel Spacing="24">
                
                <StackPanel Spacing="8">
                    <TextBlock Text="Simple (Presets)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Static services:ZenithTheme.Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:ThemePreset">
                                <Button Classes="cardBtn" Command="{ReflectionBinding [UserControl].DataContext.ApplyThemePresetCommand}" CommandParameter="{Binding}" Margin="0,0,12,12" Width="140">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Border Height="80" CornerRadius="6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{Binding HexColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding NameEn}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Advanced Customization" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Enter HEX codes to customize specific UI elements." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    
                    <Border Background="{StaticResource PanelBrushTransparent}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Background Color" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding BgHex, Mode=TwoWay}" PlaceholderText="#080A0F"/>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Sidebar Background" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding SidebarBgHex, Mode=TwoWay}" PlaceholderText="#06080D"/>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Surface (Cards)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding SurfaceHex, Mode=TwoWay}" PlaceholderText="#0D111A"/>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Card Color" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding CardHex, Mode=TwoWay}" PlaceholderText="#0D111A"/>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Panel (Editor) Color" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding PanelHex, Mode=TwoWay}" PlaceholderText="#121722"/>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Primary Text" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding TextPrimaryHex, Mode=TwoWay}" PlaceholderText="#FFFFFF"/>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Secondary Text" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding TextSecondaryHex, Mode=TwoWay}" PlaceholderText="#C5CBD6"/>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Borders" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding BorderDarkHex, Mode=TwoWay}" PlaceholderText="#121622"/>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" VerticalAlignment="Center">
                                <TextBlock Text="Accent Color" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding CustomThemeHex, Mode=TwoWay}" PlaceholderText="#3B82F6"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
