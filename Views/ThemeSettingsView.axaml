<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomMcLauncher.ViewModels"
             xmlns:controls="using:CustomMcLauncher.Controls"
             xmlns:l10n="using:CustomMcLauncher.Extensions"
             xmlns:services="using:CustomMcLauncher.Services"
             x:Class="CustomMcLauncher.Views.ThemeSettingsView"
             x:DataType="vm:MainWindowViewModel">
    
    <UserControl.Styles>
        <Style Selector="TextBox.darkInput">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="Button.subBtn">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderEditorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.subBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}"/>
        </Style>
        <Style Selector="Button.subTabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.subTabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.subTabBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header with Back Button -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="subBtn" Command="{Binding CloseThemeEditorCommand}" Padding="10,6" ToolTip.Tip="{l10n:Tr Key=back}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l10n:Tr Key=back}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{l10n:Tr Key=theme_edit}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <!-- Subtabs Switcher -->
        <Border Grid.Row="1" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="subTabBtn" Classes.active="{Binding IsThemeSubTabSimple}" Command="{Binding SwitchThemeSubTabCommand}" CommandParameter="Simple">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.22 19.59 10.56 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9zm0 15c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6z" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{l10n:Tr Key=theme_simple}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="subTabBtn" Classes.active="{Binding IsThemeSubTabAdvanced}" Command="{Binding SwitchThemeSubTabCommand}" CommandParameter="Advanced">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{l10n:Tr Key=theme_advanced}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2" Margin="0" Padding="0,0,10,0">
            <StackPanel Spacing="20">
                
                <!-- LIVE PREVIEW CARD (Common to both subtabs) -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{l10n:Tr Key=theme_preview}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Interactive sample of theme accent colors and active background particles" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{Binding PreviewAccentBrush}" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Preview Sandbox Box -->
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Height="90" ClipToBounds="True">
                            <Panel>
                                <!-- Simulated particle animation layer -->
                                <controls:ParticleSystemControl ParticleType="{Binding SelectedParticle}" IsHitTestVisible="False"/>

                                <!-- Sample UI elements displaying active theme styles -->
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="14" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource IconChipBrush}" VerticalAlignment="Center">
                                            <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Zenith Launcher" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedParticle, StringFormat='Effect: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CustomThemeHex}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Button Classes="primaryBtn" Content="Sample Button" Padding="14,6" Height="28"/>
                                    </StackPanel>
                                </Grid>
                            </Panel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SUBTAB 1: SIMPLE (PRESETS) -->
                <StackPanel Spacing="16" IsVisible="{Binding IsThemeSubTabSimple}">
                    <!-- Presets Chips -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l10n:Tr Key=set_theme}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{l10n:Tr Key=set_theme_hint}" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Static services:ZenithTheme.Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ThemePreset">
                                        <Button Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ChooseThemeCommand}"
                                                CommandParameter="{Binding HexColor}"
                                                Classes="subBtn"
                                                CornerRadius="8"
                                                Padding="10,6"
                                                Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="14" Height="14" CornerRadius="7" Background="{Binding ColorBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Particles for Simple tab -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{l10n:Tr Key=theme_particles}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Выберите эффект для фона (падающий снег или листья)" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ParticleOptions}" SelectedItem="{Binding SelectedParticle}" Width="190" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static vm:ParticleDisplayConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- SUBTAB 2: ADVANCED CUSTOMIZATION -->
                <StackPanel Spacing="16" IsVisible="{Binding IsThemeSubTabAdvanced}">
                    <!-- Particles for Advanced tab -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{l10n:Tr Key=theme_particles}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Выберите эффект для фона (падающий снег или листья)" FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ParticleOptions}" SelectedItem="{Binding SelectedParticle}" Width="190" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static vm:ParticleDisplayConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Hex Palette Editor -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Advanced Palette (HEX)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Enter HEX codes to customize specific UI elements." FontSize="11" Foreground="{StaticResource TextPlaceholderBrush}"/>
                            </StackPanel>

                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderEditorBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Accent Color" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding CustomThemeHex, Mode=TwoWay}" PlaceholderText="#3B82F6"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Background Color" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding BgHex, Mode=TwoWay}" PlaceholderText="#080A0F"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Sidebar Background" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding SidebarBgHex, Mode=TwoWay}" PlaceholderText="#06080D"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Surface (Cards)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding SurfaceHex, Mode=TwoWay}" PlaceholderText="#0D111A"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Card Color" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding CardHex, Mode=TwoWay}" PlaceholderText="#0D111A"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Panel (Editor) Color" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding PanelHex, Mode=TwoWay}" PlaceholderText="#121722"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Primary Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding TextPrimaryHex, Mode=TwoWay}" PlaceholderText="#FFFFFF"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Secondary Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding TextSecondaryHex, Mode=TwoWay}" PlaceholderText="#C5CBD6"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                        <TextBlock Text="Borders" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="darkInput" Text="{Binding BorderDarkHex, Mode=TwoWay}" PlaceholderText="#121622"/>
                                    </Grid>

                                    <Button Classes="primaryBtn" Command="{Binding RequestApplyThemeCommand}" Content="{l10n:Tr Key=set_apply}" HorizontalAlignment="Right" Padding="18,6" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
