<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CustomMcLauncher.Views.UpdateNotificationWindow"
        x:DataType="vms:UpdateNotificationViewModel"
        xmlns:vms="clr-namespace:CustomMcLauncher.Views"
        Title="Zenith Launcher"
        Width="360" Height="150"
        MinWidth="320" MinHeight="140"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        CanResize="False"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondaryBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Padding="24,20" Background="{StaticResource BgBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="{Binding TitleText}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <!-- Status -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusText}"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Classes="secondaryBtn"
                        Content="{Binding DismissText}"
                        Command="{Binding DismissCommand}"
                        IsEnabled="{Binding !IsDownloading}"/>
                <Button Classes="primaryBtn"
                        Content="{Binding UpdateButtonText}"
                        Command="{Binding UpdateCommand}"
                        IsEnabled="{Binding !IsDownloading}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
